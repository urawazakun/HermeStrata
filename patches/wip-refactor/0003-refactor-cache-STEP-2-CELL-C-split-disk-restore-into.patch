+
+bool m_repair(void* p) {
+    MSeams* s = static_cast<MSeams*>(p);
+    s->seq.push_back(3);
+    if (s->throw_at == 3) throw std::runtime_error("fake repair throw");
+    return s->repair_ret;
+}
+
+bool m_reset(void* p) {
+    MSeams* s = static_cast<MSeams*>(p);
+    ++s->resets;
+    s->seq.push_back(9);
+    return s->reset_ret;
+}
