diff --git a/include/strata/program/restore.hpp b/include/strata/program/restore.hpp
index 7e60866..9810095 100644
--- a/include/strata/program/restore.hpp
+++ b/include/strata/program/restore.hpp
@@ -221,4 +221,68 @@ class RestoreWalk {
     std::vector<std::string> disk_skip_;
 };
 
+// ---- Disk restore phases: validate (no GPU mutation) then mount (GPU mutation). -------------
+//
+// Phase 1 loads the lazy payload and runs full validation without touching the GPU; phase 2
+// uploads, refills the ring and pairs the boundary cell, resetting for coherence on any
+// failure. Both catch internally and return typed outcomes; the walk consumes them with a
+// switch (no phase-level try/catch/continue). The drivers never touch the index themselves:
+// index disposition is encoded in the outcome for the caller (drop = drop_path only, never
+// file deletion). Attempt logs print inside the drivers in original order (reason strings
+// borrowed from the caller, never copied for metadata); only the fatal ERR line stays with
+// the caller, selected by the FatalMount/FatalRepair disposition.
+
+/// Phase-1 index disposition: the entry is validated (mount it), dropped from the index by
+/// the driver itself (caller drops nothing; chain stays alive), or transiently failed (index
+/// and chain kept, try shorter).
+enum class DiskValidateDisposition : uint8_t { Proceed, DroppedIndex, KeepIndex };
+
+struct DiskValidateOutcome {
+    DiskValidateDisposition disposition = DiskValidateDisposition::KeepIndex;
+    RestoreFail fail = RestoreFail::None;
+};
+
+/// Non-owning phase-1 seams (function + borrowed context, synchronous use only).
+using DiskLoadFn = bool (*)(const saved_state::RootDiskStore::Entry&, saved_state::SavedItem&,
+                            std::string&, void*);
+using DiskValidateFn = bool (*)(const saved_state::SavedItem&, std::string&, void*);
+using DiskDropFn = void (*)(const std::string&, void*);
+
+/// Phase 1: lazy load (any false drops the index, including unreadable/stopped stores - never
+/// classified retryable) then full validation (any false drops the index); the drop runs
+/// inside the same try, so a throwing drop is a transient keep exactly as before. Throws on
+/// any side keep the index and the chain. True/true proceeds to the mount phase.
+DiskValidateOutcome validate_disk_candidate(
+    const saved_state::RootDiskStore::Entry& dent, saved_state::SavedItem& mount, std::string& why,
+    int64_t sk, DiskLoadFn load, void* load_ctx, DiskValidateFn validate, void* validate_ctx,
+    DiskDropFn drop, void* drop_ctx);
+
+/// Phase-2 disposition: restored (record success), fallthrough (reset held: kill chain, keep
+/// index, try shorter), or fatal (reset failed: fail the request with the mount/repair ERR).
+enum class DiskMountDisposition : uint8_t { Restored, Fallthrough, FatalMount, FatalRepair };
+
+struct DiskMountOutcome {
+    DiskMountDisposition disposition = DiskMountDisposition::Fallthrough;
+    RestoreFail fail = RestoreFail::None;
+};
+
+/// Non-owning phase-2 seams (functions + one borrowed context, synchronous use only). Upload
+/// covers device-sync, stage uploads, MTP rows and ordering syncs (false includes the initial
+/// device-not-idle: it resets exactly like a failed upload); refill is the ring refill after
+/// a good upload; repair pairs boundary cell k-1. Any seam may throw (transient). Reset runs
+/// the full coherence reset; false is fatal.
+struct DiskMountSteps {
+    bool (*upload)(void*);
+    void (*refill)(void*);
+    bool (*repair)(void*);
+    bool (*reset)(void*);
+    void* ctx;
+};
+
+/// Phase 2: upload, ring refill, then boundary repair in order; any failure or throw resets
+/// for coherence (reset failure is fatal). upload_why/repair_why are borrowed for the attempt
+/// logs (filled by the seams, as before). Restored carries fail None.
+DiskMountOutcome mount_disk_candidate(const DiskMountSteps& steps, int64_t sk,
+                                      const std::string& upload_why, const std::string& repair_why);
+
 }  // namespace strata::program::restore
