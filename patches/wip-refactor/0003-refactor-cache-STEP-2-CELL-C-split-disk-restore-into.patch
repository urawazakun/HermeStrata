+// context (F1RestoreCtx lifetime) plus non-owning functions, never heap ownership. Reason
+// strings live here exactly as before; the walk owns the attempt flow through typed outcomes.
+struct F1DiskSeams {
+    saved::RootDiskStore* disk = nullptr;
+    const std::vector<int64_t>* ids = nullptr;
+    const std::vector<int32_t>* ids32 = nullptr;
+    const std::vector<saved::ImgKey>* req_simgs = nullptr;
+    bool cvec_cached = true;
+    int64_t n = 0;
+    const strata::core::ModelGeometry* g = nullptr;
+    strata::core::SessionState* ss = nullptr;
+    std::vector<std::unique_ptr<GpuStage>>* stages = nullptr;
+    strata::core::MtpDrafter* mtp = nullptr;
+    const saved::SavedItem* mount_src = nullptr;
+    int64_t sk = 0;
+    size_t hcn = 0;
+    void* main_cs = nullptr;
+    cudaStream_t main_stream = nullptr;
+    std::vector<ConvCheckpoint>* checks = nullptr;
+    int64_t* live_bdry_L = nullptr;
+    std::string upload_why;
+    std::string repair_why;
+};
+
+static bool f1_disk_load_item(const saved::RootDiskStore::Entry& e, saved::SavedItem& out,
+                              std::string& why, void* p) {
+    return static_cast<F1DiskSeams*>(p)->disk->load_item(e, out, why);
+}
+
+static bool f1_disk_validate_item(const saved::SavedItem& item, std::string& why, void* p) {
+    const F1DiskSeams* s = static_cast<const F1DiskSeams*>(p);
+    return saved_validate_for_restore(item, *s->ids32, *s->req_simgs, s->cvec_cached, s->n, *s->g,
+                                      *s->ss, *s->stages, *s->mtp, why);
+}
+
+static void f1_disk_drop_path(const std::string& path, void* p) {
+    static_cast<F1DiskSeams*>(p)->disk->drop_path(path);
+}
+
+static bool f1_disk_upload(void* p) {
+    F1DiskSeams* s = static_cast<F1DiskSeams*>(p);
+    bool ok = cudaDeviceSynchronize() == cudaSuccess;
+    std::string& why2 = s->upload_why;
+    if (!ok) why2 = "device not idle";
+    if (ok && !saved_restore_stage(*s->ss, *s->g, s->mount_src->stages[0], s->mount_src->ids, s->sk,
+                                   s->main_cs, why2))
+        ok = false;
+    for (size_t i = 0; ok && i < s->stages->size(); ++i) {
+        const strata::core::OnDevice on((*s->stages)[i]->dev);
+        if (!saved_restore_stage((*s->stages)[i]->ss, *s->g, s->mount_src->stages[i + 1],
+                                 s->mount_src->ids, s->sk, (void*)(*s->stages)[i]->stream, why2))
+            ok = false;
+    }
+    if (ok && !saved_restore_mtp(*s->mtp, *s->g, s->mount_src->mtp, why2)) ok = false;
+    if (ok) {   // order the streamed-slot resets before any later resolve reads them
+        if (cudaDeviceSynchronize() != cudaSuccess) { why2 = "restore sync failed"; ok = false; }
+        for (size_t i = 0; ok && i < s->stages->size(); ++i) {
+            const strata::core::OnDevice on((*s->stages)[i]->dev);
+            if (cudaDeviceSynchronize() != cudaSuccess) {
+                why2 = "stage sync failed";
+                ok = false;
+            }
+        }
+    }
+    return ok;
+}
+
+static void f1_disk_refill(void* p) {
+    F1DiskSeams* s = static_cast<F1DiskSeams*>(p);
+    s->mtp->kv_restore(s->sk);
+}
+
+static bool f1_disk_repair(void* p) {
+    F1DiskSeams* s = static_cast<F1DiskSeams*>(p);
+    const saved::BoundaryRow& b = s->mount_src->boundary;
+    const int32_t btok = (int32_t)(*s->ids)[(size_t)s->sk];
+    std::string& be = s->repair_why;
+    bool bok = b.row.size() == s->hcn && s->hcn > 0;
+    try {
+        const strata::core::OnDevice on_row(s->mtp->device());
+        std::unique_ptr<float, CudaFreeDel> bdev;
+        float* raw = nullptr;
+        if (bok && cudaMalloc(&raw, s->hcn * sizeof(float)) == cudaSuccess) {
+            bdev.reset(raw);
+            if (cudaMemcpy(bdev.get(), b.row.data(), s->hcn * sizeof(float), cudaMemcpyHostToDevice) ==
+                cudaSuccess)
+                bok = s->mtp->prefill(bdev.get(), &btok, 1, s->sk - 1, be);
+            else
+                bok = false;
+        } else {
+            bok = false;
+        }
+    } catch (const std::exception& ex) {
+        bok = false;
+        be = ex.what();
+    } catch (...) { bok = false; }
+    return bok;
+}
+
+static bool f1_disk_reset(void* p) {
+    F1DiskSeams* s = static_cast<F1DiskSeams*>(p);
+    return f1_cold_reset_all(*s->ss, *s->g, *s->stages, *s->checks, *s->live_bdry_L, s->main_cs,
+                             s->main_stream);
+}
