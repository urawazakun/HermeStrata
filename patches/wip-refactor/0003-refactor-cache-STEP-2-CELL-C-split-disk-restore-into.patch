diff --git a/src/program/restore.cpp b/src/program/restore.cpp
index 3170712..f0e1410 100644
--- a/src/program/restore.cpp
+++ b/src/program/restore.cpp
@@ -188,4 +188,84 @@ RestoreCandidate RestoreWalk::next() const {
     return c;
 }
 
+DiskValidateOutcome validate_disk_candidate(
+    const saved_state::RootDiskStore::Entry& dent, saved_state::SavedItem& mount, std::string& why,
+    int64_t sk, DiskLoadFn load, void* load_ctx, DiskValidateFn validate, void* validate_ctx,
+    DiskDropFn drop, void* drop_ctx) {
+    // Phase 1 (no GPU touched): lazy load + full validation. Load/validation failures drop the
+    // index entry inside this same try: without this a corrupt file pins its key (enqueue
+    // dedups against the index) and a recaptured root could never replace it, while a
+    // throwing drop is a transient keep exactly as before. The file itself stays for trim;
+    // the rewrite replaces it. Dropping is index-only, never file deletion.
+    try {
+        if (!load(dent, mount, why, load_ctx)) {
+            std::fprintf(stderr, "strata serve: root-disk at %lld tokens unreadable "
+                                 "(%s): trying shorter\n",
+                         (long long) sk, why.c_str());
+            drop(dent.path, drop_ctx);
+            return {DiskValidateDisposition::DroppedIndex, RestoreFail::Corruption};
+        }
+        if (!validate(mount, why, validate_ctx)) {
+            std::fprintf(stderr, "strata serve: root-disk at %lld tokens ineligible "
+                                 "(%s): trying shorter\n",
+                         (long long) sk, why.c_str());
+            drop(dent.path, drop_ctx);
+            return {DiskValidateDisposition::DroppedIndex, RestoreFail::Validation};
+        }
+    } catch (const std::exception& ex) {
+        std::fprintf(stderr, "strata serve: root-disk candidate at %lld tokens threw (%s): "
+                             "trying shorter\n",
+                     (long long) sk, ex.what());
+        return {DiskValidateDisposition::KeepIndex, RestoreFail::Transient};
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: root-disk candidate at %lld tokens threw: "
+                             "trying shorter\n",
+                     (long long) sk);
+        return {DiskValidateDisposition::KeepIndex, RestoreFail::Transient};
+    }
+    return {DiskValidateDisposition::Proceed, RestoreFail::None};
+}
+
+DiskMountOutcome mount_disk_candidate(const DiskMountSteps& steps, int64_t sk,
+                                      const std::string& upload_why,
+                                      const std::string& repair_why) {
+    // Phase 2 (may write the GPU): upload + ring refill + boundary repair in order. Any failure
+    // or throw resets for coherence and falls through to shorter candidates; the file stays
+    // indexed throughout (an upload/repair failure is transient, not corruption). A failed
+    // reset is fatal (the caller prints the mount/repair ERR and fails the request).
+    try {
+        if (!steps.upload(steps.ctx)) {
+            std::fprintf(stderr, "strata serve: root-disk restore at %lld tokens failed (%s): "
+                                 "trying shorter\n",
+                         (long long) sk, upload_why.c_str());
+            if (!steps.reset(steps.ctx)) return {DiskMountDisposition::FatalMount, RestoreFail::Mount};
+            return {DiskMountDisposition::Fallthrough, RestoreFail::Mount};
+        }
+        steps.refill(steps.ctx);
+        if (!steps.repair(steps.ctx)) {
+            std::fprintf(stderr, "strata serve: root-disk boundary repair at %lld failed "
+                                 "(%s): trying shorter\n",
+                         (long long) sk, repair_why.empty() ? "staging failed" : repair_why.c_str());
+            if (!steps.reset(steps.ctx))
+                return {DiskMountDisposition::FatalRepair, RestoreFail::MtpBoundary};
+            return {DiskMountDisposition::Fallthrough, RestoreFail::MtpBoundary};
+        }
+    } catch (const std::exception& ex) {
+        // The GPU may be partially written: reset for coherence and try shorter. No result was
+        // recorded yet, so nothing stale remains.
+        std::fprintf(stderr, "strata serve: root-disk candidate at %lld tokens threw (%s): "
+                             "trying shorter\n",
+                     (long long) sk, ex.what());
+        if (!steps.reset(steps.ctx)) return {DiskMountDisposition::FatalMount, RestoreFail::Transient};
+        return {DiskMountDisposition::Fallthrough, RestoreFail::Transient};
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: root-disk candidate at %lld tokens threw: "
+                             "trying shorter\n",
