-std::vector<DiskInventoryEntry> RootDiskStore::disk_inventory() const {
-    std::unique_lock<std::mutex> lk(mu_);
-    std::vector<DiskInventoryEntry> out;
-    if (!started_) return out;
-    out.reserve(index_.size());
-    for (const auto& [key, e] : index_)
-        out.push_back(DiskInventoryEntry{e.meta.ids.size(), e.file_bytes});
-    return out;
-}
