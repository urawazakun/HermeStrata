+std::string RootDiskCodec::file_key(const RootDiskHeader& hdr, const SavedItem& item) const {
+    // Length-prefix every variable field: two different (field, value) splits must never hash equal.
+    uint64_t h = 1469598103934665603ull;
+    auto mix_str = [&](const std::string& s) {
+        const uint64_t L = (uint64_t)s.size();
+        h = root_fnv1a(&L, 8, h);
+        h = root_fnv1a(s.data(), s.size(), h);
+    };
+    auto mix_i64 = [&](int64_t v) {
+        const uint64_t u = (uint64_t)v;
+        h = root_fnv1a(&u, 8, h);
+    };
+    mix_str(hdr.engine_version);
+    mix_str(hdr.pack_path);
+    mix_str(hdr.kv_type);
+    mix_str(hdr.mtp_dir);
+    mix_str(hdr.model_fingerprint);
+    mix_str(hdr.numeric_flags);
+    const uint64_t nl = (uint64_t)item.ids.size();
+    h = root_fnv1a(&nl, 8, h);
+    h = root_fnv1a(item.ids.data(), item.ids.size() * 4, h);
+    const uint64_t ni = (uint64_t)item.imgs.size();
+    h = root_fnv1a(&ni, 8, h);
+    for (const ImgKey& k : item.imgs) {
+        mix_i64(k.start);
+        h = root_fnv1a(&k.hash, 8, h);
+    }
+    const uint8_t c = item.cvec ? 1 : 0;
+    h = root_fnv1a(&c, 1, h);
+    mix_i64(item.geom.n_qsa_layers);
+    mix_i64(item.geom.n_head_kv);
+    mix_i64(item.geom.head_dim);
+    mix_i64(item.geom.idx_dim);
+    mix_i64(item.geom.idx_block);
+    mix_i64(item.geom.page_size);
+    mix_i64(item.n_stages);
+    return root_hex16(h);
+}
+
+namespace {
+bool is_hex16(const char* s) {
+    for (int i = 0; i < 16; ++i) {
+        const char c = s[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+    }
+    return true;
+}
+}  // namespace
+
+bool root_file_name_ok(const std::string& name) {
+    // exactly "root-" (5) + 16 lowercase hex + ".hstr" (5) = 26 chars: ASCII only, no directories.
+    if (name.size() != 26) return false;
+    if (name.compare(0, 5, "root-") != 0) return false;
+    if (name.compare(21, 5, ".hstr") != 0) return false;
+    return is_hex16(name.data() + 5);
+}
+
+bool root_temp_name_ok(const std::string& name) {
+    // exactly the writer's "root-" + 16 hex + ".tmp." + nonempty suffix.
+    if (name.size() <= 26) return false;
+    if (name.compare(0, 5, "root-") != 0) return false;
+    if (!is_hex16(name.data() + 5)) return false;
+    if (name.compare(21, 5, ".tmp.") != 0) return false;
+    for (size_t i = 26; i < name.size(); ++i) {
+        const char c = name[i];
+        if (c == '/' || c == '\\') return false;
+    }
+    return true;
+}
