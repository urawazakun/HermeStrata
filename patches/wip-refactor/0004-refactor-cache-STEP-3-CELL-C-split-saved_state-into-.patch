+// src/program/root_disk_codec.cpp - RootDiskCodec: the on-disk root format (CPU-only, no CUDA).
+//
+// Split out of saved_state.cpp (readability refactor, behaviour-preserving): the FNV-1a identity,
+// the little-endian writer/bounded reader, the KV shape helpers, the filename gates, the exact
+// byte layout codec (encode/decode/scan) and bulk stripping. No logic changes.
+#include "strata/program/root_disk_codec.hpp"
+#include "strata/program/saved_state.hpp"
