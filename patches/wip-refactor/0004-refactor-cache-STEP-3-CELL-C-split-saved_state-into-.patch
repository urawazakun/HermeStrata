-        for (KvLayerPayload& k : s.kv) {
-            k.k.clear();
-            k.k.shrink_to_fit();
-            k.v.clear();
-            k.v.shrink_to_fit();
-            k.ks.clear();
-            k.ks.shrink_to_fit();
