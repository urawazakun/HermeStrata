+// src/program/root_disk_codec_test.cpp - RootDiskCodec format/rejection contract (CPU-only).
+//
+// Focused test for the extracted codec API (strata/program/root_disk_codec.hpp, implemented in
+// src/program/root_disk_codec.cpp): exact byte roundtrip, meta-only decode, corruption /
+// truncation / trailing / bounds rejection, header identity comparison, filename gates, file-key
+// stability and bulk stripping. Fixture sizes are hand-derived literals (same gA layout contract
+// as the other CPU suites), never the implementation's own size helpers. Including the codec
+// header directly proves it stands alone (saved_state.hpp re-includes it for compatibility).
+#include "strata/program/root_disk_codec.hpp"
+#include "strata/program/saved_state.hpp"   // payload definitions for the fixtures below
+
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace saved = strata::program::saved_state;
+namespace fs = std::filesystem;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const char* what) {
+    std::printf("  %-66s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+// Complete fp16 gA item (1 layer, 1 KV head, head_dim 8, page 4 -> ceil(C/4)*64 B per k/v;
+// indexer block 4, idx_dim 4 -> L/4+1 pooled rows of 16 B, dead_key 16 B; boundary 8 floats).
+saved::SavedItem make_item(int L, int base) {
+    saved::SavedItem it;
+    it.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) it.ids[(size_t) i] = (int32_t) (base + i);
+    it.cvec = true;
+    it.n_stages = 1;
+    it.geom.n_qsa_layers = 1;
+    it.geom.n_head_kv = 1;
+    it.geom.head_dim = 8;
+    it.geom.idx_dim = 4;
+    it.geom.idx_block = 4;
+    it.geom.page_size = 4;
+    saved::StagePayload sp;
+    sp.rec.gdn = {7, 9};
+    sp.rec.tails = {8};
+    sp.rec.ple_prev[0] = L >= 2 ? base + L - 2 : -1;
+    sp.rec.ple_prev[1] = base + L - 1;
+    saved::KvLayerPayload kv;
+    kv.fmt = saved::kKvF16;
+    kv.cells = L;
+    kv.k.assign((size_t) ((L + 3) / 4) * 64, 0x31);
+    kv.v.assign((size_t) ((L + 3) / 4) * 64, 0x32);
+    sp.kv.push_back(std::move(kv));
+    saved::IndexerPayload ix;
+    ix.pooled_rows = L / 4 + 1;
+    ix.pooled.assign((size_t) (ix.pooled_rows * 16), 0x11);
+    ix.block_pos = {3};
+    ix.dead_key.assign(16, 0x22);
+    sp.idx.push_back(std::move(ix));
+    it.stages.push_back(std::move(sp));
+    it.boundary.hc = 2;
+    it.boundary.n_embd = 4;
+    it.boundary.row.assign(8, 0.5f);
+    if (L > 1) {
+        saved::KvLayerPayload m;
+        m.fmt = saved::kKvF16;
+        m.cells = L - 1;
+        m.k.assign((size_t) ((L - 1 + 3) / 4) * 64, 0x41);
+        m.v.assign((size_t) ((L - 1 + 3) / 4) * 64, 0x42);
+        it.mtp.kv.push_back(std::move(m));
+        it.mtp.cells = L - 1;
+        it.mtp.valid_from = 0;
+    }
+    return it;
+}
+
+saved::RootDiskHeader make_header() {
+    saved::RootDiskHeader h;
+    h.engine_version = "0.1.21";
+    h.pack_path = "pack/full";
+    h.kv_type = "fp16";
+    h.mtp_dir = "";
+    h.model_fingerprint = "sizes+mtimes";
+    h.numeric_flags = "native+resident";
+    return h;
+}
+
+void write_file(const std::string& path, const std::vector<uint8_t>& buf) {
+    std::ofstream o(path, std::ios::binary | std::ios::trunc);
+    o.write((const char*) buf.data(), (std::streamsize) buf.size());
+    o.close();
+}
+}  // namespace
+
+int main() {
+    std::printf("root_disk_codec_test\n");
+    check(saved::RootDiskHeader::kVersion == 3, "schema v3");
+    const saved::RootDiskHeader h = make_header();
+    const saved::SavedItem it = make_item(40, 0);
+    check(it.complete(), "fixture itself is complete");
+    std::vector<uint8_t> buf;
+    std::string why;
+    {   // Exact byte roundtrip: every payload byte survives (canaries differ per blob).
+        check(saved::root_encode(h, it, buf, why), "roundtrip encodes");
+        check(!buf.empty(), "encoding is nonempty");
+        saved::RootDiskHeader dh;
+        saved::SavedItem got;
+        check(saved::root_decode(buf.data(), buf.size(), dh, got, false, why), "roundtrip decodes");
+        check(dh.compatible_with(h) && got.complete(), "decoded header compat + payload complete");
+        check(got.ids == it.ids && got.imgs == it.imgs && got.cvec == it.cvec &&
+                  got.geom == it.geom && got.n_stages == 1,
+              "decoded identity (ids/images/cvec/geometry) matches");
+        check(got.stages[0].rec.gdn == it.stages[0].rec.gdn &&
+                  got.stages[0].rec.tails == it.stages[0].rec.tails &&
+                  got.stages[0].idx[0].pooled == it.stages[0].idx[0].pooled &&
+                  got.stages[0].kv[0].k == it.stages[0].kv[0].k &&
+                  got.stages[0].kv[0].v == it.stages[0].kv[0].v && got.mtp.cells == it.mtp.cells &&
+                  got.mtp.kv[0].k == it.mtp.kv[0].k && got.boundary.row == it.boundary.row,
+              "decoded bulk bytes match (no silent rewrite)");
+    }
+    {   // Meta-only decode: scalars without bulk allocation.
+        saved::RootDiskHeader dh;
+        saved::SavedItem meta;
+        check(saved::root_decode(buf.data(), buf.size(), dh, meta, true, why), "meta decodes");
+        check(meta.ids == it.ids && meta.geom == it.geom && meta.mtp.cells == 39 &&
+                  meta.mtp.valid_from == 0 && meta.boundary.hc == 2 && meta.boundary.n_embd == 4,
+              "meta carries ids/geometry/MTP/boundary scalars");
+        check(meta.stages.empty() && meta.mtp.kv.empty() && meta.boundary.row.empty(),
+              "meta allocates no bulk");
+    }
+    {   // Rejection contract: bad magic/version, truncation, trailing bytes, bulk corruption.
+        saved::RootDiskHeader dh;
+        saved::SavedItem got;
+        std::vector<uint8_t> bad = buf;
+        bad[0] ^= 0xFF;
+        check(!saved::root_decode(bad.data(), bad.size(), dh, got, false, why),
+              "bad magic rejected");
+        bad = buf;
+        bad[4] ^= 0xFF;
+        check(!saved::root_decode(bad.data(), bad.size(), dh, got, false, why),
+              "bad version rejected");
+        std::vector<uint8_t> half(buf.begin(), buf.begin() + buf.size() / 2);
+        check(!saved::root_decode(half.data(), half.size(), dh, got, false, why),
+              "truncation rejected");
+        check(!saved::root_decode(buf.data(), 0, dh, got, false, why), "empty rejected");
+        std::vector<uint8_t> trail = buf;
+        trail.push_back(0x00);
+        check(!saved::root_decode(trail.data(), trail.size(), dh, got, false, why),
+              "trailing bytes rejected");
+        std::vector<uint8_t> corrupt = buf;
+        corrupt[corrupt.size() / 2] ^= 0xFF;   // same-length bulk corruption: checksum sees it
+        check(!saved::root_decode(corrupt.data(), corrupt.size(), dh, got, false, why),
+              "same-length bulk corruption rejected");
+        check(!saved::root_decode(corrupt.data(), corrupt.size(), dh, got, true, why),
+              "bulk corruption rejected even in meta mode");
+    }
+    {   // Encode refuses incomplete payloads and oversize header strings (no unbounded write).
+        saved::SavedItem bad = it;
+        bad.stages[0].kv[0].k.pop_back();
+        check(!bad.complete(), "truncated fixture is incomplete");
+        check(!saved::root_encode(h, bad, buf, why), "encode refuses incomplete payload");
+        saved::RootDiskHeader hb = h;
+        hb.pack_path.assign((size_t) saved::kMaxRootString + 1, 'x');
+        check(!saved::root_encode(hb, it, buf, why), "encode refuses oversize header string");
+        check(saved::root_encode(h, it, buf, why), "encoder still accepts the good fixture");
+    }
+    {   // Header identity: every numerics field gates; ids length/hash never do.
+        check(h.compatible_with(h), "identical headers compatible");
+        saved::RootDiskHeader f = h;
+        f.engine_version += "_other";
+        check(!f.compatible_with(h), "engine version gates");
+        f = h;
+        f.pack_path += "_other";
+        check(!f.compatible_with(h), "pack path gates");
+        f = h;
+        f.kv_type = "int8";
+        check(!f.compatible_with(h), "kv type gates");
+        f = h;
+        f.mtp_dir = "other";
+        check(!f.compatible_with(h), "mtp dir gates");
+        f = h;
+        f.model_fingerprint += "_other";
+        check(!f.compatible_with(h), "model fingerprint gates");
+        f = h;
+        f.numeric_flags += "_other";
+        check(!f.compatible_with(h), "numeric flags gate");
+        saved::RootDiskHeader loose = h;
+        loose.ids_len = 999;
+        loose.ids_hash = 12345;
+        check(loose.compatible_with(h), "ids length/hash do not gate compatibility");
+        saved::RootDiskHeader v2 = h;
+        v2.version = 2;
+        check(!v2.compatible_with(h), "older schema version rejected");
+    }
+    {   // File keys: stable for equal bytes, sensitive to every bound field.
+        const std::string k0 = saved::root_file_key(h, it);
+        check(k0.size() == 16 && saved::root_file_key(h, it) == k0, "key stable (16 hex)");
+        check(saved::root_file_key(h, make_item(40, 0)) == k0, "equal bytes share the key");
+        check(saved::root_file_key(h, make_item(41, 0)) != k0, "ids length changes the key");
+        check(saved::root_file_key(h, make_item(40, 4)) != k0, "ids content changes the key");
+        saved::RootDiskHeader other = h;
+        other.kv_type = "int8";
+        check(saved::root_file_key(other, it) != k0, "header identity changes the key");
+        check(saved::root_file_name_ok("root-" + k0 + ".hstr"), "cache filename accepted");
+        check(!saved::root_file_name_ok("root-" + k0 + ".tmp.1"), "temp is not a cache name");
+        check(!saved::root_file_name_ok("root-xyz.hstr"), "non-hex rejected");
+        check(!saved::root_file_name_ok("sub/root-" + k0 + ".hstr"), "directories rejected");
+        check(saved::root_temp_name_ok("root-" + k0 + ".tmp.3"), "writer temp accepted");
+        check(!saved::root_temp_name_ok("root-" + k0 + ".hstr"), "cache file is not a temp");
+    }
+    {   // The class holds the real implementation: direct calls agree with the wrappers.
+        saved::RootDiskCodec codec;
+        std::vector<uint8_t> out2;
+        check(codec.encode(h, it, out2, why) && out2 == buf, "class encode matches wrapper bytes");
+        saved::RootDiskHeader dh;
+        saved::SavedItem got;
+        check(codec.decode(out2.data(), out2.size(), dh, got, false, why) && got.complete() &&
+                  got.ids == it.ids && got.stages[0].kv[0].k == it.stages[0].kv[0].k,
+              "class decode roundtrips the payload");
+        check(codec.file_key(h, it) == saved::root_file_key(h, it), "class file_key matches wrapper");
+    }
+    {   // Streaming scan: header + ids metadata with bulk seek-skipped, never read.
+        const std::string sub = "rootdisk-codec-tmp/scan";
+        std::error_code ec;
+        fs::remove_all("rootdisk-codec-tmp", ec);
+        fs::create_directories(sub, ec);
+        check(!ec, "scan tmpdir created");
+        const std::string path = sub + "/root-" + saved::root_file_key(h, it) + ".hstr";
+        write_file(path, buf);
+        saved::RootDiskHeader sh;
+        saved::SavedItem sm;
+        check(saved::root_scan_meta(path, buf.size(), sh, sm, why), "scan succeeds");
+        check(sh.compatible_with(h) && sm.ids == it.ids && sm.geom == it.geom && sm.n_stages == 1,
+              "scan meta carries header+ids+geometry");
+        check(sm.stages.empty() && sm.mtp.kv.empty() && sm.boundary.row.empty(),
+              "scan reads no bulk");
+        check(sm.mtp.cells == 39 && sm.boundary.hc == 2, "scan carries MTP/boundary scalars");
+        saved::RootDiskCodec codec;
+        saved::RootDiskHeader sh2;
+        saved::SavedItem sm2;
+        check(codec.scan_meta(path, buf.size(), sh2, sm2, why) && sm2.ids == it.ids,
+              "class scan_meta matches wrapper");
+        std::vector<uint8_t> half(buf.begin(), buf.begin() + buf.size() / 2);
+        const std::string hpath = sub + "/root-aaaaaaaaaaaaaaaa.hstr";
+        write_file(hpath, half);
+        check(!saved::root_scan_meta(hpath, half.size(), sh, sm, why), "scan rejects truncation");
+        fs::remove_all("rootdisk-codec-tmp", ec);
+    }
+    {   // Bulk stripping: every bulk byte cleared, every scalar kept. MTP entries are
+        // retained as records (cells/format metadata) with their k/v/ks/vs bytes emptied.
+        saved::SavedItem stripped = it;
+        saved::root_strip_bulk(stripped);
+        check(stripped.stages[0].rec.gdn.empty() && stripped.stages[0].idx[0].pooled.empty() &&
+                  stripped.stages[0].kv[0].k.empty() && stripped.boundary.row.empty() &&
+                  stripped.mtp.kv.size() == 1 && stripped.mtp.kv[0].cells == 39 &&
+                  stripped.mtp.kv[0].fmt == saved::kKvF16 && stripped.mtp.kv[0].k.empty() &&
+                  stripped.mtp.kv[0].v.empty() && stripped.mtp.kv[0].ks.empty() &&
+                  stripped.mtp.kv[0].vs.empty(),
+              "strip clears bulk bytes, retains MTP record metadata");
+        check(stripped.ids == it.ids && stripped.geom == it.geom && stripped.mtp.cells == 39 &&
+                  stripped.boundary.hc == 2 && stripped.bytes == 0,
+              "strip keeps ids/geometry/scalars, zeroes accounting");
+    }
+    if (g_fail == 0)
+        std::printf("root_disk_codec_test: all ok\n");
+    else
+        std::printf("root_disk_codec_test: %d FAILURES\n", g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
