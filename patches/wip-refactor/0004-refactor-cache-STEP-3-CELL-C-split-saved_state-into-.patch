+uint64_t root_fnv1a(const void* data, size_t n, uint64_t h) {
+    const uint8_t* p = (const uint8_t*)data;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= p[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+std::string root_hex16(uint64_t h) {
+    char b[17];
+    std::snprintf(b, sizeof b, "%016llx", (unsigned long long)h);
+    return std::string(b);
+}
+
+namespace {
+// Little-endian append-only writer (encode side: sizes already validated by the caller).
+struct RootWriter {
+    std::vector<uint8_t> b;
+    void u8(uint8_t v) { b.push_back(v); }
+    void u32(uint32_t v) {
+        for (int i = 0; i < 4; ++i) b.push_back((uint8_t)(v >> (i * 8)));
+    }
+    void i32(int32_t v) { u32((uint32_t)v); }
+    void u64(uint64_t v) {
+        for (int i = 0; i < 8; ++i) b.push_back((uint8_t)(v >> (i * 8)));
+    }
+    void i64(int64_t v) { u64((uint64_t)v); }
+    void str(const std::string& s) {
+        u32((uint32_t)s.size());
+        b.insert(b.end(), s.begin(), s.end());
+    }
+    void blob(const std::vector<uint8_t>& v) {
+        u64((uint64_t)v.size());
+        b.insert(b.end(), v.begin(), v.end());
+    }
+    void floats(const std::vector<float>& v) {
+        u64((uint64_t)v.size());
+        const uint8_t* p = (const uint8_t*)v.data();
+        b.insert(b.end(), p, p + v.size() * 4);
+    }
+    void i32vec(const std::vector<int32_t>& v) {
+        u64((uint64_t)v.size());
+        const uint8_t* p = (const uint8_t*)v.data();
+        b.insert(b.end(), p, p + v.size() * 4);
+    }
+};
+
+// Bounded reader: every length is checked against the remaining bytes (and the kMaxRoot* caps)
+// BEFORE any allocation or advance, so corrupt/truncated/oversize input fails without growing.
+struct RootReader {
+    const uint8_t* p = nullptr;
+    size_t n = 0;
+    size_t pos = 0;
+    bool ok = true;
+    bool avail(uint64_t len) const { return len <= n && pos <= n - (size_t)len; }
+    uint8_t u8() {
+        if (!avail(1)) {
+            ok = false;
+            return 0;
+        }
+        return p[pos++];
+    }
+    uint32_t u32() {
+        if (!avail(4)) {
+            ok = false;
+            return 0;
+        }
+        uint32_t v = 0;
+        std::memcpy(&v, p + pos, 4);
+        pos += 4;
+        return v;
+    }
+    uint64_t u64() {
+        if (!avail(8)) {
+            ok = false;
+            return 0;
+        }
+        uint64_t v = 0;
+        std::memcpy(&v, p + pos, 8);
+        pos += 8;
+        return v;
+    }
+    int32_t i32() { return (int32_t)u32(); }
+    int64_t i64() { return (int64_t)u64(); }
+    bool str(std::string& s, std::string& why) {
+        const uint32_t L = u32();
+        if (!ok) {
+            why = "truncated string";
+            return false;
+        }
+        if (L > kMaxRootString || !avail(L)) {
+            ok = false;
+            why = "oversize string";
+            return false;
+        }
+        s.assign((const char*)p + pos, L);
+        pos += L;
+        return true;
+    }
+    bool blob(std::vector<uint8_t>& v, bool want, std::string& why,
+              uint64_t cap = kMaxRootFileBytes) {
+        const uint64_t L = u64();
+        if (!ok) {
+            why = "truncated blob length";
+            return false;
+        }
+        // The cap binds the allocation BEFORE it happens (callers pass kMaxRootRecBytes for the
+        // recurrent blobs, whose exact size is not geometry-derived).
+        if (L > cap || !avail(L)) {
+            ok = false;
+            why = "oversize blob";
+            return false;
+        }
+        if (want) v.assign(p + pos, p + pos + (size_t)L);
+        pos += (size_t)L;
+        return true;
+    }
+    // Geometry-derived exact blob: the length must equal the size the (already validated) geometry
+    // dictates, so the allocation below is exact and bounded before it happens. Used for every blob
+    // whose size SnapshotGeom determines (KV codes/scales, indexer pools/keys); the recurrent state
+    // keeps the absolute kMaxRootRecBytes cap (its exact size needs the full model geometry, which
+    // E2's saved_validate_for_restore checks against the live session instead).
+    bool blob_exact(std::vector<uint8_t>& v, bool want, uint64_t expected, std::string& why) {
+        const uint64_t L = u64();
+        if (!ok) {
+            why = "truncated blob length";
+            return false;
+        }
+        if (L != expected || !avail(L)) {
+            ok = false;
+            why = "blob size mismatch";
+            return false;
+        }
+        if (want) v.assign(p + pos, p + pos + (size_t)L);
+        pos += (size_t)L;
+        return true;
+    }
+    bool floats(std::vector<float>& v, bool want, std::string& why) {
+        const uint64_t L = u64();
+        if (!ok) {
+            why = "truncated float length";
+            return false;
+        }
+        if (L > (kMaxRootFileBytes / 4) || !avail(L * 4)) {
+            ok = false;
+            why = "oversize float array";
+            return false;
+        }
+        if (want) {
+            v.resize((size_t)L);
+            std::memcpy(v.data(), p + pos, (size_t)L * 4);
+        }
+        pos += (size_t)L * 4;
+        return true;
+    }
+    bool i32vec(std::vector<int32_t>& v, bool want, uint64_t cap, std::string& why) {
+        const uint64_t L = u64();
+        if (!ok) {
+            why = "truncated int length";
+            return false;
+        }
+        if (L > cap || !avail(L * 4)) {
+            ok = false;
+            why = "oversize int array";
+            return false;
+        }
+        if (want) {
+            v.resize((size_t)L);
+            std::memcpy(v.data(), p + pos, (size_t)L * 4);
+        }
+        pos += (size_t)L * 4;
+        return true;
+    }
+};
+
+bool root_write_kv(RootWriter& w, const KvLayerPayload& k) {
+    w.i32(k.fmt);
+    w.i64(k.cells);
+    w.blob(k.k);
+    w.blob(k.v);
+    w.blob(k.ks);
+    w.blob(k.vs);
+    return true;
+}
+
+bool root_read_kv(RootReader& r, KvLayerPayload& k, bool want, int64_t L, const SnapshotGeom& gm,
+                 bool is_mtp, std::string& why) {
+    k.fmt = r.i32();
+    k.cells = r.i64();
+    if (!r.ok) {
+        why = "truncated KV header";
+        return false;
+    }
+    if (k.fmt != kKvF16 && k.fmt != kKvInt8 && k.fmt != kKvQ4) {
+        why = "unknown KV format";
+        return false;
+    }
+    // Exact cell counts (the encoder only writes these): main layers hold [0, L), the single MTP layer
+    // holds the L-1 real pairs (L == 1 carries no MTP layer at all, enforced at the count below).
+    const int64_t want_cells = is_mtp ? L - 1 : L;
+    if (k.cells != want_cells) {
+        why = "KV cell count mismatch";
+        return false;
+    }
+    // Exact byte sizes from the already-validated geometry (gm caps keep this arithmetic in u64 range):
+    // a corrupt length fails here, before any allocation, and the allocation below is then exact.
+    const uint64_t code = kv_pool_bytes(k.fmt, k.cells, gm.n_head_kv, gm.head_dim, gm.page_size, false);
+    const uint64_t sc =
+        k.fmt == kKvInt8 ? kv_pool_bytes(k.fmt, k.cells, gm.n_head_kv, gm.head_dim, gm.page_size, true) : 0;
+    return r.blob_exact(k.k, want, code, why) && r.blob_exact(k.v, want, code, why) &&
+           r.blob_exact(k.ks, want, sc, why) && r.blob_exact(k.vs, want, sc, why);
+}
+}  // namespace
