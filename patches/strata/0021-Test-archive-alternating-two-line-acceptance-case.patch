++    faithful = tail_load_faithful()
++    if not faithful.get("ok"):
++        return {"ok": False, "reason": faithful.get("reason", "faithful unavailable")}
++    tok, template, turn_id = faithful["tok"], faithful["template"], faithful["turn_id"]
++
++    def render(body):
