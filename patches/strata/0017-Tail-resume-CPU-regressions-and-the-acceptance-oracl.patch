+        p4 = [1, 2, 3, 9, 4, 5, 9, 77, 9, 60, 62, 9, 61]
+        self.assertEqual(A.tail_lcp(p1, p4), len(p1) - 1)
+        pr = A.tail_mutated_proof(p1, p2, p3, p4, T, 3, 0, 6, 9,
+                                  every=8, chunk=4, short=64)
+        self.assertTrue(pr["ok"], pr)
