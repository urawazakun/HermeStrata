+        self.assertTrue(pr["ok"], pr)
+        self.assertEqual(pr["K_exp"], 6)
+
+    def test_lcp_eq_n1_minus_1_accepted_when_uncaptured(self):
+        # The pack may retokenize a final newline so lcp reaches n1-1; valid because the
+        # simulated schedule (short segments) captured no checkpoint at n-1.
+        T = self.T
