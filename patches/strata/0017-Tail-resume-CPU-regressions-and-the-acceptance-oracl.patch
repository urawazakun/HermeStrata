+    def test_proof_ok_cold(self):
+        p1, p2, p3, p4 = self.prompts()
+        pr = A.tail_mutated_proof(p1, p2, p3, p4, self.T, 3, 0, 6, 10,
+                                  every=8, chunk=4, short=64)
+        self.assertTrue(pr["ok"], pr)
+        self.assertEqual((pr["K_exp"], pr["L1"], pr["K2"], pr["K3"]), (6, 6, 6, 10))
+        self.assertLess(pr["L1"], pr["change"])
