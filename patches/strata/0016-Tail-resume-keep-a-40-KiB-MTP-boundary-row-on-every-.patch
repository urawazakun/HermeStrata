 include/strata/program/restore.hpp         |  48 ++-
 src/core/conversation_state.cpp            |   9 +-
 src/program/generate.cpp                   | 222 +++++++++++++-
 src/program/restore.cpp                    | 172 ++++++++++-
 src/program/restore_test.cpp               | 330 +++++++++++++++++++++
 src/program/saved_state_layout_test.cpp    |  45 +++
 7 files changed, 861 insertions(+), 22 deletions(-)

diff --git a/include/strata/core/conversation_cache.hpp b/include/strata/core/conversation_cache.hpp
index 40490a5..fe7ff83 100644
--- a/include/strata/core/conversation_cache.hpp
+++ b/include/strata/core/conversation_cache.hpp
@@ -20,6 +20,59 @@ struct ConversationImageKey {
     bool operator==(const ConversationImageKey&) const = default;
 };
 
+// Per-row byte cap for the attached MTP boundary row (TAIL-RESUME). It bounds the TOTAL
+// extra row-vector allocation: 4*hc*n_embd payload bytes plus the copied image-key bytes.
+// The real model row is far smaller (tens of KB). The cap gates the transient stash and
+// every attached row (the retained live row keeps its existing checks); the division-first
+// check runs before any product or allocation, so no wrap-to-small shape can pass.
+// No duplicate recurrent state.
+// Per-row dynamic cost: 4*hc*n_embd + imgs.size()*sizeof(ConversationImageKey); the fixed
+// struct overhead is sizeof(ConversationCheckpointRow) (counted once per checkpoint by
+// the enclosing vectors, not in bytes() below).
+inline constexpr size_t kCheckpointRowCapBytes = 1u << 20;
+// Maximum row cells (floats) under the cap: the division-first bound behind every check.
+inline constexpr uint64_t kCheckpointRowCapCells = (uint64_t)(1u << 20) / sizeof(float);
+
+/// CPU-only MTP boundary row attached to a ConversationCheckpoint (TAIL-RESUME).
+///
+/// A checkpoint carries recurrent state only; the top-level checkpoint additionally holds
+/// the final-stage residual row R_(L-1) that pairs MTP cell L-1 on resume. The row is
+/// borrowed scratch at capture (device residual rows) copied once to this host vector;
+/// stage_parts hold recurrent state only, never a second row copy. Validity is decided
+/// by restore::checkpoint_row_valid_for, never by mere existence: L must equal the
+/// checkpoint length, the ids hash/image identity/cvec/shape must match the request,
+/// and the saved valid_from must be reachable from the new request's window.
+/// No disk schema change: this row is RAM-only (root v3 unchanged); parked accounting
+/// covers it via bytes() below (capacity, so eviction/pruning stays truthful).
+struct ConversationCheckpointRow {
+    int64_t L = -1;                             ///< checkpoint length this row was captured for
+    uint64_t ids_hash = 0;                      ///< FNV-1a of the checkpoint ids at capture
+    std::vector<ConversationImageKey> imgs;     ///< image identity at capture (copy of checkpoint imgs)
+    bool cvec = true;                           ///< control-vector enablement at capture
+    int64_t hc = 0;                             ///< model hc at capture (row shape)
+    int64_t n_embd = 0;                         ///< model n_embd at capture (row shape)
+    int64_t valid_from = 0;                     ///< drafter valid_from at capture (reachability floor)
+    std::vector<float> row;                     ///< R_(L-1): hc*n_embd host floats
+
+    bool has() const { return L >= 0 && !row.empty(); }
+    void clear() {
+        L = -1;
+        ids_hash = 0;
+        imgs.clear();
+        cvec = true;
+        hc = 0;
+        n_embd = 0;
+        valid_from = 0;
+        row.clear();
+    }
+    // Dynamic allocation only (capacities, independent of validity): clear() keeps capacity,
+    // so a cleared-but-retained row still counts. Fixed struct overhead rides with the
+    // enclosing vectors' sizeof(ConversationCheckpoint) and is not counted here.
+    size_t bytes() const {
+        return row.capacity() * sizeof(float) + imgs.capacity() * sizeof(ConversationImageKey);
+    }
+};
+
 struct ConversationCheckpoint {
     std::vector<int32_t> ids;
     std::vector<ConversationImageKey> imgs;
@@ -28,11 +81,13 @@ struct ConversationCheckpoint {
     // Ordinary layer-split checkpoints retain each device's running state.
     // Whole-session parking is currently single-GPU and rejects these parts.
     std::vector<ConversationCheckpoint> stage_parts;
+    // TAIL-RESUME: the final-stage residual row R_(L-1) for MTP repair (RAM-only).
+    ConversationCheckpointRow boundary_row;
 
     size_t bytes() const {
         size_t n = ids.capacity() * sizeof(int32_t) + imgs.capacity() * sizeof(ConversationImageKey) +
                gdn.capacity() + ple.capacity() + tails.capacity() + dead.capacity() + block_pos.capacity() +
-               stage_parts.capacity() * sizeof(ConversationCheckpoint);
+               stage_parts.capacity() * sizeof(ConversationCheckpoint) + boundary_row.bytes();
         for (const auto& part : stage_parts) n += part.bytes();
         return n;
     }
diff --git a/include/strata/program/restore.hpp b/include/strata/program/restore.hpp
index 225137c..02e8ecf 100644
--- a/include/strata/program/restore.hpp
+++ b/include/strata/program/restore.hpp
@@ -134,11 +134,55 @@ struct RepairCtx {
     bool cvec = true;
     int64_t boundary_hc = 0;                                 ///< live g.hc (boundary shape check)
     int64_t boundary_n_embd = 0;                             ///< live g.n_embd
+    // TAIL-RESUME: the actual chain checkpoint under test (non-live candidates only) plus the
+    // request-side key for its attached-row validator. Null = pre-tail behaviour (SavedState
+    // fallback only). Borrowed for the call only, same lifetime as the other references.
+    const strata::core::ConversationCheckpoint* ckpt = nullptr;
+    const std::vector<int64_t>* req_ids = nullptr;           ///< request ids (attached-row prefix key)
+    const std::vector<strata::core::ConversationImageKey>* req_imgs = nullptr;
 };
 
+/// TAIL-RESUME: overflow-safe boundary-row shape gate. True iff hc/n_embd are positive,
+/// their product is exactly row_cells, and the payload fits the per-row byte cap.
+/// Division FIRST (bounding before multiplying) closes the wrap-to-small hole: a product
+/// computed first could wrap to a small value and pass. No allocation, never throws.
+inline bool checkpoint_row_shape_ok(int64_t hc, int64_t n_embd, size_t row_cells) {
+    if (hc <= 0 || n_embd <= 0 || row_cells == 0) return false;
+    if ((uint64_t) hc > strata::core::kCheckpointRowCapCells / (uint64_t) n_embd) return false;
+    return (uint64_t) hc * (uint64_t) n_embd == (uint64_t) row_cells;
+}
+
+/// TAIL-RESUME: attach a captured host boundary row to a checkpoint (CPU-only, no device copy).
+/// The device copy (D2H) is the caller's: `row` must already hold exactly the scratch row for
+/// `stash_L` (R_(stash_L-1)). Requires stash_L == checkpoint length, positive model shape,
+/// the division-first cap bound, exact vector length, 0<=valid_from<=L-1, and the total extra
+/// allocation (payload + copied image keys) under the cap. The ids hash and image identity are
+/// derived from the checkpoint itself (never caller-supplied), so a stale row cannot be
+/// legitimized with fresh metadata. Attach builds a fresh row and moves it in, so no prior
+/// oversized capacity survives success; on any failure the checkpoint is left with NO usable
+/// attached row (fail closed). `why` names the reason. Never throws.
+bool attach_checkpoint_row(strata::core::ConversationCheckpoint& cc, const std::vector<float>& row,
+                           int64_t stash_L, bool cvec, int64_t hc, int64_t n_embd,
+                           int64_t valid_from, std::string* why = nullptr);
+
+/// TAIL-RESUME: validate a checkpoint's attached boundary row for a request (CPU-only).
+/// Every reject is independent: req_ids.size()==n, 1<=k<n with request[k] present for the
+/// pairing, nonzero shape, recorded L == checkpoint length == k, exact shape AND vector
+/// length, ids hash, full checkpoint-ids equality to the request prefix with direct int64
+/// comparison (no out-of-int32 truncation forge), below-L image identity to the request AND
+/// to the retained row, exact cvec equality, 0<=saved valid_from<=k-1 and
+/// new_valid_from>=saved valid_from. A missing row is a plain reject (false). Never throws.
+bool checkpoint_row_valid_for(const strata::core::ConversationCheckpoint& cc, int64_t n, size_t hcn,
+                              int64_t boundary_hc, int64_t boundary_n_embd, int64_t new_valid_from,
+                              bool cvec, const std::vector<int64_t>& req_ids,
+                              const std::vector<strata::core::ConversationImageKey>& req_imgs,
+                              std::string* why = nullptr);
+
 /// The MTP boundary repairability gate for one chain/live candidate at k (moved verbatim
-/// semantics from generate.cpp): K8V4 needs no repair source; live needs the retained row
-/// (length/hash/window); chain needs a same-length saved boundary with a reachable window.
+/// semantics from generate.cpp, plus the TAIL-RESUME attached-row preference): K8V4 needs no
+/// repair source; live needs the retained row (length/hash/window); chain prefers the
+/// checkpoint-attached row (same identity checks) with the same-length saved boundary as
+/// fallback, both gated on a reachable window.
 /// Never throws: a throwing lookup reports false (caller logs "trying shorter").
 bool chain_repairable(int64_t k, bool is_live, const RepairCtx& ctx);
 
