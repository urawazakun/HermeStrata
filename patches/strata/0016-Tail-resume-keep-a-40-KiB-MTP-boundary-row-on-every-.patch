+                  "shape gate rejects overflow");
+            check(!restore::checkpoint_row_shape_ok(((int64_t) 1 << 62) + 1, 4, 4),
+                  "shape gate rejects wrap-to-small");
+        }
+    }
+    {   // TAIL-RESUME attach side: failures leave NO usable row (fail closed, never legitimized).
+        const std::vector<int64_t> ids = req64(250);
+        std::vector<float> row(8, 0.5f);
+        {   // scratch length mismatch (a later row must never dress an earlier checkpoint)
+            auto c = chain_item(150, 0);
+            check(!restore::attach_checkpoint_row(c, row, 149, true, 2, 4, 0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "stale-length attach fails closed");
+        }
+        {   // short row
+            auto c = chain_item(150, 0);
+            std::vector<float> short_row(7, 0.5f);
+            check(!restore::attach_checkpoint_row(c, short_row, 150, true, 2, 4, 0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "short-row attach fails closed");
+        }
+        {   // over the per-row byte cap (512x513 floats = just over 1 MiB)
+            auto c = chain_item(150, 0);
+            std::vector<float> big((size_t) 512 * 513, 0.5f);
+            check(!restore::attach_checkpoint_row(c, big, 150, true, 512, 513, 0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "over-cap attach fails closed");
+        }
+        {   // overflow shape without a matching allocation
+            auto c = chain_item(150, 0);
+            check(!restore::attach_checkpoint_row(c, row, 150, true, (int64_t) 1 << 32, 4, 0,
+                                                  nullptr) &&
+                      !c.boundary_row.has(),
+                  "overflow attach fails closed");
+        }
+        {   // wrap-to-small shape ((1LL<<62)+1 * 4 wraps to 4): bounded before multiplying
+            auto c = chain_item(150, 0);
+            std::vector<float> four(4, 0.5f);
+            check(!restore::attach_checkpoint_row(c, four, 150, true, ((int64_t) 1 << 62) + 1, 4,
+                                                  0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "wrap-to-small attach fails closed");
+        }
+        {   // too many image keys: the count is bounded before multiplying
+            auto c = chain_item(150, 0);
+            c.imgs.assign(70000, strata::core::ConversationImageKey{0, 0});
+            check(!restore::attach_checkpoint_row(c, row, 150, true, 2, 4, 0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "too-many-image attach fails closed");
+        }
+        {   // retained over-cap capacity rejects at validation (size still exact)
+            auto c = chain_item(150, 0);
+            std::vector<float> cap_row(8, 0.5f);
+            check(restore::attach_checkpoint_row(c, cap_row, 150, true, 2, 4, 0, nullptr),
+                  "retained-capacity fixture attaches");
+            c.boundary_row.row.reserve(300000);   // ~1.2 MiB retained, 8 floats live
+            check(!restore::checkpoint_row_valid_for(c, 250, 8, 2, 4, 0, true, ids, no_cimgs),
+                  "over-cap retained capacity rejects");
+        }
+        {   // invalid valid_from is rejected before publication (capture passes min(vf, L-1))
+            auto c = chain_item(150, 0);
+            check(!restore::attach_checkpoint_row(c, row, 150, true, 2, 4, -1, nullptr) &&
+                      !c.boundary_row.has(),
+                  "negative valid_from attach fails closed");
+            auto d = chain_item(150, 0);
+            check(!restore::attach_checkpoint_row(d, row, 150, true, 2, 4, 150, nullptr) &&
+                      !d.boundary_row.has(),
+                  "valid_from past L-1 attach fails closed");
+            auto e = chain_item(150, 0);
+            check(restore::attach_checkpoint_row(e, row, 150, true, 2, 4, 149, nullptr) &&
+                      e.boundary_row.has(),
+                  "valid_from at L-1 attaches");
+        }
+        {   // a failed re-attach erases the previously valid row (never a stale success)
+            auto c = chain_item(150, 0);
+            check(restore::attach_checkpoint_row(c, row, 150, true, 2, 4, 0, nullptr),
+                  "re-attach fixture valid");
+            std::vector<float> short_row(7, 0.5f);
+            check(!restore::attach_checkpoint_row(c, short_row, 150, true, 2, 4, 0, nullptr) &&
+                      !c.boundary_row.has(),
+                  "failed re-attach invalidates");
+            check(!restore::checkpoint_row_valid_for(c, 250, 8, 2, 4, 0, true, ids, no_cimgs),
+                  "invalidated row rejects");
+        }
+    }
+    {   // TAIL-RESUME fallback + ordering: the old exact SavedState source still admits a
+        // row-less checkpoint; the longest matching attached checkpoint wins; a mutated middle
+        // selects the newest checkpoint below the change (never the root).
+        const std::vector<int64_t> ids = req64(250);
+        const std::vector<int32_t> ids32 = req32(250);
+        saved::SavedStateStore st;
+        check(st.insert_tip(make_item(150, 0), false), "fallback boundary source tip(150) stores");
+        restore::RepairCtx ctx = repair_ctx(250, &st, &ids32, &no_simgs, true);
+        const std::vector<int32_t> live = req32(200);
+        {   // invalid attached row + exact SavedState at the same k: the fallback admits it
+            auto bad = chain_item(150, 0);
+            std::vector<float> row(8, 0.5f);
+            check(restore::attach_checkpoint_row(bad, row, 150, true, 2, 4, 0, nullptr),
+                  "fallback fixture attaches");
+            bad.boundary_row.ids_hash ^= 1;   // invalid row, legitimate store entry remains
+            std::vector<strata::core::ConversationCheckpoint> checks;
+            checks.push_back(bad);
+            std::vector<restore::ChainCand> got = restore::collect_chain_candidates(
+                true, false, live, no_cimgs, checks, ids, no_cimgs, 250, ctx);
+            check(got.size() == 1 && got[0].k == 150, "invalid row falls back to SavedState");
+        }
+        {   // longest matching attached checkpoint beats the older root-length one
+            saved::SavedStateStore empty;
+            restore::RepairCtx c2 = repair_ctx(250, &empty, &ids32, &no_simgs, true);
+            std::vector<strata::core::ConversationCheckpoint> checks;
+            auto root = chain_item(100, 0);
+            auto tip = chain_item(150, 0);
+            std::vector<float> row(8, 0.5f);
+            check(restore::attach_checkpoint_row(root, row, 100, true, 2, 4, 0, nullptr) &&
+                      restore::attach_checkpoint_row(tip, row, 150, true, 2, 4, 0, nullptr),
+                  "ordering fixtures attach");
+            checks.push_back(root);
+            checks.push_back(tip);
+            std::vector<restore::ChainCand> got = restore::collect_chain_candidates(
+                true, false, live, no_cimgs, checks, ids, no_cimgs, 250, c2);
+            check(got.size() == 2 && got[0].k == 150 && got[1].k == 100,
+                  "longest attached checkpoint first");
+        }
+        {   // mutated middle: the client changed token 160; 180 no longer prefixes, 150 does
+            saved::SavedStateStore empty;
+            restore::RepairCtx c2 = repair_ctx(250, &empty, &ids32, &no_simgs, true);
+            std::vector<int64_t> mut = req64(250);
+            mut[160] = 9999;
+            std::vector<strata::core::ConversationCheckpoint> checks;
+            auto above = chain_item(180, 0);
+            auto below = chain_item(150, 0);
+            std::vector<float> row(8, 0.5f);
+            check(restore::attach_checkpoint_row(above, row, 180, true, 2, 4, 0, nullptr) &&
+                      restore::attach_checkpoint_row(below, row, 150, true, 2, 4, 0, nullptr),
+                  "mutation fixtures attach");
+            checks.push_back(above);
+            checks.push_back(below);
+            std::vector<restore::ChainCand> got = restore::collect_chain_candidates(
+                true, false, live, no_cimgs, checks, mut, no_cimgs, 250, c2);
+            check(got.size() == 1 && got[0].k == 150,
+                  "mutated middle selects newest below the change");
+        }
+        {   // live + K8V4 no-repair behaviour unchanged: row-less checkpoints still offered
+            saved::SavedStateStore empty;
+            restore::RepairCtx c2 = repair_ctx(250, &empty, &ids32, &no_simgs, false);
+            std::vector<strata::core::ConversationCheckpoint> checks;
+            checks.push_back(chain_item(150, 0));
+            std::vector<restore::ChainCand> got = restore::collect_chain_candidates(
+                true, false, live, no_cimgs, checks, ids, no_cimgs, 250, c2);
+            check(got.size() == 1 && got[0].k == 150, "no-repair needs no row");
+        }
+    }
+    {   // TAIL-RESUME accounting: the row is counted (capacities, validity-independent)
+        // while attached; clear() keeps capacity, so a cleared-but-retained row still counts
+        // (truthful until the checkpoint is evicted/pruned, which destroys the vectors).
+        // The bound is prompt_cache rows of at most the per-row cap each.
+        auto c = chain_item(150, 0);
+        const size_t bare = c.bytes();
+        std::vector<float> row(8, 0.5f);
+        check(restore::attach_checkpoint_row(c, row, 150, true, 2, 4, 0, nullptr),
+              "accounting fixture attaches");
+        const size_t full = c.bytes();
+        check(full > bare && full - bare >= 8 * sizeof(float),
+              "attached row counted in bytes()");
+        c.boundary_row.clear();
+        check(!c.boundary_row.has() && c.bytes() == full,
+              "cleared retained capacity still counted");
+        // eviction destroys the row with its checkpoint: summed bytes drop by the full row cost.
+        std::vector<strata::core::ConversationCheckpoint> chain;
+        chain.push_back(chain_item(100, 0));
+        chain.push_back(chain_item(150, 0));
+        check(restore::attach_checkpoint_row(chain[0], row, 100, true, 2, 4, 0, nullptr) &&
+                  restore::attach_checkpoint_row(chain[1], row, 150, true, 2, 4, 0, nullptr),
+              "eviction fixtures attach");
+        size_t before = 0;
+        for (const auto& k : chain) before += k.bytes();
+        chain.erase(chain.begin());
+        size_t after = 0;
+        for (const auto& k : chain) after += k.bytes();
+        check(after < before, "evicted checkpoint takes its row bytes");
+    }
     if (g_fail == 0)
         std::printf("restore_test: all ok\n");
     else
