From 478ab668dfa7e036c12705886adf95dc2dcad6ff Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Wed, 30 Sep 2026 12:20:22 +0900
Subject: [PATCH 15/16] fix(cache): tip boundary point at last turn boundary,
 not raw prompt end (F2b)

---
 include/strata/program/saved_state.hpp |  53 +++--
 src/program/generate.cpp               | 292 ++++++++++++++++---------
 src/program/saved_state_test.cpp       |  99 ++++++++-
 tools/probe_turn_prefix.py             | 157 +++++++++++++
 4 files changed, 466 insertions(+), 135 deletions(-)
 create mode 100644 tools/probe_turn_prefix.py

diff --git a/include/strata/program/saved_state.hpp b/include/strata/program/saved_state.hpp
index 030a460..29ebf5b 100644
--- a/include/strata/program/saved_state.hpp
+++ b/include/strata/program/saved_state.hpp
@@ -30,8 +30,10 @@
 // F2 (BRIEF-CACHE-FIX-1): the tip's generation-end ids are prompt + generated ids (reasoning/<think> included)
 // but the next turn re-renders the assistant WITHOUT the reasoning, so the generation point is never a prefix
 // of the next prompt. One tip therefore retains TWO coherent restorable points of its line:
-//   (a) the prompt end (state + logical KV [0, n)) - always a prefix of the next turn of the same line and of
-//       a forked child's prompt (parent prompt + re-rendered assistant + tool result);
+//   (a) the LAST TURN BOUNDARY inside the prompt (F2b: the start of the trailing assistant generation
+//       header, i.e. the preceding <|im_end|> + newline end - NOT the raw prompt end n, whose trailing
+//       generation header is re-rendered as a history assistant turn) - a prefix of the next turn of the
+//       same line and of a forked child's prompt (parent prompt + re-rendered assistant + tool result);
 //   (b) the generation end (previous behaviour) - used when the client echoes the generated ids verbatim.
 // Resume picks the longest valid point across both. The prompt point lives in the store (tips_), so it survives
 // an unrelated (child) request independently of the chain, which the chain does not. Roots stay single-point
@@ -336,30 +338,32 @@ struct SavedItem {
 
 /// F2: one tip line's TWO coherent restorable points (see the file-top note).
 ///
-/// The prompt point is the state at exactly the prompt end n (NOT n-1, NOT a header/turn boundary): the next
-/// request re-renders the assistant turn without reasoning, so only n is a prefix of it. The generation point
+/// The prompt point is the state at exactly the LAST TURN BOUNDARY L inside the prompt (F2b: the start of
+/// the trailing assistant generation header - the raw prompt end n is NOT a prefix of the next request,
+/// which re-renders that header as a history assistant turn without reasoning). The generation point
 /// is the previous tip behaviour (prompt + generated ids at DONE).
 ///
 /// Capture contract (E1/E2, implemented in generate.cpp; the store only gates coherence):
-/// - The prompt's recurrent payload (GDN/PLE/tails + ple_prev over the PROMPT ids), indexer payloads, MTP
-///   rows [0, n-1) and boundary R_(n-1) are captured at prompt end from the first verifier window, when only
-///   the last prompt input is consumed and BEFORE any generated input is committed. A speculative multi-row
-///   verifier state is NOT the prompt end: use a coherent 1-row first window (or an equivalent snapshot
-///   mechanism). MTP pairs [0, n-1) need their exact source - the prompt snapshot source must be retained
-///   before scratch/decode changes it.
+/// - The prompt's recurrent payload (GDN/PLE/tails + ple_prev over the BOUNDARY ids), indexer payloads,
+///   MTP metadata (cells = L-1) and boundary R_(L-1) are captured at the prefill segment ending at L,
+///   when the session holds exactly the boundary-L state and BEFORE any generated input is committed.
+///   A speculative multi-row verifier state, or later decode state sliced to shorter ids, is NOT the
+///   boundary: use a coherent exact-L snapshot mechanism. MTP rows [0, L-1) need their exact source -
+///   the boundary snapshot source must be retained before scratch/decode changes it.
 /// - Post-DONE the final KV [0, L) is captured once with the generation point. The main KV prefix is
-///   immutable (decode only appends cells [n, L)), so the prompt point SHARES it: the prompt stores NO main-KV
-///   copy (its StagePayload::kv vectors are empty) and logically covers the shorter page range [0, n). The
-///   drafter rows [0, n-1) are likewise immutable during decode, so the prompt shares those too: its MtpPayload
-///   keeps its own cells/valid_from metadata (cells = n-1) with an EMPTY kv (no second draft-KV copy); E2
-///   restores rows [0, n-1) from the generation backing. (An owned prompt MTP copy also validates, for tests.)
-/// - The prompt's indexer/recurrent/boundary payloads are its own (prompt-only, never generation state).
+///   immutable (decode only appends cells past the prompt), so the prompt point SHARES it: the prompt stores
+///   NO main-KV copy (its StagePayload::kv vectors are empty) and logically covers the shorter page range
+///   [0, L). The drafter rows [0, L-1) are likewise immutable during decode, so the prompt shares those
+///   too: its MtpPayload keeps its own cells/valid_from metadata (cells = L-1) with an EMPTY kv (no second
+///   draft-KV copy); E2 restores rows [0, L-1) from the generation backing. (An owned prompt MTP copy also
+///   validates, for tests.)
+/// - The prompt's indexer/recurrent/boundary payloads are its own (boundary-only, never generation state).
 ///
-/// E2 mount recipe for a prompt point p of entry e (gen g, prompt length n, request ids P with P[n] first
-/// suffix token): upload the KV prefix - the first kv_pool_bytes(fmt, n, gm...) bytes of each of g's layer
+/// E2 mount recipe for a prompt point p of entry e (gen g, boundary length L, request ids P with P[L] first
+/// suffix token): upload the KV prefix - the first kv_pool_bytes(fmt, L, gm...) bytes of each of g's layer
 /// vectors (pages are contiguous, so the prefix is a byte-prefix) - restore recurrent/indexer from p, MTP
-/// metadata from p with rows [0, n-1) from g (or p's own copy when present), then pair p.boundary R_(n-1)
-/// with P[n] before the suffix prefill (same boundary block as a generation mount, at k = n).
+/// metadata from p with rows [0, L-1) from g (or p's own copy when present), then pair p.boundary R_(L-1)
+/// with P[L] before the suffix prefill (same boundary block as a generation mount, at k = L).
 ///
 /// Budget: entry bytes = gen.payload_bytes() + prompt.payload_bytes(); the shared KV is counted ONCE (it only
 /// exists in gen), both recurrent payloads are counted. Eviction removes the pair coherently (one LRU entry).
@@ -376,16 +380,17 @@ struct TipEntry {
 };
 
 /// F2 coherence gate: p is a valid shared-KV prompt point for generation item g. g must be complete on its
-/// own; p must be a strict prefix line of g (ids, cvec, images below n), share its geometry/stages, carry a
-/// complete boundary of the same shape (a DIFFERENT row: R_(n-1), not R_(L-1)), own exact MTP pairs [0, n-1),
-/// prompt-only recurrent/indexer state of the right sizes, and NO main-KV copy (sharing is structural).
+/// own; p must be a strict prefix line of g (ids, cvec, images below the boundary length), share its
+/// geometry/stages, carry a complete boundary of the same shape (a DIFFERENT row: R_(L-1), not R_(gen-1)),
+/// own exact MTP pairs [0, L-1), boundary-only recurrent/indexer state of the right sizes, and NO main-KV
+/// copy (sharing is structural).
 inline bool prompt_for_shared_ok(const SavedItem& p, const SavedItem& g) {
     const int64_t n = (int64_t)p.ids.size();
     const int64_t L = (int64_t)g.ids.size();
     if (n < 1 || L < 2 || n >= L) return false;
     if (!g.complete()) return false;
     if (g.stages.empty() || g.stages[0].kv.empty()) return false;
-    if (!is_prefix(p.ids, g.ids)) return false;   // exact prompt end n, not n-1 or a header boundary
+    if (!is_prefix(p.ids, g.ids)) return false;   // exact boundary-L ids: a strict prefix of the gen line
     if (p.cvec != g.cvec) return false;
     if (p.imgs != imgs_below(g.imgs, n)) return false;
     if (p.geom != g.geom) return false;
