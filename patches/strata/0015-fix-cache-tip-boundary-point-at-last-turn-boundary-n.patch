@@ -0,0 +1,157 @@
+"""tools/probe_turn_prefix.py - CPU-only F2b hypothesis probe (BRIEF-CACHE-FIX-1.md Round 2).
+
+Reconstructs the GPU acceptance case-3 prompts (parent1 / parent2 / fork child) from a
+captured request body, renders them through the serving path (serve.frontend
+openai_to_messages + the pack's own chat_template.jinja) and tokenizes with the
+reference production tokenizer (tools.strata_tokenizer), then checks the F2b claim:
+
+  * the raw prompt end n of parent1 is NOT a prefix of the parent2/fork prompts
+    (the template's generation header is re-rendered as a history assistant turn), but
+  * the LAST TURN BOUNDARY L inside parent1 (start of the trailing assistant
+    generation header, i.e. end of "<|im_end|>" + newline) IS a prefix of both.
+
+CPU-only: no network, no engine, no GPU. Takes tokenizer/body paths on the command
+line and never embeds request bodies. Assistant generations are not in the captured
+body, so their content is supplied with --assistant1/--assistant2 (text or @file);
+without them a SYNTHETIC placeholder is used and labelled as such in the output.
+Prefix booleans at L do not depend on that content (it renders after L), while the
+exact LCP length may.
+
+Usage:
+  python tools/probe_turn_prefix.py --tokenizer <pack>/tokenizer --body <bisect-body.json>
+      [--rep 0] [--assistant1 TEXT|--assistant1 @file] [--assistant2 ...] [--turn-token ID]
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "tools"))
+
+from serve.frontend import ChatTemplate, openai_to_messages  # noqa: E402
+from strata_tokenizer import Tokenizer  # noqa: E402
+
+TOPICS = ["ローグライクの食料システム", "FOV の対称性", "セーブの決定論"]
+FOLLOWUP = "その1行目をもう少し具体的に。"
+FORK_USER = ("[forked child, depth 1/2] You are a copy of the agent above, now working ONLY on "
+             "this task: 最初に教わった合言葉をそのまま1行で答えよ。 Do it yourself.")
+SYNTHETIC_A = "1. 飢えは段階的ペナルティで表現する。\n2. 腐敗と重量で探索に意味を持たせる。"
+
+
+def load_text(arg: str) -> tuple[str, str]:
+    """--assistant TEXT or @file -> (content, label)."""
+    if arg.startswith("@"):
+        return Path(arg[1:]).read_text(encoding="utf-8"), "file:" + arg[1:]
+    return arg, "cli-text"
+
+
+def body_with(body: dict, messages: list[dict], max_tokens: int) -> dict:
+    b = copy.deepcopy(body)
+    b["messages"] = [body["messages"][0]] + messages
+    b["max_tokens"], b["temperature"] = max_tokens, 0
+    return b
+
+
+def render_ids(body: dict, template: ChatTemplate, tok: Tokenizer) -> tuple[list[int], str]:
+    messages, tools, kwargs = openai_to_messages(body)
+    prompt = template.render(messages, tools=tools, **kwargs)
+    return tok.encode(prompt, parse_special=True), prompt
+
+
+def lcp(a: list[int], b: list[int]) -> int:
+    n = min(len(a), len(b))
+    i = 0
+    while i < n and a[i] == b[i]:
+        i += 1
+    return i
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="F2b turn-boundary prefix probe (CPU-only).")
+    ap.add_argument("--tokenizer", required=True, help="pack tokenizer directory")
+    ap.add_argument("--body", required=True, help="captured request JSON (bisect-body.json)")
+    ap.add_argument("--rep", type=int, default=0)
+    ap.add_argument("--assistant1", default=None, help="parent1 generation content (TEXT or @file)")
+    ap.add_argument("--assistant2", default=None, help="parent2 generation content (TEXT or @file)")
+    ap.add_argument("--turn-token", type=int, default=None, help="default: <|im_start|> id from vocab")
+    args = ap.parse_args()
+
+    tpath = Path(args.tokenizer)
+    raw = json.loads(Path(args.body).read_text(encoding="utf-8"))
+    body = raw["request"]["body"] if "request" in raw else raw
+
+    vocab = json.loads((tpath / "vocab.json").read_text(encoding="utf-8"))
+    tokens = [None] * len(vocab)
+    for t, i in vocab.items():
+        tokens[i] = t
+    merges = (tpath / "merges.txt").read_text(encoding="utf-8").split("\n")
+    types = json.loads((tpath / "token_type.json").read_text(encoding="utf-8"))
+    tok = Tokenizer(tokens, merges, types)
+    template = ChatTemplate(tpath / "chat_template.jinja")
+
+    if args.assistant1 is None:
+        a1, a1_label = SYNTHETIC_A, "SYNTHETIC (default placeholder)"
+    else:
+        a1, a1_label = load_text(args.assistant1)
+    if args.assistant2 is None:
+        a2, a2_label = SYNTHETIC_A, "SYNTHETIC (default placeholder)"
+    else:
+        a2, a2_label = load_text(args.assistant2)
+
+    rep = args.rep
+    p1 = [{"role": "user",
+           "content": f"（合言葉: 青いペンギン{rep}号。覚えておいて）{TOPICS[rep]}について、設計上の注意点を2行で。"}]
+    p2 = p1 + [{"role": "assistant", "content": a1}, {"role": "user", "content": FOLLOWUP}]
+    fork = p2 + [{"role": "assistant", "content": a2}, {"role": "user", "content": FORK_USER}]
+
+    p1_ids, p1_text = render_ids(body_with(body, p1, 96), template, tok)
+    p2_ids, _ = render_ids(body_with(body, p2, 96), template, tok)
+    fork_ids, _ = render_ids(body_with(body, fork, 400), template, tok)
+    n = len(p1_ids)
+
+    turn_id = args.turn_token
+    if turn_id is None:
+        enc = tok.encode("<|im_start|>", parse_special=True)
+        assert len(enc) == 1, f"<|im_start|> is not one token: {enc}"
+        turn_id = enc[0]
+    hdr = max(i for i, t in enumerate(p1_ids) if t == turn_id)  # last turn header in parent1
+    tail = tok.encode("<|im_end|>\n", parse_special=True)
+    tail_ok = p1_ids[hdr - len(tail):hdr] == tail
+    L = hdr  # boundary: right after the last message's end-of-turn, before the gen header
+    assert tail_ok, (f"last <|im_start|> at {hdr} is NOT preceded by <|im_end|>+newline: "
+                     f"{p1_ids[hdr - len(tail):hdr + 1]} vs {tail}")
+
+    lcp12 = lcp(p1_ids, p2_ids)
+    lcp1f = lcp(p1_ids, fork_ids)
+    raw_prefix_p2 = p1_ids == p2_ids[:n]
+    raw_prefix_fork = p1_ids == fork_ids[:n]
+    L_prefix_p2 = p1_ids[:L] == p2_ids[:L]
+    L_prefix_fork = p1_ids[:L] == fork_ids[:L]
+
+    print(f"assistant1 content: {a1_label} ({len(a1)} chars)")
+    print(f"assistant2 content: {a2_label} ({len(a2)} chars)")
+    print(f"turn token id: {turn_id}; last header at {hdr}; end-of-turn tail ok: {tail_ok}")
+    print(f"parent1 prompt n={n}  parent2 prompt {len(p2_ids)}  fork prompt {len(fork_ids)}")
+    print(f"last turn boundary L={L} (raw tail {n - L} tokens: {tok.decode(p1_ids[L:])!r})")
+    print(f"LCP(parent1, parent2)={lcp12}  LCP(parent1, fork)={lcp1f}")
+    print(f"raw prompt end n is prefix of parent2: {raw_prefix_p2}")
+    print(f"raw prompt end n is prefix of fork:    {raw_prefix_fork}")
+    print(f"boundary L is prefix of parent2: {L_prefix_p2}")
+    print(f"boundary L is prefix of fork:    {L_prefix_fork}")
+    print(f"parent2 suffix at L ({len(p2_ids) - L} tokens) starts: {tok.decode(p2_ids[L:L + 32])!r}")
+    print(f"fork suffix at L ({len(fork_ids) - L} tokens) starts: {tok.decode(fork_ids[L:L + 32])!r}")
+    print(f"parent1 tail at LCP({lcp12}) decoded: {tok.decode(p1_ids[max(0, lcp12 - 8):lcp12 + 8])!r}")
+    print(f"parent2 at LCP({lcp12}) decoded:     {tok.decode(p2_ids[max(0, lcp12 - 8):lcp12 + 8])!r}")
+
+    ok = L_prefix_p2 and L_prefix_fork and not raw_prefix_p2 and not raw_prefix_fork
+    print("F2b hypothesis (L prefix, raw-n not prefix):", "HOLDS" if ok else "VIOLATED")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
