 /// under memory pressure the way a heap-owning wrapper would.
 using RamEligibilityFn = bool (*)(const saved_state::SavedItem&, std::string&, void*);
 
+/// Per-request counters for the RAM walk (TWO-LINES observability): how many
+/// store points were considered, how many passed eligibility, how many were
+/// rejected, and how many sat at/past the request end. The engine reports one
+/// `tip-cache restore` summary line per request from these; the detailed
+/// rejection reasons stay on the existing per-candidate stderr lines.
+struct RamWalkCounters {
+    size_t considered = 0;
+    size_t eligible = 0;
+    size_t ineligible = 0;
+    size_t skipped_end = 0;
+};
+
 /// The accumulating-skip-set RAM walk (moved from generate.cpp): longest-first via
 /// find_best_except without revisit (always terminates), at/past-end skip, eligibility gate.
 /// No store mutation between calls: returned pointers stay valid. Logs verbatim.
@@ -210,6 +222,13 @@ std::vector<const saved_state::SavedItem*> collect_ram_candidates(
     const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n,
     RamEligibilityFn eligible, void* ctx);
 
+/// Counted form of the walk above (same order, same gates, same logs, same
+/// checks): fills `cnt` when non-null. The uncounted form delegates to this one.
+std::vector<const saved_state::SavedItem*> collect_ram_candidates_counted(
+    const saved_state::SavedStateStore& store, const std::vector<int32_t>& ids,
+    const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n,
+    RamEligibilityFn eligible, void* ctx, RamWalkCounters* cnt);
+
 /// Adapter for any callable (capturing lambdas in tests, the engine's inline check): forwards
 /// to the non-owning core borrowing the callable by reference for the synchronous call only.
 /// No copy, no heap ownership at any point (const callables supported); the reference stays
@@ -225,6 +244,21 @@ std::vector<const saved_state::SavedItem*> collect_ram_candidates(
     return collect_ram_candidates(store, ids, imgs, cvec, n, trampoline, &eligible);
 }
 
+/// Counted adapter (same non-owning borrowing contract as above, plus the
+/// nullable out-counters): lets the engine report one per-request summary
+/// without changing the selection itself.
+template <typename F>
+std::vector<const saved_state::SavedItem*> collect_ram_candidates_counted(
+    const saved_state::SavedStateStore& store, const std::vector<int32_t>& ids,
+    const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n, F&& eligible,
+    RamWalkCounters* cnt) {
+    using Plain = typename std::remove_reference<F>::type;
+    auto trampoline = [](const saved_state::SavedItem& it, std::string& why, void* ctx) -> bool {
+        return (*static_cast<Plain*>(ctx))(it, why);
+    };
+    return collect_ram_candidates_counted(store, ids, imgs, cvec, n, trampoline, &eligible, cnt);
+}
