+const SavedItem* SavedStateStore::find_exact_tip(const std::vector<int32_t>& ids,
+                                                 const std::vector<ImgKey>& imgs, bool cvec,
+                                                 int64_t k) const {
+    if (k < 1 || k > (int64_t) ids.size()) return nullptr;
+    auto matches = [&](const SavedItem& it) {
+        if ((int64_t) it.ids.size() != k) return false;
+        if ((int) it.stages.size() != n_stages_ || it.n_stages != n_stages_) return false;
+        if (it.cvec != cvec) return false;
+        if (!is_prefix(it.ids, ids)) return false;
+        return tip_imgs_match(imgs, k, it.imgs);
+    };
+    // Tips only (same match rule as find_exact, roots excluded).
+    for (const TipEntry& t : tips_) {
+        if (t.has_prompt && matches(t.prompt)) return &t.prompt;
+        if (matches(t.gen)) return &t.gen;
+    }
+    return nullptr;
+}
