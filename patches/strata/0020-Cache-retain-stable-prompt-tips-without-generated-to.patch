+        check(st.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false),
+              "S2 pair admits");
+        const uint64_t full = st.tip_bytes();
+        check(st.find_exact(req_at(0, 100), no_imgs, true, 60) != nullptr,
+              "S2 prompt point verifiably retained");
+        st.set_tip_budget_bytes(full);   // exactly full with line A
+        check(st.insert_tip_pair(make_prompt_item(40, 5000), make_line(80, 5000), false),
+              "S2 line B admits");
+        check(st.tips() == 1, "S2 pressure evicts the whole older line");
+        check(st.find_best(req_at(0, 100), no_imgs, true) == nullptr, "S2 evicted line A is gone");
+        check(st.find_best(req_at(5000, 80), no_imgs, true) != nullptr, "S2 line B survives");
+        saved::SavedStateStore st2;
+        st2.set_tip_budget_bytes(1);   // below one entry: self-eviction on insert
+        check(st2.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false),
+              "S2 over-budget pair insert still returns true");
+        check(st2.tips() == 0 && st2.find_best(req_at(0, 100), no_imgs, true) == nullptr &&
+                  st2.find_exact(req_at(0, 100), no_imgs, true, 60) == nullptr,
+              "S2 self-evicted pair retains nothing (admission != retention)");
+    }
+    {   // TWO-LINES TIP-entry-specific survival (control data): has_retained_pair needs BOTH
+        // the exact gen key AND the paired prompt in the SAME retained entry. A pinned root
+        // matching the prompt length, or a gen-only single (downgrade), must NOT report paired.
+        saved::SavedStateStore st;
+        check(st.insert_root(make_line(60, 0)), "S2 root matching the prompt length stores");
+        check(st.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false),
+              "S2 pair stores");
+        check(st.has_retained_pair(req_at(0, 100), no_imgs, true, 60),
+              "S2 stored pair verifies gen key + prompt in one entry");
+        check(!st.has_retained_pair(req_at(0, 100), no_imgs, true, 61),
+              "S2 wrong prompt length is not paired");
+        check(!st.has_retained_pair(req_at(0, 100), no_imgs, false, 60),
+              "S2 cvec flip is not paired");
+        check(!st.has_retained_pair(req_at(5000, 100), no_imgs, true, 60),
+              "S2 wrong gen ids are not paired");
+        // Evict the pair under budget pressure: the pinned root survives, the pair does not.
+        st.set_tip_budget_bytes(1);
+        check(st.tips() == 0, "S2 pressure evicts the pair, root pinned");
+        check(!st.has_retained_pair(req_at(0, 100), no_imgs, true, 60),
+              "S2 evicted pair is not reported paired");
+        check(st.find_exact(req_at(0, 100), no_imgs, true, 60) != nullptr,
+              "S2 legacy find_exact still sees the pinned root (why it cannot verify pairs)");
+        // Gen-only downgrade over the same key is not a pair either.
+        saved::SavedStateStore st3;
+        check(st3.insert_tip(make_line(100, 0), false), "S2 gen-only single stores");
+        check(!st3.has_retained_pair(req_at(0, 100), no_imgs, true, 60),
+              "S2 gen-only single is not a pair");
+        check(st3.find_exact_tip(req_at(0, 100), no_imgs, true, 100) != nullptr,
+              "S2 tip-only exact lookup sees the generation point");
+        check(st3.find_exact_tip(req_at(0, 100), no_imgs, true, 60) == nullptr,
+              "S2 tip-only exact lookup misses the absent prompt point");
+        check(st.find_exact_tip(req_at(0, 100), no_imgs, true, 60) == nullptr,
+              "S2 tip-only lookup excludes the pinned root");
+        check(!st3.has_retained_pair(req_at(0, 100), no_imgs, true, 100),
+              "S2 prompt length == gen length is not paired");
+    }
+    {   // TWO-LINES tip-lookup census: tips-only key-gate summary per request (no allocation).
+        // entries=0 means no tips at all; matching=0 with prefix_mismatch>0 means only a
+        // pinned root could match; lengths only, never tokens.
+        saved::SavedStateStore st;
+        saved::TipLookupSummary empty;
+        st.summarize_lookup(req_at(0, 120), no_imgs, true, 1, empty);
+        check(empty.entries == 0 && empty.points == 0 && empty.matching == 0 &&
+                  empty.best_match_len == -1 && empty.best_mismatch_lcp == -1,
+              "S2 empty store census is zero");
+        check(st.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false),
+              "S2 line A pair stores");
+        check(st.insert_tip(make_line(40, 5000), false), "S2 line B single stores");
+        check(st.insert_root(make_line(30, 0)), "S2 older root stores (excluded from census)");
+        saved::TipLookupSummary a;
+        st.summarize_lookup(req_at(0, 120), no_imgs, true, 1, a);
+        check(a.entries == 2 && a.points == 3, "S2 census counts tip lines and points, not roots");
+        check(a.matching == 2 && a.prefix_mismatch == 1 && a.image_mismatch == 0 &&
+                  a.cvec_mismatch == 0 && a.stage_mismatch == 0,
+              "S2 line A request: pair matches, line B mismatches prefix");
+        check(a.best_match_len == 100 && a.best_mismatch_lcp == 0,
+              "S2 best lengths for the A request");
+        saved::TipLookupSummary b;
+        st.summarize_lookup(req_at(5000, 70), no_imgs, true, 1, b);
+        check(b.matching == 1 && b.prefix_mismatch == 2 && b.best_match_len == 40 &&
+                  b.best_mismatch_lcp == 0,
+              "S2 line B request: only its own point matches");
+        saved::TipLookupSummary cf;
+        st.summarize_lookup(req_at(0, 120), no_imgs, false, 1, cf);
+        check(cf.matching == 0 && cf.cvec_mismatch == 3 && cf.prefix_mismatch == 0,
+              "S2 cvec flip mismatches every point on cvec");
+        saved::TipLookupSummary sg;
+        st.summarize_lookup(req_at(0, 120), no_imgs, true, 2, sg);
+        check(sg.matching == 0 && sg.stage_mismatch == 3, "S2 stage mismatch counted");
+        // Partial prefix overlap records the safe LCP length.
+        saved::SavedStateStore st4;
+        saved::SavedItem near = make_line(80, 0);
+        for (int i = 70; i < 80; ++i) near.ids[(size_t) i] = (int32_t) (9000 + i);
+        check(near.complete(), "S2 near-miss fixture is complete");
+        check(st4.insert_tip(std::move(near), false), "S2 near-miss tip stores");
+        saved::TipLookupSummary nm;
+        st4.summarize_lookup(req_at(0, 120), no_imgs, true, 1, nm);
+        check(nm.matching == 0 && nm.prefix_mismatch == 1 && nm.best_mismatch_lcp == 70,
+              "S2 near-miss records LCP 70");
+        // Image identity is its own mismatch category.
+        saved::SavedStateStore st5;
+        saved::SavedItem with_img = make_line(50, 0);
+        with_img.imgs.push_back({5, 9});
+        check(with_img.complete(), "S2 image fixture is complete");
+        check(st5.insert_tip(std::move(with_img), false), "S2 image tip stores");
+        saved::TipLookupSummary im;
+        st5.summarize_lookup(req_at(0, 120), no_imgs, true, 1, im);
+        check(im.matching == 0 && im.image_mismatch == 1 && im.prefix_mismatch == 0,
+              "S2 missing image mismatches on images, not prefix");
+        saved::TipLookupSummary im2;
+        st5.summarize_lookup(req_at(0, 120), std::vector<saved::ImgKey>{{5, 9}}, true, 1, im2);
+        check(im2.matching == 1 && im2.image_mismatch == 0, "S2 matching image hits");
+    }
     std::printf(g_fail ? "FAIL\n" : "PASS\n");
     return g_fail ? 1 : 0;
 }
