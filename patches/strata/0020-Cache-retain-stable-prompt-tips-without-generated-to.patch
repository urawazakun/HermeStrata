+void SavedStateStore::summarize_lookup(const std::vector<int32_t>& ids,
+                                       const std::vector<ImgKey>& imgs, bool cvec,
+                                       int live_n_stages, TipLookupSummary& out) const {
+    out = TipLookupSummary{};
+    out.entries = tips_.size();
+    // Key-gate order mirrors find_best_except (stage, cvec, full-ids prefix, images).
+    for (const TipEntry& t : tips_) {
+        const SavedItem* pts[2] = {&t.gen, t.has_prompt ? &t.prompt : nullptr};
+        for (int p = 0; p < 2; ++p) {
+            const SavedItem* it = pts[p];
+            if (it == nullptr) continue;
+            ++out.points;
+            const int64_t k = (int64_t) it->ids.size();
+            if ((int) it->stages.size() != live_n_stages || it->n_stages != live_n_stages) {
+                ++out.stage_mismatch;
+                continue;
+            }
+            if (it->cvec != cvec) {
+                ++out.cvec_mismatch;
+                continue;
+            }
+            if (!is_prefix(it->ids, ids)) {
+                ++out.prefix_mismatch;
+                const int64_t lcp = tip_lcp_len(it->ids, ids);
+                if (lcp > out.best_mismatch_lcp) out.best_mismatch_lcp = lcp;
+                continue;
+            }
+            if (!tip_imgs_match(imgs, k, it->imgs)) {
+                ++out.image_mismatch;
+                continue;
+            }
+            ++out.matching;
+            if (k > out.best_match_len) out.best_match_len = k;
+        }
+    }
