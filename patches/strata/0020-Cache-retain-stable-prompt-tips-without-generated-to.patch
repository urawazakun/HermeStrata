+bool SavedStateStore::has_retained_pair(const std::vector<int32_t>& gen_ids,
+                                        const std::vector<ImgKey>& gen_imgs, bool cvec,
+                                        int64_t prompt_len) const {
+    if (prompt_len < 1 || gen_ids.empty()) return false;
+    const int64_t g = (int64_t) gen_ids.size();
+    if (prompt_len >= g) return false;
+    // Tips only: a pinned root matching the prompt length proves nothing about the pair.
+    for (const TipEntry& t : tips_) {
+        if (!t.has_prompt) continue;
+        const SavedItem& gen = t.gen;
+        if ((int64_t) gen.ids.size() != g) continue;
+        if (gen.ids != gen_ids) continue;
+        if (gen.cvec != cvec) continue;
+        if (!tip_imgs_match(gen_imgs, g, gen.imgs)) continue;
+        if ((int64_t) t.prompt.ids.size() != prompt_len) continue;
+        if (!is_prefix(t.prompt.ids, gen_ids)) continue;
+        return true;
+    }
+    return false;
