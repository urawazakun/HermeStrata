 /// The per-iteration longest-first selection state machine. Owns the attempt variables that
 /// used to live in main()'s loop head: the chain/RAM cursors, chain_dead, the disk skip set,
 /// and the sk_disk/sk_ram/sk_saved/take_chain decision. The execution half calls next() to
diff --git a/include/strata/program/saved_state.hpp b/include/strata/program/saved_state.hpp
index bbb3a6b..38327f2 100644
--- a/include/strata/program/saved_state.hpp
