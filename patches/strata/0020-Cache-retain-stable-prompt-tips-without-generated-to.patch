+/// Standalone stable-prompt fallback (TWO-LINES narrow gap): a fresh F2b prompt
+/// point carries boundary-only recurrent/indexer/boundary/MTP-metadata payloads
+/// and NO main-KV copy (it was captured to share a generation backing). When no
+/// generation tip is retained (zero emitted tokens, failed snapshot, incoherent
+/// pair), the prompt point is still retained as an ordinary single-point
+/// complete SavedItem by attaching its OWN exact [0,k) main-KV and [0,k-1) MTP
+/// copies. Below-k rows are immutable through append-only decode, so post-DONE
+/// copies from the live backing are exact; recurrent/indexer/R come from the
+/// fresh prefill-boundary capture only - never later state relabeled as k.
+/// A standalone fallback is a SEPARATE single entry (insert_tip): the pair
+/// structural sharing checks are deliberately NOT extended to allow a
+/// duplicate owned-KV prompt inside a pair.
+struct StandaloneKvBacking {
+    /// Per stage (main + splits), one KvLayerPayload per QSA layer with exactly
+    /// cells == k. Empty until the engine fills it post-DONE from the
+    /// authoritative append-only backing (bounded [0,k) copies only).
+    std::vector<std::vector<KvLayerPayload>> stages_kv;
+    /// The MTP [0,k-1) pairs (exactly one entry, cells == k-1). Empty unless
+    /// has_mtp; k == 1 holds no pair, so has_mtp is false there.
+    KvLayerPayload mtp_kv;
+    bool has_mtp = false;
+};
+
+/// Mode gates for the standalone fallback, resolved by the engine at the
+/// post-DONE call site (all must hold; each maps to one production condition).
+struct StandaloneMode {
+    bool supported_kv = false;   ///< saved_state_kv_ok(): no K8V4, startup mode on
+    bool non_aux = false;        ///< main line (!req_aux): aux lines retain nothing
+    bool tip_budget_on = false;  ///< o.tip_cache_gib > 0
+    bool no_stop = false;        ///< !stop_req: a STOP invalidates the boundary
+    bool no_cancel = false;      ///< !cancelled: no mid-request cancel
+    bool boundary_ok = false;    ///< exact-boundary state (false after flush/device failure)
+    bool mtp_ok = false;         ///< coherent drafter state (false after catch-up failure)
+    /// No known failed post-DONE device copy/snapshot on this request (flush-row
+    /// copy, generation snapshot/sync/copy). A later successful sync cannot justify
+    /// the fallback once a copy error was consumed: fail closed. Structural or
+    /// coherence rejection after successful copies (and zero-generated requests,
+    /// where no copy ran) keeps this true.
+    bool copies_clean = false;
+};
+
+/// Pure eligibility for the standalone fallback (CPU-only, unit-tested): every
+/// payload/identity/window condition plus every mode gate. `live_*` is the
+/// CURRENT post-DONE session transcript (prompt + actually emitted tokens);
+/// `cur_mtp_valid_from` is the current drafter window bound. The fresh prompt
+/// must exactly prefix-match live with image/cvec/geometry/stage identity,
+/// carry a complete boundary row, boundary-only payloads (NO main-KV copy -
+/// relabeling later state as k is rejected), and exact MTP metadata for
+/// [0,k-1). Coverage (k > 1 only): the current backing/window bound must lie at
+/// or below the prompt's saved valid_from (current backing vf <= saved prompt
+/// vf); a negative or transcript-impossible current bound is rejected outright.
+/// Zero emitted tokens are fine: no newly emitted token is required.
+/// Geometry is validated division-first (nonzero/bounded scalars, row product
+/// within the allocation cap) BEFORE any product, division, or size math, so
+/// hostile payloads cannot divide by zero or overflow here or in complete().
+bool standalone_fallback_eligible(const SavedItem& prompt, const std::vector<int32_t>& live_ids,
+                                  const std::vector<ImgKey>& live_imgs, bool live_cvec,
+                                  const SnapshotGeom& live_geom, int live_n_stages,
+                                  int64_t cur_mtp_valid_from, const StandaloneMode& mode,
+                                  std::string& why);
+
+/// Attach caller-copied bounded backing to the fresh prompt's own boundary
+/// payloads and validate the assembled single point. All sizes are validated
+/// BEFORE any move, then the assembly commits TRANSACTIALLY: backing attaches to
+/// a temporary copy (one extra prompt-bulk transient, fallback-rare only - never
+/// on the normal pair path), complete() validates the copy, and only a fully
+/// complete assembly moves back. On false (or a copy throw) the prompt keeps its
+/// original recurrent/indexer/R/metadata untouched. True ⟺ the item passes the
+/// full complete() structural gate and may go to insert_tip.
+bool complete_standalone_prompt(SavedItem& prompt, StandaloneKvBacking backing, std::string& why);
+
+/// Per-request tip-lookup census (TWO-LINES telemetry): a CPU-only, nonmutating,
+/// no-allocation summary of the tip store against one request's key. Counts tip
+/// LINES (entries) and restorable POINTS (gen + prompt points), how many points
+/// pass the store key gates (stage/cvec/full-ids-prefix/images, in the same order
+/// as find_best_except), per-cause rejection counters, the longest matching
+/// point, and the longest common-prefix LENGTH among mismatching points (lengths
+/// only - never tokens, text, or hashes). Roots are excluded: no retained tip passed
+/// the key gates when matching=0 (entries=0 means no tips at all); the restore
+/// outcome separately identifies live/chain/root/disk alternatives.
+/// Filled by SavedStateStore::summarize_lookup (never mutates, never allocates).
+struct TipLookupSummary {
+    size_t entries = 0;
+    size_t points = 0;
+    size_t matching = 0;
+    size_t prefix_mismatch = 0;
+    size_t image_mismatch = 0;
+    size_t cvec_mismatch = 0;
+    size_t stage_mismatch = 0;
+    int64_t best_match_len = -1;
+    int64_t best_mismatch_lcp = -1;
+};
 /// Per-request stats (defined here; filled per request): `resume from {chain|tip|root|root-disk} at k, suffix n,
 /// restore ms, snapshot ms`.
 struct ResumeStats {
@@ -571,6 +663,23 @@ class SavedStateStore {
     /// exactly this length. CPU-testable.
     const SavedItem* find_exact(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs, bool cvec,
                                 int64_t k) const;
+    /// TIP-entry-specific survival queries (control data, not best-effort diagnostics).
+    /// has_retained_pair is true iff some tip ENTRY's gen key exactly matches (gen ids of
+    /// length gen_ids.size() with image/cvec identity) AND the SAME entry still holds its
+    /// paired prompt of length prompt_len (prefix-verified). Roots never count (a pinned
+    /// root matching the prompt length proves nothing about the pair), and gen-only
+    /// singles never count as paired. find_exact_tip is the tip-only exact-length lookup
+    /// (same match rule as find_exact, roots excluded). Neither allocates; both only walk
+    /// pointer/size comparisons. CPU-testable.
+    bool has_retained_pair(const std::vector<int32_t>& gen_ids, const std::vector<ImgKey>& gen_imgs,
+                           bool cvec, int64_t prompt_len) const;
+    const SavedItem* find_exact_tip(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs,
+                                    bool cvec, int64_t k) const;
+    /// No-allocation key-gate census for one request (see TipLookupSummary): tips-only,
+    /// never mutates, never allocates. live_n_stages is the session's stage count.
+    /// CPU-testable.
+    void summarize_lookup(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs,
+                          bool cvec, int live_n_stages, TipLookupSummary& out) const;
     /// Mounts go through the point find_best() returned: advances its LINE's last_use to now (a mount of
     /// either point of a pair refreshes the entry AND both points' own last_use, so the pair evicts coherently
     /// and S2 rows stay fresh). False for null or foreign pointers (never fabricates freshness).
