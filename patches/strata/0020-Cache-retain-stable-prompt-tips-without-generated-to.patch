+bool standalone_fallback_eligible(const SavedItem& prompt, const std::vector<int32_t>& live_ids,
+                                  const std::vector<ImgKey>& live_imgs, bool live_cvec,
+                                  const SnapshotGeom& live_geom, int live_n_stages,
+                                  int64_t cur_mtp_valid_from, const StandaloneMode& mode,
+                                  std::string& why) {
+    // Mode gates first (each maps to one production post-DONE condition).
+    if (!mode.supported_kv) { why = "kv-unsupported"; return false; }
+    if (!mode.non_aux) { why = "aux"; return false; }
+    if (!mode.tip_budget_on) { why = "tip-budget-off"; return false; }
+    if (!mode.no_stop) { why = "stop"; return false; }
+    if (!mode.no_cancel) { why = "cancelled"; return false; }
+    if (!mode.boundary_ok) { why = "boundary"; return false; }
+    if (!mode.mtp_ok) { why = "mtp"; return false; }
+    if (!mode.copies_clean) { why = "prior-copy-error"; return false; }
+    const int64_t k = (int64_t) prompt.ids.size();
+    // Division-first shape gate before any product, division, or size math below
+    // (including boundary.complete()'s signed row product).
+    if (!standalone_shape_ok(prompt.geom, k, prompt.boundary.hc, prompt.boundary.n_embd,
+                              prompt.boundary.row.size(), why))
+        return false;
+    if ((int64_t) live_ids.size() < k) { why = "prefix"; return false; }
+    // A negative current window bound, or one beyond the available pair count
+    // (live holds live.size() tokens, so pair rows stop at live.size()-1), is rejected.
+    if (cur_mtp_valid_from < 0 || cur_mtp_valid_from > (int64_t) live_ids.size() - 1) {
+        why = "mtp-window";
+        return false;
+    }
+    if (!is_prefix(prompt.ids, live_ids)) { why = "prefix"; return false; }
+    if (prompt.cvec != live_cvec) { why = "cvec"; return false; }
+    if (!tip_imgs_match(live_imgs, k, prompt.imgs)) { why = "images"; return false; }
+    if (prompt.geom != live_geom) { why = "geometry"; return false; }
+    if (prompt.n_stages != live_n_stages || (int) prompt.stages.size() != live_n_stages ||
+        live_n_stages < 1) {
+        why = "stages";
+        return false;
+    }
+    if (!prompt.boundary.complete()) { why = "row"; return false; }
+    const int64_t prow = k / prompt.geom.idx_block + 1;   // pooled rows covering [0, k)
+    for (const StagePayload& s : prompt.stages) {
+        if (s.rec.gdn.empty() || s.rec.tails.empty()) { why = "recurrent"; return false; }
+        if (!s.kv.empty()) { why = "duplicate-kv"; return false; }   // fresh prompt shares; never relabel
+        if ((int64_t) s.idx.size() != prompt.geom.n_qsa_layers) { why = "stages"; return false; }
+        if (s.rec.ple_prev[0] != (k >= 2 ? prompt.ids[(size_t) (k - 2)] : -1) ||
+            s.rec.ple_prev[1] != prompt.ids[(size_t) (k - 1)]) {
+            why = "ple-prev";
+            return false;
+        }
+        for (const IndexerPayload& x : s.idx) {
+            if (x.pooled_rows != prow) { why = "indexer-rows"; return false; }
+            if ((int64_t) x.pooled.size() != prow * prompt.geom.idx_dim * 4) {
+                why = "indexer-size";
+                return false;
+            }
+            if ((int64_t) x.dead_key.size() != prompt.geom.idx_dim * 4) {
+                why = "indexer-dead";
+                return false;
+            }
+            if (x.block_pos.size() != 1) { why = "indexer-cursor"; return false; }
+        }
+    }
+    // Exact MTP metadata for [0, k-1). k == 1 holds no pair (no coverage to check).
+    if (k == 1) {
+        if (!prompt.mtp.kv.empty() || prompt.mtp.cells != 0) { why = "mtp-pairs"; return false; }
+        return true;
+    }
+    if (!prompt.mtp.kv.empty()) { why = "duplicate-mtp"; return false; }   // filled at materialize, not before
+    if (prompt.mtp.cells != k - 1) { why = "mtp-pairs"; return false; }
+    if (prompt.mtp.valid_from < 0 || prompt.mtp.valid_from > prompt.mtp.cells) {
+        why = "mtp-valid-from";
+        return false;
+    }
+    if (cur_mtp_valid_from > prompt.mtp.valid_from) { why = "mtp-window"; return false; }
+    return true;
+}
+
+bool complete_standalone_prompt(SavedItem& prompt, StandaloneKvBacking backing, std::string& why) {
+    const int64_t k = (int64_t) prompt.ids.size();
+    // Division-first shape gate before any product, division, or size math below.
+    if (!standalone_shape_ok(prompt.geom, k, prompt.boundary.hc, prompt.boundary.n_embd,
+                              prompt.boundary.row.size(), why))
+        return false;
+    if (prompt.geom.n_qsa_layers < 1) { why = "geometry"; return false; }
+    const int n_stages = prompt.n_stages;
+    if (n_stages < 1 || (int) prompt.stages.size() != n_stages ||
+        (int) backing.stages_kv.size() != n_stages) {
+        why = "stages";
+        return false;
+    }
+    // Fresh prompt carries no KV of its own: a non-empty store means this is not
+    // the prefill-boundary capture (never overwrite generation state as k).
+    for (const StagePayload& s : prompt.stages)
+        if (!s.kv.empty()) { why = "duplicate-kv"; return false; }
+    if (!prompt.mtp.kv.empty()) { why = "duplicate-mtp"; return false; }
+    // The PLE window must be the boundary ids' last two (mirrors the pair gate).
+    for (const StagePayload& s : prompt.stages)
+        if (s.rec.ple_prev[0] != (k >= 2 ? prompt.ids[(size_t) (k - 2)] : -1) ||
+            s.rec.ple_prev[1] != prompt.ids[(size_t) (k - 1)]) {
+            why = "ple-prev";
+            return false;
+        }
+    // Validate every bounded copy BEFORE any move: the prompt is untouched on false.
+    for (int s = 0; s < n_stages; ++s) {
+        if ((int64_t) backing.stages_kv[(size_t) s].size() != prompt.geom.n_qsa_layers) {
+            why = "stages";
+            return false;
+        }
+        for (const KvLayerPayload& e : backing.stages_kv[(size_t) s])
+            if (!kv_blob_ok(e, k, prompt.geom)) { why = "kv-size"; return false; }
+    }
+    if (k == 1) {
+        if (backing.has_mtp) { why = "mtp-pairs"; return false; }
+    } else {
+        if (!backing.has_mtp) { why = "mtp-missing"; return false; }
+        if (!kv_blob_ok(backing.mtp_kv, k - 1, prompt.geom)) { why = "mtp-size"; return false; }
+        if (backing.mtp_kv.fmt != backing.stages_kv[0][0].fmt) { why = "mtp-format"; return false; }
+    }
+    // Transactional commit: attach to a temporary copy (one extra prompt-bulk transient,
+    // fallback-rare only), validate the copy fully, and move back only when complete.
+    // A complete() failure or a copy throw below leaves the prompt's original
+    // recurrent/indexer/R/metadata untouched.
+    SavedItem assembled = prompt;   // may throw: prompt untouched (only the copy allocates)
+    for (int s = 0; s < n_stages; ++s)
+        assembled.stages[(size_t) s].kv = std::move(backing.stages_kv[(size_t) s]);
+    if (k > 1) assembled.mtp.kv.push_back(std::move(backing.mtp_kv));
+    if (!assembled.complete()) { why = "assembled-incomplete"; return false; }
+    prompt = std::move(assembled);   // move-assign moves pointers only: no allocation
+    return true;
+}
