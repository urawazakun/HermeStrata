+// Division-first shape gate shared by both standalone entry points: validates every
+// scalar BEFORE any product or division below, so later size math cannot divide by zero,
+// overflow (signed or unsigned), or exceed the boundary-row allocation cap. Bounds reuse
+// the existing root/checkpoint limits consistently - never multiply before bounding.
+bool standalone_shape_ok(const SnapshotGeom& gm, int64_t k, int64_t hc, int64_t n_embd,
+                         size_t row_cells, std::string& why) {
+    if (gm.n_qsa_layers < 1 || gm.n_qsa_layers > kMaxRootLayers ||
+        gm.n_head_kv < 1 || gm.n_head_kv > kMaxRootHeads ||
+        gm.head_dim < 1 || gm.head_dim > kMaxRootDim ||
+        gm.idx_dim < 1 || gm.idx_dim > kMaxRootDim ||
+        gm.idx_block < 1 || gm.idx_block > kMaxRootBlock ||
+        gm.page_size < 1 || gm.page_size > kMaxRootBlock) {
+        why = "geometry";
+        return false;
+    }
+    if (k < 1 || k > (int64_t) kMaxRootIds) { why = "length"; return false; }
+    if (hc <= 0 || n_embd <= 0) { why = "row-shape"; return false; }
+    // Division FIRST: bound before multiplying (a product computed first could wrap to a
+    // small value and pass - the same wrap-to-small rule as the checkpoint row helpers).
+    if ((uint64_t) hc > strata::core::kCheckpointRowCapCells / (uint64_t) n_embd) {
+        why = "row-shape";
+        return false;
+    }
+    if ((uint64_t) hc * (uint64_t) n_embd != (uint64_t) row_cells) {
+        why = "row-shape";
+        return false;
+    }
+    return true;
+}
+
+// Common-prefix length of two id vectors (lengths only, no allocation).
+int64_t tip_lcp_len(const std::vector<int32_t>& a, const std::vector<int32_t>& b) {
+    const size_t m = a.size() < b.size() ? a.size() : b.size();
+    int64_t l = 0;
+    for (size_t i = 0; i < m; ++i) {
+        if (a[i] != b[i]) break;
+        ++l;
+    }
+    return l;
+}
+
+// Request images below k equal the point images, without allocating the filtered list
+// (equivalent to imgs_below(req, k) == pt, order-preserving).
+bool tip_imgs_match(const std::vector<ImgKey>& req, int64_t k, const std::vector<ImgKey>& pt) {
+    size_t j = 0;
+    for (size_t i = 0; i < req.size(); ++i) {
+        if (req[i].start >= k) continue;
+        if (j >= pt.size() || req[i].start != pt[j].start || req[i].hash != pt[j].hash)
+            return false;
+        ++j;
+    }
+    return j == pt.size();
+}
