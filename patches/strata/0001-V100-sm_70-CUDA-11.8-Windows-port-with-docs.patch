+"""tests/test_setup_arch.py - setup.py arch selection, CPU-only (no GPU, installs, or network).
+
+    python tests/test_setup_arch.py     (or: python -m unittest discover -s tests -p "test_setup_arch.py")
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_setup():
+    spec = importlib.util.spec_from_file_location("strata_setup", ROOT / "setup.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+setup = load_setup()
+
+
+def g(arch, archs=None):
+    d = {"index": 0, "name": "t", "vram_gb": 16.0, "arch": arch, "driver": "550.00"}
+    if archs is not None:
+        d["archs"] = archs
+    return d
+
+
+class ArchSelect(unittest.TestCase):
+    def test_cu11_only_sm70(self):
+        self.assertTrue(setup.needs_cu11(g("70")))
+        for a in ("0", "72", "75", "80", "86", "120"):
+            self.assertFalse(setup.needs_cu11(g(a)), a)
+        self.assertFalse(setup.needs_cu11({}))
+        self.assertTrue(setup.needs_cu11(g("80", ["70", "80"])))
+        self.assertFalse(setup.needs_cu11(g("80", ["75", "80"])))
+
+    def test_need_cuda_single(self):
+        self.assertEqual(setup.need_cuda(g("70")), (11, 8))
+        self.assertEqual(setup.need_cuda(g("75")), (12, 0))
+        self.assertEqual(setup.need_cuda(g("80")), (12, 0))
+        self.assertEqual(setup.need_cuda(g("120")), (13, 0))
+
+    def test_need_cuda_mixed(self):
+        self.assertEqual(setup.need_cuda(g("70", ["70", "80"])), (11, 8))
+        self.assertEqual(setup.need_cuda(g("75", ["75", "120"])), (13, 0))
+        self.assertEqual(setup.need_cuda(g("75", ["75", "80"])), (12, 0))
+
+    def test_need_cuda_incompatible_mix_fails(self):
+        for archs in (["70", "120"], ["70", "100"], ["70", "90", "120"]):
+            with self.assertRaises(SystemExit, msg=str(archs)):
+                setup.need_cuda(g("70", archs))
+
+    def test_wheels_driver_variant(self):
+        self.assertEqual(setup.cuda_wheels(g("70")), setup.CUDA_WHEELS_CU11)
+        self.assertEqual(setup.cuda_wheels(g("75")), setup.CUDA_WHEELS)
+        self.assertEqual(setup.cuda_wheels(g("80", ["70", "80"])), setup.CUDA_WHEELS_CU11)
+        self.assertEqual(setup.min_driver(g("70")), setup.MIN_DRIVER_CU11)
+        self.assertEqual(setup.min_driver(g("75")), setup.MIN_DRIVER)
+        self.assertEqual(setup.cuda_variant(g("70")), "cu11")
+        self.assertEqual(setup.cuda_variant(g("75")), "cu13")
+        self.assertEqual(setup.cuda_variant(g("120")), "cu13")
+
+
+if __name__ == "__main__":
+    unittest.main()
