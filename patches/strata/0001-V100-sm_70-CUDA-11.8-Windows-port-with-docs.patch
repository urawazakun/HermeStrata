+// The current device's major compute capability, cached per device (a layer split runs on several).
+// The tensor-core / Ampere-tuned kernels refuse an older card at run time so the portable kernel runs.
+bool sm80_or_newer() {
+    static int cc_major[64] = {};
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64) { cudaGetLastError(); return false; }
+    if (cc_major[dev] == 0) {
+        int major = 0;
+        if (cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev) != cudaSuccess) {
+            cudaGetLastError();
+            return false;
+        }
+        cc_major[dev] = major;
+    }
+    return cc_major[dev] >= 8;
+}
