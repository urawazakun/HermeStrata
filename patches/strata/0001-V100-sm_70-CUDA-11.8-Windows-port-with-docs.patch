+def gpu_archs(gpu) -> list:
+    """Every compute arch (as int, e.g. 70) this install targets: the layer-split cards when known, else the one card."""
+    try:
+        return [int(x) for x in gpu.get("archs", [gpu["arch"]])]
+    except (KeyError, TypeError, ValueError):
+        return []
+
+
+def needs_cu11(gpu) -> bool:
+    """True when a targeted card needs the Volta/CUDA 11.8 path (sm_70: nvcc 11.8 is the last one emitting it).
+    sm_75+ keeps upstream's CUDA 13 prebuilt and toolkit ladder (v0.1.27+)."""
+    return any(a == 70 for a in gpu_archs(gpu))
+
+
+def cuda_wheels(gpu):
+    """The pip CUDA libraries matching this GPU's engine: cu11 for a sm_70 local build, upstream's cu13 otherwise
+    (a ready-made engine is accepted only for a compatible arch, so the GPU selects correctly for both)."""
+    return CUDA_WHEELS_CU11 if needs_cu11(gpu) else CUDA_WHEELS
+
+
+def min_driver(gpu):
+    """The oldest NVIDIA driver this GPU's engine runs on."""
+    return MIN_DRIVER_CU11 if needs_cu11(gpu) else MIN_DRIVER
+
+
+def need_cuda(gpu):
+    """The minimum CUDA toolkit compiling for EVERY targeted card: 11.8 when a Volta (sm_70) card is among them,
+    upstream's ladder otherwise (13.0 for RTX 50 - #220, 12.0 for the rest).  Stops when no single toolkit covers
+    the mix (sm_70 with sm_100+: nvcc 11.8 emits nothing newer than sm_90)."""
+    archs = gpu_archs(gpu)
+    if not archs:
+        return (12, 0)
+    if needs_cu11(gpu) and max(archs) > 90:
+        fail(f"these GPUs need different CUDA toolkits (sm_{min(archs)} needs CUDA 11.8, sm_{max(archs)} needs "
+             "CUDA 12 or newer): the engine is compiled once for every card sharing the model",
+             "run one card at a time instead (START-HERE.bat --gpu N picks the card)")
+    if needs_cu11(gpu):
+        return (11, 8)
+    return (13, 0) if max(archs) >= 120 else (12, 0)
+
+
+def cuda_variant(gpu):
+    """'cu11' for a sm_70 local build, 'cu13' otherwise: which library set to look for on disk."""
+    return "cu11" if needs_cu11(gpu) else "cu13"
