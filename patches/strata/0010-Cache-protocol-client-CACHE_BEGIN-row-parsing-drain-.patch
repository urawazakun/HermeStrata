+        self.assertEqual(stdin.written, ["CACHE INVENTORY\n"] * 2)
+
+    def test_malformed_is_drained(self):
+        client, _stdin, _proc = make_client(
+            ["CACHE_BEGIN budget=1 used=0 roots=0 tips=0 disk=0 disk_enabled=0",
+             "CACHE memory kind=tip pinned=0 ids_len=1 bytes=1",   # no last_use
+             "CACHE_END",
+             "CACHE_BEGIN budget=2 used=0 roots=0 tips=0 disk=0 disk_enabled=0", "CACHE_END"])
+        with self.assertRaises(ValueError):
+            client.rpc("INVENTORY", timeout=5)
+        self.assertEqual(client.rpc("INVENTORY", timeout=5)["memory"]["tip_budget_bytes"], 2)
+
+    def test_count_mismatch_never_drains_next_reply(self):
+        """CACHE_END is already consumed when counts are checked: the failure must not eat the next reply."""
+        client, stdin, _ = make_client(
+            ["CACHE_BEGIN budget=100 used=50 roots=0 tips=1 disk=0 disk_enabled=0",
+             "CACHE_END",                       # claims a tip that never arrives
+             "CACHE_BEGIN budget=100 used=0 roots=0 tips=0 disk=0 disk_enabled=0",
+             "CACHE_END"])
+        with self.assertRaises(ValueError):
+            client.rpc("INVENTORY", timeout=5)
+        out = client.rpc("INVENTORY", timeout=5)
+        self.assertEqual(out["memory"]["tip_bytes"], 0)
+        self.assertEqual(stdin.written, ["CACHE INVENTORY\n"] * 2)
+
+    def test_dead_pipe_kills_and_desyncs(self):
+        client, _stdin, proc = make_client([None])
+        with self.assertRaises(EngineDied):
+            client.rpc("INVENTORY", timeout=5)
+        self.assertTrue(client.desynced)
+        self.assertEqual(proc.kills, 1)
+        with self.assertRaises(EngineDied):       # never reused without touching the pipe
+            client.rpc("INVENTORY", timeout=5)
+
+    def test_timeout_without_boundary_desyncs(self):
+        """No boundary arrives: the pipe is stopped, never reused."""
+        client, stdin, proc = make_client([], timeout=0.2, drain_timeout=0.2)
+        with self.assertRaises(TimeoutError):
+            client.rpc("INVENTORY")
+        self.assertTrue(client.desynced)
+        self.assertEqual(proc.kills, 1)           # the engine was stopped for a clean restart
+        with self.assertRaises(EngineDied):
+            client.rpc("INVENTORY", timeout=5)
+        self.assertEqual(stdin.written, ["CACHE INVENTORY\n"])   # the dead pipe was never reused
+
+    def test_timeout_late_reply_is_discarded_not_trusted(self):
+        """The late reply arrives inside the drain: discarded, TimeoutError stands, the next exchange reads
+        only fresh lines (stale budget=111 never surfaces)."""
+        client, stdin, _ = make_client(
+            ["CACHE_BEGIN budget=111 used=0 roots=0 tips=0 disk=0 disk_enabled=0", "CACHE_END"])
+        with self.assertRaises(TimeoutError):
