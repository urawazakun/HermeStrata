+    def test_error_response_exact(self):
+        """The mapping inside the client: exact status/body per failure kind."""
+        self.assertEqual(CacheProtocolClient.error_response(
+            EngineDied("the engine stopped unexpectedly (exit code -9)")),
+            (503, {"error": {"type": "server_error", "message":
+                             "the engine stopped unexpectedly (exit code -9); the next request restarts it"}}))
+        self.assertEqual(CacheProtocolClient.error_response(
+            NotImplementedError("this engine does not support /v1/cache")),
+            (501, {"error": {"type": "unsupported",
+                             "message": "this engine does not support /v1/cache"}}))
+        self.assertEqual(CacheProtocolClient.error_response(
