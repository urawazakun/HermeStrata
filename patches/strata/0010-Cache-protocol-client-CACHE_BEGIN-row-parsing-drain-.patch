+"""serve/test_cache_protocol.py - STEP 5 (BRIEF CELL-C) focused tests for serve/cache_protocol.py.
+
+Covers the extracted CacheProtocolClient (CACHE_BEGIN / row parsing / drain / timeout / desync kill),
+StrataEngine's delegation (process management stays there: kill, ended, desync mirror, rebind on
+restart), the serve.server re-exports existing mocks/tests import, and the HTTP mapping (503/501).
+
+    python -m unittest serve.test_cache_protocol -v
+"""
+from __future__ import annotations
+
+import json
+import queue
+import sys
+import unittest
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from serve.cache_protocol import (CACHE_DRAIN_S, CACHE_MAX_ITEMS, CACHE_TIMEOUT_S, CacheProtocolClient,  # noqa: E402
+                                  EngineDied, format_cache_command, parse_cache_begin, parse_cache_item,
+                                  validate_cache_inventory)
+from serve.server import ByteTokenizer, MockEngine, Service, StrataEngine, serve  # noqa: E402
+from serve.frontend import ChatTemplate  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+CTX = 4096
+
+
+class Stdin:
+    def __init__(self):
+        self.written = []
+
+    def write(self, s):
+        self.written.append(s)
+
+    def flush(self):
+        pass
+
+
+class Proc:
+    def __init__(self, stdin):
+        self.stdin = stdin
+        self.kills = 0
+
+    def kill(self):
+        self.kills += 1
+
+    def poll(self):
+        return None if self.kills == 0 else -9
+
+    def wait(self, timeout=None):
+        return -9
+
+
+def make_client(lines, **kw):
+    """A CacheProtocolClient over a fake pipe preloaded with `lines` (None = engine death)."""
+    kw.setdefault("exit_code", lambda: -9)
+    stdin = Stdin()
+    proc = Proc(stdin)
+    q: queue.Queue = queue.Queue()
+    for ln in lines:
+        q.put(ln)
+    return CacheProtocolClient(proc, q, **kw), stdin, proc
+
+
+INV = ["CACHE_BEGIN budget=100 used=20 roots=1 tips=1 disk=1 disk_enabled=1",
+       "CACHE memory kind=root pinned=1 ids_len=40 bytes=10 last_use=7",
+       "CACHE memory kind=tip pinned=0 ids_len=60 bytes=20 last_use=9",
+       "CACHE disk kind=root pinned=1 ids_len=40 bytes=300",
+       "CACHE_END"]
+
+
+class CacheClientPipe(unittest.TestCase):
+    """The protocol client against a fake pipe: grammar, drain, timeout, desync kill."""
+
+    def test_inventory_ok(self):
+        client, stdin, _ = make_client(list(INV))
+        out = client.rpc("INVENTORY", timeout=5)
+        self.assertEqual(stdin.written, ["CACHE INVENTORY\n"])
+        self.assertEqual(out["memory"]["tip_budget_bytes"], 100)
+        self.assertEqual(out["memory"]["tip_bytes"], 20)
+        self.assertEqual([i["kind"] for i in out["memory"]["items"]], ["root", "tip"])
+        self.assertEqual(out["disk"], {"enabled": True, "items": [
+            {"kind": "root", "pinned": True, "ids_len": 40, "bytes": 300}]})
+        self.assertNotIn("dropped", out)
+
+    def test_drop_ok(self):
+        client, stdin, _ = make_client(
+            ["CACHE_BEGIN dropped=2 budget=100 used=0 roots=1 tips=0 disk=0 disk_enabled=0",
+             "CACHE memory kind=root pinned=1 ids_len=40 bytes=10 last_use=7",
+             "CACHE_END"])
+        out = client.rpc("DROP", timeout=5)
+        self.assertEqual(stdin.written, ["CACHE DROP\n"])
+        self.assertEqual(out["dropped"], 2)
+        self.assertEqual(len(out["memory"]["items"]), 1)
+
+    def test_stray_is_rejected_not_absorbed(self):
+        """A GEN-protocol stray (or a pre-BEGIN item) fails the exchange; the drain consumes the bounded
+        reply and the next exchange starts clean."""
+        client, stdin, _ = make_client(
+            ["T 5",
+             "CACHE_BEGIN budget=0 used=0 roots=0 tips=0 disk=0 disk_enabled=0",
+             "CACHE_END",
+             "CACHE_BEGIN budget=7 used=0 roots=0 tips=0 disk=0 disk_enabled=0",
+             "CACHE_END"])
+        with self.assertRaises(ValueError):
+            client.rpc("INVENTORY", timeout=5)
+        out = client.rpc("INVENTORY", timeout=5)
+        self.assertEqual(out["memory"]["tip_budget_bytes"], 7)
+        self.assertEqual(stdin.written, ["CACHE INVENTORY\n"] * 2)
+        client2, _, _ = make_client(["CACHE memory kind=tip pinned=0 ids_len=1 bytes=1 last_use=1",
+                                     "CACHE_END"])
+        with self.assertRaises(ValueError):
+            client2.rpc("INVENTORY", timeout=5)
+
+    def test_err_never_drains(self):
+        """The standalone ERR line is the whole response: reported, never drained, pipe stays clean."""
+        client, stdin, _ = make_client(
+            ["ERR boom",
+             "CACHE_BEGIN budget=1 used=0 roots=0 tips=0 disk=0 disk_enabled=0",
+             "CACHE_END"])
+        with self.assertRaises(ValueError) as ctx:
+            client.rpc("INVENTORY", timeout=5)
+        self.assertIn("boom", str(ctx.exception))
+        out = client.rpc("INVENTORY", timeout=5)   # the second reply is intact: no drain ate it
