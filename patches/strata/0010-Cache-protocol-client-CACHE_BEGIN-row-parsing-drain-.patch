+"""serve/cache_protocol.py - STEP 5 (BRIEF CELL-C): the engine's S2 cache pipe protocol, extracted from
+StrataEngine behaviour-preserving (same wire protocol, same errors, same HTTP mapping).
+
+The server writes one line (`CACHE INVENTORY` or `CACHE DROP`) and reads `CACHE_BEGIN ...` item lines
+(`CACHE memory|disk ...`) up to `CACHE_END` (`ERR ...` on engine failure). Parsing is strict (exact field
+sets, bounded counts, post-CACHE_END count/byte validation); a failure reuses the pipe ONLY after consuming
+CACHE_END or the standalone ERR line, else the engine is stopped for a clean restart (a late ERR must never
+reach a future GEN). Engines without a cache pipe are 501, never a fabricated success. All deadlines use the
+monotonic clock.
+
+Ownership split: `CacheProtocolClient` owns only the protocol (op gate, stdin write, CACHE_BEGIN / row
+parsing, drain, timeout/deadline, desync kill). `StrataEngine` (serve/server.py) keeps process management
+(spawn, restart, unload, `ended`) and delegates to a client bound to its current proc/lines. The HTTP layer
+(GET/DELETE /v1/cache) is unchanged: EngineDied/TimeoutError/ValueError -> 503, NotImplementedError -> 501.
+"""
+from __future__ import annotations
+
+import queue
+import time
+
+
+class EngineDied(RuntimeError):
+    """The engine process ended in the middle of a request (issue #27: on Linux, the out-of-memory killer)."""
+
+
+# ------------------------------------------------------------------------------------------------ S2 cache control
+# (tunables live here; serve/server.py re-exports them, and StrataEngine passes its module's current values
+# into the client on every exchange, so patching serve.server.CACHE_DRAIN_S in tests keeps working.)
+CACHE_TIMEOUT_S = 30.0            # one cache exchange may wait this long (post-DONE capture runs first)
+CACHE_DRAIN_S = 5.0               # after a malformed reply, how long to discard until CACHE_END
+CACHE_MAX_ITEMS = 100000          # bound on inventory lines per exchange
+
+
+def format_cache_command(op: str) -> str:
+    """The stdin line for a cache exchange: `CACHE INVENTORY` or `CACHE DROP` (ValueError otherwise)."""
+    if op not in ("INVENTORY", "DROP"):
+        raise ValueError(f"unknown cache op {op!r}")
+    return f"CACHE {op}\n"
+
+
+def _cache_int(fields: dict, key: str) -> int:
+    try:
+        v = int(fields[key])
+    except (KeyError, TypeError, ValueError):
+        raise ValueError(f"bad cache field {key!r}") from None
+    if v < 0:
+        raise ValueError(f"bad cache field {key!r}")
+    return v
+
+
+def _cache_fields(parts: list, allowed: set, what: str) -> dict:
+    """Split `k=v` tokens strictly: no duplicates, no unknown fields, no bare tokens."""
+    fields = {}
+    for tok in parts:
+        k, sep, v = tok.partition("=")
+        if not sep or not k or not v:
+            raise ValueError(f"bad cache field {tok!r} in {what}")
+        if k in fields:
+            raise ValueError(f"duplicate cache field {k!r} in {what}")
+        if k not in allowed:
+            raise ValueError(f"unknown cache field {k!r} in {what}")
+        fields[k] = v
+    return fields
+
+
+# Every count the engine reports is bounded: roots are a handful, tips fit the byte budget, disk fits the cap.
+_CACHE_BEGIN_INVENTORY = {"budget", "used", "roots", "tips", "disk", "disk_enabled"}
+_CACHE_BEGIN_DROP = _CACHE_BEGIN_INVENTORY | {"dropped"}
+_CACHE_ITEM_MEMORY = {"kind", "pinned", "ids_len", "bytes", "last_use"}
+_CACHE_ITEM_DISK = {"kind", "pinned", "ids_len", "bytes"}
+
+
+def parse_cache_begin(line: str, expect_dropped: bool) -> dict:
+    """`CACHE_BEGIN ...` -> {"dropped"?, "tip_budget_bytes", "tip_bytes", "roots", "tips", "disk", "disk_enabled"}.
+
+    Strict: exact field set (dropped only for DROP), every count within CACHE_MAX_ITEMS."""
+    parts = line.split()
+    if not parts or parts[0] != "CACHE_BEGIN":
+        raise ValueError("not a CACHE_BEGIN line")
+    fields = _cache_fields(parts[1:], _CACHE_BEGIN_DROP if expect_dropped else _CACHE_BEGIN_INVENTORY,
+                           "CACHE_BEGIN")
+    out = {}
+    if expect_dropped:
+        out["dropped"] = _cache_int(fields, "dropped")
+    out["tip_budget_bytes"] = _cache_int(fields, "budget")
+    out["tip_bytes"] = _cache_int(fields, "used")
+    out["roots"] = _cache_int(fields, "roots")
+    out["tips"] = _cache_int(fields, "tips")
+    out["disk"] = _cache_int(fields, "disk")
+    if out["roots"] > CACHE_MAX_ITEMS or out["tips"] > CACHE_MAX_ITEMS or out["disk"] > CACHE_MAX_ITEMS:
+        raise ValueError("cache counts out of range")
+    if "disk_enabled" not in fields or fields["disk_enabled"] not in ("0", "1"):
+        raise ValueError("bad cache field 'disk_enabled'")
+    out["disk_enabled"] = fields["disk_enabled"] == "1"
+    for key in ("budget", "used", "roots", "tips", "disk", "dropped"):
+        if key in fields and fields[key] != str(_cache_int(fields, key)):
+            raise ValueError(f"bad cache field {key!r}")
+    return out
+
+
+def parse_cache_item(line: str) -> dict:
+    """`CACHE memory|disk kind=... ...` -> {"source", "kind", "pinned", "ids_len", "bytes", "last_use"?}.
+
+    Strict: exact field set per source (memory rows carry last_use, disk rows never do)."""
+    parts = line.split()
+    if len(parts) < 3 or parts[0] != "CACHE" or parts[1] not in ("memory", "disk"):
+        raise ValueError("not a CACHE item line")
+    source = parts[1]
+    fields = _cache_fields(parts[2:], _CACHE_ITEM_MEMORY if source == "memory" else _CACHE_ITEM_DISK,
+                           "CACHE item")
+    if fields.get("kind") not in ("root", "tip"):
+        raise ValueError("bad cache kind")
+    if source == "disk" and fields["kind"] != "root":
+        raise ValueError("disk holds pinned roots only")
+    pinned = _cache_int(fields, "pinned")
+    if pinned not in (0, 1):
+        raise ValueError("bad cache pinned flag")
+    if bool(pinned) != (fields["kind"] == "root"):
+        raise ValueError("only roots are pinned")
+    out = {"source": source, "kind": fields["kind"], "pinned": bool(pinned),
+           "ids_len": _cache_int(fields, "ids_len"), "bytes": _cache_int(fields, "bytes")}
+    if source == "memory":
+        out["last_use"] = _cache_int(fields, "last_use")
+    return out
+
+
+def validate_cache_inventory(begin: dict, memory: list, disk_items: list) -> None:
+    """Cross-check a complete exchange: row counts match CACHE_BEGIN, tip bytes sum to `used`, and the
+    budget covers them. Raises ValueError on any truncation or mismatch (called after CACHE_END, so the
+    caller must NOT drain on failure: the next reply is already on the wire)."""
+    roots = sum(1 for i in memory if i["kind"] == "root")
+    tips = sum(1 for i in memory if i["kind"] == "tip")
+    if roots != begin["roots"] or tips != begin["tips"] or len(disk_items) != begin["disk"]:
+        raise ValueError(f"cache row counts do not match CACHE_BEGIN "
+                         f"(roots {roots}/{begin['roots']}, tips {tips}/{begin['tips']}, "
+                         f"disk {len(disk_items)}/{begin['disk']})")
+    tip_bytes = sum(i["bytes"] for i in memory if i["kind"] == "tip")
+    if tip_bytes != begin["tip_bytes"]:
+        raise ValueError(f"cache tip bytes {tip_bytes} do not match CACHE_BEGIN used {begin['tip_bytes']}")
+    if begin["tip_bytes"] > begin["tip_budget_bytes"]:
+        raise ValueError("cache tip bytes exceed the budget")
+
+
+class CacheProtocolClient:
+    """One side of the S2 cache exchange over an engine pipe: `proc` (stdin write, kill) plus the shared
+    stdout `lines` queue and an `exit_code` callable for death messages.
+
+    Lifecycle (`ended`, restart, unload) stays with StrataEngine: `invalidate()` only marks this pipe
+    desynchronized and stops the process, never a usable pipe again. A client is bound to one process and
+    queue; after a restart the engine binds a fresh one (a late reply from the old process can never be
+    trusted as a fresh answer). Raises EngineDied (dead pipe or a desynchronized one), TimeoutError (no
+    CACHE_END in time) or ValueError (the engine's ERR line, or a strict parse/count rejection) - the HTTP
+    layer maps all three to 503."""
+
+    def __init__(self, proc, lines: "queue.Queue", exit_code=None,
+                 timeout: float = CACHE_TIMEOUT_S, drain_timeout: float = CACHE_DRAIN_S,
+                 max_items: int = CACHE_MAX_ITEMS):
+        self.proc = proc
+        self.lines = lines
+        self._exit_code = exit_code          # StrataEngine.exit_code (bound); None keeps "exit code None"
+        self.timeout = timeout
+        self.drain_timeout = drain_timeout
+        self.max_items = max_items
+        self.desynced = False                # an exchange left the pipe mid-response (see invalidate)
+
+    def _code(self):
+        return self._exit_code() if callable(self._exit_code) else None
+
+    def invalidate(self) -> None:
+        """A cache exchange left the pipe mid-response (no CACHE_END or ERR consumed): a late reply could be
+        trusted as a fresh answer, or leak generation tokens into a later request. Stop the engine instead -
+        the next generation restarts it via the existing alive()/restart() flow, and cache calls fail as
+        EngineDied until then. Never returns a usable pipe."""
+        self.desynced = True
+        try:
+            self.proc.kill()
+        except OSError:
+            pass
+
+    def drain(self, timeout: float | None = None) -> str:
+        """Consume a failed exchange's remainder: "end"/"err" when a response boundary was consumed (the pipe
+        is reusable), "dead" when the engine died mid-drain, "open" when nothing bounded arrived (desync)."""
+        if timeout is None:
+            timeout = self.drain_timeout
+        end = time.monotonic() + timeout
+        for _ in range(self.max_items):
+            try:
+                line = self.lines.get(timeout=max(0.0, end - time.monotonic()))
+            except queue.Empty:
+                return "open"
+            if line is None:
+                return "dead"
+            if line.strip() == "CACHE_END" or line.startswith("ERR"):
+                return "end" if line.strip() == "CACHE_END" else "err"
+        return "open"
+
+    def rpc(self, op: str, timeout: float | None = None) -> dict:
+        """One `CACHE <op>` exchange (the caller holds Service.fifo).
+
+        Returns {"memory": {"tip_budget_bytes", "tip_bytes", "items": [...]}, "disk": {"enabled", "items":
+        [...]}} plus {"dropped": n} for DROP. Raises EngineDied (dead pipe or a desynchronized one, stopped
+        for safety), TimeoutError (no CACHE_END in time) or ValueError (the engine's ERR line, or a strict
+        parse/count rejection). The pipe is reused after a failure ONLY when a response boundary (CACHE_END
+        or the standalone ERR line) was consumed - a late ERR is never left for a future GEN (which would
+        raise on it and orphan its real tokens), and post-CACHE_END count errors never drain (the next reply
+        is already on the wire). Otherwise the engine is stopped for a clean restart. All deadlines use the
+        monotonic clock."""
+        if timeout is None:
+            timeout = self.timeout
+        format_cache_command(op)                          # ValueError on an unknown op, before touching the pipe
+        if self.desynced:
+            raise EngineDied("the cache protocol desynchronized; the engine was stopped for a clean restart")
+        try:
+            self.proc.stdin.write(f"CACHE {op}\n")
+            self.proc.stdin.flush()
+        except OSError:
+            self.invalidate()
+            raise EngineDied(f"the engine stopped unexpectedly (exit code {self._code()})") from None
+        expect_dropped = op == "DROP"
+        begin, memory, disk_items, disk_enabled = None, [], [], False
+        terminal: str | None = None                       # "end" once CACHE_END is consumed, "err" on ERR
+        deadline = time.monotonic() + timeout
+        try:
+            for _ in range(self.max_items + 2):
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError(f"the engine did not answer CACHE {op} in time")
+                try:
+                    line = self.lines.get(timeout=remaining)
+                except queue.Empty:
+                    raise TimeoutError(f"the engine did not answer CACHE {op} in time") from None
+                if line is None:
+                    self.invalidate()
+                    raise EngineDied(f"the engine stopped unexpectedly (exit code {self._code()})")
+                if line.startswith("ERR"):
+                    # A standalone terminal: the whole response. Never drained (nothing follows it) and the
+                    # pipe stays reusable - but never left queued, where a future GEN would raise on it.
+                    terminal = "err"
+                    raise ValueError(line[4:].strip() or "the engine refused the cache command")
+                s = line.strip()
+                if s == "CACHE_END":
+                    terminal = "end"
+                    if begin is None:
+                        raise ValueError("CACHE_END without CACHE_BEGIN")
+                    break
+                if s.startswith("CACHE_BEGIN"):
+                    if begin is not None:
+                        raise ValueError("two CACHE_BEGIN lines")
+                    begin = parse_cache_begin(s, expect_dropped)
+                    disk_enabled = begin.pop("disk_enabled")
+                    continue
+                if s.startswith("CACHE "):
+                    if begin is None:
+                        raise ValueError("CACHE item before CACHE_BEGIN")
+                    item = parse_cache_item(s)
+                    if len(memory) + len(disk_items) >= self.max_items:
+                        raise ValueError("too many cache items")
+                    (memory if item.pop("source") == "memory" else disk_items).append(item)
+                    continue
+                # Anything else on an idle pipe (a GEN-protocol stray, a blank line, garbage) is a protocol
+                # violation, never absorbed: trusting the rest of the reply after it is how stale inventories
+                # and orphaned tokens happen.
+                raise ValueError(f"unexpected engine line during CACHE {op}: {s[:60]!r}")
+            else:
+                raise ValueError("too many cache lines")
+        except TimeoutError:
+            if self.drain() not in ("end", "err"):
+                self.invalidate()
+            raise
+        except ValueError:
+            if terminal is None and self.drain() not in ("end", "err"):
+                self.invalidate()
+            raise
+        if begin is None:                                 # unreachable (CACHE_END requires begin), kept explicit
+            raise ValueError("no CACHE_BEGIN from the engine")
+        # Post-terminal count validation: CACHE_END is already consumed, so no drain here - draining would eat
+        # the NEXT reply. A mismatch still fails the call, but the pipe stays reusable.
+        validate_cache_inventory(begin, memory, disk_items)
+        out = {"memory": {"tip_budget_bytes": begin["tip_budget_bytes"], "tip_bytes": begin["tip_bytes"],
+                          "items": memory},
+               "disk": {"enabled": disk_enabled, "items": disk_items}}
+        return {"dropped": begin["dropped"], **out} if expect_dropped else out
+
+    @staticmethod
+    def error_response(exc: BaseException) -> tuple:
+        """HTTP status/body for a cache failure: EngineDied/TimeoutError/ValueError -> 503,
+        NotImplementedError -> 501. The exact mapping (and strings) the /v1/cache handlers always
+        sent - EngineDied keeps its "; the next request restarts it" suffix."""
+        if isinstance(exc, EngineDied):
+            return 503, {"error": {"type": "server_error",
+                                   "message": f"{exc}; the next request restarts it"}}
+        if isinstance(exc, NotImplementedError):
+            return 501, {"error": {"type": "unsupported", "message": str(exc)}}
+        return 503, {"error": {"type": "server_error", "message": str(exc)}}
