+AUX_WAIT_S = 180.0            # an aux request waits this long at most for the main turn to finish
+AUX_GRACE_S = 1.5             # ... then gives a just-finished main turn this long to take the engine again
+AUX_POLL_S = 0.05             # how often a waiting aux request looks at the status
