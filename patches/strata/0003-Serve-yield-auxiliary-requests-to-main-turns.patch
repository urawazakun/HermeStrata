+    def _yield_to_main_turn(self, cancel, wait=None, grace=None) -> bool:
+        """Hold an aux request until no main request holds or waits for the engine, so it runs after the main turn.
+
+        Reads only status["busy"]/status["queued"] under status_lock (no second busy counter); the FIFO still
+        serializes the actual run.  Waits up to `wait` seconds (AUX_WAIT_S), then a `grace` window (AUX_GRACE_S) in
+        which a just-finished main turn (e.g. its next MCP round) may take the engine again - if it does, waiting
+        resumes.  True when the engine stayed idle through the grace window, False on timeout or cancel."""
+        if wait is None:
+            wait = AUX_WAIT_S
+        if grace is None:
+            grace = AUX_GRACE_S
+        t0, deadline = time.time(), time.time() + wait
+        while True:
+            with self.status_lock:
+                occupied = bool(self.status.get("busy")) or self.status.get("queued", 0) > 0 or self._mcp_turns > 0
+            if not occupied:
+                end = time.time() + grace
+                while True:
+                    if cancel.is_set():
+                        return False
+                    time.sleep(min(AUX_POLL_S, max(0.0, end - time.time())))
+                    with self.status_lock:
+                        occupied = bool(self.status.get("busy")) or self.status.get("queued", 0) > 0 or \
+                            self._mcp_turns > 0
+                    if occupied:
+                        break
+                    if time.time() >= end:
+                        waited = time.time() - t0
+                        if waited >= AUX_POLL_S:
+                            print(f"[strata] aux request waited {waited:.1f} s for the main turn", flush=True)
+                        return True
+            if cancel.is_set() or time.time() >= deadline:
+                return False
+            time.sleep(AUX_POLL_S)
+
