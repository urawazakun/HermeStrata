+def is_aux_request(req: dict, tools) -> bool:
+    """An aux request: no tools, but a response_format (a small structured side request, e.g. a session title).
+
+    Aux runs after the main turn (Service._yield_to_main_turn), without thinking and outside the MCP tool loop."""
+    return not tools and bool(req.get("response_format"))
