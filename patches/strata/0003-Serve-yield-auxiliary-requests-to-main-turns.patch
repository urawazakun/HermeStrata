+class AuxGatedEngine(MockEngine):
+    """Holds the engine until released: a main turn occupying the fifo."""
+
+    def __init__(self, tok, script, max_context, gate):
+        super().__init__(tok, script, max_context=max_context)
+        self.gate, self.entered = gate, threading.Event()
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        self.entered.set()
+        self.gate.wait(30)
+        yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+
+
+class AuxYield(unittest.TestCase):
+    """Aux requests (no tools + response_format): thinking off, wait for the main turn over both APIs."""
+
+    AUX_OPENAI = {"model": "m", "messages": [{"role": "user", "content": "title this chat"}],
+                  "response_format": {"type": "json_object"}, "max_tokens": 20}
+    AUX_ANTHROPIC = {"model": "x", "messages": [{"role": "user", "content": "title this chat"}],
+                     "response_format": {"type": "json_object"}, "max_tokens": 20}
+
+    def setUp(self):
+        tok = ByteTokenizer()
+        self.gate = threading.Event()
+        self.engine = AuxGatedEngine(tok, "</think>\n\nok", max_context=CTX, gate=self.gate)
+        self.svc = Service(self.engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"))
+        self.httpd = serve(self.svc, port=0)
+        self.base = f"http://127.0.0.1:{self.httpd.server_address[1]}"
+
+    def tearDown(self):
+        self.gate.set()
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+    def post(self, path, body):
+        req = urllib.request.Request(self.base + path, data=json.dumps(body).encode(),
+                                     headers={"Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(req, timeout=30) as r:
+                return r.status, json.loads(r.read())
+        except urllib.error.HTTPError as e:
+            with e:
+                return e.code, json.loads(e.read())
+
+    def start_main(self):
+        """A main request (no response_format) on a thread; -> (thread, box) once it holds the engine."""
+        box = {}
+        body = {"model": "m", "messages": [{"role": "user", "content": "write a long story"}], "max_tokens": 20}
+
+        def work():
+            try:
+                box["r"] = self.post("/v1/chat/completions", body)
+            except Exception as e:  # noqa: BLE001 - record thread errors for the main thread to raise
+                box["e"] = e
+
+        t = threading.Thread(target=work, daemon=True)
+        t.start()
+        self.assertTrue(self.engine.entered.wait(30))
+        return t, box
+
+    def run_thread(self, fn):
+        """fn on a thread with its result/exception recorded; -> (thread, box, done event)."""
+        box, done = {}, threading.Event()
+
+        def work():
+            try:
+                box["r"] = fn()
+            except Exception as e:  # noqa: BLE001 - as above
+                box["e"] = e
+            finally:
+                done.set()
+
+        t = threading.Thread(target=work, daemon=True)
+        t.start()
+        return t, box, done
+
+    def test_is_aux_request(self):
+        rf = {"type": "json_object"}
+        self.assertTrue(is_aux_request({"response_format": rf}, None))
+        self.assertFalse(is_aux_request({"response_format": rf}, [{"name": "t"}]))  # tools: a main request
+        self.assertFalse(is_aux_request({}, None))                                   # no format: a main request
+        self.assertFalse(is_aux_request({"response_format": None}, None))
+
+    def aux_case(self, path, aux):
+        t, box = self.start_main()
+        _, out, done = self.run_thread(lambda: self.post(path, aux))
+        try:
+            self.assertFalse(done.wait(1.0))                # still waiting while the main turn holds the fifo
+            self.gate.set()
+            t.join(30)
+            self.assertTrue(done.wait(30), out)
+            self.assertNotIn("e", box, box.get("e"))
+            self.assertNotIn("e", out, out.get("e"))
+            self.assertEqual(box["r"][0], 200, box["r"])
+            self.assertEqual(out["r"][0], 200, out["r"])
+        finally:
+            self.gate.set()
+            t.join(30)
+
+    def test_aux_waits_for_the_main_turn_openai(self):
+        self.aux_case("/v1/chat/completions", dict(self.AUX_OPENAI))
+
+    def test_aux_waits_for_the_main_turn_anthropic(self):
+        self.aux_case("/v1/messages", dict(self.AUX_ANTHROPIC))
+
+    def test_aux_waits_for_a_queued_main_request(self):
+        """An aux arriving while a main request is queued also waits for its turn."""
+        t1, box1 = self.start_main()
+        _, box2, main2_done = self.run_thread(lambda: self.post(
+            "/v1/chat/completions",
+            {"model": "m", "messages": [{"role": "user", "content": "another"}], "max_tokens": 5}))
+        time.sleep(0.5)                                     # let the second main reach status["queued"]
+        _, out, done = self.run_thread(lambda: self.post("/v1/chat/completions", dict(self.AUX_OPENAI)))
+        try:
+            self.assertFalse(done.wait(1.0))
+            self.gate.set()
+            t1.join(30)
+            self.assertTrue(main2_done.wait(30), box2)
+            self.assertTrue(done.wait(30), out)
+            self.assertEqual(box1["r"][0], 200, box1)
+            self.assertEqual(box2["r"][0], 200, box2)
+            self.assertEqual(out["r"][0], 200, out["r"])
+        finally:
+            self.gate.set()
+            t1.join(30)
+
