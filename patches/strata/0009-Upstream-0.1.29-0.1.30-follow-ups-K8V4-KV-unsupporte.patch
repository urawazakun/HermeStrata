+/// Expected recurrent sizes for one stage under the 030 carve-aware checkpoint contract: gdn for this
+/// session's carve, per-layer tails/dead/cursors times the stage's owned QSA layers, ple exactly when
+/// the live session holds PLE history. Pure so CPU tests cover the exact predicate the restore path
+/// enforces BEFORE any GPU mutation (a 029-shaped payload without dead/block_pos can never pass again).
+struct RecExpect {
+    size_t gdn = 0, tails = 0, dead = 0, block_pos = 0, ple = 0;
+    bool ple_present = false;
+};
+inline bool rec_sizes_ok(const RecurrentPayload& r, const RecExpect& e) {
+    if (r.gdn.size() != e.gdn || r.tails.size() != e.tails || r.dead.size() != e.dead ||
+        r.block_pos.size() != e.block_pos)
+        return false;
+    return e.ple_present ? r.ple.size() == e.ple : r.ple.empty();
+}
