+        const size_t mcode = (size_t)saved::kv_pool_bytes(saved::kKvF16, 8, 2, 8, 4, false);
+        mkv.k.assign(mcode, 5);
+        mkv.v.assign(mcode, 6);
+        it.mtp.kv.push_back(std::move(mkv));
+        it.boundary.hc = 1;
+        it.boundary.n_embd = 4;
+        it.boundary.row.assign(4, 0.5f);
+        saved::RootDiskHeader h;
+        std::vector<uint8_t> buf;
+        std::string why;
+        check(saved::root_encode(h, it, buf, why), "layout scan fixture encodes");
+        // Forge the v2 schema tag (LE u32 at bytes 4..7): the scan must refuse it at the version
+        // gate, before any bulk byte is read - the trailing checksum is irrelevant to the scan.
+        // A valid v3 control file proves the store scans this directory at all.
+        buf[4] = 2;
+        buf[5] = 0;
+        buf[6] = 0;
+        buf[7] = 0;
+        auto write_file = [&](const std::string& name, const std::vector<uint8_t>& data) {
+            std::ofstream out(dir + "/" + name, std::ios::binary);
+            if (!out) return false;
+            out.write(reinterpret_cast<const char*>(data.data()), (std::streamsize)data.size());
+            return static_cast<bool>(out);
+        };
+        std::vector<uint8_t> good;
+        check(saved::root_encode(h, it, good, why), "layout scan control encodes");
+        // The store only indexes files named by their content key; the v2 forgery gets distinct
+        // ids so both files have valid distinct names (same key would dedup by mtime instead).
+        saved::SavedItem it2 = it;
+        std::fill(it2.ids.begin(), it2.ids.end(), 6);
+        std::vector<uint8_t> buf2;
+        check(saved::root_encode(h, it2, buf2, why), "layout scan v2 source encodes");
+        buf = std::move(buf2);
+        buf[4] = 2;
+        buf[5] = 0;
+        buf[6] = 0;
+        buf[7] = 0;
+        const std::string key3 = saved::root_file_key(h, it);
+        const std::string key2 = saved::root_file_key(h, it2);
+        check(key3.size() == 16 && key2.size() == 16 && key3 != key2, "layout scan keys distinct");
+        check(write_file(("root-" + key2 + ".hstr").c_str(), buf), "layout scan v2 file written");
+        check(write_file(("root-" + key3 + ".hstr").c_str(), good), "layout scan v3 file written");
+        saved::RootDiskStore st;
+        saved::RootDiskStore::Config cfg;
+        cfg.dir = dir;
+        cfg.cap_bytes = 1ull << 40;
+        cfg.live = h;
+        cfg.live_geom = it.geom;
+        cfg.stages = 1;
+        const bool started = st.start(cfg, why);
+        check(started && st.enabled(), "layout scan store starts");
+        check(st.indexed() == 1, "layout scan indexes only the v3 file");
+        st.shutdown();
+        fs::remove_all(dir, ec);
+        check(!ec && !fs::exists(dir), "layout scan tmp cleaned");
+    }
+    std::printf(g_fail ? "FAIL\n" : "PASS\n");
+    return g_fail ? 1 : 0;
+}
