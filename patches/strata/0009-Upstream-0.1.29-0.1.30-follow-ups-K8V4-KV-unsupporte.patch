+inline bool saved_startup_mode_on(int64_t conv_mib, int conv_slots, int64_t prompt_cache, bool layer_split) {
+    if (layer_split) return false;
+    return !(conv_mib > 0 && conv_slots > 0 && prompt_cache > 0);
+}
