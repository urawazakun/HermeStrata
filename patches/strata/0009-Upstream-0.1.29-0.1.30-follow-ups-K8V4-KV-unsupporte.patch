     std::vector<uint8_t> gdn, ple, tails;
+    std::vector<uint8_t> dead;        ///< 030 carve-aware checkpoint contract: the spare key per owned layer
+    std::vector<uint8_t> block_pos;   ///< 030 carve-aware checkpoint contract: the block cursor per owned layer
