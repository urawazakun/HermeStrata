+// src/program/saved_state_layout_test.cpp - host-only regression for the 030 carve-aware
+// checkpoint contract (GPU-acceptance failure: every SavedState restore failed upstream
+// `conversation_checkpoint_validate` with "invalid checkpoint running-state payload").
+//
+// Links conversation_state.cpp + conversation_snapshot.cpp + saved_state.cpp with test-only
+// CUDA stubs below: no GPU, no device init, no cudart link. Uses the REAL ModelGeometry (artifact
+// defaults) and SessionState structs, REAL size derivation (conversation_session_sizes), the REAL
+// save/restore transfer seam (conversation_checkpoint_save/restore, stub memcpy), the REAL validator,
+// and the REAL disk codec (root_encode/decode) + RootDiskStore scan. Fails on the 029-shaped layout
+// (missing dead/block_pos), passes on the complete 030 one.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include "strata/core/conversation_snapshot.hpp"
+#include "strata/core/conversation_cache.hpp"
+#include "strata/core/layout.hpp"
+#include "strata/core/session.hpp"
+#include "strata/kernels/qsa.hpp"   // real QsaShapes formula for the pooled fixture sizing
+#include "strata/program/saved_state.hpp"
+
+// ---- test-only CUDA stubs (definitions only; declarations + types come from <cuda_runtime.h>
+// via session.hpp; C linkage matches cudart ABI; host memcpy, always success) ----
+extern "C" {
+cudaError_t cudaMemcpy(void* dst, const void* src, size_t n, enum cudaMemcpyKind) {
+    if (n) std::memcpy(dst, src, n);
+    return cudaSuccess;
+}
+cudaError_t cudaDeviceSynchronize(void) { return cudaSuccess; }
+cudaError_t cudaGetLastError(void) { return cudaSuccess; }
+const char* cudaGetErrorString(cudaError_t) { return "stub-no-gpu"; }
+}  // extern "C"
+
+// Uncalled-link stubs for the KV leg (conversation_kv_restore) of conversation_snapshot.cpp: this
+// test exercises the running-state contract (sizes/validate/save/restore) and the disk codec only.
+// Any accidental call aborts loudly instead of faking device behavior.
+namespace strata::kernels {
+void kv_stream_reset(const KvStreamMap&, void*) { std::abort(); }
+void kv_ring_restore(const QsaAttnPools&, const KvHostPools&, int, int64_t, int64_t, int64_t,
+                     const QsaShapes&, void*) {
+    std::abort();
+}
+}  // namespace strata::kernels
+namespace strata::core {
+strata::kernels::QsaAttnPools qsa_attn_pools(const QsaState&) { std::abort(); }
+}  // namespace strata::core
+
+namespace {
+
+namespace fs = std::filesystem;
+namespace core = strata::core;
+namespace saved = strata::program::saved_state;
+
+int g_fail = 0;
+void check(bool ok, const char* what) {
+    std::printf("  %-72s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+void fill_pattern(std::vector<uint8_t>& v, uint8_t seed) {
+    for (size_t i = 0; i < v.size(); ++i) v[i] = (uint8_t)(seed + i * 31);
+}
+
+// A SessionState fixture with host buffers: `qsa_alloc` owned QSA states starting at global
+// ordinal `qsa_ord0` (the array keeps global indexing: size ord0+alloc), `gdn_alloc` GDN rows.
+// All device pointers are host allocations (the stub memcpy treats everything as host).
+struct Fixture {
+    core::ModelGeometry g;   // artifact defaults (48 layers: 12 QSA, 36 GDN)
+    core::SessionState ss;
+    std::vector<core::QsaState> qs;
+    std::vector<uint8_t> gdn_buf, ple_buf;
+    struct QBuf {
+        std::vector<uint8_t> tail, dead, bpos, pooled;
+    };
+    std::vector<QBuf> qb;
+};
+
+bool make_fixture(int64_t qsa_ord0, int64_t qsa_alloc, int64_t gdn_ord0, int64_t gdn_alloc,
+                  bool with_ple, Fixture& f, std::string& err) {
+    f = Fixture{};
+    // max_cells is fixture-scale (the layout contract under test is max_cells-independent), but the
+    // restore seam writes the pooled row at ids/idx_block, so idx_pooled uses the real formula
+    // (max_cells/idx_block + 2, idx_dim) - a short dummy would be a heap smash, not a layout check.
+    f.ss.max_cells = 16384;
+    f.ss.qsa_ord0 = qsa_ord0;
+    f.ss.qsa_alloc = qsa_alloc;
+    f.ss.gdn_ord0 = gdn_ord0;
+    f.ss.gdn_alloc = gdn_alloc;
+    core::ConversationStateSizes z;
+    if (!core::conversation_session_sizes(f.g, f.ss, z, err)) return false;
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    f.gdn_buf.resize(z.gdn);
+    fill_pattern(f.gdn_buf, 11);
+    f.ss.gdn_state = reinterpret_cast<float*>(f.gdn_buf.data());
+    if (with_ple) {
+        f.ple_buf.resize(z.ple);
+        fill_pattern(f.ple_buf, 23);
+        f.ss.ple_hist = reinterpret_cast<float*>(f.ple_buf.data());
+    }
+    f.qs.resize((size_t)(qsa_ord0 + qsa_alloc));
+    f.qb.resize((size_t)(qsa_ord0 + qsa_alloc));
+    for (int64_t j = 0; j < qsa_alloc; ++j) {
+        const size_t o = (size_t)(qsa_ord0 + j);
+        core::QsaState& st = f.qs[o];
+        Fixture::QBuf& b = f.qb[o];
+        b.tail.resize(z.tail);
+        b.dead.resize(z.dead);
+        b.bpos.resize(z.block_pos);
+        b.pooled.resize(((size_t)f.ss.max_cells / (size_t)qs.idx_block + 2) * (size_t)qs.idx_dim * 4);
+        fill_pattern(b.tail, (uint8_t)(40 + j));
+        fill_pattern(b.dead, (uint8_t)(60 + j));
+        fill_pattern(b.bpos, (uint8_t)(80 + j));
+        fill_pattern(b.pooled, (uint8_t)(100 + j));
+        st.idx_tail = reinterpret_cast<float*>(b.tail.data());
+        st.idx_dead = reinterpret_cast<float*>(b.dead.data());
+        st.idx_block_pos = reinterpret_cast<int32_t*>(b.bpos.data());
+        st.idx_pooled = reinterpret_cast<float*>(b.pooled.data());
+        st.idx_pooled_rows = 65536;   // >> 11687/idx_block: the targets check passes
+        st.max_cells = f.ss.max_cells;
+    }
+    f.ss.qsa_states = f.qs.data();
+    return true;
+}
+
+}  // namespace
