+/// SavedState is explicitly unsupported for K8V4 (kv_hybrid) KV: no capture, restore, or offers
+/// (RAM or disk, including disk load). Logs 'saved state: disabled for K8V4 KV' once per process.
+/// The live conversation chain is untouched - only SavedState store paths check this.
+/// Central gate: the startup mode (upstream conversation cache opted in, or a layer split) is folded
+/// in here too, so EVERY entry point - RAM/disk capture, restore offers, inventory/drop, post-DONE
+/// work - is covered with no call-site edits. The prefix keeper (serve/) is independent and unaffected.
+static bool g_saved_startup_on = true;
+inline bool saved_state_kv_ok() {
+    static bool logged = false;
+    if (!g_saved_startup_on) return false;   // logged once at startup with the reason; stay silent per request
+    if (saved::kv_saved_supported(strata::core::qsa_kv_hybrid())) return true;
+    if (!logged) {
+        logged = true;
+        std::fprintf(stderr, "saved state: disabled for K8V4 KV\n");
+    }
+    return false;
+}
