+// ---- E1: SavedState snapshot capture (DESIGN-HERMES-CACHE.md sections 1, 2 and the section 7 addendum).
+// Implemented: Muse / review: Sol. CAPTURE ONLY: roots pin at the upstream system-prefix boundary and tips
+// snapshot after DONE is flushed (prompt + generated tokens at exactly that boundary). Restore (E2), disk
+// persistence (E3) and the per-request stats line (E4) consume saved_state.hpp's interface; they are not here.
+//
+// The positional cells below a snapshot are the live session's (exactly as for ConvCheckpoint); the payloads
+// below are self-contained host copies: with --kv-resident the authoritative host ranges are copied (no D2H),
+// fully resident pools are copied D2H. A failed snapshot is non-fatal: the caller keeps the request's answer
+// and stores nothing (never silently corrupt the cache).
+namespace saved = strata::program::saved_state;
+
+inline int saved_kv_format(const strata::core::QsaState& st) {
+    return st.kv_q4 ? saved::kKvQ4 : st.kv_int8 ? saved::kKvInt8 : saved::kKvF16;
+}
+
+/// Copies `n` bytes from one page-contiguous pool. `from_host` reads the (device-mapped, pinned) host copy.
+inline bool saved_copy_bytes(const uint8_t* src, uint8_t* dst, size_t n, bool from_host) {
+    if (n == 0) return true;
+    if (src == nullptr || dst == nullptr) return false;
+    if (from_host) {
+        std::memcpy(dst, src, n);
+        return true;
+    }
+    return cudaMemcpy(dst, src, n, cudaMemcpyDeviceToHost) == cudaSuccess;
+}
+
+/// QSA KV cells [0, k) of one layer into `out`, rounded up to whole pages (page_size cells): the padding past k
+/// is stale-but-harmless (the verifier overwrites K/V cells past the accepted prefix before any query reads
+/// them), and page granularity keeps the restore a plain copy-back. With kv-resident (kv_mode 1 streamed, 2
+/// ring) the authoritative host copy - identity layout [page][kv_head][page_size] rows - is the source; fully
+/// resident (mode 0, identity page table) is copied D2H from the device pools.
+bool saved_snapshot_kv(const strata::core::QsaState& st, const strata::core::ModelGeometry& g, int64_t k,
+                       saved::KvLayerPayload& out) {
+    out = saved::KvLayerPayload{};
+    if (k <= 0) return true;
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t nH = g.n_head_kv, hd = g.head_dim, ps = qs.page_size;
+    if (nH < 1 || hd < 1 || ps < 1) return false;
+    const int64_t pages = (k + ps - 1) / ps;
+    if (pages > st.n_pages) return false;
+    const bool streamed = st.kv_mode != 0;
+    if (streamed && !st.host.present()) return false;   // no authoritative copy to read: store nothing
+    out.fmt = saved_kv_format(st);
+    out.cells = k;
+    auto page_bytes = [&](size_t row) { return (size_t) nH * (size_t) ps * row; };
+    auto copy_pool = [&](const void* dev, const void* host, size_t row, std::vector<uint8_t>& dst) -> bool {
+        const uint8_t* src = streamed ? (const uint8_t*) host : (const uint8_t*) dev;
+        if (src == nullptr) return false;
+        dst.resize(pages * page_bytes(row));
+        for (int64_t p = 0; p < pages; ++p)
+            if (!saved_copy_bytes(src + (size_t) p * page_bytes(row), dst.data() + (size_t) p * page_bytes(row),
+                                  page_bytes(row), streamed))
+                return false;
+        return true;
+    };
+    if (st.kv_q4) {
+        const size_t row = (size_t) strata::kernels::kv_q4_bytes_per_head((int) hd);
+        return copy_pool(st.k_q4, st.host.k_q4, row, out.k) && copy_pool(st.v_q4, st.host.v_q4, row, out.v);
+    }
+    if (st.kv_int8) {
+        const size_t sc = (size_t) (hd / 64) * 2;
+        return copy_pool(st.k_q, st.host.k_q, (size_t) hd, out.k) &&
+               copy_pool(st.v_q, st.host.v_q, (size_t) hd, out.v) &&
+               copy_pool(st.k_scale, st.host.k_scale, sc, out.ks) &&
+               copy_pool(st.v_scale, st.host.v_scale, sc, out.vs);
+    }
+    return copy_pool(st.k_pool, st.host.k_pool, (size_t) hd * 2, out.k) &&
+           copy_pool(st.v_pool, st.host.v_pool, (size_t) hd * 2, out.v);
+}
+
+/// The indexer's pooled block keys covering [0, k): completed blocks k/idx_block plus the spare slot row, the
+/// block cursor and the constant dead key. Pooled keys live on the device only, so this is always D2H.
+bool saved_snapshot_indexer(const strata::core::QsaState& st, const strata::core::ModelGeometry& g, int64_t k,
+                            saved::IndexerPayload& out) {
+    out = saved::IndexerPayload{};
+    if (k <= 0) return true;
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t dim = g.idx_key_dim, ib = qs.idx_block;
+    if (dim < 1 || ib < 1) return false;
+    out.pooled_rows = k / ib + 1;
+    if (out.pooled_rows > st.idx_pooled_rows) return false;
+    out.pooled.resize((size_t) out.pooled_rows * (size_t) dim * 4);
+    out.block_pos.assign(1, 0);
+    out.dead_key.resize((size_t) dim * 4);
+    return saved_copy_bytes((const uint8_t*) st.idx_pooled, out.pooled.data(), out.pooled.size(), false) &&
+           saved_copy_bytes((const uint8_t*) st.idx_block_pos, (uint8_t*) out.block_pos.data(), 4, false) &&
+           saved_copy_bytes((const uint8_t*) st.idx_dead, out.dead_key.data(), out.dead_key.size(), false);
+}
+
+/// One session's full recurrent + indexer + KV state at exactly L tokens. The caller synchronized the device
+/// (checkpoint_save's contract); stage sessions are synchronized under their own OnDevice guard by the caller.
+bool saved_snapshot_stage(const strata::core::SessionState& ss, const strata::core::ModelGeometry& g, int64_t L,
+                          saved::StagePayload& out) {
+    out = saved::StagePayload{};
+    ConvCheckpoint tmp;   // the existing recurrent copy (GDN state + conv history, PLE history, QSA tails)
+    if (!checkpoint_save(tmp, ss, g)) return false;
+    out.rec.gdn = std::move(tmp.gdn);
+    out.rec.ple = std::move(tmp.ple);
+    out.rec.tails = std::move(tmp.tails);
+    for (int64_t i = 0; i < g.n_qsa_layers(); ++i) {
+        saved::KvLayerPayload kv;
+        if (!saved_snapshot_kv(ss.qsa_states[i], g, L, kv)) return false;
+        out.kv.push_back(std::move(kv));
+        saved::IndexerPayload ix;
+        if (!saved_snapshot_indexer(ss.qsa_states[i], g, L, ix)) return false;
+        out.idx.push_back(std::move(ix));
+    }
+    return true;
+}
+
+// ---- E2: SavedState restore (DESIGN-HERMES-CACHE.md sections 1, 2 and the section 7 addendum).
+// Implemented: Muse / review: Sol. Longest exact-prefix live-chain/tip/root match (chain wins ties);
+// roots/tips are independent of chain pruning and --prompt-cache. ALL validation (geometry, payload sizes,
+// MTP reachable valid_from) runs BEFORE any GPU state is touched; any failure at any stage takes the cold
+// path (session_zero on ALL stages, chain cleared, resume 0) - never a stale chain after overwritten KV,
+// never silently consuming corrupted state.
+//
+// E2 REVIEW MAP (for Sol) - where each repair lives:
+//   KV repair:    saved_restore_kv() per layer: host copy for kv-resident streamed/ring layouts, device pools
+//                 + identity page table when fully resident. Streamed slots are invalidated via kv_stream_reset
+//                 so the next resolve reloads from the restored host (never a stale slot under a remapped block).
+//   MTP repair:   saved_restore_mtp() restores the L-1 real pairs, the shared mtp.kv_restore(k) refills the ring,
+//                 and the boundary block pairs saved R_(k-1) with request.ids[k] BEFORE the suffix prefill (the
+//                 suffix still starts at k; k==n is rejected - the decoder would double-feed the last token).
+//                 Chain/live mounts get the same k-1 repair from the retained live row or a same-length saved
+//                 boundary (no upload; chain preference kept).
+//   Recurrent:    saved_restore_stage() reuses checkpoint_restore for GDN/PLE/tails (+ple_prev from ids) and
+//                 restores the indexer pooled keys/cursor/dead-key per layer. Every byte size, pointer and
+//                 capacity is validated BEFORE any mutation (validate_for_restore).
+//   Split fallback: per-stage uploads run under that stage's OnDevice guard with its stream; ANY exception or
+//                 upload/boundary failure after a mount was attempted cold-resets ALL stages (checked) and the
+//                 MTP via prefill-from-0 - never a stale chain over overwritten KV. A failed reset fails the
+//                 request outright (no coherent fallback exists). Fork parent tips survive: the store is never
+//                 pruned by traffic, and a successful mount calls note_use.
+/// Device staging buffer that frees on every exit path, including exceptions (blocker 4). Declared
+/// AFTER the OnDevice guard at each use site so cudaFree runs on the right device on a split.
+struct CudaFreeDel {
+    void operator()(void* p) const noexcept { if (p != nullptr) cudaFree(p); }
+};
+
+/// Blocker 5 review: every pool a KV upload dereferences - device pools always, the authoritative host
+/// pools on kv-resident layouts. Used for main stages and the MTP drafter alike.
+bool saved_kv_ptrs_ok(const strata::core::QsaState& st, std::string& why) {
+    if (st.kv_q4) {
+        if (st.k_q4 == nullptr || st.v_q4 == nullptr) { why = "KV pointers missing"; return false; }
+        if (st.kv_mode != 0 && (st.host.k_q4 == nullptr || st.host.v_q4 == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    } else if (st.kv_int8) {
+        if (st.k_q == nullptr || st.v_q == nullptr || st.k_scale == nullptr || st.v_scale == nullptr) {
+            why = "KV pointers missing";
+            return false;
+        }
+        if (st.kv_mode != 0 && (st.host.k_q == nullptr || st.host.v_q == nullptr ||
+                                st.host.k_scale == nullptr || st.host.v_scale == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    } else {
+        if (st.k_pool == nullptr || st.v_pool == nullptr) { why = "KV pointers missing"; return false; }
+        if (st.kv_mode != 0 && (st.host.k_pool == nullptr || st.host.v_pool == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    }
+    return true;
+}
+inline saved::SnapshotGeom saved_live_geom(const strata::core::ModelGeometry& g) {
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    saved::SnapshotGeom gm;
+    gm.n_qsa_layers = g.n_qsa_layers();
+    gm.n_head_kv = g.n_head_kv;
+    gm.head_dim = g.head_dim;
+    gm.idx_dim = g.idx_key_dim;
+    gm.idx_block = qs.idx_block;
+    gm.page_size = qs.page_size;
+    return gm;
+}
+
+/// One layer's QSA KV cells [0, cells) from a snapshot payload. Mode 0 (fully resident): H2D into the device
+/// pools + identity page table. Mode 1 (streamed): memcpy into the authoritative host copy + kv_stream_reset
+/// so resolve refills slots from the restored host. Mode 2 (ring): memcpy into the host copy; the caller
+/// refills the ring (mtp.kv_restore). `st` is const: every destination is a mutable pool through it.
+bool saved_restore_kv(const strata::core::QsaState& st, const strata::core::ModelGeometry& g,
+                       const saved::KvLayerPayload& pay, int64_t cells, void* stream, std::string& e) {
+    if (pay.cells != cells || cells < 1) { e = "KV cell count mismatch"; return false; }
+    if (pay.fmt != saved_kv_format(st)) { e = "KV format changed"; return false; }
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t nH = g.n_head_kv, hd = g.head_dim, ps = qs.page_size;
+    if (nH < 1 || hd < 1 || ps < 1) { e = "bad KV geometry"; return false; }
+    const int64_t pages = (cells + ps - 1) / ps;
+    if (pages > st.n_pages) { e = "KV pages exceed capacity"; return false; }
+    if (!saved::kv_blob_ok(pay, cells, saved_live_geom(g))) { e = "KV blob size mismatch"; return false; }
+    const size_t page_row = (size_t) nH * (size_t) ps;   // rows per page; times the per-row bytes below
+    auto copy_dev = [&](const std::vector<uint8_t>& src, void* dev, size_t row) -> bool {
