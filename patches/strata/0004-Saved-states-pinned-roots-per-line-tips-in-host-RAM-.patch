+// src/program/saved_state.cpp - E1: the SavedState store policy (CPU-only, no CUDA).
+//
+// Implemented: Muse / review: Sol. See saved_state.hpp for the design contract.
+#include "strata/program/saved_state.hpp"
+
+namespace strata::program::saved_state {
+
+SavedStateStore::SavedStateStore() = default;
+
+void SavedStateStore::set_stage_count(int n) {
+    if (n < 1) n = 1;
+    if (n == n_stages_) return;
+    // A new stage layout invalidates every saved byte: clear rather than risk a cross-layout restore.
+    n_stages_ = n;
+    clear();
+}
+
+bool SavedStateStore::insert_root(SavedItem item) {
+    if ((int)item.stages.size() != n_stages_ || item.n_stages != n_stages_) return false;
+    if (!item.complete()) return false;   // finding 5: never store an inconsistent/incomplete payload
+    item.kind = Kind::Root;
+    item.bytes = item.payload_bytes();
+    item.last_use = ++clock_;
+    for (SavedItem& r : roots_) {
+        if (same_key(r, item)) {
+            r = std::move(item);
+            return true;
+        }
+    }
+    roots_.push_back(std::move(item));
+    return true;
+}
+
+bool SavedStateStore::insert_tip(SavedItem item, bool is_aux) {
+    if (is_aux) return false;   // S1: aux lines get no tip and never evict a main line
+    if ((int)item.stages.size() != n_stages_ || item.n_stages != n_stages_) return false;
+    if (!item.complete()) return false;   // finding 5: never store an inconsistent/incomplete payload
+    if (item.ids.empty()) return false;   // resume 0 is "read from the start": nothing to save
+    item.kind = Kind::Tip;
+    item.bytes = item.payload_bytes();
+    item.last_use = ++clock_;
+    for (SavedItem& t : tips_) {
+        if (same_key(t, item)) {
+            tip_bytes_ -= t.bytes;
+            t = std::move(item);
+            tip_bytes_ += t.bytes;
+            evict_tips();
+            return true;
+        }
+    }
+    tip_bytes_ += item.bytes;
+    tips_.push_back(std::move(item));
+    evict_tips();
+    return true;
+}
+
+const SavedItem* SavedStateStore::find_best(const std::vector<int32_t>& ids,
+                                            const std::vector<ImgKey>& imgs, bool cvec) const {
+    return find_best_except(ids, imgs, cvec, {});
+}
+
+const SavedItem* SavedStateStore::find_best_except(const std::vector<int32_t>& ids,
+                                                   const std::vector<ImgKey>& imgs, bool cvec,
+                                                   const std::vector<const SavedItem*>& skip) const {
+    const SavedItem* best = nullptr;
+    auto skipped = [&](const SavedItem& it) {
+        for (const SavedItem* s : skip)
+            if (s == &it) return true;
+        return false;
+    };
+    auto consider = [&](const SavedItem& it) {
+        if (skipped(it)) return;
+        if ((int)it.stages.size() != n_stages_ || it.n_stages != n_stages_) return;
+        if (it.cvec != cvec) return;
+        if (!is_prefix(it.ids, ids)) return;
+        if (imgs_below(imgs, (int64_t)it.ids.size()) != it.imgs) return;
+        if (best == nullptr || it.ids.size() > best->ids.size()) best = &it;
+    };
+    for (const SavedItem& r : roots_) consider(r);
+    for (const SavedItem& t : tips_) consider(t);
+    return best;
+}
+
+const SavedItem* SavedStateStore::find_exact(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs,
+                                             bool cvec, int64_t k) const {
+    if (k < 1 || k > (int64_t)ids.size()) return nullptr;
+    auto matches = [&](const SavedItem& it) {
+        if ((int64_t)it.ids.size() != k) return false;
+        if ((int)it.stages.size() != n_stages_ || it.n_stages != n_stages_) return false;
+        if (it.cvec != cvec) return false;
+        if (!is_prefix(it.ids, ids)) return false;
+        return imgs_below(imgs, k) == it.imgs;
+    };
+    for (const SavedItem& r : roots_)
+        if (matches(r)) return &r;
+    for (const SavedItem& t : tips_)
+        if (matches(t)) return &t;
+    return nullptr;
+}
+
+bool SavedStateStore::note_use(const SavedItem* it) {
+    if (it == nullptr) return false;
+    for (SavedItem& r : roots_)
+        if (&r == it) {
+            r.last_use = ++clock_;
+            return true;
+        }
+    for (SavedItem& t : tips_)
+        if (&t == it) {
+            t.last_use = ++clock_;
+            return true;
+        }
+    return false;
+}
+
+size_t SavedStateStore::drop_non_pinned() {    const size_t n = tips_.size();
+    tips_.clear();
+    tip_bytes_ = 0;
+    return n;
+}
+
+std::vector<InventoryEntry> SavedStateStore::inventory() const {
+    std::vector<InventoryEntry> out;
+    out.reserve(roots_.size() + tips_.size());
+    for (const SavedItem& r : roots_) out.push_back({Kind::Root, r.ids.size(), r.bytes, r.last_use});
+    for (const SavedItem& t : tips_) out.push_back({Kind::Tip, t.ids.size(), t.bytes, t.last_use});
+    return out;
+}
+
+void SavedStateStore::clear() {
+    roots_.clear();
+    tips_.clear();
+    tip_bytes_ = 0;
+}
+
+void SavedStateStore::evict_tips() {
+    while (!tips_.empty() && tip_bytes_ > tip_budget_) {
+        size_t v = 0;   // LRU: least recently used tip leaves first
+        for (size_t i = 1; i < tips_.size(); ++i)
+            if (tips_[i].last_use < tips_[v].last_use) v = i;
+        tip_bytes_ -= tips_[v].bytes;
+        tips_.erase(tips_.begin() + (std::ptrdiff_t)v);
+    }
+}
+
