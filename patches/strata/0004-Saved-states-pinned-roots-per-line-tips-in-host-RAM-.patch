diff --git a/include/strata/program/saved_state.hpp b/include/strata/program/saved_state.hpp
new file mode 100644
index 0000000..3fc0614
--- /dev/null
+++ b/include/strata/program/saved_state.hpp
@@ -0,0 +1,389 @@
+// include/strata/program/saved_state.hpp - E1: the SavedState store (DESIGN-HERMES-CACHE.md sections 1, 2, 7).
+//
+// Implemented: Muse / review: Sol.
+//
+// Three kinds of saved state: pinned ROOTS (the end of a fixed prefix, keyed by token ids, never evicted by
+// traffic, E3 persists them to disk), byte-budget LRU TIPS (one recent tip per conversation line in host RAM,
+// what makes parent<->child alternation and forked children cheap), and upstream's live ConvCheckpoint CHAIN
+// (unchanged, lives in generate.cpp).
+//
+// This header is CPU-ONLY on purpose: no CUDA includes, no device code. The store owns the policy (prefix match
+// by exact full ids, cvec/image identity, pin, LRU budget, per-line replacement, split-stage generation) while
+// generate.cpp fills the opaque payload blobs from the device. That keeps the policy unit-testable on CPU for E5
+// and leaves E2 (restore), E3 (disk), E4 (stats) and S2 (inventory) as consumers of this interface:
+//
+//   E2 restores via find_best() + the payload blobs (upload KV [0,k) + recurrent state, re-point page table).
+//   E3 serialises SavedItem + RootDiskHeader (header.compatible_with() gates loads).
+//   E4 fills ResumeStats per request (source/k/suffix/restore_ms/snapshot_ms).
+//   S2 serves inventory() and drop_non_pinned().
+//
+// Payload completeness (section 1: "A saved item contains"): ids, recurrent state snapshot (GDN recurrence +
+// conv history, PLE history + token window, QSA indexer tails), the pooled indexer keys + block positions, QSA
+// KV cells [0,k) for all 12 layers (host copy when kv-resident, else a D2H copy), and the MTP draft rows [0,k).
+// The residual R is deliberately NOT saved: it is per-token scratch rebuilt from the next token's embedding
+// (put_input rebroadcasts every token; session_zero at position 0).
+//
+// Section 7 (forked children): a tip covers prompt + GENERATED assistant tokens at exactly the DONE boundary,
+// so a forked child (parent prompt + parent's generated tool-call + a short tool result) resumes with a tiny
+// suffix. Tips are snapshotted after DONE is sent/flushed, never blocking the reply.
+#pragma once
+
+#include "strata/kernels/kv_q4.hpp"   // authoritative q4 row formula (CPU-clean: <cstdint> + qsa.hpp only)
+#include "strata/kernels/kv_q8.hpp"   // authoritative int8 group (same)
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::program::saved_state {
+
+/// Default tip budget: --tip-cache-gib. 8 GiB holds >= depth+1 lines: a 12K prefix tip is ~150 MiB KV +
+/// ~113 MiB recurrent state, a 40K tip ~550 MiB + state (DESIGN section 0 numbers).
+inline constexpr double kDefaultTipCacheGib = 8.0;
+/// E3's --root-dir default. E1 parses the flag but does not write (interface ready).
+inline const char* kDefaultRootDir = "H:\\qwen38-v100\\strata-cache\\roots";
+
+/// An image among the ids: its first <|image_pad|> position plus the hash of its grid and embeddings.
+/// Mirrors generate.cpp's ImgKey; compared exactly (section 1: validity needs the full picture, not a hash of
+/// the pads alone).
+struct ImgKey {
+    int64_t start = 0;
+    uint64_t hash = 0;
+    bool operator==(const ImgKey& o) const { return start == o.start && hash == o.hash; }
+};
+
+enum class Kind : uint8_t { Root, Tip };
+
+/// E4's resume source. E1 only defines it; the restore path (E2) and the per-request stats line (E4) fill it.
+enum class ResumeSource : uint8_t { None, Chain, Tip, Root, RootDisk };
+
+/// Exact full-ids prefix comparison (section 1: "valid only if its full ids are a prefix of P, not just the
+/// hash"). Empty `pre` is never a valid prefix: resume 0 means "read from the start".
+inline bool is_prefix(const std::vector<int32_t>& pre, const std::vector<int32_t>& full) {
+    if (pre.empty() || pre.size() > full.size()) return false;
+    for (size_t i = 0; i < pre.size(); ++i)
+        if (pre[i] != full[i]) return false;
+    return true;
+}
+
+/// The images among the first L tokens (mirrors generate.cpp's imgs_below).
+inline std::vector<ImgKey> imgs_below(const std::vector<ImgKey>& all, int64_t L) {
+    std::vector<ImgKey> v;
+    for (const ImgKey& k : all)
+        if (k.start < L) v.push_back(k);
+    return v;
+}
+
+/// KV cell storage format (mirrors qsa_kv_format: 0 fp16, 1 int8, 2 q4_0).
+enum KvFormat : int { kKvF16 = 0, kKvInt8 = 1, kKvQ4 = 2 };
+
+/// QSA KV cells [0, cells) of ONE layer, identity layout [block][kv_head][page_size][head_dim].
+/// k/v hold codes (or fp16 halves as bytes); ks/vs the int8 scales (empty in fp16/q4_0).
+struct KvLayerPayload {
+    int fmt = kKvF16;
+    int64_t cells = 0;
+    std::vector<uint8_t> k, v, ks, vs;
+    uint64_t bytes() const { return (uint64_t)k.size() + v.size() + ks.size() + vs.size(); }
+};
+
+/// The indexer's pooled block keys rows [0, pooled_rows) plus the block positions and the constant dead key.
+/// pooled is float32 rows of idx_dim; block_pos/dead_key appended after it by the capturer is NOT assumed here:
+/// block_pos is stored separately, dead_key (one idx_dim row) rides at the end of pooled when present.
+struct IndexerPayload {
+    int64_t pooled_rows = 0;
+    std::vector<uint8_t> pooled;          ///< pooled_rows * idx_dim floats (D2H copy; no host original exists)
+    std::vector<int32_t> block_pos;       ///< per-layer block cursor (1 int32)
+    std::vector<uint8_t> dead_key;        ///< one idx_dim float row: the spare slot's key (sequence-constant)
+    uint64_t bytes() const {
+        return (uint64_t)pooled.size() + (uint64_t)block_pos.size() * 4 + (uint64_t)dead_key.size();
+    }
+};
+
+/// The recurrent snapshot: GDN recurrence + conv history, PLE history + token window, QSA raw tails.
+/// Same set checkpoint_save() copies today (conv_state_sizes), plus the ple window.
+struct RecurrentPayload {
+    std::vector<uint8_t> gdn, ple, tails;
+    int32_t ple_prev[2] = {-1, -1};
+    uint64_t bytes() const { return (uint64_t)gdn.size() + ple.size() + tails.size() + 8; }
+};
+
+/// One GPU stage's worth of state. Stage 0 is the main session; a layer split's later stages append theirs
+/// (mirrors ConvCheckpoint::stage_parts). n_stages is fixed at startup; a change clears the store.
+struct StagePayload {
+    RecurrentPayload rec;
+    std::vector<IndexerPayload> idx;  ///< one per QSA layer of this stage's session (pooled keys are per layer)
+    std::vector<KvLayerPayload> kv;       ///< one per QSA layer of this stage's session
+    uint64_t bytes() const {
+        uint64_t b = rec.bytes();
+        for (const IndexerPayload& l : idx) b += l.bytes();
+        for (const KvLayerPayload& l : kv) b += l.bytes();
+        return b;
+    }
+};
+
+/// The MTP repair row (Sol final review): R_(L-1), the main model's final residual after the last layer
+/// for the last consumed token, as a host float blob with its layout. The residual R is per-token scratch
+/// (rebuilt from each token's embedding), so WITHOUT this row E2 could not repair MTP pair L-1: pairing cell
+/// L-1 needs (R_(L-1), tok_L), and tok_L is the new request's first suffix token (request.ids[L]).
+///
+/// REQUIRED E2 REPAIR (documented here, implemented in E2): on resume at k=L with suffix starting at tok_L,
+/// pair cell L-1 via mtp.prefill(&boundary.row, &tok_L, 1, L-1) BEFORE the suffix prefill, then prefill the
+/// suffix normally. E2 MUST reject a candidate outright when the new request's drafter window reaches below
+/// valid_from (rows there are unwritten zeros, not pairs - resuming under them would attend garbage).
+/// Roots and tips both carry the row (roots: stashed from the authoritative prompt source inside on_chunk /
+/// read_windows before scratch is overwritten; tips: the final flush verifier residual, last stage on split).
+/// A snapshot without its boundary row is rejected (complete()).
+struct BoundaryRow {
+    int64_t hc = 0;                       ///< ModelGeometry::hc at capture (E2/E3 layout validation)
+    int64_t n_embd = 0;                   ///< ModelGeometry::n_embd at capture
+    std::vector<float> row;               ///< R_(L-1): hc*n_embd host floats
+    uint64_t bytes() const { return (uint64_t)row.size() * 4 + 16; }
+    bool complete() const { return hc > 0 && n_embd > 0 && (int64_t)row.size() == hc * n_embd; }
+};
+
+/// The MTP drafter's K/V rows: the valid-pair invariant (Sol review finding 3).
+///
+/// AUTHORITATIVE SEMANTICS (see MtpDrafter::prefill/draft): drafter cell i pairs the main model's final
+/// residual R_i with the token at position i+1. Prompt cells are exact (on_chunk/read_windows prefill with
+/// real next tokens); decode cells over kept rows are exact (draft() catch-up pairs kept rows with their real
+/// argmaxes; the final window gets its exact catch-up post-DONE before any snapshot). The last main cell's
+/// pairing needs tok_L, which does not exist yet, and is NEVER invented: a snapshot of L main tokens carries
+/// exactly cells = L-1 valid pairs in rows [0, cells).
+///
+/// WINDOWING: prompt prefill skips cells the attention window can never reach again, so rows below
+/// valid_from may be unwritten zeros (deterministic - the drafter starts zeroed). Rows [valid_from, cells)
+/// are real-paired. E2 MUST repair the boundary on restore by re-pairing from the resume suffix (prefill /
+/// draft over the suffix, as prompt reads do) rather than trusting speculative rows past it.
+struct MtpPayload {
+    std::vector<KvLayerPayload> kv;       ///< exactly one entry (the drafter's layer) when captured
+    int64_t cells = 0;                    ///< valid-pair count: L-1 for a snapshot of L main tokens
+    int64_t valid_from = 0;               ///< first row with a real pairing (MtpDrafter::prefill_valid_from)
+    uint64_t bytes() const {
+        uint64_t b = 0;
+        for (const KvLayerPayload& l : kv) b += l.bytes();
+        return b;
+    }
+};
+
+/// Geometry/layout key captured with every snapshot (E1) and validated before any restore (E2) or disk
+/// load (E3): a stage layout, KV format geometry or indexer shape change must never restore stale bytes.
+/// Per-layer KV formats ride in each KvLayerPayload::fmt; this covers the shared geometry.
+struct SnapshotGeom {
+    int64_t n_qsa_layers = 0;
+    int64_t n_head_kv = 0;
+    int64_t head_dim = 0;
+    int64_t idx_dim = 0;
+    int64_t idx_block = 0;
+    int64_t page_size = 0;
+    bool operator==(const SnapshotGeom& o) const {
+        return n_qsa_layers == o.n_qsa_layers && n_head_kv == o.n_head_kv && head_dim == o.head_dim &&
+               idx_dim == o.idx_dim && idx_block == o.idx_block && page_size == o.page_size;
+    }
+    bool operator!=(const SnapshotGeom& o) const { return !(*this == o); }
+};
+
+/// Exact pool bytes for `cells` cells (Sol final-review fix): pages = ceil(cells/page_size), each page
+/// n_head_kv*page_size rows of `row` bytes. Row widths mirror the capturer bit-for-bit: fp16 halves, int8
+/// codes + scales per KV_Q8_GROUP values, q4 via the authoritative kv_q4_bytes_per_head. `scales` selects the
+/// scale pools (int8 only).
+inline uint64_t kv_pool_bytes(int fmt, int64_t cells, int64_t n_head_kv, int64_t head_dim, int64_t page_size,
+                              bool scales) {
+    const uint64_t pages = (uint64_t)((cells + page_size - 1) / page_size);
+    uint64_t row = 0;
+    if (scales) {
+        row = (uint64_t)(head_dim / strata::kernels::KV_Q8_GROUP) * 2;
+    } else if (fmt == kKvF16) {
+        row = (uint64_t)head_dim * 2;
+    } else if (fmt == kKvInt8) {
+        row = (uint64_t)head_dim;
+    } else {
+        row = strata::kernels::kv_q4_bytes_per_head((int)head_dim);
+    }
+    return pages * (uint64_t)n_head_kv * (uint64_t)page_size * row;
+}
+
+/// Exact k/v/scale validation for one layer's [0, cells) range against the page geometry.
+inline bool kv_blob_ok(const KvLayerPayload& k, int64_t cells, const SnapshotGeom& gm) {
+    if (k.cells != cells) return false;
+    if (k.fmt != kKvF16 && k.fmt != kKvInt8 && k.fmt != kKvQ4) return false;
+    const uint64_t code = kv_pool_bytes(k.fmt, cells, gm.n_head_kv, gm.head_dim, gm.page_size, false);
+    if ((uint64_t)k.k.size() != code || (uint64_t)k.v.size() != code) return false;
+    const uint64_t sc =
+        k.fmt == kKvInt8 ? kv_pool_bytes(k.fmt, cells, gm.n_head_kv, gm.head_dim, gm.page_size, true) : 0;
+    return (uint64_t)k.ks.size() == sc && (uint64_t)k.vs.size() == sc;
+}
+
+struct SavedItem {
+    Kind kind = Kind::Tip;    std::vector<int32_t> ids;             ///< the tokens this state has consumed (prompt + generated for tips)
+    std::vector<ImgKey> imgs;             ///< imgs_below(all, ids.size()) at capture
+    bool cvec = true;                     ///< the control-vector enablement the state was read with
+    int n_stages = 1;                     ///< stages.size(); must match the store's stage count
+    uint64_t bytes = 0;                   ///< set by the store on insert (payload + ids/imgs overhead)
+    uint64_t last_use = 0;                ///< set by the store (LRU clock)
+    SnapshotGeom geom;                    ///< geometry/layout the payloads were captured under (E2 validates)
+    std::vector<StagePayload> stages;
+    MtpPayload mtp;
+    BoundaryRow boundary;                 ///< R_(L-1): the MTP repair row (Sol final review; E2 pairs it)
+    uint64_t payload_bytes() const {
+        uint64_t b = (uint64_t)ids.size() * 4 + (uint64_t)imgs.size() * 16 + 16 + 48;   // +48: geom + scalars
+        for (const StagePayload& s : stages) b += s.bytes();
+        b += mtp.bytes() + boundary.bytes();
+        return b;
+    }
+    /// Strict structural gate (findings 5 + final review): the store rejects anything inconsistent or
+    /// incomplete - a truncated copy must never become a restorable item. ple may be empty (no-PLE builds);
+    /// gdn/tails never are. Byte sizes are checked against the geometry, not just non-emptiness.
+    bool complete() const {
+        const int64_t L = (int64_t)ids.size();
+        if (L < 1 || n_stages < 1 || (int)stages.size() != n_stages) return false;
+        if (geom.n_qsa_layers < 1 || geom.n_head_kv < 1 || geom.head_dim < 1 || geom.idx_dim < 1 ||
+            geom.idx_block < 1 || geom.page_size < 1)
+            return false;
+        for (const ImgKey& k : imgs)
+            if (k.start < 0 || k.start >= L) return false;
+        if (!boundary.complete()) return false;   // no MTP repair row, no snapshot
+        const int64_t prow = L / geom.idx_block + 1;   // pooled rows covering [0, L)
+        for (const StagePayload& s : stages) {
+            if (s.rec.gdn.empty() || s.rec.tails.empty()) return false;
+            if ((int64_t)s.kv.size() != geom.n_qsa_layers || (int64_t)s.idx.size() != geom.n_qsa_layers)
+                return false;
+            for (const KvLayerPayload& k : s.kv)
+                if (!kv_blob_ok(k, L, geom)) return false;   // main cells are exactly [0, L), byte-exact
+            for (const IndexerPayload& x : s.idx) {
+                if (x.pooled_rows != prow) return false;
+                if ((int64_t)x.pooled.size() != prow * geom.idx_dim * 4) return false;
+                if ((int64_t)x.dead_key.size() != geom.idx_dim * 4) return false;
+                if (x.block_pos.size() != 1) return false;
+            }
+        }
+        // MTP: exactly L-1 real pairs (L==1: no pair exists, mtp stays empty), valid_from inside
+        // [0, cells], sizes matching, same KV format as the main layers.
+        if (L == 1) {
+            if (!mtp.kv.empty() || mtp.cells != 0) return false;
+        } else {
+            if (mtp.kv.empty() || mtp.kv.size() != 1) return false;
+            if (mtp.cells != L - 1) return false;
+            if (mtp.valid_from < 0 || mtp.valid_from > mtp.cells) return false;
+            const KvLayerPayload& m = mtp.kv[0];
+            if (m.fmt != stages[0].kv[0].fmt) return false;
+            if (!kv_blob_ok(m, mtp.cells, geom)) return false;   // MTP rows byte-exact over [0, cells)
+        }
+        return true;
+    }
+};
+
+/// E3's on-disk header (interface only in E1): every field that changes numerics must match, else the file is
+/// ignored. The capturer fills it; compatible_with() gates the load. Pure and CPU-testable.
+struct RootDiskHeader {
+    static constexpr uint32_t kMagic = 0x48535452;   // 'HSTR' (Hermes strata root)
+    static constexpr uint32_t kVersion = 1;
+    uint32_t magic = kMagic;
+    uint32_t version = kVersion;
+    std::string engine_version;           ///< STRATA_VERSION
+    std::string pack_path;
+    std::string kv_type;                  ///< --kv: fp16|int8|q4_0
+    std::string mtp_dir;                  ///< --mtp DIR (draft quality only affects drafts, but keep it strict)
+    std::string model_fingerprint;        ///< model file sizes+mtimes (or hash)
+    std::string numeric_flags;            ///< flags that change numerics: --native set, --kv-resident mode class
+    int64_t ids_len = 0;
+    uint64_t ids_hash = 0;                ///< FNV-1a over the ids (prefix rule still compares full ids after load)
+    bool compatible_with(const RootDiskHeader& o) const {
+        return magic == o.magic && version == o.version && engine_version == o.engine_version &&
+               pack_path == o.pack_path && kv_type == o.kv_type && mtp_dir == o.mtp_dir &&
+               model_fingerprint == o.model_fingerprint && numeric_flags == o.numeric_flags;
+    }
+};
+
+/// E4's per-request stats (interface only in E1): `resume from {chain|tip|root|root-disk} at k, suffix n,
+/// restore ms, snapshot ms`.
+struct ResumeStats {
+    ResumeSource source = ResumeSource::None;
+    int64_t k = 0;                        ///< reused prefix cells
+    int64_t suffix = 0;                   ///< cells read fresh
+    double restore_ms = 0.0;
+    double snapshot_ms = 0.0;
+};
+
+/// S2's inventory row (interface only in E1): GET /v1/cache lists these; DELETE drops all non-pinned.
+struct InventoryEntry {
+    Kind kind = Kind::Tip;
+    size_t ids_len = 0;
+    uint64_t bytes = 0;
+    uint64_t last_use = 0;
+};
+
+/// Roots (pinned) + tips (byte-budget LRU). Not thread-safe: the serve loop is single-threaded per process.
+class SavedStateStore {
+  public:
+    SavedStateStore();
+
+    void set_tip_budget_bytes(uint64_t b) { tip_budget_ = b; evict_tips(); }
+    void set_tip_budget_gib(double gib) {
+        tip_budget_ = gib <= 0.0 ? 0 : (uint64_t)(gib * 1073741824.0);
+        evict_tips();
+    }
+    uint64_t tip_budget_bytes() const { return tip_budget_; }
+    uint64_t tip_bytes() const { return tip_bytes_; }
+
+    /// Split-stage generation. The split is fixed at startup; a change clears the store rather than risk a
+    /// cross-layout restore (never silently corrupt the cache).
+    void set_stage_count(int n);
+    int stage_count() const { return n_stages_; }
+
+    size_t roots() const { return roots_.size(); }
+    size_t tips() const { return tips_.size(); }
+    uint64_t clock() const { return clock_; }
+
+    /// Insert a root: pinned, never evicted by traffic. An exact-duplicate (same ids+imgs+cvec) refresh is
+    /// replaced in place. Rejects stage-count mismatches.
+    bool insert_root(SavedItem item);
+    /// Insert a tip. is_aux (title/side requests, S1) is a strict no-op: no insert, no eviction, no clock
+    /// advance - aux traffic must never cost the main path anything. Exact-duplicate ids refresh in place
+    /// (one recent tip per line for re-runs); otherwise LRU-evict tips past the byte budget.
+    ///
+    /// Deliberately NOT collapsing prefix-related tips of the same line: a forked child (section 7) extends
+    /// its parent's ids, and dropping the parent's tip on the child's insert would destroy the alternation
+    /// benefit. The byte budget bounds the duplication; E2 may add line collapsing once restore lands.
+    bool insert_tip(SavedItem item, bool is_aux);
+    /// E2's resume lookup: longest item whose full ids are a prefix of `ids` with exact image and cvec
+    /// identity and a matching stage count. Ties are impossible (lengths differ); live-chain ties prefer the
+    /// chain (no upload) at the call site. Null when nothing matches. A successful restore MUST call
+    /// note_use() on the returned item so the LRU clock counts mounts, not just inserts.
+    const SavedItem* find_best(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs,
+                               bool cvec) const;
+    /// E2 eligibility filter (Sol review): longest match excluding every previously rejected candidate, so
+    /// the call site can walk longest-first with an accumulating skip set. Skipping one pointer loops forever
+    /// with two invalid candidates (A skipped -> B invalid -> A returned again); the vector cannot. No store
+    /// mutation between calls: pointers stay valid. CPU-testable (see saved_state_test.cpp).
+    const SavedItem* find_best_except(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs,
+                                      bool cvec, const std::vector<const SavedItem*>& skip) const;
+    /// E2b exact-length prefix lookup: the item with ids.size()==k whose ids/cvec/images match, even when a
+    /// longer tip also matches (find_best would hide it). Null when none. No-upload MTP boundary repair needs
+    /// exactly this length. CPU-testable.
+    const SavedItem* find_exact(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs, bool cvec,
+                                int64_t k) const;
+    /// E2 mounts through the item find_best() returned: advances its last_use to now. False for null or foreign
+    /// pointers (never fabricates freshness).
+    bool note_use(const SavedItem* it);
+    /// S2 DELETE: drop all non-pinned items. Returns how many tips were dropped.
+    size_t drop_non_pinned();
+    /// S2 GET: roots then tips.
+    std::vector<InventoryEntry> inventory() const;
+    void clear();
+
+  private:
+    static bool same_key(const SavedItem& a, const SavedItem& b) {
+        return a.ids == b.ids && a.imgs == b.imgs && a.cvec == b.cvec;
+    }
+    void evict_tips();   // LRU among tips while tip_bytes_ > tip_budget_
+
+    std::vector<SavedItem> roots_;
+    std::vector<SavedItem> tips_;
+    uint64_t tip_budget_ = (uint64_t)(kDefaultTipCacheGib * 1073741824.0);
+    uint64_t tip_bytes_ = 0;
+    uint64_t clock_ = 0;
+    int n_stages_ = 1;
+};
+
+}  // namespace strata::program::saved_state
