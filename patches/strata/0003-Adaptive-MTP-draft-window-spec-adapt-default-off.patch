+    // T4 adaptive MTP cap state (streak/probe counters; last-use rounds per size).
+    bool adapt_ = false;                  // default off
+    int adapt_cap_ = kMaxT;               // largest MTP window adapt may use (the caller's S_mtp)
+    int cur_ = 1;                         // sticky anchor: the argmax domain is [1, min(cur_, M)]
+    int streak_t_ = 0;                    // the size the streaks below were earned at (0 = none running)
+    int full_streak_ = 0;                 // consecutive fully-accepted MTP windows at the dealt size
+    int zero_streak_ = 0;                 // consecutive zero-accept MTP windows at the dealt size
+    bool grow_pending_ = false;           // a +1 growth probe is owed to the next MTP round
+    int grow_probe_ = 0;                  // the absolute probed size (one above the size that earned it)
+    int last_cap_ = 0;                  // size mtp_cap() last dealt (0 = none yet); streaks count only for it
+    int64_t round_ = 0;                   // MTP rounds observed (stale-size clock)
+    std::array<int64_t, kMaxT + 1> last_seen_{};   // last round each size was tried (0 = never)
 };
 
 }  // namespace strata::spec
