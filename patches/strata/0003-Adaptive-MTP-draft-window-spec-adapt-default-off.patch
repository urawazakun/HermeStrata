diff --git a/src/spec/draft_policy.cpp b/src/spec/draft_policy.cpp
index 1ac7719..5fd463f 100644
--- a/src/spec/draft_policy.cpp
+++ b/src/spec/draft_policy.cpp
@@ -18,11 +18,71 @@ constexpr double kDecay = 0.97;       // lookup counts: older windows fade
 constexpr double kPriorQ[DraftPolicy::kBuckets] = {0.75, 0.88, 0.93, 0.96};
 constexpr double kPriorN = 4.0;
 constexpr int kProbes = 3;       // a lookup window size is tried this often before its guessed cost can veto it
+// T4: the adaptive MTP cap's exploration rules.
+constexpr int kGrowAfter = 3;       // consecutive fully-accepted windows before a one-round +1 probe
+constexpr int kShrinkAfter = 2;     // consecutive zero-accept rounds before the anchor drops one
+constexpr int kStaleRounds = 64;    // a size untried this long gets one probe
 
 }  // namespace
 
 DraftPolicy::DraftPolicy(int max_t, double margin)
-    : max_t_(std::clamp(max_t, 1, kMaxT)), margin_(margin) {}
+    : max_t_(std::clamp(max_t, 1, kMaxT)), margin_(margin) {
+    cur_ = max_t_;
+    last_seen_.fill(0);
+}
+
+void DraftPolicy::set_adapt(bool on, int ceiling) {
+    adapt_ = on;
+    adapt_cap_ = std::clamp(ceiling, 1, kMaxT);
+    cur_ = std::min(max_t_, adapt_cap_);
+    full_streak_ = zero_streak_ = grow_probe_ = last_cap_ = streak_t_ = 0;
+    grow_pending_ = false;
+}
+
+// The adaptive MTP cap: the best measured E(t)/cost(t) over [1, min(cur_, M)], where M is the tightest bound the
+// caller knows this round (min-p cutoff, first-window T=1) and cur_ is the sticky anchor the streak rules move.
+// One deal per round: the caller calls mtp_cap() once and passes the dealt size on; choose() only queries
+// through cap_for() and never deals, so a round cannot arm two probes or overwrite the dealt size. Streaks and
+// the stale clock count only windows the policy dealt (last_cap_): a caller that ignores the cap (or a lookup
+// round) only refreshes the EMAs. Exploration: after 3 consecutive fully-accepted MTP windows at one size the
+// next round probes one size higher (adopted when that round also fully accepts); after 2 consecutive
+// zero-accept MTP rounds at a size above 1 the anchor drops one immediately; a size untried for ~64 rounds
+// gets one probe (the stalest; ties go larger). Probes still report through observe(), so they only refresh
+// EMAs unless a streak rule adopts them.
+// Default off: mtp_cap(M) is just min(M, max_t_).
+int DraftPolicy::cap_for(int bound) const {
+    const int m = std::clamp(bound, 1, max_t_);
+    if (!adapt_) return m;
+    const int lim = std::min({m, cur_, adapt_cap_});
+    // one-round probes outrank the argmax: growth first, then a stale size.
+    if (grow_pending_ && grow_probe_ >= 1 && grow_probe_ <= m && grow_probe_ <= adapt_cap_)
+        return grow_probe_;
+    if (!grow_pending_) {
+        // the stalest size within reach (ties go larger) gets one probe once it lapses by ~64 rounds: the
+        // loop runs largest-first and only a strictly older size replaces the candidate.
+        int cand = 0;
+        int64_t oldest = round_;
+        for (int u = std::min(m, adapt_cap_); u >= 1; --u)
+            if (round_ - last_seen_[u] >= kStaleRounds && last_seen_[u] < oldest) {
+                oldest = last_seen_[u];
+                cand = u;
+            }
+        if (cand > 0) return cand;
+    }
+    int best = 1;
+    double best_r = -1.0;
+    for (int t = 1; t <= lim; ++t) {
+        const double r = mtp_tokens(t) / cost_ms(t);
+        if (r > best_r) { best_r = r; best = t; }
+    }
+    return best;
+}
+
+int DraftPolicy::mtp_cap(int bound) {
+    const int cap = cap_for(bound);
+    if (adapt_) last_cap_ = cap;
+    return cap;
+}
 
 int DraftPolicy::bucket(int match) {
     return match < 6 ? 0 : match < 12 ? 1 : match < 24 ? 2 : 3;
@@ -54,7 +114,7 @@ double DraftPolicy::mtp_tokens(int t) const {
 
 DraftPolicy::Pick DraftPolicy::choose(int t_mtp, int lookup_k, int match) const {
     Pick p;
-    p.t = std::clamp(t_mtp, 1, max_t_);
+    p.t = adapt_ ? cap_for(t_mtp) : std::clamp(t_mtp, 1, max_t_);
     if (lookup_k <= 0) return p;
     const double base = mtp_tokens(p.t) / cost_ms(p.t);
     const double q = lookup_rate(match);
@@ -91,10 +151,59 @@ void DraftPolicy::observe(bool lookup, int t, int accepted, int match, double ro
         const int b = bucket(match);
         ok_[b] = kDecay * ok_[b] + accepted;
         bad_[b] = kDecay * bad_[b] + (accepted < t - 1 ? 1.0 : 0.0);
-    } else {
-        const double got = accepted + 1.0;
-        mtp_tok_[t] = mtp_n_[t] > 0 ? (1.0 - kTokAlpha) * mtp_tok_[t] + kTokAlpha * got : got;
-        mtp_n_[t] += 1.0;
+        // an MTP probe still flies as an MTP window (from_sfx=false), so a lookup round only breaks the streaks;
+        // the probe stays due until its MTP round reports. The lookup consumes the outstanding MTP deal: that
+        // window never flew, so a later report of its size without a new deal is undealt.
+        full_streak_ = zero_streak_ = streak_t_ = 0;
+        last_cap_ = 0;
+        return;
+    }
+    const double got = accepted + 1.0;
+    mtp_tok_[t] = mtp_n_[t] > 0 ? (1.0 - kTokAlpha) * mtp_tok_[t] + kTokAlpha * got : got;
+    mtp_n_[t] += 1.0;
+    if (!adapt_) return;
+    // only the size the last mtp_cap() dealt advances the streaks, arms probes, or moves the stale clock, and
+    // every report consumes that deal: a second report of the same size without a new deal (or a report with
+    // no deal at all) only refreshes the EMAs above. Whether this report matched is decided before clearing.
+    const bool dealt = last_cap_ != 0 && last_cap_ == t;
+    last_cap_ = 0;
+    if (!dealt) return;
+    ++round_;
+    last_seen_[t] = round_;
+    // a growth probe resolves here: a full accept adopts the new anchor, anything less releases it.
+    if (grow_pending_ && t == grow_probe_) {
+        grow_pending_ = false;
+        grow_probe_ = 0;
+        if (accepted == t - 1) {
+            cur_ = std::min(t, adapt_cap_);
+            full_streak_ = zero_streak_ = streak_t_ = 0;
+            return;
+        }
+        full_streak_ = zero_streak_ = streak_t_ = 0;   // the probe itself does not seed the next streak
+        return;
+    }
+    // streaks run per dealt size: consecutive full (or zero) accepts at one size restart when it changes.
+    if (t != streak_t_) {
+        full_streak_ = zero_streak_ = 0;
+        streak_t_ = t;
+    }
+    const bool full = accepted == t - 1, zero = accepted == 0;
+    full_streak_ = full ? full_streak_ + 1 : 0;
+    zero_streak_ = zero ? zero_streak_ + 1 : 0;
+    if (zero_streak_ >= kShrinkAfter && t > 1) {
+        // shrink immediately: the anchor drops one and both streaks reset so a further drop needs fresh evidence.
+        cur_ = std::max(1, std::min(cur_, t) - 1);
+        grow_pending_ = false;
+        grow_probe_ = 0;
+        full_streak_ = zero_streak_ = streak_t_ = 0;
+        return;
+    }
+    // 3 consecutive full accepts at one size earn a one-round +1 probe (the next round's mtp_cap deals it).
+    // Arming here (not on the next observe) keeps the "next round" promise even if the caller skips a deal.
+    if (full_streak_ >= kGrowAfter && !grow_pending_ && t + 1 <= std::min(max_t_, adapt_cap_)) {
+        grow_probe_ = t + 1;
+        grow_pending_ = true;
+        full_streak_ = 0;
     }
 }
 
