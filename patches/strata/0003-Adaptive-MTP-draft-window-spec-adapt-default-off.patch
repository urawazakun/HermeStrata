+        p.set_adapt(true, 6);
+        check(p.adapt_on(), "set_adapt(true) turns adapt on");
+        feed(p, 2, 1, 60, cheap_small_cost(2));
+        feed(p, 6, 5, 60, cheap_small_cost(6));
+        check(p.mtp_cap(6) == 2, "adapt on: the best E(t)/cost(t) wins over the bigger window");
+        check(p.choose(6, 0, 0).t == 2, "adapt on: choose() clamps the MTP side to the cap");
+        check(p.mtp_cap(4) == 2, "adapt on: the caller's tighter bound still applies");
+        p.set_adapt(false);
+        check(p.choose(6, 0, 0).t == 6, "set_adapt(false) restores the pass-through");
+    }
+    // T4: on - 3 consecutive full accepts at one size probe +1 for one round; a full probe is kept.
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        p.observe(false, 6, 5, 0, cost(6));   // seed every size's EMAs once so the mid-test deals stay put
+        for (int t = 5; t >= 3; --t) p.observe(false, t, t - 1, 0, cost(t));
+        for (int i = 0; i < 3; ++i) round(p, 2, 1, cost(2));   // 3 dealt full accepts at size 2 ...
+        check(p.mtp_cap(6) == 3, "3 full accepts: one round probes +1");
+        p.observe(false, 3, 2, 0, cost(3));   // the probe fully accepts: adopted
+        check(p.mtp_cap(6) == 3, "a fully-accepted probe is kept");
+        check(p.mtp_cap(6) != 4, "a kept probe does not jump twice in one round");
+    }
+    // T4: on - a rejected growth probe is released (no double probe).
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        p.observe(false, 6, 5, 0, cost(6));
+        for (int t = 5; t >= 3; --t) p.observe(false, t, t - 1, 0, cost(t));   // seed EMAs (no deals yet)
+        for (int i = 0; i < 3; ++i) round(p, 2, 1, cost(2));
+        check(p.mtp_cap(6) == 3, "growth probe is due");
+        p.observe(false, 3, 0, 0, cost(3));   // the probe rejects everything
+        check(p.mtp_cap(2) == 2, "a rejected probe falls back to the dealt size");
+    }
+    // T4: on - 2 consecutive zero-accept rounds shrink the anchor immediately.
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        feed(p, 2, 1, 60, cheap_small_cost(2));
+        feed(p, 6, 5, 60, cheap_small_cost(6));
+        check(p.mtp_cap(6) == 2, "shrink setup: the cap sits at 2");
+        round(p, 6, 0, cheap_small_cost(2));   // dealt a 2, zero accepts ...
+        check(p.mtp_cap(6) == 2, "one zero-accept round does not shrink yet");
+        p.observe(false, 2, 0, 0, cheap_small_cost(2));   // ... second zero at the dealt size
+        check(p.mtp_cap(6) == 1, "2 zero-accept rounds: the anchor drops one immediately");
+    }
+    // T4: on - a size untried for ~64 rounds gets one probe (stalest; ties go larger).
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        // idle at size 2 without arming growth (never 3 full in a row) or shrinking (never 2 zeros in a
+        // row). The seed full accept puts measured size 2 above unmeasured size 1's prior rate, so every idle
+        // round deals 2 while 1,3..6 go stale.
+        round(p, 2, 1, cheap_small_cost(2));
+        for (int i = 0; i < 63; ++i) round(p, 2, i % 2 == 0 ? 0 : 1, cheap_small_cost(2));
+        check(p.mtp_cap(6) == 6, "a stale size is probed (ties go larger)");
+        p.observe(false, 6, 1, 0, cheap_small_cost(6));   // partial: refreshes 6, seeds no streak
+        check(p.mtp_cap(6) == 5, "after the probe the next-stalest size is due");
+        p.observe(false, 5, 1, 0, cheap_small_cost(5));
+        // refresh 1,3,4 through tight bounds (each deals exactly that size) and re-assert 2: nothing is
+        // stale anymore, so the measured best rules again.
+        round(p, 1, 0, cheap_small_cost(1));
+        round(p, 3, 1, cheap_small_cost(3));
+        round(p, 4, 1, cheap_small_cost(4));
+        round(p, 2, 1, cheap_small_cost(2));
+        check(p.mtp_cap(6) == 2, "fresh sizes leave the argmax alone");
+    }
+    // T4: one deal feeds one report - a duplicate report of the same size without a new deal advances nothing.
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        feed(p, 2, 1, 20, cheap_small_cost(2));
+        feed(p, 6, 5, 20, cheap_small_cost(6));
+        round(p, 6, 1, cheap_small_cost(2));              // deals 2, full: a streak of 1 at size 2
+        p.observe(false, 2, 1, 0, cheap_small_cost(2));   // duplicate without a deal: ignored
+        round(p, 6, 1, cheap_small_cost(2));              // a streak of 2, not 3: no growth probe due
+        check(p.mtp_cap(6) == 2, "a duplicate observe without a deal does not extend the streak");
+    }
+    // T4: a lookup (or mismatched-size) report consumes the outstanding deal.
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        feed(p, 2, 1, 20, cheap_small_cost(2));
+        feed(p, 6, 5, 20, cheap_small_cost(6));
+        check(p.mtp_cap(6) == 2, "lookup setup deals size 2");
+        p.observe(true, 4, 2, 8, cheap_small_cost(4));    // a lookup flies instead: deal consumed, streaks broken
+        p.observe(false, 2, 1, 0, cheap_small_cost(2));   // undealt same-size report: ignored
+        round(p, 6, 1, cheap_small_cost(2));              // a streak of 1 ...
+        round(p, 6, 1, cheap_small_cost(2));              // ... then 2, not 3
+        check(p.mtp_cap(6) == 2, "a lookup consumes the deal: a later undealt report advances nothing");
+        check(p.mtp_cap(6) == 2, "mismatch setup deals size 2 again");
+        p.observe(false, 6, 0, 0, cheap_small_cost(6));   // mismatched size: deal consumed, streaks kept
+        p.observe(false, 2, 1, 0, cheap_small_cost(2));   // undealt same-size report: ignored
+        check(p.mtp_cap(6) == 2, "a mismatch consumes the deal too");
+    }
+    // T4: streaks run per dealt size - alternating sizes accumulate neither growth nor shrink evidence.
+    {
+        DraftPolicy p(6);
+        p.set_adapt(true, 6);
+        feed(p, 2, 1, 40, 10.0);   // size 2: 2 tok / 10 ms
+        feed(p, 3, 2, 40, 10.0);   // size 3: 3 tok / 10 ms, the measured best
+        check(round(p, 3, 2, 10.0) == 3, "alternation deals size 3");
+        check(round(p, 2, 1, 10.0) == 2, "alternation deals size 2");
+        check(round(p, 3, 2, 10.0) == 3, "alternation deals size 3 again");
+        check(round(p, 2, 1, 10.0) == 2, "alternation deals size 2 again");
+        check(round(p, 3, 2, 10.0) == 3, "three fulls across sizes");
+        check(round(p, 2, 1, 10.0) == 2, "six fulls across sizes");
+        check(p.mtp_cap(6) == 3, "alternating fulls at two sizes arm no +1 growth probe");
+        check(round(p, 3, 0, 10.0) == 3, "alternating zeros deal size 3");
+        check(round(p, 2, 0, 10.0) == 2, "alternating zeros deal size 2");
+        check(p.mtp_cap(6) == 3, "alternating zeros at two sizes shrink nothing");
+    }
     std::printf(g_fail ? "FAIL\n" : "PASS\n");
     return g_fail ? 1 : 0;
 }
