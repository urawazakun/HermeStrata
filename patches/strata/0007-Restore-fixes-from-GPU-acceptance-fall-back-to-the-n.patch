+        saved::SavedStateStore st;
+        saved::SavedItem gen = make_line(100, 0);
+        saved::SavedItem shr = make_shared_prompt_item(60, 0);
+        check(shr.mtp.kv.empty() && shr.mtp.cells == 59, "F2 shared prompt carries MTP metadata only");
+        check(saved::prompt_for_shared_ok(shr, gen), "F2 shared-MTP pair is coherent");
+        const uint64_t owned_bytes = make_prompt_item(60, 0).payload_bytes() + gen.payload_bytes();
+        check(st.insert_tip_pair(std::move(shr), std::move(gen), false), "F2 shared-MTP pair stores");
+        check(st.tip_bytes() < owned_bytes, "F2 shared MTP rows are not copied twice");
+        std::vector<int32_t> next = req_at(0, 60);
+        for (int i = 0; i < 20; ++i) next.push_back(1000 + i);
+        const saved::SavedItem* b = st.find_best(next, no_imgs, true);
+        check(b != nullptr && b->ids.size() == 60 && b->mtp.kv.empty() && b->mtp.cells == 59,
+              "F2 re-rendered turn resumes at the shared-MTP prompt point");
+        check(st.find_best(req_at(0, 120), no_imgs, true)->ids.size() == 100,
+              "F2 verbatim echo still takes the generation point");
+        // owner accessor: prompt -> gen; gen/root/foreign -> null.
+        const saved::SavedItem* ge = st.find_exact(req_at(0, 120), no_imgs, true, 100);
+        check(ge != nullptr && st.tip_gen_for(b) == ge, "F2 tip_gen_for maps prompt to its owner");
+        check(st.tip_gen_for(ge) == nullptr, "F2 tip_gen_for(null) for a generation point");
+        check(st.tip_gen_for(nullptr) == nullptr, "F2 tip_gen_for(null) is null");
+        saved::SavedItem foreign = make_line(60, 0);
+        check(st.tip_gen_for(&foreign) == nullptr, "F2 tip_gen_for(foreign) is null");
+        // a shared prompt with wrong metadata still rejected (cells must be exactly n-1).
+        saved::SavedItem bad = make_shared_prompt_item(60, 0);
+        bad.mtp.cells = 58;
+        check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 1,
+              "F2 shared prompt with short cells rejected");
+    }
+    {   // F2 shared-MTP coverage: the backing must really hold every row the prompt claims - an owner
+        // valid_from above the prompt's means the prompt claims rows absent from the backing.
+        saved::SavedItem gen = make_line(100, 0);
+        check(gen.complete(), "F2 coverage fixture itself is complete");
+        gen.mtp.valid_from = 5;
+        saved::SavedItem shr = make_shared_prompt_item(60, 0);   // valid_from 0 < owner 5
+        check(!saved::prompt_for_shared_ok(shr, gen), "F2 owner bound above prompt rejected");
+        saved::SavedItem shr_eq = make_shared_prompt_item(60, 0);
+        shr_eq.mtp.valid_from = 5;   // equal backing bound accepted
+        check(saved::prompt_for_shared_ok(shr_eq, gen), "F2 equal backing bound accepted");
+        saved::SavedItem shr_lo = make_shared_prompt_item(60, 0);
+        shr_lo.mtp.valid_from = 9;   // lower backing bound (owner covers more) accepted
+        check(saved::prompt_for_shared_ok(shr_lo, gen), "F2 lower backing bound accepted");
+        saved::SavedStateStore st;
+        check(st.insert_tip_pair(std::move(shr_eq), std::move(gen), false),
+              "F2 equal-bound shared pair stores");
+    }
+    {   // F2b: the prompt point sits at the LAST TURN BOUNDARY L, not the raw prompt end n. Minimal
+        // fixture modelled on the probe (raw n=70, boundary L=60, 10-token generation-header tail):
+        // the parent prompt's raw end can never be a prefix of the next turn (the header re-renders as
+        // a history assistant turn), while L is. The pair stores (boundary@60, gen@100); the next-turn
+        // request shares [0, 60) then diverges (re-rendered assistant + new user).
+        saved::SavedItem gen = make_line(100, 0);   // prompt 0..69 + 30 generated (reasoning) ids
+        saved::SavedItem bnd = make_shared_prompt_item(60, 0);   // boundary-L point (engine form)
+        check(bnd.mtp.kv.empty() && bnd.mtp.cells == 59, "F2b boundary point has MTP metadata only");
+        check(saved::prompt_for_shared_ok(bnd, gen), "F2b boundary/gen pair is coherent");
+        saved::SavedStateStore st;
+        check(st.insert_tip_pair(std::move(bnd), std::move(gen), false), "F2b boundary pair stores");
+        check(st.tips() == 1 && st.tip_points() == 2, "F2b one line holds two restorable points");
+        std::vector<int32_t> next = req_at(0, 60);   // shared boundary prefix ...
+        for (int i = 0; i < 25; ++i) next.push_back(1000 + i);   // ... then re-rendered assistant + new user
+        const saved::SavedItem* b = st.find_best(next, no_imgs, true);
+        check(b != nullptr && b->ids.size() == 60, "F2b next turn resumes at the boundary point (60)");
+        check(b != nullptr && (int64_t) next.size() - (int64_t) b->ids.size() == 25,
+              "F2b suffix is the re-rendered assistant + new user only");
+        check(st.find_exact(next, no_imgs, true, 100) == nullptr,
+              "F2b generation point is not a prefix of the re-rendered prompt");
+        const saved::SavedItem* pe = st.find_exact(next, no_imgs, true, 60);
+        check(pe != nullptr && pe->ids.size() == 60, "F2b boundary point exact-addressable at 60");
+        check(pe != nullptr && pe->stages[0].kv.empty(), "F2b boundary point stores no KV copy (shared)");
+        check(pe != nullptr && pe->mtp.kv.empty() && pe->mtp.cells == 59,
+              "F2b boundary MTP is cells=L-1 metadata over the shared backing");
+        check(pe != nullptr && pe->mtp.valid_from >= 0 && pe->mtp.valid_from <= pe->mtp.cells,
+              "F2b boundary MTP valid_from inside [0, cells]");
+        check(pe != nullptr && pe->boundary.complete(),
+              "F2b exact MTP repair row R_(L-1) stored with the boundary point");
+        check(pe != nullptr && pe->stages[0].rec.ple_prev[0] == 58 && pe->stages[0].rec.ple_prev[1] == 59,
+              "F2b ple window is the boundary ids' last two");
+    }
+    {   // F2b old-vs-new: the same next-turn request (shared [0, 60), changed header past L)
+        // against the OLD raw-end store resumes the root at 40, while the boundary store resumes tip60
+        // after unrelated child traffic. Rejection of the raw point and the improvement, together.
+        std::vector<int32_t> next = req_at(0, 60);
+        for (int i = 0; i < 20; ++i) next.push_back(4000 + i);   // re-rendered assistant + new user
+        {
+            saved::SavedStateStore old;
+            check(old.insert_root(make_line(40, 0)), "F2b-old root40 stores");
+            check(old.insert_tip_pair(make_prompt_item(70, 0), make_line(100, 0), false),
+                  "F2b-old raw70/gen100 pair stores");
+            const saved::SavedItem* b = old.find_best(next, no_imgs, true);
+            check(b != nullptr && b->ids.size() == 40 && b->kind == saved::Kind::Root,
+                  "F2b-old next turn falls back to root40 (raw70/gen100 never a prefix)");
+        }
+        {
+            saved::SavedStateStore now;
+            check(now.insert_root(make_line(40, 0)), "F2b-new root40 stores");
+            check(now.insert_tip_pair(make_shared_prompt_item(60, 0), make_line(100, 0), false),
+                  "F2b-new boundary60/gen100 pair stores");
+            check(now.insert_tip(make_line(75, 5000), false), "F2b-new child tip stores alongside");
+            const saved::SavedItem* b = now.find_best(next, no_imgs, true);
+            check(b != nullptr && b->ids.size() == 60 && b->kind == saved::Kind::Tip,
+                  "F2b-new next turn resumes tip60 after child traffic");
+            check(b != nullptr && (int64_t) next.size() - (int64_t) b->ids.size() == 20,
+                  "F2b-new suffix is the re-rendered tail only (20, not 40)");
+        }
+    }
+    {   // F2b: a boundary point with a malformed or missing MTP repair row is rejected (E2 cannot pair
+        // cell L-1 without R_(L-1)); the generation tip still stores alone.
+        {
+            saved::SavedItem bad = make_shared_prompt_item(60, 0);
+            bad.boundary.row.clear();   // missing repair row
+            check(!bad.boundary.complete(), "F2b missing row is incomplete");
+            check(!saved::prompt_for_shared_ok(bad, make_line(100, 0)),
+                  "F2b missing-row boundary pair incoherent");
+            saved::SavedStateStore st;
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2b missing-row boundary pair rejected");
+        }
+        {
+            saved::SavedItem bad = make_shared_prompt_item(60, 0);
+            bad.boundary.row.pop_back();   // truncated repair row
+            check(!saved::prompt_for_shared_ok(bad, make_line(100, 0)),
+                  "F2b truncated-row boundary pair incoherent");
+            saved::SavedStateStore st;
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2b truncated-row boundary pair rejected");
+        }
+        {
+            saved::SavedItem bad = make_shared_prompt_item(60, 0);
+            bad.mtp.cells = 60;   // cells must be exactly L-1
+            check(!saved::prompt_for_shared_ok(bad, make_line(100, 0)),
+                  "F2b wrong-cells boundary pair incoherent");
+            saved::SavedStateStore st;
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2b wrong-cells boundary pair rejected");
+        }
+        {
+            saved::SavedItem bad = make_shared_prompt_item(60, 0);
+            bad.mtp.valid_from = 60;   // valid_from outside [0, cells]
+            check(!saved::prompt_for_shared_ok(bad, make_line(100, 0)),
+                  "F2b out-of-range valid_from rejected");
+        }
+    }
+    {   // F2 point metadata: the store sets each point's bytes/last_use (prior API contract); note_use
+        // refreshes the entry AND both points together.
+        saved::SavedStateStore st;
+        check(st.insert_tip_pair(make_shared_prompt_item(60, 0), make_line(100, 0), false),
+              "F2 pair stores");
+        const saved::SavedItem* pe = st.find_exact(req_at(0, 70), no_imgs, true, 60);
+        const saved::SavedItem* ge = st.find_exact(req_at(0, 120), no_imgs, true, 100);
+        check(pe != nullptr && ge != nullptr, "F2 both points addressable");
+        check(pe->bytes == pe->payload_bytes() && ge->bytes == ge->payload_bytes(),
+              "F2 store sets each point's bytes");
+        check(pe->last_use > 0 && ge->last_use > 0 && pe->last_use == ge->last_use,
+              "F2 store sets both points' last_use consistently");
+        check(pe->bytes + ge->bytes == st.tip_bytes(), "F2 point bytes sum to the entry bytes");
+        check(st.note_use(pe), "F2 note_use(prompt) succeeds");
+        check(pe->last_use == ge->last_use && pe->last_use == st.clock(),
+              "F2 note_use refreshes both points plus the entry clock");
+    }
+    {   // F2 x F1: the retry walk composes with pairs - longest-first over gen, prompt, then the root, with
+        // each sub-point retiring independently so the walk always terminates on the eligible root.
+        saved::SavedStateStore st;
+        check(st.insert_root(make_line(40, 0)), "F2 root(40) stores");
+        check(st.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false), "F2 pair(60,100) stores");
+        std::vector<const saved::SavedItem*> skip;
+        std::vector<int> seen;
+        for (;;) {
+            const saved::SavedItem* cand = st.find_best_except(req, no_imgs, true, skip);
+            if (cand == nullptr) break;
+            seen.push_back((int) cand->ids.size());
+            skip.push_back(cand);
+        }
+        check(seen == std::vector<int>{100, 60, 40}, "F2 walk visits gen, prompt, then root (no revisit)");
+    }
+    {   // F2: incoherent pairs never store; aux pair inserts are a strict no-op (clock frozen); exact
+        // duplicates replace in place; a single insert over a paired gen key replaces the whole entry.
+        saved::SavedStateStore st;
+        {
+            saved::SavedItem bad = make_line(60, 0);   // a full KV copy is NOT shared storage
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2 duplicate-KV prompt rejected");
+        }
+        {
+            saved::SavedItem bad = make_prompt_item(60, 0);
+            bad.ids[59] = 9999;   // prompt is not the exact prompt end of the gen line
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2 non-prefix prompt rejected");
+        }
+        check(!st.insert_tip_pair(make_prompt_item(100, 0), make_line(100, 0), false) && st.tips() == 0,
+              "F2 prompt == gen length rejected (strict prefix required)");
+        {
+            saved::SavedItem bad = make_prompt_item(60, 0);
+            bad.mtp.cells = 99;   // MTP range disagrees with the prompt end
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2 wrong-range prompt MTP rejected");
+        }
+        {
+            saved::SavedItem bad = make_prompt_item(60, 0);
+            bad.stages[0].idx[0].pooled_rows += 1;   // indexer sized for generation, not the prompt
+            check(!st.insert_tip_pair(std::move(bad), make_line(100, 0), false) && st.tips() == 0,
+                  "F2 generation-sized prompt indexer rejected");
+        }
+        saved::SavedStateStore st2;
+        check(st2.clock() == 0, "F2 fresh clock is 0");
+        check(!st2.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), true),
+              "F2 aux pair insert returns false");
+        check(st2.tips() == 0 && st2.clock() == 0, "F2 aux pair stores nothing and freezes the clock");
+        saved::SavedStateStore st3;
+        check(st3.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false), "F2 pair stores");
+        const uint64_t b0 = st3.tip_bytes();
+        check(st3.insert_tip_pair(make_prompt_item(60, 0), make_line(100, 0), false),
+              "F2 duplicate pair returns true");
+        check(st3.tips() == 1 && st3.tip_points() == 2 && st3.tip_bytes() == b0,
+              "F2 duplicate pair replaces in place (no growth)");
+        check(st3.insert_tip(make_line(100, 0), false), "F2 single over the paired gen key returns true");
+        check(st3.tips() == 1 && st3.tip_points() == 1, "F2 single replaces the pair (downgrade)");
+    }
     {   // E5: exact-duplicate replacement refreshes in place (one recent tip per line for re-runs).
         saved::SavedStateStore st;
         check(st.insert_tip(make_line(50, 1000), false), "tip stores");
