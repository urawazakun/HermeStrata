+/// F2: one tip line's TWO coherent restorable points (see the file-top note).
+///
+/// The prompt point is the state at exactly the LAST TURN BOUNDARY k inside the prompt (F2b: the start of
+/// the trailing assistant generation header - the raw prompt end n is NOT a prefix of the next request,
+/// which re-renders that header as a history assistant turn without reasoning). The generation point
+/// is the previous tip behaviour (prompt + generated ids at DONE, length G).
+///
+/// Capture contract (E1/E2, implemented in generate.cpp; the store only gates coherence):
+/// - The prompt's recurrent payload (GDN/PLE/tails + ple_prev over the BOUNDARY ids), indexer payloads,
+///   MTP metadata (cells = k-1) and boundary R_(k-1) are captured at the prefill segment ending at k,
+///   when the session holds exactly the boundary-k state and BEFORE any generated input is committed.
+///   A speculative multi-row verifier state, or later decode state sliced to shorter ids, is NOT the
+///   boundary: use a coherent exact-k snapshot mechanism. MTP rows [0, k-1) need their exact source -
+///   the boundary snapshot source must be retained before scratch/decode changes it.
+/// - Post-DONE the final KV [0, G) is captured once with the generation point. The main KV prefix is
+///   immutable (decode only appends cells past the prompt), so the prompt point SHARES it: the prompt stores
+///   NO main-KV copy (its StagePayload::kv vectors are empty) and logically covers the shorter page range
+///   [0, k). The drafter rows [0, k-1) are likewise immutable during decode, so the prompt shares those
+///   too: its MtpPayload keeps its own cells/valid_from metadata (cells = k-1) with an EMPTY kv (no second
+///   draft-KV copy); E2 restores rows [0, k-1) from the generation backing. (An owned prompt MTP copy also
+///   validates, for tests.)
+/// - The prompt's indexer/recurrent/boundary payloads are its own (boundary-only, never generation state).
+///
+/// E2 mount recipe for a prompt point p of entry e (gen g of length G, boundary length k, request ids P
+/// with P[k] first suffix token): upload the KV prefix - the first kv_pool_bytes(fmt, k, gm...) bytes of
+/// each of g's layer vectors (pages are contiguous, so the prefix is a byte-prefix) - restore
+/// recurrent/indexer from p, MTP metadata from p with rows [0, k-1) from g (or p's own copy when present),
+/// then pair p.boundary R_(k-1) with P[k] before the suffix prefill (same boundary block as a generation
+/// mount, at k).
+///
+/// Budget: entry bytes = gen.payload_bytes() + prompt.payload_bytes(); the shared KV is counted ONCE (it only
+/// exists in gen), both recurrent payloads are counted. Eviction removes the pair coherently (one LRU entry).
+struct TipEntry {
+    SavedItem prompt;        ///< prompt-end point; StagePayload::kv empty (shares gen's KV); valid iff has_prompt
+    SavedItem gen;           ///< generation-end point; owns the full shared KV [0, L)
+    bool has_prompt = false;
+    uint64_t bytes = 0;      ///< set by the store on insert (gen + prompt, shared KV once)
+    uint64_t last_use = 0;   ///< one LRU clock per LINE: a mount of either point refreshes the entry
+    uint64_t entry_bytes() const {
+        return gen.payload_bytes() + (has_prompt ? prompt.payload_bytes() : 0);
+    }
+    bool complete() const;
+};
+
+/// F2 coherence gate: p is a valid shared-KV prompt point for generation item g. g must be complete on its
+/// own; p must be a strict prefix line of g (ids, cvec, images below the boundary length k), share its
+/// geometry/stages, carry a complete boundary of the same shape (a DIFFERENT row: R_(k-1), not R_(G-1)),
+/// own exact MTP pairs [0, k-1), boundary-only recurrent/indexer state of the right sizes, and NO main-KV
+/// copy (sharing is structural).
+inline bool prompt_for_shared_ok(const SavedItem& p, const SavedItem& g) {
+    const int64_t n = (int64_t)p.ids.size();
+    const int64_t L = (int64_t)g.ids.size();
+    if (n < 1 || L < 2 || n >= L) return false;
+    if (!g.complete()) return false;
+    if (g.stages.empty() || g.stages[0].kv.empty()) return false;
+    if (!is_prefix(p.ids, g.ids)) return false;   // exact boundary-k ids: a strict prefix of the gen line
+    if (p.cvec != g.cvec) return false;
+    if (p.imgs != imgs_below(g.imgs, n)) return false;
+    if (p.geom != g.geom) return false;
+    if (p.n_stages != g.n_stages || (int)p.stages.size() != p.n_stages) return false;
+    if (!p.boundary.complete()) return false;
+    if (p.boundary.hc != g.boundary.hc || p.boundary.n_embd != g.boundary.n_embd) return false;
+    const int64_t prow = n / p.geom.idx_block + 1;   // pooled rows covering [0, n)
+    for (const StagePayload& s : p.stages) {
+        if (s.rec.gdn.empty() || s.rec.tails.empty()) return false;
+        if (!s.kv.empty()) return false;   // NO duplicate KV: the prompt shares gen's storage
+        if ((int64_t)s.idx.size() != p.geom.n_qsa_layers) return false;
+        if (s.rec.ple_prev[0] != (n >= 2 ? p.ids[(size_t)(n - 2)] : -1) ||
+            s.rec.ple_prev[1] != p.ids[(size_t)(n - 1)])
+            return false;
+        for (const IndexerPayload& x : s.idx) {
+            if (x.pooled_rows != prow) return false;
+            if ((int64_t)x.pooled.size() != prow * p.geom.idx_dim * 4) return false;
+            if ((int64_t)x.dead_key.size() != p.geom.idx_dim * 4) return false;
+            if (x.block_pos.size() != 1) return false;
+        }
+    }
+    // MTP: exact pairs [0, n-1) (n == 1: no pair exists, mtp stays empty), same format as gen's KV. Two
+    // modes: OWNED (mtp.kv holds the prompt's own copy - tests) or SHARED (mtp.kv empty: rows [0, n-1) come
+    // from the generation backing, which decode never rewrites; only the cells/valid_from metadata is the
+    // prompt's own). Either way no full second copy of anything large exists.
+    if (n == 1) {
+        if (!p.mtp.kv.empty() || p.mtp.cells != 0) return false;
+    } else if (p.mtp.kv.empty()) {
+        if (p.mtp.cells != n - 1) return false;
+        if (p.mtp.valid_from < 0 || p.mtp.valid_from > p.mtp.cells) return false;
+        if (g.mtp.kv.empty() || g.mtp.kv.size() != 1) return false;
+        if (g.mtp.cells < p.mtp.cells) return false;   // the gen backing covers the prompt range
+        // Coverage: the prompt claims real pairs from p.mtp.valid_from, so the backing must really hold
+        // rows there - a higher owner bound means the prompt claims rows absent from the backing.
+        if (g.mtp.valid_from > p.mtp.valid_from) return false;
+        const KvLayerPayload& m = g.mtp.kv[0];
+        if (m.fmt != g.stages[0].kv[0].fmt) return false;
+        if (!kv_prefix_ok(m, p.mtp.cells, p.geom)) return false;
+    } else {
+        if (p.mtp.kv.empty() || p.mtp.kv.size() != 1) return false;
+        if (p.mtp.cells != n - 1) return false;
+        if (p.mtp.valid_from < 0 || p.mtp.valid_from > p.mtp.cells) return false;
+        const KvLayerPayload& m = p.mtp.kv[0];
+        if (m.fmt != g.stages[0].kv[0].fmt) return false;
+        if (!kv_blob_ok(m, p.mtp.cells, p.geom)) return false;
+    }
+    return true;
+}
