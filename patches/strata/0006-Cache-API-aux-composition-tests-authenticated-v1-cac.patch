+    def _cache_exchange(self, op, timeout, fifo_timeout) -> dict:
+        """One FIFO-serialized cache exchange. The fifo wait itself is bounded (CACHE_FIFO_TIMEOUT_S):
+        on timeout nothing is sent and the running generation is untouched - the caller answers 503 busy."""
+        if not self.fifo.acquire(timeout=fifo_timeout):
+            raise TimeoutError("the engine is busy; try again shortly")
+        try:
+            if hasattr(self.engine, "alive") and not self.engine.alive():
+                code = self.engine.exit_code() if hasattr(self.engine, "exit_code") else None
+                raise EngineDied(f"the engine stopped unexpectedly (exit code {code})")
+            rpc = getattr(self.engine, "cache_rpc", None)
+            if rpc is None:
+                # MockEngine speaks cache_rpc (honest empty); anything else without it is unsupported -
+                # never a fabricated success (a DELETE must not claim tips were cleared).
+                raise NotImplementedError("this engine does not support /v1/cache")
+            return rpc(op, timeout=timeout)
+        finally:
+            self.fifo.release()
+
+    def cache_inventory(self, timeout=CACHE_TIMEOUT_S, fifo_timeout=CACHE_FIFO_TIMEOUT_S) -> dict:
+        """S2 GET /v1/cache: the engine's SavedState inventory, serialized through the same FIFO as
+        generations and vision encodes (a running or queued generation finishes first; an aux wait never
+        blocks it)."""
+        return self._cache_exchange("INVENTORY", timeout, fifo_timeout)
+
+    def cache_drop(self, timeout=CACHE_TIMEOUT_S, fifo_timeout=CACHE_FIFO_TIMEOUT_S) -> dict:
+        """S2 DELETE /v1/cache: drop all non-pinned tips (pinned memory/disk roots survive), then the
+        post-drop inventory plus the dropped count. Same FIFO serialization as cache_inventory."""
+        return self._cache_exchange("DROP", timeout, fifo_timeout)
+
