+        self.disk_enabled = True
+
+    def cache_rpc(self, op, timeout=None):
+        format_cache_command(op)
+        if op == "DROP":
+            dropped = len(self.tips)
+            self.tips = []
+            return {"dropped": dropped, "memory": self._mem(), "disk": self._disk()}
+        return {"memory": self._mem(), "disk": self._disk()}
+
+    def _mem(self):
+        return {"tip_budget_bytes": self.budget,
+                "tip_bytes": sum(t["bytes"] for t in self.tips),
+                "items": list(self.roots) + list(self.tips)}
+
+    def _disk(self):
+        return {"enabled": self.disk_enabled, "items": list(self.disk)}
