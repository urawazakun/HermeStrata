+    def test_pump_keeps_process_local_refs(self):
+        """A restart's fresh queue never sees the old proc's EOF; ended follows only the current proc."""
+        import queue
+        import threading
+
+        release = threading.Event()
+
+        def gen():
+            yield "T 1\n"
+            release.wait(10)
+
+        class Stdout:
+            def __init__(self, g):
+                self.g = g
+
+            def __iter__(self):
+                return self.g
+
+        eng = StrataEngine.__new__(StrataEngine)
+        eng.proc = type("P", (), {})()
+        eng.proc.stdout = Stdout(gen())
+        old_q = eng.lines = queue.Queue()
+        eng.ended = False
+        t = threading.Thread(target=eng._pump, args=(eng.proc, old_q), daemon=True)
+        t.start()
+        self.assertEqual(old_q.get(timeout=10), "T 1\n")
+        eng.lines = queue.Queue()                     # a restart swaps the queue ...
+        eng.proc = type("P2", (), {})()               # ... and the process
+        release.set()
+        t.join(10)
+        self.assertTrue(old_q.get(timeout=10) is None)  # the old EOF lands in the old queue
+        self.assertTrue(eng.lines.empty())              # the fresh queue is uncontaminated
+        self.assertFalse(eng.ended)                     # a dead stranger marks nothing alive
