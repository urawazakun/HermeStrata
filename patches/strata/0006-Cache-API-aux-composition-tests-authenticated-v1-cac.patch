+    def test_queued_generation_serializes_without_stdout_interference(self):
+        gate = threading.Event()
+        entered = threading.Event()
+
+        class Gated(FakeCacheEngine):
+            def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+                entered.set()
+                self.last_ids = list(ids)
+                self.last_sampling = dict(sampling or {})
+                gate.wait(30)
+                yield from MockEngine.generate(self, ids, max_new, sampling, cancel, embeddings)
+
+        tok = ByteTokenizer()
+        eng = Gated(tok, "</think>\n\nok", max_context=CTX)
+        svc = Service(eng, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"))
+        httpd = serve(svc, port=0)
+        try:
+            base = f"http://127.0.0.1:{httpd.server_address[1]}"
+            box, done = {}, threading.Event()
+
+            def gen():
+                body = {"model": "m", "messages": [{"role": "user", "content": "hi"}], "max_tokens": 5}
+                r = urllib.request.Request(base + "/v1/chat/completions", data=json.dumps(body).encode(),
+                                           headers={"Content-Type": "application/json"})
+                try:
+                    with urllib.request.urlopen(r, timeout=30) as resp:
+                        box["r"] = (resp.status, json.loads(resp.read()))
+                except Exception as e:  # noqa: BLE001 - record thread errors for the main thread
+                    box["e"] = e
+                finally:
+                    done.set()
+
+            t = threading.Thread(target=gen, daemon=True)
+            t.start()
+            self.assertTrue(entered.wait(30))         # the generation holds the fifo ...
+            cbox, cdone = {}, threading.Event()
+
+            def cache():
+                try:
+                    with urllib.request.urlopen(base + "/v1/cache", timeout=30) as resp:
+                        cbox["r"] = (resp.status, json.loads(resp.read()))
+                except Exception as e:  # noqa: BLE001 - as above
+                    cbox["e"] = e
+                finally:
+                    cdone.set()
+
+            ct = threading.Thread(target=cache, daemon=True)
+            ct.start()
+            self.assertFalse(cdone.wait(1.0))         # ... so the cache waits behind it
+            gate.set()
+            self.assertTrue(done.wait(30), box)
+            self.assertTrue(cdone.wait(30), cbox)
+            t.join(30)
+            ct.join(30)
+            self.assertNotIn("e", box, box.get("e"))
+            self.assertNotIn("e", cbox, cbox.get("e"))
+            self.assertEqual(box["r"][0], 200, box["r"])      # the answer is intact: no stdout interference
+            self.assertEqual(box["r"][1]["usage"]["completion_tokens"], 5)
+            self.assertEqual(cbox["r"][0], 200, cbox["r"])
+            self.assertEqual(len(cbox["r"][1]["memory"]["items"]), 3)
+        finally:
+            gate.set()
+            httpd.shutdown()
+            httpd.server_close()
