+    def test_held_fifo_is_503_busy_without_touching_the_pipe(self):
+        """A stuck generation bounds the cache wait: 503 busy, no CACHE sent, the generation untouched."""
+        self.assertTrue(self.svc.fifo.acquire())      # the stuck generation's hold, simulated
+        try:
+            with self.assertRaises(TimeoutError):
+                self.svc.cache_inventory(fifo_timeout=0.2)
+            with self.assertRaises(TimeoutError):
+                self.svc.cache_drop(fifo_timeout=0.2)
+        finally:
+            self.svc.fifo.release()
+        code, inv = self.get("/v1/cache")             # released: straight through again
+        self.assertEqual(code, 200, inv)
+        self.assertEqual(len(inv["memory"]["items"]), 3)
+
+    def test_busy_http_is_503(self):
+        """Same bound over HTTP while the fifo is held elsewhere."""
+        orig = self.svc.cache_inventory
+        self.svc.cache_inventory = lambda: orig(fifo_timeout=0.3)   # fast bound for this probe only
+        self.assertTrue(self.svc.fifo.acquire())
+        try:
+            code, b = self.get("/v1/cache")
+            self.assertEqual(code, 503, b)
+            self.assertIn("busy", b["error"]["message"])
+        finally:
+            self.svc.fifo.release()
+            self.svc.cache_inventory = orig
+        code, inv = self.get("/v1/cache")
+        self.assertEqual(code, 200, inv)
+
+    def test_unsupported_routes(self):
