+    def pipe(self, lines):
+        import queue
+
+        class Stdin:
+            def __init__(self):
+                self.written = []
+
+            def write(self, s):
+                self.written.append(s)
+
+            def flush(self):
+                pass
+
+        class Proc:
+            def __init__(self, stdin):
+                self.stdin = stdin
+                self.kills = 0
+
+            def kill(self):
+                self.kills += 1
+
+            def poll(self):
+                return None if self.kills == 0 else -9
+
+            def wait(self, timeout=None):
+                return -9
+
+        stdin = Stdin()
+        proc = Proc(stdin)
+        eng = StrataEngine.__new__(StrataEngine)
+        eng.proc = proc
+        eng.lines = queue.Queue()
+        eng.ended = False
+        eng._cache_desync = False
+        for ln in lines:
+            eng.lines.put(ln)
+        eng.exit_code = lambda: -9
+        return eng, stdin
