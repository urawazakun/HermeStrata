+    ("screenshot-removed/image",
+     r"(?i)screenshot removed|image|vision|picture|screenshot"),
+    ("tool-call-json",
+     r"tool_call|tool-use|tool_use|\"arguments\"|'arguments'|\"name\"\s*:\s*\""),
+    ("system-prompt",
+     r"(?i)system prompt|instructions|workspace|git snapshot|status:"),
+)
