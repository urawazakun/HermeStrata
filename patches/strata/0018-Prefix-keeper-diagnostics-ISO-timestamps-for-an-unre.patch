+    @staticmethod
+    def _maybe_rotate(path, pending_len: int) -> None:
+        """Rotate BEFORE the write whose bytes would push the JSONL past 20 MB: the active file moves to
+        `<path>.1` (a stale backup is replaced), then the write lands in a fresh active file. Byte
+        accounting, so multibyte rows count fully; active plus one backup stay bounded."""
+        try:
+            if not os.path.exists(path):
+                return
+            if os.path.getsize(path) + pending_len <= KEEPER_JSONL_MAX_BYTES:
+                return
+            backup = f"{path}.1"
+            if os.path.exists(backup):
+                os.remove(backup)
+            os.replace(path, backup)
