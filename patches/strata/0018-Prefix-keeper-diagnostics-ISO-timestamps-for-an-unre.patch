@@ -807,6 +811,136 @@ KEEPER_MAX_SYS_LINES = 8        # a system message may differ by this many chang
 KEEPER_MAX_SYS_FRAC = 0.05      # ... and by this fraction of its stored lines at most
 KEEPER_TAG = "\n\n[context update]\n"
 KEEPER_DIFF_CHARS = 600         # bound on the diff text in both log sinks
+KEEPER_JSONL_MAX_BYTES = 20 * 1024 * 1024   # prefix-keeper.jsonl rotates past this size (BRIEF-IMAGE-KEEP item 4)
+KEEPER_EXCERPT_CHARS = 300      # bound on each old/new excerpt in mutation-unrepaired JSONL rows
+KEEPER_HINT_PATTERNS = (        # (hint, regex): first match on text around the divergence wins
+    ("memory-context/Honcho/Holographic",
+     r"(?i)memory.context|honcho|holograph|memory|prefetch|api_content"),
+    ("async-delegation/internal-notification/watch",
