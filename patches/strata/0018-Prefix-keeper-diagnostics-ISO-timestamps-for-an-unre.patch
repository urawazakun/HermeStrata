+def _keeper_now_iso() -> str:
+    """UTC ISO-8601 timestamp for every keeper log line and JSONL row (item 4)."""
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def _keeper_msg_text(m) -> str | None:
+    """A message's comparable text: str content plus canonical tool calls when present (so a changed
+    tool-call JSON moves the offset), otherwise canonical JSON (None when absent)."""
+    if not isinstance(m, dict):
+        return None
+    c = m.get("content")
+    tcs = m.get("tool_calls")
+    if isinstance(c, str):
+        if tcs is not None:
+            try:
+                return c + "\n" + json.dumps(tcs, ensure_ascii=False, sort_keys=True)
+            except (TypeError, ValueError):
+                return c
+        return c
+    if c is None and tcs is not None:
+        try:
+            return json.dumps(tcs, ensure_ascii=False, sort_keys=True)
+        except (TypeError, ValueError):
+            return None
+    if c is None:
+        return None
+    try:
+        return json.dumps(c, ensure_ascii=False, sort_keys=True)
+    except (TypeError, ValueError):
+        return str(c)
+
+
+def _keeper_first_diff(a: str, b: str) -> int:
+    """First differing character offset between two texts (min length when one extends the other)."""
+    n = min(len(a), len(b))
+    for i in range(n):
+        if a[i] != b[i]:
+            return i
+    return n
+
+
+def _keeper_excerpt(text: str, offset: int, limit: int = KEEPER_EXCERPT_CHARS) -> str:
+    """<=limit chars of text around offset (a window, not the full prompt; JSONL only)."""
+    if not text:
+        return ""
+    start = max(0, min(offset - limit // 3, len(text) - limit) if len(text) > limit else 0)
+    return text[start:start + limit]
+
+
+def _keeper_classify(old: str, new: str, s=None, n=None, note: str = "") -> str:
+    """Classification hint for a mutation-unrepaired divergence (regex on text around the offset).
+
+    Checks the old/new window first, then falls back to structural signals (tool calls,
+    system role, the aligner's note) so config-only mutations still get a useful hint."""
+    window = f"{old or ''}\n{new or ''}"
+    for hint, pat in KEEPER_HINT_PATTERNS:
+        if re.search(pat, window):
+            return hint
+    for m in (s, n):
+        if isinstance(m, dict) and m.get("tool_calls"):
+            return "tool-call-json"
+    if isinstance(s, dict) and isinstance(n, dict):
+        if (s.get("tool_calls") or []) != (n.get("tool_calls") or []):
+            return "tool-call-json"
+        if s.get("role") == "system" or n.get("role") == "system":
+            return "system-prompt"
+    if re.search(r"(?i)system|tool_call|tools|options", note or ""):
+        if re.search(r"(?i)tool", note or ""):
+            return "tool-call-json"
+        if re.search(r"(?i)system", note or ""):
+            return "system-prompt"
+    return "content-changed"
+
+
+def _keeper_mutation_detail(old_msg, new_msg, note: str = "") -> dict:
+    """JSONL-only detail for mutation-unrepaired: offset, hint and <=300-char excerpts.
+
+    The offset is None when there is no message pair or no textual difference (e.g. a
+    tool_call_id-only change: identical text, changed metadata); the hint still carries
+    the structural signal in that case."""
+    old_text = _keeper_msg_text(old_msg) if old_msg is not None else None
+    new_text = _keeper_msg_text(new_msg) if new_msg is not None else None
+    if old_text is None and new_text is None:
+        return {"offset": None, "hint": _keeper_classify("", "", old_msg, new_msg, note),
+                "old_excerpt": "", "new_excerpt": ""}
+    old_text = old_text if old_text is not None else ""
+    new_text = new_text if new_text is not None else ""
+    offset = None if old_text == new_text else _keeper_first_diff(old_text, new_text)
+    window = 600
+    lo = max(0, (offset or 0) - window // 2)
+    hint = _keeper_classify(old_text[lo:lo + window], new_text[lo:lo + window],
+                            old_msg, new_msg, note)
+    return {"offset": offset, "hint": hint,
+            "old_excerpt": _keeper_excerpt(old_text, offset or 0),
+            "new_excerpt": _keeper_excerpt(new_text, offset or 0)}
+
+
+def _keeper_divergence_pair(stored: list, received: list, plan: dict):
+    """(stored, received) message pair for a mutation plan's divergence point.
+
+    The received side is plan["at"]; the stored side is plan["sat"], the aligner's stored
+    cursor at the first divergence (past any restored messages), not the received index.
+    System rewrites compare the system pair; config-only mutations (tools/options, budget)
+    have no message pair -> (None, None)."""
+    note = plan.get("note") or ""
+    at = plan.get("at", 0) or 0
+    if note.startswith("system rewritten") and stored and received:
+        if stored[0].get("role") == "system" and received[0].get("role") == "system":
+            return stored[0], received[0]
+    if not isinstance(at, int) or at < 0 or at >= len(received):
+        return None, None
+    sat = plan.get("sat", at)
+    old_msg = stored[sat] if isinstance(sat, int) and 0 <= sat < len(stored) else None
+    return old_msg, received[at]
 
 
