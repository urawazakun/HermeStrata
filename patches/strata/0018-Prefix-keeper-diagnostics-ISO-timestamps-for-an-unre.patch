+    def test_jsonl_rotation_counts_utf8_bytes(self):
+        import serve.server as srv
+        svc, log = self.bare()
+        old_limit = srv.KEEPER_JSONL_MAX_BYTES
+        srv.KEEPER_JSONL_MAX_BYTES = 2000
+        try:
+            diff = "\u00e9" * 200                # 200 chars, 400 UTF-8 bytes
+            probe = {"ts": "0" * 32, "req": "r", "kind": "system-delta", "index": 0,
+                     "before_bytes": 1, "after_bytes": 2, "diff": diff}
+            char_len = len(json.dumps(probe, ensure_ascii=False) + "\n")
+            fill = 2000 - char_len - 100
+            Path(log).write_bytes(b"x" * fill)
+            # char accounting would fit (fill + chars < bound) but byte accounting must rotate
+            self.assertLess(fill + char_len, 2000)
+            _, err = self.capture(
+                lambda: svc.keeper._log(svc, "system-delta", "r", 0, 1, 2, diff))
+            self.assertTrue(os.path.exists(log + ".1"), err)    # rotated on UTF-8 bytes ...
+            rows = self.jsonl(log)
+            self.assertEqual(len(rows), 1)                       # ... and the row still landed
+            self.assertEqual(rows[0]["diff"], diff)
+        finally:
+            srv.KEEPER_JSONL_MAX_BYTES = old_limit
