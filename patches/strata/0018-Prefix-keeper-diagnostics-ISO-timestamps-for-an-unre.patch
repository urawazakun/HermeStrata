+    def test_jsonl_rotates_before_write_and_stays_bounded(self):
+        import serve.server as srv
+        svc, log = self.bare()
+        old_limit = srv.KEEPER_JSONL_MAX_BYTES
+        srv.KEEPER_JSONL_MAX_BYTES = 700      # small rows (~250 B): several rotations over 10 rows
+        try:
+            seed = [{"role": "system", "content": self.system()},
+                    {"role": "user", "content": "U1-rot"}]
+            svc.keeper_remember(seed, None, {})
+
+            def rotate_work():
+                for i in range(10):
+                    svc.keeper_repair(
+                        [{"role": "system", "content": self.system(volatile=f"77 untracked r{i}")},
+                         {"role": "user", "content": "U1-rot"},
+                         {"role": "user", "content": f"U-rot-{i}"}], None, {})
+
+            self.capture(rotate_work)
+            backup = log + ".1"
+            self.assertTrue(os.path.exists(backup), os.listdir(os.path.dirname(log)))
+            # rotate-BEFORE-write: neither file ever passes the bound ...
+            self.assertLessEqual(os.path.getsize(log), 700)
+            self.assertLessEqual(os.path.getsize(backup), 700)
+            with open(backup, encoding="utf-8") as f:
+                backup_rows = [json.loads(line) for line in f if line.strip()]
+            rows = self.jsonl(log)
+            self.assertTrue(rows)                                # ... the active file keeps new rows ...
+            self.assertLess(len(rows) + len(backup_rows), 10)    # ... while repeated rotation bounds both
+            for row in rows + backup_rows:
+                datetime.datetime.fromisoformat(row["ts"])
+        finally:
+            srv.KEEPER_JSONL_MAX_BYTES = old_limit
