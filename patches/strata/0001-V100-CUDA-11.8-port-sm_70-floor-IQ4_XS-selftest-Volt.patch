+# Drivers older than ~510 have no compute_cap query field; these are the Volta/Turing cards they commonly run.
+CC_BY_NAME = {"V100": "70", "TITAN V": "70", "GV100": "70", "T4": "75", "RTX 20": "75", "TITAN RTX": "75"}
