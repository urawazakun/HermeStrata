+def is_volta(gpu) -> bool:
+    """True when this GPU needs the Volta/CUDA 11.8 path (sm_70): upstream's CUDA 13 toolchain cannot target it."""
+    try:
+        return int(gpu["arch"]) < 80
+    except (KeyError, TypeError, ValueError):
+        return False
+
+
+def cuda_wheels(gpu):
+    """The pip CUDA libraries matching this GPU's engine: cu11 for a sm_70 local build, upstream's cu13 otherwise
+    (a ready-made engine is accepted only for a compatible arch, so the GPU selects correctly for both)."""
+    return CUDA_WHEELS_CU11 if is_volta(gpu) else CUDA_WHEELS
+
+
+def min_driver(gpu):
+    """The oldest NVIDIA driver this GPU's engine runs on."""
+    return MIN_DRIVER_CU11 if is_volta(gpu) else MIN_DRIVER
+
+
+def need_cuda(gpu):
+    """The minimum CUDA toolkit compiling for this GPU: 11.8 on Volta, upstream's ladder otherwise."""
+    return (11, 8) if is_volta(gpu) else ((12, 8) if int(gpu["arch"]) >= 120 else (12, 0))
+
+
+def cuda_variant(gpu):
+    """'cu11' for a sm_70 local build, 'cu13' otherwise: which library set to look for on disk."""
+    return "cu11" if is_volta(gpu) else "cu13"
+
