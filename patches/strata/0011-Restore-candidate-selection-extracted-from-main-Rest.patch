+// src/program/restore.cpp - restore candidate selection (readability refactor).
+//
+// Behaviour-preserving extraction from src/program/generate.cpp's F1 unified restore walk.
+// CPU-only: no CUDA here.
+//
+// What moved where (all from generate.cpp's per-request restore block):
+//   f1_chain_repairable lambda -> restore::chain_repairable (same gate, explicit RepairCtx)
+//   generate.cpp's starts_with  -> restore::chain_prefix_ok (same L/image rule, explicit params)
+//   chain scan + longest-first sort -> restore::collect_chain_candidates (same logs)
+//   RAM skip-set walk -> restore::collect_ram_candidates (eligibility injected: the caller
+//     passes saved_validate_for_restore + tip_gen_for; same logs, same termination)
+//   loop-head take_chain/sk_disk/sk_ram/sk_saved/chain_dead/f1_ci/f1_si/disk_skip
+//     -> restore::RestoreWalk (same selection, same exhausted rule)
+//
+// Defensive mapping (every check kept, none merged):
+//   prefix-by-ids + image identity + L < n .... chain_prefix_ok (chain/live)
+//   exact full-ids prefix + cvec/images ..... the store (find_best_except / find_match)
+//   at/past-request-end skip (sk >= n) ...... collect_ram_candidates
+//   MTP boundary repair source ............. chain_repairable (live row or same-length saved)
+//   K8V4 no-SavedState ..................... caller gates (need_repair/store_ok flags in)
+//   full restore validation ................ injected eligibility (still pre-mount, longest-first)
+#include "strata/program/restore.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <exception>
+#include <utility>
+
+namespace strata::program::restore {
