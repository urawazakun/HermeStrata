+        c.k = c.sk_disk;
+        c.have_disk = true;
+        c.disk = std::move(dent);
+        return c;
+    }
+    c.source = RestoreCandidate::Source::Ram;
+    c.k = c.sk_ram;
+    c.ram = ram_[si_];
+    return c;
+}
+
