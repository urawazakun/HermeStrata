+// src/program/restore_test.cpp - restore candidate selection + walk (CPU-only).
+//
+// Focused unit tests for the extracted selection logic in strata/program/restore.hpp +
+// src/program/restore.cpp - the take_chain tie rule, chain prefix/repairability gates, the
+// RAM skip-set walk with a fake eligibility predicate (mirroring the serve loop's structure),
+// the longest-first walk with chain/RAM/disk fall-through, and the RestoreResult type.
+// Fixture sizes are hand-derived literals (same layout contract as saved_state_test.cpp),
+// never the implementation's own size helpers. No CUDA, no GPU types: the execution half
+// stays in generate.cpp.
+#include "strata/program/restore.hpp"
+
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace saved = strata::program::saved_state;
+namespace restore = strata::program::restore;
+namespace fs = std::filesystem;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const char* what) {
+    std::printf("  %-66s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+// A complete() item of length L with nesting ids (0..L-1 + base), one stage, fp16 KV.
+// Geometry gA (hand-derived): 1 layer, 1 KV head, head_dim 8, page 4 -> one code row 16 B,
+// one page 64 B, C cells -> ceil(C/4)*64 B per k/v. Indexer (block 4, idx_dim 4): pooled
+// rows L/4+1, 16 B each, dead_key 16 B. Boundary hc=2, n_embd=4 -> 8 floats.
+saved::SavedItem make_item(int L, int base) {
+    saved::SavedItem it;
+    it.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) it.ids[(size_t) i] = (int32_t) (base + i);
+    it.cvec = true;
+    it.n_stages = 1;
+    it.geom.n_qsa_layers = 1;
+    it.geom.n_head_kv = 1;
+    it.geom.head_dim = 8;
+    it.geom.idx_dim = 4;
+    it.geom.idx_block = 4;
+    it.geom.page_size = 4;
+    saved::StagePayload sp;
+    sp.rec.gdn = {7};
+    sp.rec.tails = {8};
+    sp.rec.ple_prev[0] = L >= 2 ? base + L - 2 : -1;
+    sp.rec.ple_prev[1] = base + L - 1;
+    saved::KvLayerPayload kv;
+    kv.fmt = saved::kKvF16;
+    kv.cells = L;
+    kv.k.assign((size_t) ((L + 3) / 4) * 64, 0);
+    kv.v.assign((size_t) ((L + 3) / 4) * 64, 0);
+    sp.kv.push_back(std::move(kv));
+    saved::IndexerPayload ix;
+    ix.pooled_rows = L / 4 + 1;
+    ix.pooled.assign((size_t) (ix.pooled_rows * 16), 0);
+    ix.block_pos = {0};
+    ix.dead_key.assign(16, 0);
+    sp.idx.push_back(std::move(ix));
+    it.stages.push_back(std::move(sp));
+    it.boundary.hc = 2;
+    it.boundary.n_embd = 4;
+    it.boundary.row.assign(8, 0.5f);
+    if (L > 1) {
+        saved::KvLayerPayload m;
+        m.fmt = saved::kKvF16;
+        m.cells = L - 1;
+        m.k.assign((size_t) ((L - 1 + 3) / 4) * 64, 0);
+        m.v.assign((size_t) ((L - 1 + 3) / 4) * 64, 0);
+        it.mtp.kv.push_back(std::move(m));
+        it.mtp.cells = L - 1;
+        it.mtp.valid_from = 0;
+    }
+    return it;
+}
+
+std::vector<int32_t> req32(int n) {
+    std::vector<int32_t> v((size_t) n);
+    for (int i = 0; i < n; ++i) v[(size_t) i] = i;
+    return v;
+}
+
+std::vector<int64_t> req64(int n) {
+    std::vector<int64_t> v((size_t) n);
+    for (int i = 0; i < n; ++i) v[(size_t) i] = i;
+    return v;
+}
+
+strata::core::ConversationCheckpoint chain_item(int L, int base) {
+    strata::core::ConversationCheckpoint c;
+    c.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) c.ids[(size_t) i] = (int32_t) (base + i);
+    return c;
+}
+
+// Repair context for a request of length n over fixtures with boundary hc=2, n_embd=4
+// (hcn=8): K8V4-style no-repair unless asked, no live row unless installed.
+restore::RepairCtx repair_ctx(int64_t n, const saved::SavedStateStore* store,
+                              const std::vector<int32_t>* ids32,
+                              const std::vector<saved::ImgKey>* simgs, bool need_repair = true) {
+    restore::RepairCtx ctx;
+    ctx.n = n;
+    ctx.hcn = 8;
+    ctx.new_valid_from = 0;
+    ctx.need_repair = need_repair;
+    ctx.store = store;
+    ctx.store_ok = true;
+    ctx.ids = ids32;
+    ctx.imgs = simgs;
+    ctx.cvec = true;
+    ctx.boundary_hc = 2;
+    ctx.boundary_n_embd = 4;
+    return ctx;
+}
+
+saved::RootDiskHeader disk_header() {
+    saved::RootDiskHeader h;
+    h.engine_version = "0.1.21";
+    h.pack_path = "pack/full";
+    h.kv_type = "fp16";
+    h.mtp_dir = "";
+    h.model_fingerprint = "sizes+mtimes";
+    h.numeric_flags = "native+resident";
+    return h;
+}
+
+saved::RootDiskStore::Config disk_config(const std::string& dir) {
+    saved::RootDiskStore::Config c;
+    c.dir = dir;
+    c.cap_bytes = 1ull << 40;
+    c.live = disk_header();
+    c.live_geom.n_qsa_layers = 1;
+    c.live_geom.n_head_kv = 1;
+    c.live_geom.head_dim = 8;
+    c.live_geom.idx_dim = 4;
+    c.live_geom.idx_block = 4;
+    c.live_geom.page_size = 4;
+    c.stages = 1;
+    return c;
+}
+
+void write_file(const std::string& path, const std::vector<uint8_t>& buf) {
+    std::ofstream o(path, std::ios::binary | std::ios::trunc);
+    o.write((const char*) buf.data(), (std::streamsize) buf.size());
+    o.close();
+}
+}  // namespace
+
+int main() {
+    std::printf("restore_test\n");
+    const std::vector<saved::ImgKey> no_simgs;
+    const std::vector<strata::core::ConversationImageKey> no_cimgs;
+    {   // RestoreResult carries restored k + source, or a typed failure (cold normalizes to None/0).
+        // Recording is noexcept and allocation-free: it runs inside fallback and catch paths.
+        static_assert(noexcept(restore::RestoreResult::restored_at(0, saved::ResumeSource::Chain)),
+                      "restored_at is noexcept");
+        static_assert(noexcept(restore::RestoreResult::failure(restore::RestoreFail::Mount)),
+                      "failure is noexcept");
+        static_assert(noexcept(restore::RestoreResult::cold()), "cold is noexcept");
+        static_assert(std::is_nothrow_move_constructible<restore::RestoreResult>::value,
+                      "RestoreResult moves without throwing");
+        const restore::RestoreResult r =
+            restore::RestoreResult::restored_at(120, saved::ResumeSource::RootDisk);
+        check(r.restored && r.k == 120 && r.source == saved::ResumeSource::RootDisk &&
+                  r.fail == restore::RestoreFail::None,
+              "restored_at carries k + source");
+        const restore::RestoreResult f =
+            restore::RestoreResult::failure(restore::RestoreFail::MtpBoundary);
+        check(!f.restored && f.k == 0 && f.source == saved::ResumeSource::None &&
+                  f.fail == restore::RestoreFail::MtpBoundary,
+              "failure carries the typed reason only, cold stats");
+        const restore::RestoreResult c = restore::RestoreResult::cold();
+        check(!c.restored && c.k == 0 && c.fail == restore::RestoreFail::None, "cold is empty");
+        check(restore::RestoreFail::Validation != restore::RestoreFail::Mount &&
+                  restore::RestoreFail::Corruption != restore::RestoreFail::Transient,
+              "failure reasons are distinct");
+    }
+    {   // Outcome contract the stats readout relies on: every success carries its source and k
+        // (disk -> RootDisk, RAM -> Root/Tip by kind, chain and reread-nominal -> Chain); every
+        // failure and cold normalizes to None/0 (the reread debug override then reports true-zero).
+        const restore::RestoreResult disk =
+            restore::RestoreResult::restored_at(120, saved::ResumeSource::RootDisk);
+        const restore::RestoreResult root =
+            restore::RestoreResult::restored_at(100, saved::ResumeSource::Root);
+        const restore::RestoreResult tip =
+            restore::RestoreResult::restored_at(80, saved::ResumeSource::Tip);
+        const restore::RestoreResult chain =
+            restore::RestoreResult::restored_at(200, saved::ResumeSource::Chain);
+        check(disk.restored && disk.source == saved::ResumeSource::RootDisk && disk.k == 120,
+              "disk success maps to RootDisk/k");
+        check(root.restored && root.source == saved::ResumeSource::Root && root.k == 100,
+              "root success maps to Root/k");
+        check(tip.restored && tip.source == saved::ResumeSource::Tip && tip.k == 80,
+              "tip success maps to Tip/k");
+        check(chain.restored && chain.source == saved::ResumeSource::Chain && chain.k == 200,
+              "chain (and reread-nominal) success maps to Chain/k");
+        const restore::RestoreFail kinds[] = {restore::RestoreFail::MtpBoundary,
+                                              restore::RestoreFail::Validation, restore::RestoreFail::Mount,
+                                              restore::RestoreFail::Corruption, restore::RestoreFail::Transient};
+        bool all_cold = true;
+        for (restore::RestoreFail f : kinds) {
+            const restore::RestoreResult r = restore::RestoreResult::failure(f);
+            all_cold = all_cold && !r.restored && r.k == 0 &&
+                       r.source == saved::ResumeSource::None && r.fail == f;
+        }
+        check(all_cold, "every failure normalizes to None/0 with its reason");
+    }
+    {   // take_chain: the exact loop predicate - ties prefer live/chain, dead kills, exhausted ends.
+        using restore::restore_take_chain;
+        check(restore_take_chain(false, true, 200, 180, false, false), "longer chain wins");
+        check(restore_take_chain(false, true, 180, 180, false, false), "tie prefers chain (no upload)");
+        check(!restore_take_chain(false, true, 150, 180, false, false), "shorter chain yields to RAM");
+        check(!restore_take_chain(true, true, 200, 100, false, false), "chain_dead kills the chain");
+        check(!restore_take_chain(false, false, -1, 100, false, false), "no chain offers nothing");
+        check(restore_take_chain(false, true, 50, -1, true, false), "lone chain mounts (all exhausted)");
+        check(!restore_take_chain(false, true, 50, 60, true, true), "disk(60) outranks chain(50)");
+        check(!restore_take_chain(false, true, 50, 60, false, true), "RAM/disk present: short chain waits");
+    }
+    {   // chain_prefix_ok: L in [1, n-1], exact ids, image identity below L.
+        const std::vector<int64_t> ids = req64(250);
+        check(restore::chain_prefix_ok(req32(100), no_cimgs, ids, no_cimgs, 250), "proper prefix ok");
+        check(!restore::chain_prefix_ok(req32(0), no_cimgs, ids, no_cimgs, 250), "empty never a prefix");
+        check(!restore::chain_prefix_ok(req32(250), no_cimgs, ids, no_cimgs, 250), "k == n never mounts");
+        check(restore::chain_prefix_ok(req32(249), no_cimgs, ids, no_cimgs, 250), "k == n-1 mounts");
+        std::vector<int32_t> div = req32(100);
+        div[50] = 999;
+        check(!restore::chain_prefix_ok(div, no_cimgs, ids, no_cimgs, 250), "divergent ids rejected");
+        const std::vector<strata::core::ConversationImageKey> one = {{3, 99}};
+        check(!restore::chain_prefix_ok(req32(40), no_cimgs, ids, one, 250), "missing image rejected");
+        check(restore::chain_prefix_ok(req32(40), one, ids, one, 250), "identical image hits");
+        check(!restore::chain_prefix_ok(req32(40), std::vector<strata::core::ConversationImageKey>{{4, 99}},
+                                        ids, one, 250),
+              "shifted image rejected");
+    }
+    {   // collect_ram_candidates with a fake eligibility: longest-first, accumulating skips, at/past-end
+        // rejection, ineligible and throwing candidates fall through, the walk always terminates.
+        saved::SavedStateStore st;
+        check(st.insert_root(make_item(100, 0)), "ram root(100) stores");
+        check(st.insert_tip(make_item(200, 0), false), "ram tip(200) stores");
+        check(st.insert_tip(make_item(150, 0), false), "ram tip(150) stores");
+        const std::vector<int32_t> ids = req32(250);
+        auto accept = [](const saved::SavedItem&, std::string&) { return true; };
+        std::vector<const saved::SavedItem*> got = restore::collect_ram_candidates(st, ids, no_simgs,
+                                                                                    true, 250, accept);
+        check(got.size() == 3 && got[0]->ids.size() == 200 && got[1]->ids.size() == 150 &&
+                  got[2]->ids.size() == 100,
+              "ram walk is longest-first across kinds (200, 150, 100)");
+        auto reject_big = [](const saved::SavedItem& it, std::string& why) {
+            if (it.ids.size() == 200 || it.ids.size() == 150) {
+                why = "fake-invalid";
+                return false;
+            }
+            return true;
+        };
+        got = restore::collect_ram_candidates(st, ids, no_simgs, true, 250, reject_big);
+        check(got.size() == 1 && got[0]->ids.size() == 100, "two rejections fall through to the root");
+        auto reject_all = [](const saved::SavedItem&, std::string& why) {
+            why = "fake-invalid";
+            return false;
+        };
+        check(restore::collect_ram_candidates(st, ids, no_simgs, true, 250, reject_all).empty(),
+              "all rejected ends the walk (cold)");
+        int throws = 0;
+        auto flaky = [&](const saved::SavedItem& it, std::string&) -> bool {
+            if (it.ids.size() == 200) {
+                ++throws;
+                throw std::runtime_error("fake throw");
+            }
+            return true;
+        };
+        got = restore::collect_ram_candidates(st, ids, no_simgs, true, 250, flaky);
+        check(throws == 1 && got.size() == 2 && got[0]->ids.size() == 150, "throw retires one candidate");
+        got = restore::collect_ram_candidates(st, ids, no_simgs, true, 150, accept);
+        check(got.size() == 1 && got[0]->ids.size() == 100, "at/past-end candidates never mount");
+        check(restore::collect_ram_candidates(st, ids, no_simgs, false, 250, accept).empty(),
+              "cvec flip offers nothing");
+    }
+    {   // Non-owning core: an explicit function plus a borrowed context reaches the same walk with
+        // no wrapper allocation - the pointer pair constructs trivially, the context is borrowed
+        // for the synchronous call only.
+        struct Limit {
+            int keep_below;
+        };
+        auto over_limit = [](const saved::SavedItem& it, std::string& why, void* p) -> bool {
+            const int lim = static_cast<const Limit*>(p)->keep_below;
+            if ((int) it.ids.size() > lim) {
+                why = "over limit";
+                return false;
+            }
+            return true;
+        };
+        static_assert(std::is_nothrow_copy_constructible<decltype(over_limit)>::value,
+                      "captureless check copies trivially");
+        restore::RamEligibilityFn fn = over_limit;   // captureless: decays, never allocates
+        saved::SavedStateStore st;
+        check(st.insert_root(make_item(100, 0)), "core root(100) stores");
+        check(st.insert_tip(make_item(200, 0), false), "core tip(200) stores");
+        check(st.insert_tip(make_item(150, 0), false), "core tip(150) stores");
+        const std::vector<int32_t> ids = req32(250);
+        Limit ctx{150};
+        std::vector<const saved::SavedItem*> got =
+            restore::collect_ram_candidates(st, ids, no_simgs, true, 250, fn, &ctx);
+        check(got.size() == 2 && got[0]->ids.size() == 150 && got[1]->ids.size() == 100,
+              "borrowed-context walk filters longest-first (150, 100)");
+    }
+    {   // Borrowing proof: a stateful noncopyable check compiles only when borrowed, never copied.
+        struct NoCopy {
+            int keep_below;
+            explicit NoCopy(int l) : keep_below(l) {}
+            NoCopy(const NoCopy&) = delete;
+            NoCopy& operator=(const NoCopy&) = delete;
+            bool operator()(const saved::SavedItem& it, std::string& why) {
+                if ((int) it.ids.size() > keep_below) {
+                    why = "over limit";
+                    return false;
+                }
+                return true;
+            }
+        };
+        saved::SavedStateStore st;
+        check(st.insert_tip(make_item(200, 0), false), "borrow tip(200) stores");
+        check(st.insert_tip(make_item(150, 0), false), "borrow tip(150) stores");
+        NoCopy checker(150);
+        std::vector<const saved::SavedItem*> got =
+            restore::collect_ram_candidates(st, req32(250), no_simgs, true, 250, checker);
+        check(got.size() == 1 && got[0]->ids.size() == 150, "borrowed noncopyable check filters (150)");
+    }
+    {   // collect_chain_candidates: prefix scan, repairability gate, longest-first with live ties first.
+        saved::SavedStateStore st;
+        check(st.insert_tip(make_item(150, 0), false), "chain boundary source tip(150) stores");
+        const std::vector<int64_t> ids = req64(250);
+        const std::vector<int32_t> ids32 = req32(250);
+        const std::vector<int32_t> live = req32(200);
+        std::vector<strata::core::ConversationCheckpoint> checks;
+        checks.push_back(chain_item(180, 0));
+        checks.push_back(chain_item(150, 0));
+        // No live row and no repair need (K8V4 form): every prefix match is offered, ties live-first.
+        restore::RepairCtx ctx = repair_ctx(250, &st, &ids32, &no_simgs, false);
+        std::vector<restore::ChainCand> got =
+            restore::collect_chain_candidates(true, true, live, no_cimgs, checks, ids, no_cimgs, 250, ctx);
+        check(got.size() == 3 && got[0].k == 200 && got[0].live && got[1].k == 180 &&
+                  got[2].k == 150,
+              "no-repair walk offers live + chain longest-first");
+        // Repair required: the live candidate needs the retained row; chain needs a same-length
+        // saved boundary. The store holds 150 only, so chain 180 drops out.
+        restore::RepairCtx r2 = repair_ctx(250, &st, &ids32, &no_simgs, true);
+        std::vector<float> row(8, 0.25f);
+        r2.live_row = &row;
+        r2.live_row_L = 200;
+        r2.live_row_hash = saved::root_fnv1a(live.data(), live.size() * sizeof(int32_t));
+        r2.live_row_vf = 0;
+        r2.live_ids = &live;
+        got = restore::collect_chain_candidates(true, true, live, no_cimgs, checks, ids, no_cimgs, 250, r2);
+        check(got.size() == 2 && got[0].k == 200 && got[0].live && got[1].k == 150 && !got[1].live,
+              "repair gate keeps live(200) + exact-boundary chain(150), drops 180");
+        // A wrong live hash (another transcript) rejects the live candidate; the chain survives.
+        r2.live_row_hash ^= 1;
+        got = restore::collect_chain_candidates(true, true, live, no_cimgs, checks, ids, no_cimgs, 250, r2);
+        check(got.size() == 1 && got[0].k == 150, "foreign live row never pairs");
+        // prompt_cache off disables the whole walk; live_ok false drops live only.
+        check(restore::collect_chain_candidates(false, true, live, no_cimgs, checks, ids, no_cimgs, 250,
+                                                ctx)
+                  .empty(),
+              "prompt_cache 0 offers no chain");
+        got = restore::collect_chain_candidates(true, false, live, no_cimgs, checks, ids, no_cimgs, 250,
+                                                ctx);
+        check(got.size() == 2 && got[0].k == 180, "live_ok false drops live, keeps chain");
+        // Divergent and over-long checkpoints never match.
+        std::vector<strata::core::ConversationCheckpoint> bad;
+        strata::core::ConversationCheckpoint dv = chain_item(120, 0);
+        dv.ids[60] = 9999;
+        bad.push_back(std::move(dv));
+        bad.push_back(chain_item(250, 0));
+        check(restore::collect_chain_candidates(true, false, live, no_cimgs, bad, ids, no_cimgs, 250,
+                                                ctx)
+                  .empty(),
+              "divergent and at-end checkpoints excluded");
+    }
+    {   // RestoreWalk: longest-first across chain + RAM with the tie rules, kill_chain, exhausted.
+        saved::SavedStateStore st;
+        check(st.insert_tip(make_item(180, 0), false), "walk tip(180) stores");
+        check(st.insert_root(make_item(100, 0)), "walk root(100) stores");
+        const saved::SavedItem* r180 = st.find_exact(req32(250), no_simgs, true, 180);
+        const saved::SavedItem* r100 = st.find_exact(req32(250), no_simgs, true, 100);
+        check(r180 != nullptr && r100 != nullptr, "walk fixtures addressable");
+        restore::RestoreWalk w;
+        w.set_chain({{200, false}, {150, false}});
+        w.set_ram({r180, r100});
+        w.set_disk(nullptr, nullptr, nullptr, true, 250);
+        restore::RestoreCandidate c = w.next();
+        check(!c.exhausted && c.take_chain && c.k == 200, "walk opens with the longest chain (200)");
+        w.advance_chain();
+        c = w.next();
+        check(!c.exhausted && !c.take_chain && c.source == restore::RestoreCandidate::Source::Ram &&
+                  c.k == 180,
+              "chain(150) yields to longer RAM(180)");
+        w.advance_ram();
+        c = w.next();
+        check(!c.exhausted && c.take_chain && c.k == 150, "then chain(150)");
+        w.advance_chain();
+        c = w.next();
+        check(!c.exhausted && !c.take_chain && c.ram == r100, "then RAM root(100)");
+        w.advance_ram();
+        check(w.next().exhausted, "exhausted ends the walk");
+        // kill_chain after a GPU-touching failure drops the remaining chain, RAM stays tryable.
+        restore::RestoreWalk w2;
+        w2.set_chain({{200, false}});
+        w2.set_ram({r180});
+        w2.set_disk(nullptr, nullptr, nullptr, true, 250);
+        check(w2.next().take_chain, "w2 opens with chain");
+        w2.advance_chain();
+        w2.kill_chain();
+        c = w2.next();
+        check(!c.exhausted && !c.take_chain && c.k == 180, "killed chain falls through to RAM");
+        // Equal lengths: chain wins the tie over RAM.
+        restore::RestoreWalk w3;
+        w3.set_chain({{100, false}});
+        w3.set_ram({r100});
+        w3.set_disk(nullptr, nullptr, nullptr, true, 250);
+        check(w3.next().take_chain, "chain wins the equal-length tie (no upload)");
+    }
+    {   // RestoreWalk over disk: strictly-longer disk mounts, ties stay RAM, retire moves shorter.
+        const std::string sub = "rootdisk-restore-tmp/disk";
+        std::error_code ec;
+        fs::remove_all("rootdisk-restore-tmp", ec);
+        fs::create_directories(sub, ec);
+        check(!ec, "restore disk tmpdir created");
+        const saved::RootDiskHeader h = disk_header();
+        const saved::SavedItem d120 = make_item(120, 0);
+        std::vector<uint8_t> buf;
+        std::string why;
+        check(saved::root_encode(h, d120, buf, why), "restore disk fixture encodes");
+        write_file(sub + "/root-" + saved::root_file_key(h, d120) + ".hstr", buf);
+        saved::RootDiskStore store;
+        check(store.start(disk_config(sub), why) && store.enabled() && store.indexed() == 1,
+              "restore disk store starts with one root");
+        saved::SavedStateStore st;
+        check(st.insert_tip(make_item(100, 0), false), "restore disk RAM tip(100) stores");
+        const saved::SavedItem* r100 = st.find_exact(req32(250), no_simgs, true, 100);
+        const std::vector<int32_t> ids32 = req32(250);
+        restore::RestoreWalk w;
+        w.set_chain({});
+        w.set_ram({r100});
+        w.set_disk(&store, &ids32, &no_simgs, true, 250);
+        restore::RestoreCandidate c = w.next();
+        check(!c.exhausted && !c.take_chain && c.source == restore::RestoreCandidate::Source::Disk &&
+                  c.k == 120 && c.have_disk,
+              "strictly-longer disk(120) mounts before RAM(100)");
+        check(c.disk.meta.ids.size() == 120, "disk candidate carries the index metadata");
+        w.retire_disk(c.disk.path);
+        c = w.next();
+        check(!c.exhausted && c.source == restore::RestoreCandidate::Source::Ram && c.k == 100,
+              "retired disk falls through to RAM");
+        w.advance_ram();
+        check(w.next().exhausted, "disk retired + RAM spent ends the walk");
+        // Equal-length disk never jumps RAM: a second store holding disk(100) only.
+        const std::string sub2 = "rootdisk-restore-tmp/disk100";
+        fs::create_directories(sub2, ec);
+        const saved::SavedItem d100 = make_item(100, 0);
+        std::vector<uint8_t> buf2;
+        check(saved::root_encode(h, d100, buf2, why), "restore disk100 fixture encodes");
+        write_file(sub2 + "/root-" + saved::root_file_key(h, d100) + ".hstr", buf2);
+        saved::RootDiskStore store2;
+        check(store2.start(disk_config(sub2), why) && store2.indexed() == 1, "disk100 store starts");
+        restore::RestoreWalk w2;
+        w2.set_chain({});
+        w2.set_ram({r100});
+        w2.set_disk(&store2, &ids32, &no_simgs, true, 250);
+        c = w2.next();
+        check(!c.exhausted && c.source == restore::RestoreCandidate::Source::Ram && c.k == 100,
+              "equal-length disk stays behind RAM (no disk read)");
+        w2.advance_ram();
+        c = w2.next();
+        check(!c.exhausted && c.source == restore::RestoreCandidate::Source::Disk && c.k == 100,
+              "disk(100) still tryable after RAM");
+        fs::remove_all("rootdisk-restore-tmp", ec);
+    }
+    if (g_fail == 0)
+        std::printf("restore_test: all ok\n");
+    else
+        std::printf("restore_test: %d FAILURES\n", g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
