+bool chain_repairable(int64_t k, bool is_live, const RepairCtx& ctx) {
+    try {
+        if (k < 1 || k >= ctx.n || ctx.hcn == 0) return false;
+        // K8V4: upstream eligibility is the prefix match the caller already checked - no
+        // saved-boundary repair source is required (SavedState is unsupported; the mount stands
+        // on checkpoint_restore + kv_restore exactly as upstream).
+        if (!ctx.need_repair) return true;
+        if (is_live) {
+            if (ctx.live_row == nullptr || ctx.live_ids == nullptr) return false;
+            return ctx.live_row_L == k && ctx.live_row->size() == ctx.hcn && ctx.hcn > 0 &&
+                   ctx.live_row_hash ==
+                       saved_state::root_fnv1a(ctx.live_ids->data(),
+                                                ctx.live_ids->size() * sizeof(int32_t)) &&
+                   ctx.new_valid_from >= ctx.live_row_vf;
+        }
+        const saved_state::SavedItem* exact =
+            ctx.store_ok && ctx.store != nullptr && ctx.ids != nullptr && ctx.imgs != nullptr ?
+                ctx.store->find_exact(*ctx.ids, *ctx.imgs, ctx.cvec, k) :
+                nullptr;
+        return exact != nullptr && exact->boundary.complete() &&
+               exact->boundary.hc == ctx.boundary_hc && exact->boundary.n_embd == ctx.boundary_n_embd &&
+               exact->boundary.row.size() == ctx.hcn && ctx.new_valid_from >= exact->mtp.valid_from;
+    } catch (const std::exception& ex) {
+        std::fprintf(stderr, "strata serve: candidate at %lld tokens repair check threw (%s): "
+                             "trying shorter\n",
+                     (long long) k, ex.what());
+        return false;
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: candidate at %lld tokens repair check threw: "
+                             "trying shorter\n",
+                     (long long) k);
+        return false;
+    }
+}
+
+std::vector<ChainCand> collect_chain_candidates(
+    bool prompt_cache_on, bool live_ok, const std::vector<int32_t>& live,
+    const std::vector<ConversationImageKey>& live_imgs, const std::vector<ConversationCheckpoint>& checks,
+    const std::vector<int64_t>& ids, const std::vector<ConversationImageKey>& req_imgs, int64_t n,
+    const RepairCtx& repair) {
+    std::vector<ChainCand> chain;
+    if (prompt_cache_on) {
+        if (live_ok && chain_prefix_ok(live, live_imgs, ids, req_imgs, n)) {
+            const int64_t lk = (int64_t) live.size();
+            if (chain_repairable(lk, true, repair))
+                chain.push_back({lk, true});
+            else
+                std::fprintf(stderr, "strata serve: live candidate at %lld tokens has no MTP "
+                                     "boundary repair source: trying shorter\n",
+                             (long long) lk);
+        }
+        for (const ConversationCheckpoint& cc : checks) {
+            const int64_t ck = (int64_t) cc.ids.size();
+            if (!chain_prefix_ok(cc.ids, cc.imgs, ids, req_imgs, n)) continue;
+            if (chain_repairable(ck, false, repair))
+                chain.push_back({ck, false});
+            else
+                std::fprintf(stderr, "strata serve: chain candidate at %lld tokens has no MTP "
+                                     "boundary repair source: trying shorter\n",
+                             (long long) ck);
+        }
+        std::sort(chain.begin(), chain.end(), [](const ChainCand& a, const ChainCand& b) {
+            if (a.k != b.k) return a.k > b.k;
+            return a.live && !b.live;
+        });
+    }
+    return chain;
+}
