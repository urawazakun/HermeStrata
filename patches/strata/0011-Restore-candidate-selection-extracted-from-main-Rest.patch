+std::vector<const saved_state::SavedItem*> collect_ram_candidates(
+    const saved_state::SavedStateStore& store, const std::vector<int32_t>& ids,
+    const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n,
+    RamEligibilityFn eligible, void* ctx) {
+    std::vector<const saved_state::SavedItem*> out;   // validated, longest-first
+    // Accumulating skip set (blocker 5 review): each rejected candidate joins, so the walk is
+    // longest-first without revisit and always terminates (cand==nullptr ends it).
+    std::vector<const saved_state::SavedItem*> skip;
+    for (;;) {
+        const saved_state::SavedItem* cand = store.find_best_except(ids, imgs, cvec, skip);
+        if (cand == nullptr) break;
+        const int64_t sk = (int64_t) cand->ids.size();
+        if (sk >= n) {
+            std::fprintf(stderr, "strata serve: SavedState candidate at %lld tokens skipped "
+                                 "(at/past the request end)\n",
+                         (long long) sk);
+            skip.push_back(cand);
+            continue;
+        }
+        std::string why;
+        bool ok = false;
+        try {
+            ok = eligible(*cand, why, ctx);
+        } catch (const std::exception& ex) {
+            std::fprintf(stderr, "strata serve: SavedState candidate at %lld tokens validation "
+                                 "threw (%s): trying shorter\n",
+                         (long long) sk, ex.what());
+            skip.push_back(cand);
+            continue;
+        } catch (...) {
+            std::fprintf(stderr, "strata serve: SavedState candidate at %lld tokens validation "
+                                 "threw: trying shorter\n",
+                         (long long) sk);
+            skip.push_back(cand);
+            continue;
+        }
+        if (!ok) {
+            std::fprintf(stderr, "strata serve: SavedState candidate at %lld tokens ineligible "
+                                 "(%s): trying shorter\n",
+                         (long long) sk, why.c_str());
+            skip.push_back(cand);
+            continue;
+        }
+        out.push_back(cand);
+        skip.push_back(cand);
+    }
+    return out;
+}
