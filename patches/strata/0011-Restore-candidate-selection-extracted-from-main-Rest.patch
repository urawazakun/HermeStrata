+// include/strata/program/restore.hpp - restore candidate selection (readability refactor).
+//
+// Behaviour-preserving extraction from src/program/generate.cpp's F1 unified restore walk
+// (DESIGN-HERMES-CACHE.md sections 1, 2 and the section 7 addendum; F1: BRIEF-CACHE-FIX-1).
+//
+// This header + src/program/restore.cpp are CPU-ONLY on purpose: no CUDA includes, no device
+// code. They own the SELECTION half of the restore walk - who is eligible, in what order -
+// while generate.cpp keeps the EXECUTION half (saved_validate_for_restore, the GPU uploads,
+// the boundary repairs, cold_reset_all), injected here as plain callbacks/parameters so the
+// selection stays unit-testable on CPU:
+//
+//   collect_chain_candidates() <- the live/chain prefix scan + MTP repairability gate + sort
+//   collect_ram_candidates()   <- the accumulating-skip-set RAM walk (eligibility injected)
+//   RestoreWalk                <- the per-iteration longest-first selection state machine
+//   RestoreResult              <- restored k + source, or the typed failure of the last attempt
+//
+// Ordering contract (unchanged from generate.cpp): longest-first across {chain, RAM, disk};
+// ties prefer live/chain (no upload); disk mounts only when STRICTLY longer than RAM; any
+// GPU-touching failure kills live/chain candidacy (kill_chain) while shorter saved candidates
+// stay tryable; the walk ends cold only when exhausted.
+#pragma once
+
+#include "strata/core/conversation_cache.hpp"
+#include "strata/program/saved_state.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace strata::program::restore {
+
+/// Typed reason the last restore attempt failed. The walk falls through to the next shorter
+/// candidate on every one of these; cold only when exhausted. The enum alone is recorded
+/// (allocation-free, noexcept); the human-readable text stays on the stderr log lines only.
+enum class RestoreFail : uint8_t {
+    None,          ///< restored (or cold with no attempt: empty walk)
+    MtpBoundary,   ///< no MTP boundary repair source, or the k-1 pairing failed
+    Validation,    ///< CPU-side eligibility rejected the candidate
+    Mount,         ///< GPU upload / ring refill / sync failed after validation passed
+    Corruption,    ///< disk payload unreadable or failed integrity (index entry dropped)
+    Transient      ///< throw or device-not-idle: retryable, never corruption
+};
+
+/// The outcome of the restore walk: restored k + source, or cold carrying the last failure.
+struct RestoreResult {
+    bool restored = false;
+    int64_t k = 0;                                           ///< reused prefix cells (0 when cold)
+    saved_state::ResumeSource source = saved_state::ResumeSource::None;
+    RestoreFail fail = RestoreFail::None;
+    static RestoreResult restored_at(int64_t at, saved_state::ResumeSource src) noexcept {
+        RestoreResult r;
+        r.restored = true;
+        r.k = at;
+        r.source = src;
+        return r;
+    }
+    // No reason string: recording a failure must neither allocate nor throw (it runs inside
+    // the fallback and catch paths). The text stays on the log lines at the call site.
+    static RestoreResult failure(RestoreFail f) noexcept {
+        RestoreResult r;
+        r.fail = f;
+        return r;
+    }
+    static RestoreResult cold() noexcept { return RestoreResult{}; }
+};
+
+/// One collected chain (live session or parked checkpoint) candidate: its length and kind.
+struct ChainCand {
+    int64_t k = 0;
+    bool live = false;
+};
+
+/// One selected candidate for the execution half to attempt. The walk hands these out
+/// longest-first with the tie rules applied (chain wins ties; disk only when strictly longer
+/// than RAM); `exhausted` ends the walk (cold). The sk_*/take_chain fields are the attempt
+/// variables that used to live in main()'s loop head - they live in the walk now.
+struct RestoreCandidate {
+    enum class Source : uint8_t { Chain, Ram, Disk };
+    bool exhausted = true;
+    Source source = Source::Chain;
+    bool take_chain = false;
+    int64_t k = -1;
+    bool live = false;                                       ///< chain kind only
+    const saved_state::SavedItem* ram = nullptr;             ///< Ram kind only (store-owned)
+    saved_state::RootDiskStore::Entry disk;                  ///< Disk kind only (index metadata)
+    bool have_disk = false;
+    int64_t sk_disk = -1, sk_ram = -1, sk_saved = -1;
+};
+
+/// Exact prefix rule for chain/live candidates (moved from generate.cpp's starts_with):
+/// L in [1, n-1] with matching ids and image identity below L. Builds the below-L image
+/// vector exactly like the original (same comparison, same allocation/throw behaviour).
+inline bool chain_prefix_ok(const std::vector<int32_t>& pre,
+                            const std::vector<strata::core::ConversationImageKey>& pre_imgs,
+                            const std::vector<int64_t>& ids,
+                            const std::vector<strata::core::ConversationImageKey>& req_imgs, int64_t n) {
+    const int64_t L = (int64_t) pre.size();
+    if (L < 1 || L > n - 1) return false;
+    for (int64_t i = 0; i < L; ++i)
+        if ((int32_t) ids[(size_t) i] != pre[(size_t) i]) return false;
+    std::vector<strata::core::ConversationImageKey> below;
+    for (const auto& img : req_imgs)
+        if (img.start < L) below.push_back(img);
+    return below == pre_imgs;
+}
+
+/// The exact take_chain predicate from the attempt loop: ties prefer live/chain (no upload).
+/// ram_exhausted = no RAM candidate at/after the cursor; have_disk = a disk entry below n.
+inline bool restore_take_chain(bool chain_dead, bool have_chain, int64_t chain_k, int64_t sk_saved,
+                               bool ram_exhausted, bool have_disk) {
+    if (chain_dead || !have_chain) return false;
+    if ((ram_exhausted && !have_disk) || chain_k >= sk_saved) return true;   // ties prefer live/chain
+    return false;
+}
+
+/// Inputs for the MTP boundary repairability gate (moved from f1_chain_repairable): everything
+/// the gate reads, as plain data. All references are borrowed for the call only.
+struct RepairCtx {
+    int64_t n = 0;                                           ///< request length
+    size_t hcn = 0;                                          ///< g.hc * g.n_embd (boundary row cells)
+    int64_t new_valid_from = 0;                              ///< drafter window of the NEW request
+    bool need_repair = true;                                 ///< kv_chain_mount_needs_repair(hybrid)
+    const std::vector<float>* live_row = nullptr;            ///< retained R_(L-1), valid iff live_row_L >= 0
+    int64_t live_row_L = -1;
+    uint64_t live_row_hash = 0;                              ///< FNV-1a of the live ids at retention
+    int64_t live_row_vf = 0;                                 ///< drafter valid_from at retention
+    const std::vector<int32_t>* live_ids = nullptr;          ///< live session ids (hash input)
+    const saved_state::SavedStateStore* store = nullptr;     ///< same-length boundary lookup
+    bool store_ok = false;                                   ///< saved_state_kv_ok()
+    const std::vector<int32_t>* ids = nullptr;               ///< request ids (find_exact key)
+    const std::vector<saved_state::ImgKey>* imgs = nullptr;
+    bool cvec = true;
+    int64_t boundary_hc = 0;                                 ///< live g.hc (boundary shape check)
+    int64_t boundary_n_embd = 0;                             ///< live g.n_embd
+};
+
+/// The MTP boundary repairability gate for one chain/live candidate at k (moved verbatim
+/// semantics from generate.cpp): K8V4 needs no repair source; live needs the retained row
+/// (length/hash/window); chain needs a same-length saved boundary with a reachable window.
+/// Never throws: a throwing lookup reports false (caller logs "trying shorter").
+bool chain_repairable(int64_t k, bool is_live, const RepairCtx& ctx);
+
+/// The live/chain prefix scan + repairability gate + longest-first sort (live first on ties).
+/// prompt_cache_on gates the whole walk (o.prompt_cache > 0); live needs live_ok. Logs the
+/// "no MTP boundary repair source" lines, verbatim from generate.cpp.
+std::vector<ChainCand> collect_chain_candidates(
+    bool prompt_cache_on, bool live_ok, const std::vector<int32_t>& live,
+    const std::vector<strata::core::ConversationImageKey>& live_imgs,
+    const std::vector<strata::core::ConversationCheckpoint>& checks, const std::vector<int64_t>& ids,
+    const std::vector<strata::core::ConversationImageKey>& req_imgs, int64_t n, const RepairCtx& repair);
+
+/// Eligibility of one RAM candidate (saved_validate_for_restore + tip_gen_for in generate.cpp).
+/// True = the upload may start; `why` names the rejection. May throw (treated as ineligible).
+/// Non-owning callback: a function plus a borrowed context, synchronous use only. Construction
+/// is a trivial pointer pair (noexcept, never allocates), so selection adds no failure modes
+/// under memory pressure the way a heap-owning wrapper would.
+using RamEligibilityFn = bool (*)(const saved_state::SavedItem&, std::string&, void*);
+
+/// The accumulating-skip-set RAM walk (moved from generate.cpp): longest-first via
+/// find_best_except without revisit (always terminates), at/past-end skip, eligibility gate.
+/// No store mutation between calls: returned pointers stay valid. Logs verbatim.
+std::vector<const saved_state::SavedItem*> collect_ram_candidates(
+    const saved_state::SavedStateStore& store, const std::vector<int32_t>& ids,
+    const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n,
+    RamEligibilityFn eligible, void* ctx);
+
+/// Adapter for any callable (capturing lambdas in tests, the engine's inline check): forwards
+/// to the non-owning core borrowing the callable by reference for the synchronous call only.
+/// No copy, no heap ownership at any point (const callables supported); the reference stays
+/// valid because the call is synchronous and the argument outlives it.
+template <typename F>
+std::vector<const saved_state::SavedItem*> collect_ram_candidates(
+    const saved_state::SavedStateStore& store, const std::vector<int32_t>& ids,
+    const std::vector<saved_state::ImgKey>& imgs, bool cvec, int64_t n, F&& eligible) {
+    using Plain = typename std::remove_reference<F>::type;
+    auto trampoline = [](const saved_state::SavedItem& it, std::string& why, void* ctx) -> bool {
+        return (*static_cast<Plain*>(ctx))(it, why);
+    };
+    return collect_ram_candidates(store, ids, imgs, cvec, n, trampoline, &eligible);
+}
+
+/// The per-iteration longest-first selection state machine. Owns the attempt variables that
+/// used to live in main()'s loop head: the chain/RAM cursors, chain_dead, the disk skip set,
+/// and the sk_disk/sk_ram/sk_saved/take_chain decision. The execution half calls next() to
+/// learn WHAT to attempt, then reports back via advance_chain()/advance_ram()/retire_disk()/
+/// kill_chain() at exactly the points the old loop mutated its locals. Disk query references
+/// are borrowed: they must outlive the walk (same-request scope at the call site).
+class RestoreWalk {
+  public:
+    void set_chain(std::vector<ChainCand> chain) { chain_ = std::move(chain); }
+    void set_ram(std::vector<const saved_state::SavedItem*> ram) { ram_ = std::move(ram); }
+    void set_disk(const saved_state::RootDiskStore* store, const std::vector<int32_t>* ids,
+                  const std::vector<saved_state::ImgKey>* imgs, bool cvec, int64_t n) {
+        disk_store_ = store;
+        disk_ids_ = ids;
+        disk_imgs_ = imgs;
+        disk_cvec_ = cvec;
+        disk_n_ = n;
+    }
+    /// The single longest candidate under the tie rules, or an exhausted marker. The disk
+    /// peek is metadata-only; the payload lazy-loads only when the disk entry wins.
+    RestoreCandidate next() const;
+    void advance_chain() { ++ci_; }
+    void advance_ram() { ++si_; }
+    void retire_disk(const std::string& path) { disk_skip_.push_back(path); }
+    void kill_chain() { chain_dead_ = true; }
+    bool chain_dead() const { return chain_dead_; }
+
+  private:
+    std::vector<ChainCand> chain_;
+    std::vector<const saved_state::SavedItem*> ram_;
+    size_t ci_ = 0, si_ = 0;
+    bool chain_dead_ = false;
+    const saved_state::RootDiskStore* disk_store_ = nullptr;
+    const std::vector<int32_t>* disk_ids_ = nullptr;
+    const std::vector<saved_state::ImgKey>* disk_imgs_ = nullptr;
+    bool disk_cvec_ = true;
+    int64_t disk_n_ = 0;
+    std::vector<std::string> disk_skip_;
+};
+
+}  // namespace strata::program::restore
