+// ---- SavedState restore request (DESIGN-HERMES-CACHE.md sections 1, 2 and the section 7 addendum;
+// F1: BRIEF-CACHE-FIX-1 - failed restores fall through to the next candidate, never to cold).
+//
+// The per-request selection/attempt loop, extracted from the serve loop with explicit context:
+// main() fills an F1RestoreCtx, calls f1_restore_run(), and unpacks the outputs for promotion,
+// stats and pruning. All restore state (take_chain/sk_disk/sk_ram/chain_dead/live_ok/from_saved
+// plus the cursors and skip sets in restore::RestoreWalk) lives in the context during the run.
+// GPU operation bodies, reset/error return rules and log lines are unchanged from the inline
+// version. Returns 0 when the walk decided (restored or cold); 1 when a reset failed after a
+// failed mount/repair - with no coherent fallback the caller must fail the request.
+struct F1RestoreCtx {
+    // Borrowed request inputs (the caller's locals outlive the run):
+    int64_t n = 0;
+    const std::vector<int64_t>* ids = nullptr;
+    const std::vector<int32_t>* ids32 = nullptr;
+    const std::vector<ImgKey>* req_imgs = nullptr;
+    const std::vector<saved::ImgKey>* req_simgs = nullptr;
+    bool cvec_cached = true;
+    int prompt_cache = 0;
+    bool reread = false;   // STRATA_CKPT_REREAD debug mode
+    uint64_t* check_clock = nullptr;
+    const strata::core::ModelGeometry* g = nullptr;
+    strata::core::SessionState* ss = nullptr;
+    std::vector<std::unique_ptr<GpuStage>>* stages = nullptr;
+    strata::core::MtpDrafter* mtp = nullptr;
+    void* main_cs = nullptr;
+    cudaStream_t main_stream = nullptr;
+    const std::vector<int32_t>* live = nullptr;
+    const std::vector<ImgKey>* live_imgs = nullptr;
+    const std::vector<float>* live_bdry = nullptr;
+    uint64_t live_bdry_hash = 0;
+    int64_t live_bdry_vf = 0;
+    std::vector<ConvCheckpoint>* checks = nullptr;
+    saved::SavedStateStore* saved_states = nullptr;
+    saved::RootDiskStore* root_disk_store = nullptr;
+    // Session outputs owned by the context during the run (unpacked by the caller after):
+    bool live_ok = false;
+    int64_t live_bdry_L = -1;
+    // Request-lifetime storage owned by the context: a disk-loaded mount lives here, so the
+    // payload stays valid through the caller's promotion and stats (disk_hit points into it).
+    saved::SavedItem disk_mount;
+    int64_t resume = 0;
+    bool from_live = false;
+    bool from_saved = false;
+    const saved::SavedItem* saved_hit = nullptr;
+    const saved::SavedItem* disk_hit = nullptr;
+    std::string disk_hit_path;
+    int64_t reread_to = -1;
+    restore::RestoreResult outcome;
+};
 
