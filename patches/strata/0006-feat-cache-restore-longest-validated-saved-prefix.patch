+// ---- E2: SavedState restore (DESIGN-HERMES-CACHE.md sections 1, 2 and the section 7 addendum).
+// Implemented: Muse / review: Sol. Longest exact-prefix live-chain/tip/root match (chain wins ties);
+// roots/tips are independent of chain pruning and --prompt-cache. ALL validation (geometry, payload sizes,
+// MTP reachable valid_from) runs BEFORE any GPU state is touched; any failure at any stage takes the cold
+// path (session_zero on ALL stages, chain cleared, resume 0) - never a stale chain after overwritten KV,
+// never silently consuming corrupted state.
+//
+// E2 REVIEW MAP (for Sol) - where each repair lives:
+//   KV repair:    saved_restore_kv() per layer: host copy for kv-resident streamed/ring layouts, device pools
+//                 + identity page table when fully resident. Streamed slots are invalidated via kv_stream_reset
+//                 so the next resolve reloads from the restored host (never a stale slot under a remapped block).
+//   MTP repair:   saved_restore_mtp() restores the L-1 real pairs, the shared mtp.kv_restore(k) refills the ring,
+//                 and the boundary block pairs saved R_(k-1) with request.ids[k] BEFORE the suffix prefill (the
+//                 suffix still starts at k; k==n is rejected - the decoder would double-feed the last token).
+//                 Chain/live mounts get the same k-1 repair from the retained live row or a same-length saved
+//                 boundary (no upload; chain preference kept).
+//   Recurrent:    saved_restore_stage() reuses checkpoint_restore for GDN/PLE/tails (+ple_prev from ids) and
+//                 restores the indexer pooled keys/cursor/dead-key per layer. Every byte size, pointer and
+//                 capacity is validated BEFORE any mutation (validate_for_restore).
+//   Split fallback: per-stage uploads run under that stage's OnDevice guard with its stream; ANY exception or
+//                 upload/boundary failure after a mount was attempted cold-resets ALL stages (checked) and the
+//                 MTP via prefill-from-0 - never a stale chain over overwritten KV. A failed reset fails the
+//                 request outright (no coherent fallback exists). Fork parent tips survive: the store is never
+//                 pruned by traffic, and a successful mount calls note_use.
+/// Device staging buffer that frees on every exit path, including exceptions (blocker 4). Declared
+/// AFTER the OnDevice guard at each use site so cudaFree runs on the right device on a split.
+struct CudaFreeDel {
+    void operator()(void* p) const noexcept { if (p != nullptr) cudaFree(p); }
+};
+
+/// Blocker 5 review: every pool a KV upload dereferences - device pools always, the authoritative host
+/// pools on kv-resident layouts. Used for main stages and the MTP drafter alike.
+bool saved_kv_ptrs_ok(const strata::core::QsaState& st, std::string& why) {
+    if (st.kv_q4) {
+        if (st.k_q4 == nullptr || st.v_q4 == nullptr) { why = "KV pointers missing"; return false; }
+        if (st.kv_mode != 0 && (st.host.k_q4 == nullptr || st.host.v_q4 == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    } else if (st.kv_int8) {
+        if (st.k_q == nullptr || st.v_q == nullptr || st.k_scale == nullptr || st.v_scale == nullptr) {
+            why = "KV pointers missing";
+            return false;
+        }
+        if (st.kv_mode != 0 && (st.host.k_q == nullptr || st.host.v_q == nullptr ||
+                                st.host.k_scale == nullptr || st.host.v_scale == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    } else {
+        if (st.k_pool == nullptr || st.v_pool == nullptr) { why = "KV pointers missing"; return false; }
+        if (st.kv_mode != 0 && (st.host.k_pool == nullptr || st.host.v_pool == nullptr)) {
+            why = "KV host pointers missing";
+            return false;
+        }
+    }
+    return true;
+}
+inline saved::SnapshotGeom saved_live_geom(const strata::core::ModelGeometry& g) {
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    saved::SnapshotGeom gm;
+    gm.n_qsa_layers = g.n_qsa_layers();
+    gm.n_head_kv = g.n_head_kv;
+    gm.head_dim = g.head_dim;
+    gm.idx_dim = g.idx_key_dim;
+    gm.idx_block = qs.idx_block;
+    gm.page_size = qs.page_size;
+    return gm;
+}
+
+/// One layer's QSA KV cells [0, cells) from a snapshot payload. Mode 0 (fully resident): H2D into the device
+/// pools + identity page table. Mode 1 (streamed): memcpy into the authoritative host copy + kv_stream_reset
+/// so resolve refills slots from the restored host. Mode 2 (ring): memcpy into the host copy; the caller
+/// refills the ring (mtp.kv_restore). `st` is const: every destination is a mutable pool through it.
+bool saved_restore_kv(const strata::core::QsaState& st, const strata::core::ModelGeometry& g,
+                       const saved::KvLayerPayload& pay, int64_t cells, void* stream, std::string& e) {
+    if (pay.cells != cells || cells < 1) { e = "KV cell count mismatch"; return false; }
+    if (pay.fmt != saved_kv_format(st)) { e = "KV format changed"; return false; }
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t nH = g.n_head_kv, hd = g.head_dim, ps = qs.page_size;
+    if (nH < 1 || hd < 1 || ps < 1) { e = "bad KV geometry"; return false; }
+    const int64_t pages = (cells + ps - 1) / ps;
+    if (pages > st.n_pages) { e = "KV pages exceed capacity"; return false; }
+    if (!saved::kv_blob_ok(pay, cells, saved_live_geom(g))) { e = "KV blob size mismatch"; return false; }
+    const size_t page_row = (size_t) nH * (size_t) ps;   // rows per page; times the per-row bytes below
+    auto copy_dev = [&](const std::vector<uint8_t>& src, void* dev, size_t row) -> bool {
+        if (src.size() != (size_t) pages * page_row * row || dev == nullptr) return false;
+        return cudaMemcpy(dev, src.data(), src.size(), cudaMemcpyHostToDevice) == cudaSuccess;
+    };
+    auto copy_host = [&](const std::vector<uint8_t>& src, const void* host, size_t row) -> bool {
+        if (src.size() != (size_t) pages * page_row * row || host == nullptr) return false;
+        std::memcpy(const_cast<void*>(host), src.data(), src.size());
+        return true;
+    };
+    if (st.kv_mode == 0) {
+        bool ok = false;
+        if (st.kv_q4) {
+            const size_t row = (size_t) strata::kernels::kv_q4_bytes_per_head((int) hd);
+            ok = copy_dev(pay.k, st.k_q4, row) && copy_dev(pay.v, st.v_q4, row);
+        } else if (st.kv_int8) {
+            const size_t sc = (size_t) (hd / strata::kernels::KV_Q8_GROUP) * 2;
+            ok = copy_dev(pay.k, st.k_q, (size_t) hd) && copy_dev(pay.v, st.v_q, (size_t) hd) &&
+                 copy_dev(pay.ks, st.k_scale, sc) && copy_dev(pay.vs, st.v_scale, sc);
+        } else {
+            ok = copy_dev(pay.k, st.k_pool, (size_t) hd * 2) && copy_dev(pay.v, st.v_pool, (size_t) hd * 2);
+        }
+        if (!ok) { e = "fully-resident KV upload failed"; return false; }
+        // fully resident identity restore: the table is static in mode 0, rewrite it anyway (cheap, exact).
+        std::vector<int32_t> tab((size_t) st.n_pages);
+        for (int64_t i = 0; i < st.n_pages; ++i) tab[(size_t) i] = (int32_t) i;
+        if (cudaMemcpy(st.page_table, tab.data(), tab.size() * sizeof(int32_t), cudaMemcpyHostToDevice) !=
+            cudaSuccess) {
+            e = "page table restore failed";
+            return false;
+        }
+        return true;
+    }
+    if (!st.host.present()) { e = "no authoritative host copy"; return false; }
+    bool ok = false;
+    if (st.kv_q4) {
+        const size_t row = (size_t) strata::kernels::kv_q4_bytes_per_head((int) hd);
+        ok = copy_host(pay.k, st.host.k_q4, row) && copy_host(pay.v, st.host.v_q4, row);
+    } else if (st.kv_int8) {
+        const size_t sc = (size_t) (hd / strata::kernels::KV_Q8_GROUP) * 2;
+        ok = copy_host(pay.k, st.host.k_q, (size_t) hd) && copy_host(pay.v, st.host.v_q, (size_t) hd) &&
+             copy_host(pay.ks, st.host.k_scale, sc) && copy_host(pay.vs, st.host.v_scale, sc);
+    } else {
+        ok = copy_host(pay.k, st.host.k_pool, (size_t) hd * 2) &&
+             copy_host(pay.v, st.host.v_pool, (size_t) hd * 2);
+    }
+    if (!ok) { e = "host KV upload failed"; return false; }
+    if (st.kv_mode == 1) strata::kernels::kv_stream_reset(st.map, stream);   // slots refill from restored host
+    return true;   // mode 2 (ring): the caller refills via kv_ring_restore / mtp.kv_restore
+}
+
+/// One layer's indexer state: pooled block keys, block cursor, constant dead key. Device-only, always H2D.
+bool saved_restore_indexer(const strata::core::QsaState& st, const strata::core::ModelGeometry& g,
+                            const saved::IndexerPayload& pay, std::string& e) {
+    const int64_t dim = g.idx_key_dim;
+    if (dim < 1) { e = "bad indexer geometry"; return false; }
+    if (pay.pooled_rows > st.idx_pooled_rows) { e = "indexer rows exceed capacity"; return false; }
+    if ((int64_t) pay.pooled.size() != pay.pooled_rows * dim * 4) { e = "indexer pooled size"; return false; }
+    if ((int64_t) pay.dead_key.size() != dim * 4) { e = "indexer dead-key size"; return false; }
+    if (pay.block_pos.size() != 1) { e = "indexer cursor size"; return false; }
+    if (cudaMemcpy(st.idx_pooled, pay.pooled.data(), pay.pooled.size(), cudaMemcpyHostToDevice) != cudaSuccess ||
+        cudaMemcpy(st.idx_block_pos, pay.block_pos.data(), sizeof(int32_t), cudaMemcpyHostToDevice) !=
+            cudaSuccess ||
+        cudaMemcpy(st.idx_dead, pay.dead_key.data(), pay.dead_key.size(), cudaMemcpyHostToDevice) !=
+            cudaSuccess) {
+        e = "indexer upload failed";
+        return false;
+    }
+    return true;
+}
+
+/// One session's full state at L tokens: recurrent (via the checkpoint contract) + indexer + KV per layer.
+/// The caller holds the stage's OnDevice guard; the caller syncs the device after (orders kv_stream_reset).
+bool saved_restore_stage(strata::core::SessionState& ss, const strata::core::ModelGeometry& g,
+                          const saved::StagePayload& sp, const std::vector<int32_t>& ids, int64_t L, void* stream,
+                          std::string& e) {
+    if ((int64_t) sp.kv.size() != g.n_qsa_layers() || (int64_t) sp.idx.size() != g.n_qsa_layers()) {
+        e = "stage layer count changed";
+        return false;
+    }
+    ConvCheckpoint tmp;   // the checkpoint contract for GDN/PLE/tails (+ple_prev from ids, as at capture)
+    tmp.ids = ids;
+    tmp.gdn = sp.rec.gdn;
+    tmp.ple = sp.rec.ple;
+    tmp.tails = sp.rec.tails;
+    if (!checkpoint_restore(tmp, ss, g)) { e = "recurrent restore failed"; return false; }
+    for (int64_t i = 0; i < g.n_qsa_layers(); ++i) {
+        if (!saved_restore_indexer(ss.qsa_states[i], g, sp.idx[(size_t) i], e)) return false;
+        if (!saved_restore_kv(ss.qsa_states[i], g, sp.kv[(size_t) i], L, stream, e)) return false;
+    }
+    return true;
+}
+
+/// The drafter's L-1 real pairs into its K/V (either resident mode). Ring refill is the caller's
+/// (shared mtp.kv_restore); the boundary cell is the boundary block's, after the refill.
+bool saved_restore_mtp(strata::core::MtpDrafter& mtp, const strata::core::ModelGeometry& g,
+                        const saved::MtpPayload& m, std::string& e) {
+    if (m.kv.empty()) return true;
+    if (m.kv.size() != 1) { e = "MTP layer count"; return false; }
+    const strata::core::OnDevice on_mtp(mtp.device());   // the drafter's own device (a split's last stage)
+    if (cudaDeviceSynchronize() != cudaSuccess) { e = "MTP device not idle"; return false; }
+    return saved_restore_kv(mtp.kv_state(), g, m.kv[0], m.cells, nullptr, e);
+}
+
+/// CPU-ONLY validation for one restore candidate: geometry, every payload size, every live pointer and
+/// capacity the upload dereferences, and the MTP reachable valid_from. True = the upload may start; nothing
+/// below touches the GPU. In particular checkpoint_restore memcpys its inputs blindly, so the recurrent sizes
+/// (GDN, tails, PLE exactly as the live session holds them, ple_prev equal to the ids' last two) are gated
+/// here - a truncated payload must fail here, never mid-upload. `mtp`'s prompt length must already be the new
+/// request's (the call site sets it before the chain scan), so prefill_valid_from() is the new window's.
+bool saved_validate_for_restore(const saved::SavedItem& it, const std::vector<int32_t>& ids32,
+                                 const std::vector<saved::ImgKey>& req_simgs, bool cvec, int64_t n,
+                                 const strata::core::ModelGeometry& g, const strata::core::SessionState& ss,
+                                 const std::vector<std::unique_ptr<GpuStage>>& stages,
+                                 strata::core::MtpDrafter& mtp, std::string& why) {
+    const int64_t L = (int64_t) it.ids.size();
+    if (!it.complete()) { why = "incomplete payload"; return false; }
+    if (it.n_stages != (int) stages.size() + 1 || (int) it.stages.size() != it.n_stages) {
+        why = "stage count changed";
+        return false;
+    }
+    if (L < 1 || L > n) { why = "not a prefix of this request"; return false; }
+    if (!saved::is_prefix(it.ids, ids32)) { why = "ids not a prefix"; return false; }
+    if (it.cvec != cvec) { why = "control-vector identity changed"; return false; }
+    if (saved::imgs_below(req_simgs, L) != it.imgs) { why = "image identity changed"; return false; }
+    const saved::SnapshotGeom livegeom = saved_live_geom(g);
+    if (it.geom != livegeom) { why = "geometry changed"; return false; }
+    if (!it.boundary.complete() || it.boundary.hc != g.hc || it.boundary.n_embd != g.n_embd) {
+        why = "boundary row incomplete";
+        return false;
+    }
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t pages = (L + qs.page_size - 1) / qs.page_size;
+    const int64_t prow = L / qs.idx_block + 1;
+    const ConvStateSizes z = conv_state_sizes(g);
+    const size_t tails_exp = z.tail * (size_t) g.n_qsa_layers();
+    for (size_t s = 0; s < it.stages.size(); ++s) {
+        const strata::core::SessionState& ls = (s == 0) ? ss : stages[s - 1]->ss;
+        if (ls.qsa_states == nullptr) { why = "no live QSA states"; return false; }
+        if (L > ls.max_cells) { why = "exceeds max_cells"; return false; }
+        const saved::StagePayload& sp = it.stages[s];
+        if ((int64_t) sp.kv.size() != g.n_qsa_layers() || (int64_t) sp.idx.size() != g.n_qsa_layers()) {
+            why = "stage layer count changed";
+            return false;
+        }
+        // blocker 3: the exact recurrent sizes checkpoint_restore assumes (ple matches the live session's
+        // own presence bit, ple_prev the ids' last two) - gated before any copy starts.
+        if (sp.rec.gdn.size() != z.gdn) { why = "GDN state size"; return false; }
+        if (sp.rec.tails.size() != tails_exp) { why = "QSA tails size"; return false; }
+        if (ls.ple_hist != nullptr) {
+            if (sp.rec.ple.size() != z.ple) { why = "PLE history size"; return false; }
+        } else if (!sp.rec.ple.empty()) {
+            why = "PLE payload but no live PLE state";
+            return false;
+        }
+        if (sp.rec.ple_prev[0] != (L >= 2 ? it.ids[(size_t) (L - 2)] : -1) ||
+            sp.rec.ple_prev[1] != it.ids[(size_t) (L - 1)]) {
+            why = "ple_prev window";
+            return false;
+        }
+        for (int64_t i = 0; i < g.n_qsa_layers(); ++i) {
+            const strata::core::QsaState& q = ls.qsa_states[i];
+            // blocker 3: every pointer the upload dereferences, on every layer of every stage.
+            if (q.page_table == nullptr || q.idx_pooled == nullptr || q.idx_tail == nullptr ||
+                q.idx_dead == nullptr || q.idx_block_pos == nullptr) {
+                why = "indexer pointers missing";
+                return false;
+            }
+            if (q.n_pages < pages) { why = "KV pages exceed capacity"; return false; }
+            if (q.idx_pooled_rows < prow) { why = "indexer rows exceed capacity"; return false; }
+            if (!saved_kv_ptrs_ok(q, why)) return false;
+            if (saved_kv_format(q) != sp.kv[(size_t) i].fmt) { why = "KV format changed"; return false; }
+            if (!saved::kv_blob_ok(sp.kv[(size_t) i], L, livegeom)) { why = "KV blob size"; return false; }
+            const saved::IndexerPayload& ix = sp.idx[(size_t) i];
+            if (ix.pooled_rows != prow) { why = "indexer pooled rows"; return false; }
+            if ((int64_t) ix.pooled.size() != prow * livegeom.idx_dim * 4) {
+                why = "indexer pooled size";
+                return false;
+            }
+            if ((int64_t) ix.dead_key.size() != livegeom.idx_dim * 4) {
+                why = "indexer dead-key size";
+                return false;
+            }
+            if (ix.block_pos.size() != 1) { why = "indexer cursor size"; return false; }
+            // the cursor is write-only device scratch (a readable record of the last rotation position):
+            // positions always sit below max_cells (image-shifted too), so that bound catches corruption
+            // without false-rejecting real records.
+            if (ix.block_pos[0] < 0 || (int64_t) ix.block_pos[0] >= ls.max_cells) {
+                why = "indexer cursor out of bounds";
+                return false;
+            }
+        }
+    }
+    const strata::core::QsaState& mst = mtp.kv_state();
+    if (mst.max_cells <= 0) {
+        if (!it.mtp.kv.empty()) { why = "drafter off but snapshot has MTP rows"; return false; }
+    } else if (L > 1) {
+        if (it.mtp.kv.size() != 1 || it.mtp.cells != L - 1) { why = "MTP pair count"; return false; }
+        if (it.mtp.kv[0].fmt != saved_kv_format(mst)) { why = "MTP format changed"; return false; }
+        const int64_t mp = (it.mtp.cells + qs.page_size - 1) / qs.page_size;
+        if (mp > mst.n_pages || it.mtp.cells > mst.max_cells) { why = "MTP capacity"; return false; }
+        if (mst.page_table == nullptr) { why = "MTP page table missing"; return false; }
+        if (!saved_kv_ptrs_ok(mst, why)) return false;
+        if (!saved::kv_blob_ok(it.mtp.kv[0], it.mtp.cells, livegeom)) { why = "MTP blob size"; return false; }
+        // blocker 1 (Sol review): the new request's drafter window reaching BELOW the snapshot's first real
+        // pair resumes under unwritten zeros (garbage) - reject. Reaching ABOVE it is safe: the request
+        // simply needs a subset of the saved real pairs. prefill_valid_from() is the conservative
+        // (window+margin) lower bound of what the new request reaches.
+        if (mtp.prefill_valid_from() < it.mtp.valid_from) {
+            why = "MTP window reaches below valid_from";
+            return false;
+        }
+    }
+    return true;
+}
+
 // --control-vector-scaled: llama.cpp's `common_control_vector_load` (every file's `direction.<l>` times its scale,
 // summed; layer 0 has none) and `llama_adapter_cvec::apply` with the projection-mode patch (project: the unit
 // direction and its norm as the scale), into the tables `cvec_upload` takes.  `summary` is what INFO reports.
@@ -3220,6 +3521,18 @@ int main(int argc, char** argv) {
         int64_t e1_root_at = -1;
         std::vector<float> e1_root_row;
         int64_t e1_root_row_L = -1;
