+    out = saved::StagePayload{};
+    ConvCheckpoint tmp;   // the existing recurrent copy (GDN state + conv history, PLE history, QSA tails)
+    if (!checkpoint_save(tmp, ss, g)) return false;
+    out.rec.gdn = std::move(tmp.gdn);
+    out.rec.ple = std::move(tmp.ple);
+    out.rec.tails = std::move(tmp.tails);
+    for (int64_t i = 0; i < g.n_qsa_layers(); ++i) {
+        saved::KvLayerPayload kv;
+        if (!saved_snapshot_kv(ss.qsa_states[i], g, L, kv)) return false;
+        out.kv.push_back(std::move(kv));
+        saved::IndexerPayload ix;
+        if (!saved_snapshot_indexer(ss.qsa_states[i], g, L, ix)) return false;
+        out.idx.push_back(std::move(ix));
+    }
+    return true;
