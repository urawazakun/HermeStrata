+/// QSA KV cells [0, k) of one layer into `out`, rounded up to whole pages (page_size cells): the padding past k
+/// is stale-but-harmless (the verifier overwrites K/V cells past the accepted prefix before any query reads
+/// them), and page granularity keeps the restore a plain copy-back. With kv-resident (kv_mode 1 streamed, 2
+/// ring) the authoritative host copy - identity layout [page][kv_head][page_size] rows - is the source; fully
+/// resident (mode 0, identity page table) is copied D2H from the device pools.
+bool saved_snapshot_kv(const strata::core::QsaState& st, const strata::core::ModelGeometry& g, int64_t k,
+                       saved::KvLayerPayload& out) {
+    out = saved::KvLayerPayload{};
+    if (k <= 0) return true;
+    const strata::kernels::QsaShapes qs = strata::kernels::qsa_real_shapes();
+    const int64_t nH = g.n_head_kv, hd = g.head_dim, ps = qs.page_size;
+    if (nH < 1 || hd < 1 || ps < 1) return false;
+    const int64_t pages = (k + ps - 1) / ps;
+    if (pages > st.n_pages) return false;
+    const bool streamed = st.kv_mode != 0;
+    if (streamed && !st.host.present()) return false;   // no authoritative copy to read: store nothing
+    out.fmt = saved_kv_format(st);
+    out.cells = k;
+    auto page_bytes = [&](size_t row) { return (size_t) nH * (size_t) ps * row; };
+    auto copy_pool = [&](const void* dev, const void* host, size_t row, std::vector<uint8_t>& dst) -> bool {
+        const uint8_t* src = streamed ? (const uint8_t*) host : (const uint8_t*) dev;
+        if (src == nullptr) return false;
+        dst.resize(pages * page_bytes(row));
+        for (int64_t p = 0; p < pages; ++p)
