+namespace {
+std::string root_join(const std::string& dir, const std::string& name) {
+    return (fs::path(dir) / fs::path(name)).string();
+}
+/// Owned-regular check: exactly a regular file, never a symlink/reparse point. symlink_status (not
+/// status) so a symlink to a recognized name - pointing outside the configured root - is never
+/// scanned, read, touched or deleted. Fail closed: any error means "not owned".
+bool root_owned_regular(const fs::path& p) {
+    std::error_code ec;
+    const fs::file_status st = fs::symlink_status(p, ec);
+    return !ec && st.type() == fs::file_type::regular;
+}
+/// Genuine atomic file replacement: the old final is never removed first (it survives any failure
+/// below). Windows: MoveFileExW with REPLACE_EXISTING|WRITE_THROUGH (std::filesystem::rename does
+/// not overwrite there). POSIX: rename(2), atomic on the same filesystem. Same directory means
+/// same filesystem, so the replace is atomic. Only the caller's own temp is ever cleaned up.
+bool root_atomic_replace(const std::string& tmp_p, const std::string& final_p) {
+#ifdef _WIN32
+    const std::wstring wtmp = fs::path(tmp_p).wstring();
+    const std::wstring wfinal = fs::path(final_p).wstring();
+    return ::MoveFileExW(wtmp.c_str(), wfinal.c_str(),
+                         MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    std::error_code ec;
+    fs::rename(tmp_p, final_p, ec);
+    return !ec;
+#endif
+}
+bool root_read_all(const std::string& path, uint64_t size, std::vector<uint8_t>& buf) {
+    buf.assign((size_t)size, 0);
+    std::ifstream f(path, std::ios::binary);
+    if (!f) return false;
+    f.read((char*)buf.data(), (std::streamsize)buf.size());
+    return (bool)f && (size_t)f.gcount() == buf.size();
+}
+}  // namespace
+
+bool RootDiskStore::start(const Config& cfg, std::string& why) {
+    std::unique_lock<std::mutex> lk(mu_);
+    if (started_) {
+        why = "already started";
+        return false;
+    }
+    if (cfg.dir.empty()) {
+        why = "empty dir";
+        return false;
+    }
+    if (cfg.stages < 1) {
+        why = "bad stage count";
+        return false;
+    }
+    std::error_code ec;
+    fs::create_directories(cfg.dir, ec);
+    if (ec) {
+        why = "cannot create dir: " + ec.message();
+        return false;
+    }
+    cfg_ = cfg;
+    // The startup index is genuinely lazy: root_scan_meta streams each file's header + ids metadata and
+    // SEEK-SKIPS every bulk blob without reading or allocating it, so a multi-GB payload costs kilobytes
+    // of I/O here. Payloads load only on a request's exact full-ids match (load_item). Incompatible,
+    // corrupt, truncated, oversize, foreign-name and renamed (stem != content key) files are ignored.
+    std::map<std::string, Entry> fresh;
+    fs::directory_iterator end;
+    for (fs::directory_iterator it(cfg.dir, ec); !ec && it != end; it.increment(ec)) {
+        const std::string name = it->path().filename().string();
+        if (!root_file_name_ok(name)) continue;
+        if (!root_owned_regular(it->path())) continue;   // never follow symlinks/reparse points out
+        std::error_code e2;
+        const uint64_t fsize = it->file_size(e2);
+        if (e2 || fsize == 0 || fsize > kMaxRootFileBytes) continue;
+        RootDiskHeader hdr;
+        SavedItem meta;
+        std::string derr;
+        if (!root_scan_meta(it->path().string(), fsize, hdr, meta, derr)) continue;
+        if (!hdr.compatible_with(cfg_.live)) continue;
+        if (meta.ids.empty() || !(meta.geom == cfg_.live_geom) || meta.n_stages != cfg_.stages) continue;
+        if (name.substr(5, 16) != root_file_key(hdr, meta)) continue;
+        const std::string key = name.substr(5, 16);
+        auto dup = fresh.find(key);
+        if (dup == fresh.end()) {
+            fresh.emplace(key, Entry{hdr, std::move(meta), it->path().string(), fsize});
+            continue;
+        }
+        // Same key twice (a leftover rename/copy): keep the newer mtime, ignore the other.
+        std::error_code e3;
+        const fs::file_time_type t_old = fs::last_write_time(dup->second.path, e3);
+        const bool old_ok = !e3;
+        const fs::file_time_type t_new = fs::last_write_time(it->path(), e3);
+        if (e3 || (old_ok && t_new > t_old))
+            dup->second = Entry{hdr, std::move(meta), it->path().string(), fsize};
+    }
+    if (ec) {
+        why = "dir scan failed: " + ec.message();
+        return false;
+    }
+    index_ = std::move(fresh);
+    stop_ = false;
+    started_ = true;
+    try {
+        worker_ = std::thread(&RootDiskStore::worker_main, this);
+    } catch (const std::exception& ex) {
+        started_ = false;
+        index_.clear();
+        why = std::string("worker start failed: ") + ex.what();
+        return false;
+    }
+    // Startup cap enforce: the scan above only indexes, so without this a restart over cap would
+    // keep every stale root until the next write/shutdown. Runs OUTSIDE mu_ (trim_now locks it
+    // itself); nonfatal either way. The worker also trims after every write.
+    lk.unlock();
+    try {
+        std::string terr;
+        if (!trim_now(terr))
+            std::fprintf(stderr, "strata serve: root-disk: startup trim incomplete (%s)\n", terr.c_str());
+    } catch (const std::exception& ex) {
+        std::fprintf(stderr, "strata serve: root-disk: startup trim threw (%s)\n", ex.what());
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: root-disk: startup trim threw\n");
+    }
+    return true;
+}
+
+void RootDiskStore::shutdown() {
+    {
+        std::unique_lock<std::mutex> lk(mu_);
+        if (!started_) return;
+        stop_ = true;   // the worker drains the queue first, then exits: shutdown always joins
+    }
+    cv_.notify_all();
+    if (worker_.joinable()) worker_.join();
+    // Destructor shutdown must remain nonfatal even if the final filesystem trim allocates or throws.
+    try {
+        std::string why;
+        if (!trim_now(why))
+            std::fprintf(stderr, "strata serve: root-disk: shutdown trim incomplete (%s)\n", why.c_str());
+    } catch (const std::exception& ex) {
+        std::fprintf(stderr, "strata serve: root-disk: shutdown trim threw (%s)\n", ex.what());
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: root-disk: shutdown trim threw\n");
+    }
+    std::unique_lock<std::mutex> lk(mu_);
+    started_ = false;
+    stop_ = false;
+}
+
+bool RootDiskStore::enabled() const {
+    std::unique_lock<std::mutex> lk(mu_);
+    return started_;
+}
+
+size_t RootDiskStore::indexed() const {
+    std::unique_lock<std::mutex> lk(mu_);
+    return index_.size();
+}
+
+size_t RootDiskStore::pending() const {
+    std::unique_lock<std::mutex> lk(mu_);
+    return queue_.size();
+}
+
+bool RootDiskStore::find_match(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs, bool cvec,
+                               const std::vector<std::string>& skip, int64_t lo, int64_t hi,
+                               Entry& out) const {
+    std::unique_lock<std::mutex> lk(mu_);
+    if (!started_) return false;
+    bool found = false;
+    size_t best = 0;
+    for (const auto& [key, e] : index_) {
+        bool skipped = false;
+        for (const std::string& s : skip)
+            if (s == e.path) {
+                skipped = true;
+                break;
+            }
+        if (skipped) continue;
+        const int64_t L = (int64_t)e.meta.ids.size();
+        if (L <= lo || L >= hi) continue;   // chain wins ties (<= resume); k == n never mounts
+        if (!e.hdr.compatible_with(cfg_.live)) continue;
+        if (!(e.meta.geom == cfg_.live_geom) || e.meta.n_stages != cfg_.stages) continue;
+        if (e.meta.cvec != cvec) continue;
+        if (!is_prefix(e.meta.ids, ids)) continue;   // full exact ids: never hash-only
+        if (imgs_below(imgs, L) != e.meta.imgs) continue;
+        if (!found || e.meta.ids.size() > best) {
+            out = e;
+            best = e.meta.ids.size();
+            found = true;
+        }
+    }
+    return found;
+}
+
+bool RootDiskStore::load_item(const Entry& e, SavedItem& out, std::string& why) const {
+    RootDiskHeader live;
+    SnapshotGeom geom;
+    int stages = 1;
+    {
+        std::unique_lock<std::mutex> lk(mu_);
+        if (!started_) {
+            why = "store stopped";
+            return false;
+        }
+        live = cfg_.live;
+        geom = cfg_.live_geom;
+        stages = cfg_.stages;
+    }
+    std::error_code ec;
+    if (!root_owned_regular(e.path)) {   // fail closed: a swapped-in symlink is never read
+        why = "not an owned regular file";
+        return false;
+    }
+    const uint64_t fsize = fs::file_size(e.path, ec);
+    // The size bind: a replaced file (same name, different bytes) is refused, never half-trusted.
+    if (ec || fsize == 0 || fsize > kMaxRootFileBytes || fsize != e.file_bytes) {
+        why = "file changed since the index";
+        return false;
+    }
+    std::vector<uint8_t> buf;
+    if (!root_read_all(e.path, fsize, buf)) {
+        why = "cannot read file";
+        return false;
+    }
+    RootDiskHeader hdr;
+    SavedItem item;
+    if (!root_decode(buf.data(), buf.size(), hdr, item, false, why)) return false;
+    if (!hdr.compatible_with(live)) {
+        why = "header no longer compatible";
+        return false;
+    }
+    if (!(item.geom == geom) || item.n_stages != stages) {
+        why = "geometry changed";
+        return false;
+    }
+    if (item.ids != e.meta.ids || item.imgs != e.meta.imgs || item.cvec != e.meta.cvec) {
+        why = "payload does not match the index";
+        return false;
+    }
+    out = std::move(item);
+    return true;
+}
+
+void RootDiskStore::mark_used(const std::string& path) const {
+    {
+        std::unique_lock<std::mutex> lk(mu_);
+        if (!started_) return;
+    }
+    // The cap trim is LRU by mtime: a successful disk mount refreshes it. Best effort, nonfatal.
+    // Never touches a symlink/reparse point (a swapped-in link is not followed out of the root).
+    std::error_code ec;
+    if (!root_owned_regular(path)) return;
+    fs::last_write_time(path, fs::file_time_type::clock::now(), ec);
+}
+
+void RootDiskStore::enqueue(const SavedItem& item) {
+    // Cheap gates first (no bulk copied yet): completeness, started/stopped, then the file-key
+    // dedup. Only the final push copies the bulk - a disabled store or a duplicate returns before
+    // any multi-GB deep copy. Internal failures below are nonfatal drops (never throw past here).
+    try {
+        if (!item.complete()) return;   // never queue an inconsistent/incomplete payload
+        std::unique_lock<std::mutex> lk(mu_);
+        if (!started_ || stop_) return;
+        // Deduplicate by file key: a pinned root already on disk or already queued is skipped, so
+        // repeated snapshots of the same prefix never pile up unbounded in the writer queue. The
+        // queued_ marker is held through write completion (worker erases after write_one), so a
+        // duplicate arriving while the first root is still in flight is skipped too.
+        const std::string key = root_file_key(cfg_.live, item);
+        if (index_.count(key) != 0 || queued_.count(key) != 0) return;
+        const uint64_t bytes = item.payload_bytes();
+        if (queue_.size() >= kMaxRootQueue || queued_bytes_ + bytes > kMaxRootQueueBytes) {
+            std::fprintf(stderr, "strata serve: root-disk: writer queue full: capture dropped (nonfatal)\n");
+            return;
+        }
+        queue_.push(Queued{key, item});
+        queued_.insert(key);
+        queued_bytes_ += bytes;
+    } catch (const std::exception& ex) {
+        std::fprintf(stderr, "strata serve: root-disk: enqueue failed (%s): capture dropped (nonfatal)\n",
+                     ex.what());
+        return;
+    } catch (...) {
+        std::fprintf(stderr, "strata serve: root-disk: enqueue failed: capture dropped (nonfatal)\n");
+        return;
+    }
+    cv_.notify_one();
+}
+
+bool RootDiskStore::trim_now(std::string& why) {
+    std::string dir;
+    uint64_t cap = 0;
+    {
+        std::unique_lock<std::mutex> lk(mu_);
+        if (cfg_.dir.empty()) {
+            why = "no dir";
+            return false;
+        }
+        dir = cfg_.dir;
+        cap = cfg_.cap_bytes;
+    }
+    struct F {
+        std::string name, path;
+        uint64_t size = 0;
+        fs::file_time_type mtime{};
+    };
+    std::vector<F> files;
+    std::vector<F> tmps;
+    std::error_code ec;
+    fs::directory_iterator end;
+    for (fs::directory_iterator it(dir, ec); !ec && it != end; it.increment(ec)) {
+        const std::string name = it->path().filename().string();
+        const bool cache = root_file_name_ok(name);
+        const bool tmp = !cache && root_temp_name_ok(name);
+        if (!cache && !tmp) continue;   // never prune arbitrary user files
+        if (!root_owned_regular(it->path())) continue;   // never touch symlinks/reparse points
+        std::error_code e2;
+        F f;
+        f.name = name;
+        f.path = it->path().string();
+        f.size = it->file_size(e2);
+        if (e2) continue;
+        f.mtime = fs::last_write_time(it->path(), e2);
+        if (e2) continue;
+        (cache ? files : tmps).push_back(std::move(f));
+    }
+    if (ec) {
+        why = "dir scan failed: " + ec.message();
+        return false;
+    }
+    // Oldest-mtime-first past the cap: a successful disk mount refreshes mtime (mark_used), so live
+    // roots survive and stale ones leave. Only recognized cache files are ever deleted.
+    std::sort(files.begin(), files.end(),
+              [](const F& a, const F& b) { return a.mtime < b.mtime; });
+    uint64_t total = 0;
+    for (const F& f : files) total += f.size;
+    bool ok = true;
+    for (const F& f : files) {
+        if (total <= cap) break;
+        std::error_code e2;
+        fs::remove(f.path, e2);
+        if (e2) {
+            ok = false;   // keep going: delete what can be deleted
+            continue;
+        }
+        total -= f.size;
+        // Drop the index entry only when it points at the file just deleted (a duplicate key may
+        // legitimately point elsewhere after the scan's newer-mtime choice).
+        std::unique_lock<std::mutex> lk(mu_);
+        auto ein = index_.find(f.name.substr(5, 16));
+        if (ein != index_.end() && ein->second.path == f.path) index_.erase(ein);
+    }
+    // Stale recognized temps (a crashed writer's leftovers, older than an hour): same ownership rule.
+    const auto now = fs::file_time_type::clock::now();
+    for (const F& f : tmps) {
+        std::error_code e2;
+        const auto age = now - f.mtime;
+        if (age < std::chrono::hours(1)) continue;
+        fs::remove(f.path, e2);   // best effort: a leftover temp never fails the trim
+    }
+    if (!ok) why = "some deletions failed";
+    return ok;
+}
+
+void RootDiskStore::drop_path(const std::string& path) {
+    std::unique_lock<std::mutex> lk(mu_);
+    // Filesystem-path comparison (not raw strings): the index stores directory-iterator spellings
+    // while callers may pass root_join spellings, and `/` vs `\` differ textually on Windows.
+    for (auto it = index_.begin(); it != index_.end(); ++it) {
+        bool same = false;
+        try {
+            same = fs::path(it->second.path) == fs::path(path);
+        } catch (...) {
+            same = it->second.path == path;
+        }
+        if (same) {
+            index_.erase(it);
+            return;
+        }
+    }
+}
+
+void RootDiskStore::worker_main() {
+    // Serialized single writer: one root at a time, immutable captures, nonfatal errors. Shutdown
+    // sets stop_ and joins: the loop drains every queued capture first, then exits - no dropped
+    // writes. The destructor is effectively noexcept: per-task/per-trim exceptions (bad_alloc,
+    // filesystem, ...) are caught and logged, never propagated to terminate the process.
+    for (;;) {
+        Queued q;
+        uint64_t qbytes = 0;
+        {
+            std::unique_lock<std::mutex> lk(mu_);
+            cv_.wait(lk, [this] { return stop_ || !queue_.empty(); });
+            if (queue_.empty()) {
+                if (stop_) return;   // drained: shutdown always joins after every capture lands
+                continue;
+            }
+            q = std::move(queue_.front());
+            queue_.pop();
+            qbytes = q.item.payload_bytes();
+            // NOTE: queued_ keeps q.key until the write below completes, so a duplicate arriving
+            // while this root is in flight is skipped by enqueue instead of piling up.
+        }
+        try {
+            std::string why;
+            if (!write_one(q.key, q.item, why))
+                std::fprintf(stderr, "strata serve: root-disk: write %s skipped (%s)\n", q.key.c_str(),
+                             why.c_str());
+        } catch (const std::exception& ex) {
+            std::fprintf(stderr, "strata serve: root-disk: write %s threw (%s)\n", q.key.c_str(),
+                         ex.what());
+        } catch (...) {
+            std::fprintf(stderr, "strata serve: root-disk: write %s threw\n", q.key.c_str());
+        }
+        try {
+            std::string terr;
+            if (!trim_now(terr))
+                std::fprintf(stderr, "strata serve: root-disk: trim incomplete (%s)\n", terr.c_str());
+        } catch (const std::exception& ex) {
+            std::fprintf(stderr, "strata serve: root-disk: trim threw (%s)\n", ex.what());
+        } catch (...) {
+            std::fprintf(stderr, "strata serve: root-disk: trim threw\n");
+        }
+        // Release the dedup marker (and byte accounting) only now that the write finished.
+        std::unique_lock<std::mutex> lk(mu_);
+        queued_.erase(q.key);
+        queued_bytes_ -= std::min(queued_bytes_, qbytes);
+    }
+}
+
+bool RootDiskStore::write_one(const std::string& key, const SavedItem& item, std::string& why) {
+    RootDiskHeader live;
+    std::string dir;
+    {
+        // No stop_ early-out: shutdown drains the queue (every queued capture lands), so a write
+        // in flight during shutdown must complete, not report "stopping" and drop the root.
+        std::unique_lock<std::mutex> lk(mu_);
+        live = cfg_.live;
+        dir = cfg_.dir;
+    }
+    if (key != root_file_key(live, item)) {
+        why = "key mismatch";
+        return false;
+    }
+    std::vector<uint8_t> buf;
+    if (!root_encode(live, item, buf, why)) return false;   // worker-side serialize, off the serve path
+    // Atomic temp->replace in the same directory (same filesystem, so the replace is atomic). The
+    // old final is NEVER removed first and never adopted unverified: root_atomic_replace overwrites
+    // it in place (or fails leaving it intact). A same-key file always holds the same cacheable
+    // bytes - the key binds the header compat fields, full ids, images, cvec, geometry and stage
+    // count, and the full decode re-verifies header/key/payload before any restore, so a
+    // same-length key collision can never substitute mismatched ids/header. Only this call's own
+    // temp is ever cleaned up.
+    // Temps carry a process-unique suffix (single writer per directory is the documented
+    // ownership rule; unique temps keep two processes from clobbering each other's temp): a
+    // per-process atomic sequence plus nanosecond time plus the writer thread's hash.
+    static std::atomic<uint64_t> seq{0};
+    const std::string final_p = root_join(dir, "root-" + key + ".hstr");
+    uint64_t now_ns = 0;
+    try {
+        now_ns = (uint64_t)std::chrono::steady_clock::now().time_since_epoch().count();
+    } catch (...) {
+    }
+    const uint64_t th = (uint64_t)std::hash<std::thread::id>{}(std::this_thread::get_id());
+    const std::string tmp_p =
+        root_join(dir, "root-" + key + ".tmp." + std::to_string(seq.fetch_add(1)) + "-" +
+                         root_hex16(now_ns ^ (th + 0x9e3779b97f4a7c15ull)));
+    {
+        std::ofstream o(tmp_p, std::ios::binary | std::ios::trunc);
+        if (!o) {
+            why = "cannot open temp";
+            return false;
+        }
+        o.write((const char*)buf.data(), (std::streamsize)buf.size());
+        o.close();
+        if (!o) {
+            std::error_code ec;
+            fs::remove(tmp_p, ec);
+            why = "temp write failed";
+            return false;
+        }
+    }
+    if (!root_atomic_replace(tmp_p, final_p)) {
+        // Replace failed (the old final, if any, is intact - never removed first). Only our own
+        // temp is removed. Nonfatal either way.
+        std::error_code e2;
+        fs::remove(tmp_p, e2);
+        why = "replace failed";
+        return false;
+    }
+    {
+        // Publish the stripped metadata (bulk stays in the caller's copy / on disk, never duplicated
+        // into the index): the next request's find_match sees this root without any read.
+        std::unique_lock<std::mutex> lk(mu_);
+        SavedItem meta = item;
+        root_strip_bulk(meta);
+        index_[key] = Entry{live, std::move(meta), final_p, (uint64_t)buf.size()};
+    }
+    return true;
+}
+
 }  // namespace strata::program::saved_state
