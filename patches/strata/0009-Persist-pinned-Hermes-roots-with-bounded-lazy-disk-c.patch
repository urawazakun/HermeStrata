+        check(st.find_match(req_at(0, 60), no_imgs, true, {}, 0, 60, e),
+              "e3 re-landed file matches");
+        saved::SavedItem loaded;
+        check(st.load_item(e, loaded, why) && loaded.complete() && loaded.ids == it.ids,
+              "e3 re-landed payload loads complete");
+        const auto t_new = fs::last_write_time(final_p, ec);
+        check(!ec && t_new > t_old, "e3 replace refreshed the good file");
+        st.shutdown();
+    }
+    {   // E3: a never-started store is a safe no-op everywhere (true-cold shape without the engine).
+        saved::RootDiskStore d;
+        std::string why;
+        check(!d.enabled(), "e3 disabled store reports off");
+        d.enqueue(e3_canary_line(12, 0));
+        check(d.pending() == 0 && d.indexed() == 0, "e3 disabled enqueue is a no-op");
+        saved::RootDiskStore::Entry e;
+        check(!d.find_match(req_at(0, 20), no_imgs, true, {}, 0, 20, e), "e3 disabled find misses");
+        saved::SavedItem o;
+        check(!d.load_item(e, o, why), "e3 disabled load fails");
+        d.mark_used("whatever");   // must not crash
+        check(!d.trim_now(why), "e3 disabled trim fails");
