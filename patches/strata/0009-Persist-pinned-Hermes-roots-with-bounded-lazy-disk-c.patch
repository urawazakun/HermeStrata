+bool root_encode(const RootDiskHeader& hdr, const SavedItem& item, std::vector<uint8_t>& out,
+                 std::string& why) {
+    if (!item.complete()) {
+        why = "incomplete payload";
+        return false;
+    }
+    if (hdr.magic != RootDiskHeader::kMagic || hdr.version != RootDiskHeader::kVersion) {
+        why = "unsupported header version";
+        return false;
+    }
+    const std::string* strs[6] = {&hdr.engine_version, &hdr.pack_path,     &hdr.kv_type,
+                                  &hdr.mtp_dir,        &hdr.model_fingerprint, &hdr.numeric_flags};
+    for (const std::string* s : strs)
+        if (s->size() > kMaxRootString) {
+            why = "header string too long";
+            return false;
+        }
+    if (item.ids.size() > kMaxRootIds || item.imgs.size() > kMaxRootImages) {
+        why = "ids/images too long";
+        return false;
+    }
+    // Size bound BEFORE building the output: the writer below would otherwise allocate the full
+    // buffer first and check after. payload_bytes() sums already-allocated vector sizes, so this
+    // early-out costs nothing and never allocates.
+    if (item.payload_bytes() + 8 > kMaxRootFileBytes) {
+        why = "item exceeds the per-file bound";
+        return false;
+    }
+    RootWriter w;
+    w.u32(hdr.magic);
+    w.u32(hdr.version);
+    for (const std::string* s : strs) w.str(*s);
+    w.u64((uint64_t)item.ids.size());
+    w.u64(root_fnv1a(item.ids.data(), item.ids.size() * 4));
+    for (int32_t id : item.ids) w.i32(id);
+    w.u64((uint64_t)item.imgs.size());
+    for (const ImgKey& k : item.imgs) {
+        w.i64(k.start);
+        w.u64(k.hash);
+    }
+    w.u8(item.cvec ? 1 : 0);
+    w.i64(item.n_stages);
+    w.i64(item.geom.n_qsa_layers);
+    w.i64(item.geom.n_head_kv);
+    w.i64(item.geom.head_dim);
+    w.i64(item.geom.idx_dim);
+    w.i64(item.geom.idx_block);
+    w.i64(item.geom.page_size);
+    for (const StagePayload& s : item.stages) {
+        w.blob(s.rec.gdn);
+        w.blob(s.rec.ple);
+        w.blob(s.rec.tails);
+        w.i32(s.rec.ple_prev[0]);
+        w.i32(s.rec.ple_prev[1]);
+        for (const IndexerPayload& x : s.idx) {
+            w.i64(x.pooled_rows);
+            w.blob(x.pooled);
+            w.i32vec(x.block_pos);
+            w.blob(x.dead_key);
+        }
+        for (const KvLayerPayload& k : s.kv) root_write_kv(w, k);
+    }
+    w.i64(item.mtp.cells);
+    w.i64(item.mtp.valid_from);
+    w.u64((uint64_t)item.mtp.kv.size());
+    for (const KvLayerPayload& k : item.mtp.kv) root_write_kv(w, k);
+    w.i64(item.boundary.hc);
+    w.i64(item.boundary.n_embd);
+    w.floats(item.boundary.row);
+    // Versioned integrity: FNV-1a over every preceding payload byte. The ids hash binds the ids;
+    // this binds the whole bulk (recurrent/KV/indexer/MTP/boundary), so same-length corruption in
+    // any bulk byte fails the decode before any restore. Verified before any bulk allocation.
+    w.u64(root_fnv1a(w.b.data(), w.b.size()));
+    if (w.b.size() > kMaxRootFileBytes) {
+        why = "item exceeds the per-file bound";
+        return false;
+    }
+    out = std::move(w.b);
+    return true;
+}
