+bool root_decode(const uint8_t* data, size_t size, RootDiskHeader& hdr, SavedItem& item, bool meta_only,
+                 std::string& why) {
+    hdr = RootDiskHeader{};
+    item = SavedItem{};
+    if (data == nullptr || size < 16 || size > kMaxRootFileBytes) {
+        why = "file size out of range";
+        return false;
+    }
+    // Payload integrity FIRST, before any allocation: the trailing u64 checksums every preceding
+    // byte (v2). A same-length corruption in any bulk byte - invisible to the ids hash - fails here.
+    // v1 files (no checksum) fail closed: their last 8 payload bytes hash-mismatch, never trusted.
+    uint64_t want_hash = 0;
+    std::memcpy(&want_hash, data + size - 8, 8);
+    if (root_fnv1a(data, size - 8) != want_hash) {
+        why = "payload hash mismatch";
+        return false;
+    }
+    const size_t payload = size - 8;
+    RootReader r{data, payload, 0, true};
+    hdr.magic = r.u32();
+    hdr.version = r.u32();
+    if (!r.ok || hdr.magic != RootDiskHeader::kMagic) {
+        why = "bad magic";
+        return false;
+    }
+    if (hdr.version != RootDiskHeader::kVersion) {
+        why = "version mismatch";
+        return false;
+    }
+    std::string* strs[6] = {&hdr.engine_version, &hdr.pack_path,     &hdr.kv_type,
+                            &hdr.mtp_dir,        &hdr.model_fingerprint, &hdr.numeric_flags};
+    for (std::string* s : strs)
+        if (!r.str(*s, why)) return false;
+    const uint64_t ids_len = r.u64();
+    const uint64_t ids_hash = r.u64();
+    if (!r.ok) {
+        why = "truncated ids header";
+        return false;
+    }
+    if (ids_len == 0 || ids_len > kMaxRootIds || !r.avail(ids_len * 4)) {
+        why = "ids length out of range";
+        return false;
+    }
+    item.ids.resize((size_t)ids_len);
+    std::memcpy(item.ids.data(), data + r.pos, (size_t)ids_len * 4);
+    r.pos += (size_t)ids_len * 4;
+    if (root_fnv1a(item.ids.data(), item.ids.size() * 4) != ids_hash) {
+        item.ids.clear();
+        why = "ids hash mismatch";
+        return false;
+    }
+    hdr.ids_len = (int64_t)ids_len;
+    hdr.ids_hash = ids_hash;
+    const uint64_t n_imgs = r.u64();
+    if (!r.ok || n_imgs > kMaxRootImages || !r.avail(n_imgs * 16)) {
+        why = "image list out of range";
+        return false;
+    }
+    item.imgs.reserve((size_t)n_imgs);
+    for (uint64_t i = 0; i < n_imgs; ++i) {
+        ImgKey k{r.i64(), r.u64()};
+        item.imgs.push_back(k);
+    }
+    if (!r.ok) {
+        why = "truncated image list";
+        return false;
+    }
+    const uint8_t c = r.u8();
+    if (!r.ok || c > 1) {
+        why = "bad cvec flag";
+        return false;
+    }
+    item.cvec = c != 0;
+    // Check BEFORE the narrowing cast: a stored i64 like 2^32+1 would cast to int 1 and pass a
+    // post-cast range check (low-bit accepted overflow). The loop below is bounded by this check.
+    const int64_t n_stages = r.i64();
+    if (!r.ok || n_stages < 1 || n_stages > (int64_t)kMaxRootStages) {
+        why = "stage count out of range";
+        return false;
+    }
+    item.n_stages = (int)n_stages;
+    item.geom.n_qsa_layers = r.i64();
+    item.geom.n_head_kv = r.i64();
+    item.geom.head_dim = r.i64();
+    item.geom.idx_dim = r.i64();
+    item.geom.idx_block = r.i64();
+    item.geom.page_size = r.i64();
+    if (!r.ok) {
+        why = "truncated geometry";
+        return false;
+    }
+    // Geometry FIRST, before any loop or allocation: every scalar must be positive and within the
+    // kMaxRoot* caps. The caps keep all downstream size arithmetic in u64 range (worst case
+    // kv_pool_bytes stays below 2^64: 4M cells x 4096 heads x 64K page x 8K row), and the exact-size
+    // checks below then make every allocation geometry-derived. complete() re-checks consistency.
+    const SnapshotGeom& gm = item.geom;
+    if (item.n_stages < 1 || item.n_stages > (int)kMaxRootStages || gm.n_qsa_layers < 1 ||
+        gm.n_qsa_layers > kMaxRootLayers || gm.n_head_kv < 1 || gm.n_head_kv > kMaxRootHeads ||
+        gm.head_dim < 1 || gm.head_dim > kMaxRootDim || gm.idx_dim < 1 || gm.idx_dim > kMaxRootBlock ||
+        gm.idx_block < 1 || gm.idx_block > kMaxRootBlock || gm.page_size < 1 ||
+        gm.page_size > kMaxRootBlock) {
+        why = "geometry out of range";
+        return false;
+    }
+    const int64_t L = (int64_t)ids_len;
+    const bool want = !meta_only;
+    item.stages.reserve((size_t)item.n_stages);
+    for (int s = 0; s < item.n_stages; ++s) {
+        StagePayload sp;
+        // Recurrent cap enforced INSIDE blob() before allocation (exact size needs the full model
+        // geometry, so these carry the absolute kMaxRootRecBytes cap rather than a derived size).
+        if (!r.blob(sp.rec.gdn, want, why, kMaxRootRecBytes)) return false;
+        if (!r.blob(sp.rec.ple, want, why, kMaxRootRecBytes)) return false;
+        if (!r.blob(sp.rec.tails, want, why, kMaxRootRecBytes)) return false;
+        sp.rec.ple_prev[0] = r.i32();
+        sp.rec.ple_prev[1] = r.i32();
+        if (!r.ok) {
+            why = "truncated recurrent tail";
+            return false;
+        }
+        sp.idx.reserve((size_t)item.geom.n_qsa_layers);
+        for (int64_t i = 0; i < item.geom.n_qsa_layers; ++i) {
+            IndexerPayload x;
+            x.pooled_rows = r.i64();
+            if (!r.ok) {
+                why = "truncated indexer header";
+                return false;
+            }
+            // Exact indexer shape for L tokens (the capturer writes exactly this): rows, pool bytes,
+            // one cursor, one dead-key row. Checked u64 arithmetic (capped geometry above).
+            if (x.pooled_rows != L / gm.idx_block + 1) {
+                why = "indexer row count mismatch";
+                return false;
+            }
+            const uint64_t pooled_exp = (uint64_t)x.pooled_rows * (uint64_t)gm.idx_dim * 4;
+            const uint64_t dead_exp = (uint64_t)gm.idx_dim * 4;
+            if (!r.blob_exact(x.pooled, want, pooled_exp, why)) return false;
+            if (!r.i32vec(x.block_pos, want, 1, why)) return false;
+            if (!r.blob_exact(x.dead_key, want, dead_exp, why)) return false;
+            sp.idx.push_back(std::move(x));
+        }
+        sp.kv.reserve((size_t)item.geom.n_qsa_layers);
+        for (int64_t i = 0; i < item.geom.n_qsa_layers; ++i) {
+            KvLayerPayload k;
+            if (!root_read_kv(r, k, want, L, gm, false, why)) return false;
+            if (want) sp.kv.push_back(std::move(k));
+        }
+        if (want) item.stages.push_back(std::move(sp));
+    }
+    item.mtp.cells = r.i64();
+    item.mtp.valid_from = r.i64();
+    if (!r.ok || item.mtp.cells < 0 || item.mtp.cells > L || item.mtp.valid_from < 0 ||
+        item.mtp.valid_from > item.mtp.cells) {
+        why = "MTP counts out of range";
+        return false;
+    }
+    const uint64_t n_mtp = r.u64();
+    // Exactly the encoder's shapes: L == 1 carries no MTP layer; L > 1 carries exactly one.
+    if (!r.ok || n_mtp != (L == 1 ? 0u : 1u) || (L > 1 && item.mtp.cells != L - 1) ||
+        (L == 1 && item.mtp.cells != 0)) {
+        why = "MTP layer count mismatch";
+        return false;
+    }
+    for (uint64_t i = 0; i < n_mtp; ++i) {
+        KvLayerPayload k;
+        if (!root_read_kv(r, k, want, L, gm, true, why)) return false;
+        if (want) item.mtp.kv.push_back(std::move(k));
+    }
+    item.boundary.hc = r.i64();
+    item.boundary.n_embd = r.i64();
+    if (!r.ok || item.boundary.hc < 1 || item.boundary.n_embd < 1 ||
+        item.boundary.hc > (1 << 20) || item.boundary.n_embd > (1 << 20)) {
+        why = "boundary layout out of range";
+        return false;
+    }
+    // Exact repair-row size (checked: both factors <= 2^20, product fits u64; then avail-checked,
+    // so the allocation below is exact and bounded before it happens).
+    const uint64_t n_row = r.u64();
+    if (!r.ok || n_row != (uint64_t)item.boundary.hc * (uint64_t)item.boundary.n_embd ||
+        !r.avail(n_row * 4)) {
+        why = "boundary row size mismatch";
+        return false;
+    }
+    if (want) {
+        item.boundary.row.resize((size_t)n_row);
+        std::memcpy(item.boundary.row.data(), data + r.pos, (size_t)n_row * 4);
+    }
+    r.pos += (size_t)(n_row * 4);
+    if (!meta_only && !item.complete()) {
+        why = "incomplete payload";
+        return false;
+    }
+    if (r.pos != r.n) {
+        why = "trailing bytes";
+        return false;
+    }
+    return true;
+}
+
+namespace {
+// Streaming metadata reader for the startup index: scalar reads go through `read()`, every bulk blob
+// is skipped with `skip_blob()` (length validated against the file size, then seekg past it) without
+// reading or allocating it. `pos` is tracked arithmetically (never trusted from the stream), so all
+// bounds are checked before any read, seek or allocation.
+struct RootStreamReader {
+    std::istream& in;
+    uint64_t fsize = 0;
+    uint64_t pos = 0;
+    bool ok = true;
+    bool read(void* dst, uint64_t len, std::string& why) {
+        if (len > fsize || pos > fsize - len) {
+            ok = false;
+            why = "length past end";
+            return false;
+        }
+        in.read((char*)dst, (std::streamsize)len);
+        if (!in || (uint64_t)in.gcount() != len) {
+            ok = false;
+            why = "short read";
+            return false;
+        }
+        pos += len;
+        return true;
+    }
+    uint8_t u8(std::string& why) {
+        uint8_t v = 0;
+        if (!read(&v, 1, why)) ok = false;
+        return v;
+    }
+    uint32_t u32(std::string& why) {
+        uint32_t v = 0;
+        if (!read(&v, 4, why)) ok = false;
+        return v;
+    }
+    uint64_t u64(std::string& why) {
+        uint64_t v = 0;
+        if (!read(&v, 8, why)) ok = false;
+        return v;
+    }
+    int32_t i32(std::string& why) { return (int32_t)u32(why); }
+    int64_t i64(std::string& why) { return (int64_t)u64(why); }
+    bool str(std::string& s, std::string& why) {
+        const uint32_t L = u32(why);   // u32: the writer (RootWriter::str) and the full decoder both
+                                       // use u32 string lengths; u64 here misaligned every valid file.
+        if (!ok) {
+            why = "truncated string";
+            return false;
+        }
+        if (L > kMaxRootString) {
+            ok = false;
+            why = "oversize string";
+            return false;
+        }
+        // Remaining-bytes check BEFORE the assign: no allocation before the length is proven to fit
+        // the rest of the file.
+        if (pos > fsize || (uint64_t)L > fsize - pos) {
+            ok = false;
+            why = "string past end";
+            return false;
+        }
+        s.assign((size_t)L, '\0');
+        return read(s.data(), L, why);
+    }
+    // Validate a bulk length and seek past it: the bytes are never read.
+    bool skip_blob(std::string& why) {
+        const uint64_t L = u64(why);
+        if (!ok) {
+            why = "truncated blob length";
+            return false;
+        }
+        return skip(L, why);
+    }
+    bool skip(uint64_t len, std::string& why) {
+        if (len > fsize || pos > fsize - len) {
+            ok = false;
+            why = "skip past end";
+            return false;
+        }
+        if (len == 0) return true;
+        in.seekg((std::streamoff)len, std::ios::cur);
+        if (!in) {
+            ok = false;
+            why = "seek failed";
+            return false;
+        }
+        pos += len;
+        return true;
+    }
+    // Skip one KV payload's shape (fmt + cells scalars, four bulk blobs) with light validation; exact
+    // geometry-derived sizes are the full decoder's job (it runs on the bounded lazy load instead).
+    bool skip_kv(std::string& why) {
+        const int32_t fmt = i32(why);
+        const int64_t cells = i64(why);
+        if (!ok) {
+            why = "truncated KV header";
+            return false;
+        }
+        if (fmt != kKvF16 && fmt != kKvInt8 && fmt != kKvQ4) {
+            why = "unknown KV format";
+            return false;
+        }
+        if (cells < 0 || (uint64_t)cells > kMaxRootIds) {
+            why = "KV cell count out of range";
+            return false;
+        }
+        return skip_blob(why) && skip_blob(why) && skip_blob(why) && skip_blob(why);
+    }
+};
+}  // namespace
+
+bool root_scan_meta(const std::string& path, uint64_t fsize, RootDiskHeader& hdr, SavedItem& meta,
+                    std::string& why) {
+    hdr = RootDiskHeader{};
+    meta = SavedItem{};
+    if (fsize < 8 || fsize > kMaxRootFileBytes) {
+        why = "file size out of range";
+        return false;
+    }
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        why = "cannot open file";
+        return false;
+    }
+    RootStreamReader r{in, fsize, 0, true};
+    hdr.magic = r.u32(why);
+    hdr.version = r.u32(why);
+    if (!r.ok || hdr.magic != RootDiskHeader::kMagic) {
+        why = "bad magic";
+        return false;
+    }
+    if (hdr.version != RootDiskHeader::kVersion) {
+        why = "version mismatch";
+        return false;
+    }
+    std::string* strs[6] = {&hdr.engine_version, &hdr.pack_path,     &hdr.kv_type,
+                            &hdr.mtp_dir,        &hdr.model_fingerprint, &hdr.numeric_flags};
+    for (std::string* s : strs)
+        if (!r.str(*s, why)) return false;
+    const uint64_t ids_len = r.u64(why);
+    const uint64_t ids_hash = r.u64(why);
+    if (!r.ok) {
+        why = "truncated ids header";
+        return false;
+    }
+    if (ids_len == 0 || ids_len > kMaxRootIds) {
+        why = "ids length out of range";
+        return false;
+    }
+    // Remaining-bytes check BEFORE the resize: no ids allocation before the byte count is proven
+    // to fit the rest of the file (ids_len <= 4M so ids_len*4 cannot overflow u64).
+    if (r.pos > r.fsize || ids_len * 4 > r.fsize - r.pos) {
+        why = "ids past end";
+        return false;
+    }
+    meta.ids.resize((size_t)ids_len);
+    if (!r.read(meta.ids.data(), ids_len * 4, why)) {
+        meta.ids.clear();
+        return false;
+    }
+    if (root_fnv1a(meta.ids.data(), meta.ids.size() * 4) != ids_hash) {
+        meta.ids.clear();
+        why = "ids hash mismatch";
+        return false;
+    }
+    hdr.ids_len = (int64_t)ids_len;
+    hdr.ids_hash = ids_hash;
+    const uint64_t n_imgs = r.u64(why);
+    if (!r.ok || n_imgs > kMaxRootImages) {
+        why = "image list out of range";
+        return false;
+    }
+    meta.imgs.reserve((size_t)n_imgs);
+    for (uint64_t i = 0; i < n_imgs; ++i) {
+        const int64_t start = r.i64(why);
+        const uint64_t hash = r.u64(why);
+        if (!r.ok) {
+            why = "truncated image list";
+            return false;
+        }
+        meta.imgs.push_back(ImgKey{start, hash});
+    }
+    const uint8_t c = r.u8(why);
+    if (!r.ok || c > 1) {
+        why = "bad cvec flag";
+        return false;
+    }
+    meta.cvec = c != 0;
+    // Check BEFORE the narrowing cast (same low-bit overflow as the full decoder: 2^32+1 must not
+    // become int 1). The stage skip loop below is bounded by this check.
+    const int64_t scan_stages = r.i64(why);
+    if (!r.ok || scan_stages < 1 || scan_stages > (int64_t)kMaxRootStages) {
+        why = "stage count out of range";
+        return false;
+    }
+    meta.n_stages = (int)scan_stages;
+    meta.geom.n_qsa_layers = r.i64(why);
+    meta.geom.n_head_kv = r.i64(why);
+    meta.geom.head_dim = r.i64(why);
+    meta.geom.idx_dim = r.i64(why);
+    meta.geom.idx_block = r.i64(why);
+    meta.geom.page_size = r.i64(why);
+    if (!r.ok) {
+        why = "truncated geometry";
+        return false;
+    }
+    // Bounds before the skip loops (same caps as the full decoder): loop iterations stay bounded and
+    // every skip is range-checked against the file size, so no bulk byte is ever read here.
+    const SnapshotGeom& gm = meta.geom;
+    if (meta.n_stages < 1 || meta.n_stages > (int)kMaxRootStages || gm.n_qsa_layers < 1 ||
+        gm.n_qsa_layers > kMaxRootLayers || gm.n_head_kv < 1 || gm.n_head_kv > kMaxRootHeads ||
+        gm.head_dim < 1 || gm.head_dim > kMaxRootDim || gm.idx_dim < 1 || gm.idx_dim > kMaxRootBlock ||
+        gm.idx_block < 1 || gm.idx_block > kMaxRootBlock || gm.page_size < 1 ||
+        gm.page_size > kMaxRootBlock) {
+        why = "geometry out of range";
+        return false;
+    }
+    for (int s = 0; s < meta.n_stages; ++s) {
+        if (!r.skip_blob(why) || !r.skip_blob(why) || !r.skip_blob(why)) return false;   // rec
+        r.i32(why);
+        r.i32(why);   // ple_prev
+        if (!r.ok) {
+            why = "truncated recurrent tail";
+            return false;
+        }
+        for (int64_t i = 0; i < gm.n_qsa_layers; ++i) {
+            r.i64(why);   // pooled_rows
+            if (!r.ok) {
+                why = "truncated indexer header";
+                return false;
+            }
+            if (!r.skip_blob(why)) return false;   // pooled
+            const uint64_t n_bp = r.u64(why);      // block_pos
+            if (!r.ok || n_bp > 1024) {
+                why = "block_pos out of range";
+                return false;
+            }
+            if (!r.skip(n_bp * 4, why)) return false;
+            if (!r.skip_blob(why)) return false;   // dead_key
+        }
+        for (int64_t i = 0; i < gm.n_qsa_layers; ++i)
+            if (!r.skip_kv(why)) return false;
+    }
+    meta.mtp.cells = r.i64(why);
+    meta.mtp.valid_from = r.i64(why);
+    if (!r.ok) {
+        why = "truncated MTP header";
+        return false;
+    }
+    const uint64_t n_mtp = r.u64(why);
+    if (!r.ok || n_mtp > 1) {
+        why = "MTP layer count out of range";
+        return false;
+    }
+    for (uint64_t i = 0; i < n_mtp; ++i)
+        if (!r.skip_kv(why)) return false;
+    meta.boundary.hc = r.i64(why);
+    meta.boundary.n_embd = r.i64(why);
+    if (!r.ok) {
+        why = "truncated boundary header";
+        return false;
+    }
+    const uint64_t n_row = r.u64(why);
+    if (!r.ok) {
+        why = "truncated boundary length";
+        return false;
+    }
+    if (n_row > kMaxRootFileBytes / 4) {
+        why = "boundary row too large";
+        return false;
+    }
+    if (!r.skip(n_row * 4, why)) return false;   // the repair row: never read at scan time
+    // Trailing v2 payload checksum: presence-checked only (8 bytes, no trailing garbage). Bulk is
+    // never read at scan time, so integrity verification stays deferred to the bounded lazy load -
+    // but the exact size bind means a truncated/corrupt checksum fails here, and load_item's full
+    // decode verifies it before any restore.
+    r.u64(why);   // payload checksum (verified on lazy load, not at scan)
+    if (!r.ok) {
+        why = "truncated payload checksum";
+        return false;
+    }
+    if (r.pos != r.fsize) {
+        why = "trailing bytes";
+        return false;
+    }
+    return true;
+}
+
+void root_strip_bulk(SavedItem& item) {
+    for (StagePayload& s : item.stages) {
+        s.rec.gdn.clear();
+        s.rec.gdn.shrink_to_fit();
+        s.rec.ple.clear();
+        s.rec.ple.shrink_to_fit();
+        s.rec.tails.clear();
+        s.rec.tails.shrink_to_fit();
+        for (IndexerPayload& x : s.idx) {
+            x.pooled.clear();
+            x.pooled.shrink_to_fit();
+            x.dead_key.clear();
+            x.dead_key.shrink_to_fit();
+        }
+        for (KvLayerPayload& k : s.kv) {
+            k.k.clear();
+            k.k.shrink_to_fit();
+            k.v.clear();
+            k.v.shrink_to_fit();
+            k.ks.clear();
+            k.ks.shrink_to_fit();
+            k.vs.clear();
+            k.vs.shrink_to_fit();
+        }
+    }
+    for (KvLayerPayload& k : item.mtp.kv) {
+        k.k.clear();
+        k.k.shrink_to_fit();
+        k.v.clear();
+        k.v.shrink_to_fit();
+        k.ks.clear();
+        k.ks.shrink_to_fit();
+        k.vs.clear();
+        k.vs.shrink_to_fit();
+    }
+    item.boundary.row.clear();
+    item.boundary.row.shrink_to_fit();
+    item.bytes = 0;
+}
+
+RootDiskStore::RootDiskStore() = default;
+
+RootDiskStore::~RootDiskStore() { shutdown(); }
