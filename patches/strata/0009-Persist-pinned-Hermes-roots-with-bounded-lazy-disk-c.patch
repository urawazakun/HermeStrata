+        st.shutdown();
+    }
+    {   // E3: strict GiB parsing (shared helper): malformed/inf/nan/negative/exact-boundary
+        // reject, sane values accept. The exact boundary is 2^34 GiB ((double)UINT64_MAX rounds up
+        // to 2^64): it must reject with >=, since == already converts to 2^64 bytes (undefined).
+        double gib = -1.0;
+        std::string err;
+        check(!saved::parse_gib_flag(nullptr, gib, err), "e3 gib null rejects");
+        check(!saved::parse_gib_flag("", gib, err), "e3 gib empty rejects");
+        check(!saved::parse_gib_flag("abc", gib, err), "e3 gib non-numeric rejects");
+        check(!saved::parse_gib_flag("12x", gib, err), "e3 gib trailing garbage rejects");
+        check(!saved::parse_gib_flag("12 ", gib, err), "e3 gib trailing space rejects");
+        check(!saved::parse_gib_flag("-1", gib, err), "e3 gib negative rejects");
+        check(saved::parse_gib_flag("-0.0", gib, err) && gib == 0.0,
+              "e3 gib negative zero accepts as zero");
+        check(!saved::parse_gib_flag("nan", gib, err), "e3 gib nan rejects");
+        check(!saved::parse_gib_flag("inf", gib, err), "e3 gib inf rejects");
+        check(!saved::parse_gib_flag("-inf", gib, err), "e3 gib -inf rejects");
+        check(!saved::parse_gib_flag("1e999", gib, err), "e3 gib overflow rejects");
+        check(!saved::parse_gib_flag("17179869184", gib, err), "e3 gib exact 2^34 boundary rejects");
+        check(!saved::parse_gib_flag("20000000000", gib, err), "e3 gib past boundary rejects");
+        check(saved::parse_gib_flag("0", gib, err) && gib == 0.0, "e3 gib zero accepts");
+        check(saved::parse_gib_flag("20", gib, err) && gib == 20.0, "e3 gib integer accepts");
+        check(saved::parse_gib_flag("0.5", gib, err) && gib == 0.5, "e3 gib fraction accepts");
+        check(saved::parse_gib_flag("1e3", gib, err) && gib == 1000.0, "e3 gib exponent accepts");
+        check(saved::parse_gib_flag("17179869183", gib, err) && gib == 17179869183.0,
+              "e3 gib just below boundary accepts");
+    }
+    {   // E3: a corrupt same-key file is atomically replaced by the recaptured root (startup scan
+        // ignores it, so enqueue proceeds; the rewrite overwrites it in place, old bytes never
+        // trusted). No temp leftovers, payload loads complete.
+        const std::string sub = "rootdisk-e3-tmp/replace";
+        std::error_code ec;
+        fs::create_directories(sub, ec);
+        check(!ec, "e3 replace tmpdir created");
+        const saved::RootDiskHeader h = e3_header();
+        const saved::SavedItem it = e3_canary_line(40, 0);
+        const std::string key = saved::root_file_key(h, it);
+        const std::string final_p = sub + "/root-" + key + ".hstr";
+        e3_write_text(final_p, std::string(128, '\x7f'));   // corrupt same-key file (bad magic)
