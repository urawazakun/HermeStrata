+strata::program::saved_state::RootDiskHeader root_live_header(const Options& o, bool& ok) {
+    strata::program::saved_state::RootDiskHeader h;
+    h.engine_version = STRATA_VERSION;
+    h.pack_path = root_norm_path(o.pack);
+    h.kv_type = o.kv;
+    bool mok = true, fok = true, nok = true;
+    h.mtp_dir = root_mtp_identity(o, mok);
+    h.model_fingerprint = root_model_fingerprint(o, fok);
+    h.numeric_flags = root_numeric_flags(o, nok);
+    ok = mok && fok && nok;   // any unreadable identity input fails closed (caller disables disk)
+    return h;
+}
 
