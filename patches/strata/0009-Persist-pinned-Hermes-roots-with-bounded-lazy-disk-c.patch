+}
+
+// The cvec identity: file paths + scales + layer range + mode + direction + a contents hash (the
+// files are ~1 MB: contents, not just sizes, because a same-size edited vector changes numerics).
+// Scales hash as EXACT float bits (%.6g collapses distinct scales: 1.0000001 vs 1.0 would share an
+// identity and restore wrong bytes). Any unreadable file fails closed (ok=false): the caller then
+// disables disk instead of authorizing reuse under a common 'err' fingerprint.
+std::string root_cvec_identity(const Options& o, bool& ok) {
+    ok = true;
+    if (o.cvec_files.empty()) return "none";
+    std::string out;   // human-readable path records (the hash below binds them exactly)
+    uint64_t h = 1469598103934665603ull;
+    for (const auto& [path, scale] : o.cvec_files) {
+        uint32_t bits = 0;   // exact float bits, never a rounded decimal
+        static_assert(sizeof(bits) == sizeof(scale), "float is 32 bits");
+        std::memcpy(&bits, &scale, sizeof bits);
+        char sc[16];
+        std::snprintf(sc, sizeof sc, "%08x", (unsigned)bits);
+        const std::string rec = root_norm_path(path) + ":bits=" + sc + ";";
+        out += rec;
+        const uint64_t L = (uint64_t) rec.size();   // length-prefix the role/path record
+        h = fnv1a(&L, 8, h);
+        h = fnv1a(rec.data(), rec.size(), h);
+        try {
+            std::error_code ec;
+            const std::filesystem::file_status lst =
+                std::filesystem::symlink_status(std::filesystem::path(path), ec);
+            if (ec || lst.type() != std::filesystem::file_type::regular) { ok = false; continue; }
+            const uint64_t sz = std::filesystem::file_size(std::filesystem::path(path), ec);
+            if (!ec && sz <= (1ull << 30)) {
+                std::ifstream f(path, std::ios::binary);
+                if (f) {
+                    std::vector<char> buf((size_t)sz);
+                    f.read(buf.data(), (std::streamsize)buf.size());
+                    if (f) h = fnv1a(buf.data(), buf.size(), h);
+                    else ok = false;
+                } else {
+                    ok = false;
+                }
+            } else {
+                ok = false;
+            }
+        } catch (...) {
+            ok = false;
+        }
+    }
+    char tail[128];
+    std::snprintf(tail, sizeof tail, "range=%d-%d;mode=%d;single=%d;", o.cvec_first, o.cvec_last,
+                  o.cvec_mode, o.cvec_single);
+    out += tail;
+    char hb[17];
+    std::snprintf(hb, sizeof hb, "%016llx", (unsigned long long)h);
+    return out + "content=" + hb;
+}
+
+std::string root_model_fingerprint(const Options& o, bool& ok) {
+    std::vector<std::pair<std::string, std::string>> files;
+    files.emplace_back("pack", o.pack);
+    if (!o.ple_gguf.empty()) files.emplace_back("ple", o.ple_gguf);
+    if (!o.native_preset.empty()) files.emplace_back("native-preset", o.native_preset);
+    int di = 0;
+    for (const std::string& s : o.native_dense_gguf)
+        files.emplace_back("native-dense-" + std::to_string(di++), s);
+    if (!o.native_head_gguf.empty()) files.emplace_back("native-head", o.native_head_gguf);
+    const RootFp fp = root_files_fingerprint(files);
+    ok = fp.ok;
+    return fp.hex;
+}
+
+std::string root_mtp_identity(const Options& o, bool& ok) {
+    ok = true;
+    if (o.mtp.empty()) return "";
+    const RootFp fp = root_files_fingerprint({{"mtp", o.mtp}});
+    ok = fp.ok;
+    return root_norm_path(o.mtp) + "|content=" + fp.hex;
+}
+
+std::string root_numeric_flags(const Options& o, bool& ok) {
+    // Every flag that changes the saved state's numerics. Fail-closed extras (vision, no_pool,
+    // spec_split, read strategy) only ever cause more misses, never a wrong restore: any
+    // difference ignores the file. Capacities (max_context), residency sizes (expert_cache) and
+    // drafting policy (suffix_draft, spec_adapt, spec_min_p) do not: the restore re-validates
+    // capacities and windows instead.
+    std::string s = "kvres=" + std::to_string((long long)o.kv_resident) + ";";
+    const bool* bits[14] = {&o.stream_token,
+                            &o.gr_fp32_activations,
+                            &o.gr_native_mmvf,
+                            &o.native_bf16,
+                            &o.native_bf16_extra,
+                            &o.native_ple_key,
+                            &o.native_moe_combine,
+                            &o.native_gdn,
+                            &o.native_flash_attn_short,
+                            &o.native_qsa_indexer,
+                            &o.native_qsa,
+                            &o.native_rope,
+                            &o.native_ple_postops,
+                            &o.native_router};
+    s += "bits=";
+    for (const bool* b : bits) s += *b ? '1' : '0';
+    s += std::string(";cpuq8=") + (o.cpu_oracle_q8_0 ? '1' : '0');
+    s += std::string(";nople=") + (o.no_ple ? '1' : '0');
+    // Ablations / execution-shape flags that alter the payload or its reductions (E3 review).
+    // keep_canonical loads canonical copies of natively served tensors (different bytes).
+    // no_prefill_borrow is deliberately excluded: buffer lending only changes scratch sourcing,
+    // never the captured reductions.
+    s += std::string(";vision=") + (o.vision ? '1' : '0');
+    s += std::string(";nopool=") + (o.no_pool ? '1' : '0');
+    s += std::string(";specsplit=") + (o.spec_split ? '1' : '0');
+    s += std::string(";keepcanon=") + (o.keep_canonical ? '1' : '0');
+    s += ";shortread=" + std::to_string((long long)o.short_read) + ";prefillchunk=" +
+         std::to_string((long long)o.prefill_chunk) + ";";
+    bool cok = true;
+    s += ";cvec=" + root_cvec_identity(o, cok);
+    ok = cok;
+    s += ";mtpwin=" + std::to_string((long long)o.mtp_window) + ";spec=" + std::to_string(o.spec) + ";";
+    return s;
+}
