+                    const uint64_t sz = it->file_size(e3);
+                    const auto mt = std::filesystem::last_write_time(it->path(), e4);
+                    if (e3 || e4) { ok = false; continue; }
+                    rec.push_back(role + ":" + rel + "=" + std::to_string(sz) + ":" +
+                                  std::to_string((long long)mt.time_since_epoch().count()) + ";");
+                }
+                if (wec) ok = false;
+                continue;
+            }
+            std::error_code e2, e3;
+            const uint64_t sz = std::filesystem::file_size(q, e2);
+            const auto mt = std::filesystem::last_write_time(q, e3);
+            if (e2 || e3) {
+                rec.push_back(role + ":" + p + "=err;");
+                ok = false;
+                continue;
+            }
+            rec.push_back(role + ":" + std::filesystem::path(p).filename().string() + "=" +
+                          std::to_string(sz) + ":" +
+                          std::to_string((long long)mt.time_since_epoch().count()) + ";");
