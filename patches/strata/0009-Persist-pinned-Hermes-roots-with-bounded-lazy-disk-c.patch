+uint64_t root_fnv1a(const void* data, size_t n, uint64_t h) {
+    const uint8_t* p = (const uint8_t*)data;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= p[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+std::string root_hex16(uint64_t h) {
+    char b[17];
+    std::snprintf(b, sizeof b, "%016llx", (unsigned long long)h);
+    return std::string(b);
+}
+
+bool parse_gib_flag(const char* text, double& gib, std::string& err) {
+    gib = 0.0;
+    if (text == nullptr || *text == '\0') {
+        err = "empty value";
+        return false;
+    }
+    errno = 0;
+    char* end = nullptr;
+    const double v = std::strtod(text, &end);
+    if (end == text || *end != '\0') {
+        err = "not a number";
+        return false;
+    }
+    if (errno == ERANGE) {
+        err = "out of range";
+        return false;
+    }
+    if (!(v >= 0.0) || !std::isfinite(v)) {
+        err = "must be a finite value >= 0";
+        return false;
+    }
+    // Exact-boundary reject: (double)UINT64_MAX rounds UP to 2^64, so the quotient rounds to 2^34
+    // GiB and a value == 2^34 GiB would convert to 2^64 bytes (undefined). >= rejects the boundary
+    // itself, not just above it.
+    if (v >= (double) UINT64_MAX / 1073741824.0) {
+        err = "too large";
+        return false;
+    }
+    gib = v;
+    return true;
+}
