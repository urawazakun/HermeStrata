+        for (fs::directory_iterator jt(sub, ec); !ec && jt != fs::directory_iterator(); jt.increment(ec))
+            if (saved::root_temp_name_ok(jt->path().filename().string())) tmp_left = true;
+        check(!ec && !tmp_left, "e3 no temp leftovers after replace");
+        st.shutdown();
+    }
+    {   // E3: replacing an existing GOOD file is safe (valid before and after, mtime refreshed),
+        // and drop_path repairs a bad index entry so the same key can be recaptured and queued.
+        const std::string sub = "rootdisk-e3-tmp/repair";
+        std::error_code ec;
+        fs::create_directories(sub, ec);
+        check(!ec, "e3 repair tmpdir created");
+        const saved::RootDiskHeader h = e3_header();
+        const saved::SavedItem it = e3_canary_line(40, 0);
+        const std::string key = saved::root_file_key(h, it);
+        std::vector<uint8_t> buf;
+        std::string why;
+        check(saved::root_encode(h, it, buf, why), "e3 repair fixture encodes");
+        const std::string final_p = sub + "/root-" + key + ".hstr";
+        e3_write(final_p, buf);
+        check(e3_age_hours(final_p, 2), "e3 repair file aged");
+        const auto t_old = fs::last_write_time(final_p, ec);
