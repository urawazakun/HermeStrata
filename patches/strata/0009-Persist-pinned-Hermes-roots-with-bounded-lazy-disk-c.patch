+// ---- E3: root-disk identity (DESIGN-HERMES-CACHE.md section 2, E3 bullet). ----------------------
+// Implemented: Muse / review: Sol. The RootDiskHeader this process writes and accepts: the engine
+// version (STRATA_VERSION), the normalized absolute pack path, the --kv type, the MTP dir path plus
+// its contents fingerprint, the model fingerprint (pack listing + PLE/native shards as
+// name=size:mtime, FNV-hashed), and the numeric flags (kv-resident value, every --native-* bit,
+// stream-token/oracle bits, no-ple, the full cvec identity incl. file contents, MTP window, spec
+// width). Any difference ignores the file: a stale root never restores. All filesystem reads are
+// best-effort (a missing file fingerprints as missing: deterministic, so both runs agree).
+std::string root_norm_path(const std::string& p) {
+    try {
+        std::error_code ec;
+        std::filesystem::path q = std::filesystem::absolute(std::filesystem::path(p), ec);
+        if (ec) return p;
+        return q.lexically_normal().string();
+    } catch (...) {
+        return p;
+    }
+}
+
+// Recursive FNV-1a hex over a sorted listing of (role, relative-path, size, mtime) records.
+// Sizes+mtimes, not contents: the model shards are tens of GB (contents hashing is for the small
+// cvec files below). Directories are walked RECURSIVELY (a nested weights change must change the
+// fingerprint), paths are normalized relative paths with a role prefix, and every variable field
+// is length-prefixed in the hash mix so two different (role, path) splits never hash equal.
+// Symlinks/reparse points are never followed. Fail closed: any unreadable/missing/erroneous entry
+// (or an unreadable directory) sets ok=false - common 'err' fingerprints must never authorize
+// reuse. The caller disables disk when !ok (nonfatal: the engine serves from chain/tips only).
+struct RootFp {
+    std::string hex;
+    bool ok = false;
+};
+RootFp root_files_fingerprint(const std::vector<std::pair<std::string, std::string>>& role_paths) {
+    std::vector<std::string> rec;
+    bool ok = true;
+    auto mix_len = [](uint64_t& h, uint64_t v) { h = fnv1a(&v, 8, h); };
+    for (const auto& [role, p] : role_paths) {
+        try {
+            std::error_code ec;
+            const std::filesystem::path q(p);
+            const std::filesystem::file_status lst = std::filesystem::symlink_status(q, ec);
+            if (ec || lst.type() == std::filesystem::file_type::not_found) {
+                rec.push_back(role + ":" + p + "=missing;");
+                ok = false;
+                continue;
+            }
+            if (lst.type() != std::filesystem::file_type::regular &&
+                lst.type() != std::filesystem::file_type::directory) {
+                rec.push_back(role + ":" + p + "=special;");   // symlink/reparse: never followed
+                ok = false;
+                continue;
+            }
+            if (lst.type() == std::filesystem::file_type::directory) {
+                size_t entries = 0;
+                // Default options: no follow, no skip_permission_denied - an unreadable subtree
+                // surfaces as an iterator error below and fails closed (never silently skipped).
+                std::error_code wec;
+                std::filesystem::recursive_directory_iterator end;
+                for (std::filesystem::recursive_directory_iterator it(q, wec);
+                     !wec && it != end; it.increment(wec)) {
+                    if (++entries > (1u << 20)) { ok = false; break; }   // bounded walk
+                    // Separate codes per syscall: a later success must never overwrite an earlier
+                    // error, and every status/size/mtime failure fails closed.
+                    std::error_code e2, e3, e4;
+                    const std::filesystem::file_status est =
+                        std::filesystem::symlink_status(it->path(), e2);
+                    if (e2) { ok = false; continue; }   // status unreadable: fail closed
+                    if (est.type() == std::filesystem::file_type::directory) continue;   // descended
