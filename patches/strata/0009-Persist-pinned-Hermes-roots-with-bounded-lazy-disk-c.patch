+// ---- E3: root disk persistence (DESIGN-HERMES-CACHE.md section 2, E3 bullet). -------------------
+//
+// Implemented: Muse / review: Sol. CPU-ONLY (this header + saved_state.cpp, no CUDA): a durable versioned
+// bounded binary serialization of RootDiskHeader + the full SavedItem (every E1 payload: ids, image/cvec
+// identity, geometry, all stages' recurrent/indexer/KV, the MTP rows with valid_from, the boundary row).
+//
+// Layout (all little-endian; strings/blobs are length + bytes):
+//   u32 magic, u32 version, 6 x (u32 len + bytes: engine_version, pack_path, kv_type, mtp_dir,
+//   model_fingerprint, numeric_flags), u64 ids_len, u64 ids_hash (FNV-1a over the ids, verified on
+//   decode), ids_len x i32 ids, u64 img count + (i64 start, u64 hash) pairs, u8 cvec, i64 n_stages,
+//   6 x i64 geometry, then per stage (rec gdn/ple/tails blobs + ple_prev, per-layer indexer + KV blobs),
+//   the MTP (cells, valid_from, 0/1 KV payloads), the boundary row (hc, n_embd, floats), and a
+//   trailing u64 FNV-1a checksum over every preceding payload byte (v2): same-length corruption
+//   anywhere in the recurrent/KV bulk that the ids hash cannot see fails the decode before any
+//   restore. The streaming scan cannot verify the checksum without reading bulk (multi-GB), so
+//   startup defers integrity to the bounded lazy load - but no corrupt bulk is ever restored.
+//
+// Every length is checked against the remaining bytes (and the kMaxRoot* caps) BEFORE any allocation, so
+// a corrupt/truncated/oversize file fails the decode without a large allocation. Mismatched headers,
+// failed decodes and incomplete payloads are ignored safely (never a partial item).
+//
+// Files: `root-<16 hex>.hstr` under the configured dir, where the stem is root_file_key() (FNV-1a over the
+// header compat fields + full ids + images + cvec + geometry + stage count). Only exactly that pattern
+// (plus the writer's `root-<hex>.tmp.*` temps) is ever created, touched or deleted: trimming never prunes
+// arbitrary user files. Writes go to a temp file and rename atomically; write errors are nonfatal.
+uint64_t root_fnv1a(const void* data, size_t n, uint64_t h = 1469598103934665603ull);
+/// Strict GiB flag parser (E3 review: --root-cap-gib must be finite with a bounded conversion,
+/// and a malformed string must error - never a silent atof invalid=>0 accidental purge).
+/// Full-string strtod: empty, trailing garbage, NaN/inf, negatives and values at/above the exact
+/// uint64-byte-conversion boundary (2^34 GiB: (double)UINT64_MAX rounds up to 2^64, so >= rejects
+/// the boundary itself) all fail. 0 is valid (keep nothing). Shared CPU helper (generate.cpp uses
+/// it for --root-cap-gib/--tip-cache-gib); unit-tested in saved_state_test.cpp.
+bool parse_gib_flag(const char* text, double& gib, std::string& err);
+inline uint64_t root_fnv1a_str(const std::string& s, uint64_t h = 1469598103934665603ull) {
+    return root_fnv1a(s.data(), s.size(), h);
+}
+std::string root_hex16(uint64_t h);
+/// The filename stem for a (header, item) pair: the full exact key (header compat fields, full ids,
+/// image/cvec identity, geometry, stage count) hashed. Equal keys mean the same cacheable bytes.
+std::string root_file_key(const RootDiskHeader& hdr, const SavedItem& item);
+/// True for exactly `root-<16 hex>.hstr` (ASCII, no directories): the only names the store deletes.
+bool root_file_name_ok(const std::string& name);
+/// True for exactly the writer's `root-<16 hex>.tmp.*` temps: the only other names the store deletes.
+bool root_temp_name_ok(const std::string& name);
+/// Serialize (worker thread; the item is immutable after the caller's copy). False = do not write.
+bool root_encode(const RootDiskHeader& hdr, const SavedItem& item, std::vector<uint8_t>& out,
+                 std::string& why);
+/// Deserialize. meta_only decodes the header + ids/imgs/cvec/geometry/scalar MTP fields and VALIDATES
+/// every bulk length without allocating the bulk (unit-test path); full mode allocates and verifies
+/// the ids hash. Both modes verify the trailing payload checksum first (it covers the ids too, so a
+/// same-length bulk corruption fails even in meta mode). Either way a corrupt/truncated/oversize/
+/// mismatched buffer fails safely. Full mode additionally requires exact geometry-derived blob sizes
+/// (no allocation before the geometry is proven sane) and rejects trailing bytes past the checksum.
+bool root_decode(const uint8_t* data, size_t size, RootDiskHeader& hdr, SavedItem& item, bool meta_only,
+                 std::string& why);
+/// Streaming metadata-only scan of one root file (the startup index): reads the header + ids/imgs/
+/// cvec/geometry/scalar fields and SEEK-SKIPS every bulk blob without reading or allocating it, so a
+/// multi-GB payload costs kilobytes of I/O at startup. On success `meta` holds the index metadata
+/// (bulk cleared) and the stem key check is the caller's. Fails on any truncation, oversize length,
+/// geometry violation or trailing bytes.
+bool root_scan_meta(const std::string& path, uint64_t fsize, RootDiskHeader& hdr, SavedItem& meta,
+                    std::string& why);
+/// A copy of `item` with every bulk byte vector cleared but all scalars (ids/imgs/cvec/geometry/cells/
+/// counts/formats/valid_from) kept: what the RAM index holds (payloads stay on disk until first use).
+void root_strip_bulk(SavedItem& item);
+
+/// The on-disk root cache: a RAM index of header+ids metadata at startup, payloads lazy-loaded on first
+/// exact (full-ids, never hash-only) match, and a serialized background writer for immutable captures.
+///
+/// Thread-safe (the serve loop enqueues/matches while the worker writes/trims); write errors are nonfatal
+/// (stderr + skip). The destructor drains the queue, joins the worker and trims: shutdown always joins.
+/// Single writer per directory: one store owns a root dir per process (temps are process-unique so two
+/// processes never clobber each other's temp; same-key files hold the same cacheable bytes, so a
+/// same-name racer resolves to identical content).
+class RootDiskStore {
+  public:
+    struct Config {
+        std::string dir;                    ///< --root-dir (created when missing)
+        uint64_t cap_bytes = (uint64_t)(kDefaultRootCapGib * 1073741824.0);   ///< --root-cap-gib
+        RootDiskHeader live;                ///< this process's identity: only matching files load
+        SnapshotGeom live_geom;             ///< index pre-filter (the restore re-validates everything)
+        int stages = 1;                     ///< index pre-filter (SavedItem::complete re-checks)
+    };
+    /// One indexed file: the compat header plus the stripped metadata (full ids for the prefix rule).
+    struct Entry {
+        RootDiskHeader hdr;
+        SavedItem meta;                     ///< bulk cleared: ids/imgs/cvec/geometry/scalars only
+        std::string path;                   ///< full file path
+        uint64_t file_bytes = 0;
+    };
+
+    RootDiskStore();
+    ~RootDiskStore();
+    RootDiskStore(const RootDiskStore&) = delete;
+    RootDiskStore& operator=(const RootDiskStore&) = delete;
+
+    /// Scan `cfg.dir` (streaming metadata only: bulk blobs are seek-skipped, never read) and start
+    /// the writer. Incompatible/corrupt/oversize files are ignored. False leaves the store disabled
+    /// (cold behaviour, nonfatal): check enabled().
+    bool start(const Config& cfg, std::string& why);
+    /// Drain the queue (every queued root is written), join the worker, enforce the cap. Idempotent.
+    void shutdown();
+    bool enabled() const;
+    size_t indexed() const;                 ///< files in the RAM index
+    size_t pending() const;                 ///< captures waiting in the writer queue
+    /// Longest index entry whose full ids prefix-match `ids` (exact images/cvec/geometry/compat), with
+    /// lo < ids_len < hi and path not in `skip`. Payload is NOT loaded here (lazy on load_item).
+    bool find_match(const std::vector<int32_t>& ids, const std::vector<ImgKey>& imgs, bool cvec,
+                    const std::vector<std::string>& skip, int64_t lo, int64_t hi, Entry& out) const;
+    /// Bounded full decode of `e` + header compat + id binding + complete(): the payload the restore
+    /// validates and mounts. False = ignore this entry (add its path to the request's skip set).
+    bool load_item(const Entry& e, SavedItem& out, std::string& why) const;
+    /// A successful disk mount refreshes the file's mtime (the cap trim is LRU by mtime). Nonfatal.
+    void mark_used(const std::string& path) const;
+    /// Queue an immutable capture for the background writer. Takes a const reference and copies
+    /// only AFTER the cheap dedup/bound checks, so a disabled store or a duplicate never pays for a
+    /// multi-GB deep copy. Deduplicated by file key (already indexed or already queued roots are
+    /// skipped, so pinned roots never pile up unbounded) and bounded by kMaxRootQueue AND
+    /// kMaxRootQueueBytes; incomplete items and a disabled/stopped store are no-ops. Never throws
+    /// past the caller's copy: internal queue insertion failures are swallowed as nonfatal drops.
+    /// (The caller's own copy into the call can still throw under extreme pressure - generate.cpp
+    /// wraps the disk-only call separately so insert_root always runs.)
+    void enqueue(const SavedItem& item);
+    /// Enforce the cap now (the worker also runs it after every write): delete oldest-mtime recognized
+    /// cache files past the cap plus stale recognized temps. Never touches other names. False on error
+    /// (still deletes what it can); usable from CPU tests with a temp dir.
+    bool trim_now(std::string& why);
+    /// Drop the index entry pointing at `path` (load/validation failure repair): the next request
+    /// skips the bad file and a recaptured root for the same key can be queued again (enqueue
+    /// dedups against the index, so without this a corrupt file would pin its key forever).
+    /// No-op when no entry points at `path`. Never touches the filesystem.
+    void drop_path(const std::string& path);
+
+  private:
+    void worker_main();
+    /// Serialize + atomic temp->rename + index (worker thread only). False = skipped, nonfatal.
+    bool write_one(const std::string& key, const SavedItem& item, std::string& why);
+
+    mutable std::mutex mu_;
+    std::condition_variable cv_;
+    std::thread worker_;
+    bool started_ = false;
+    bool stop_ = false;
+    Config cfg_;
+    std::map<std::string, Entry> index_;   // file key -> indexed file
+    struct Queued {
+        std::string key;
+        SavedItem item;
+    };
+    std::queue<Queued> queue_;
+    std::set<std::string> queued_;         // keys currently in queue_ (marker held through write completion)
+    uint64_t queued_bytes_ = 0;            // retained bulk bytes currently in queue_ (byte-cap accounting)
+};
+
 }  // namespace strata::program::saved_state
