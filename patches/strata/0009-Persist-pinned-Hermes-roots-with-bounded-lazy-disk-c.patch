+                  "e3 restarted payload loads complete");
+            st.shutdown();
+        }
+    }
+    {   // E3: the startup scan enforces the cap itself (no writes needed): three files on disk, cap
+        // for the two newest - start() alone trims the oldest and the index drops it.
+        const std::string sub = "rootdisk-e3-tmp/startcap";
+        std::error_code ec;
+        fs::create_directories(sub, ec);
+        check(!ec, "e3 startcap tmpdir created");
