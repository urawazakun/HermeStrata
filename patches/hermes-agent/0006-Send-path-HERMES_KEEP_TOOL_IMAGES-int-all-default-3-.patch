+    if keep_newest is None:
+        return
     image_count = 0
     for msg in reversed(result):
         content = msg.get("content")
@@ -602,7 +608,7 @@ def _evict_old_screenshots(result: List[Dict[str, Any]]) -> None:
             if not isinstance(inner, list) or not _has_block_type(inner, {"image"}):
                 continue
             image_count += 1
-            if image_count > 3:
+            if image_count > max(keep_newest, 0):
                 placeholder = _text_block("[screenshot removed to save context]")
                 block["content"] = [placeholder if b.get("type") == "image" else b for b in inner]
 
diff --git a/agent/context_compressor.py b/agent/context_compressor.py
index 15d3543e..ad802d6f 100644
--- a/agent/context_compressor.py
+++ b/agent/context_compressor.py
@@ -7,6 +7,7 @@ import copy
 import hashlib
