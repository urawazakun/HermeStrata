diff --git a/tests/agent/test_outbound_keep_tool_images.py b/tests/agent/test_outbound_keep_tool_images.py
new file mode 100644
index 00000000..6a2a30d7
--- /dev/null
+++ b/tests/agent/test_outbound_keep_tool_images.py
@@ -0,0 +1,263 @@
+"""HERMES_KEEP_TOOL_IMAGES=all keeps the send-path prefix stable.
+
+With ``all`` the per-call eviction never rewrites older image tool results, so
+request N+1's API message list extends request N's rows. Compression still
+retires to the fixed window. Default (env unset) keeps the newest 3.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import logging
+import types
+
+from agent.agent_runtime_helpers import (
+    drop_thinking_only_and_merge_users,
+    sanitize_api_messages,
+)
+from agent.auxiliary_wire import prepare_chat_messages
+from agent.context_compressor import (
+    _MAX_KEEP_TOOL_IMAGES,
+    _tool_content_has_images,
+    evict_stale_outbound_tool_images,
+    resolve_outbound_keep_tool_images,
+)
+from agent.turn_request_assembly import assemble_api_request
+
+
+def _image_tool(i: int, *, blob: str = "A" * 80) -> list[dict]:
+    return [
+        {
+            "role": "assistant",
+            "content": None,
+            "tool_calls": [
+                {
+                    "id": f"call_{i}",
+                    "type": "function",
+                    "function": {
+                        "name": "vision_analyze",
+                        "arguments": f'{{"image_url":"shot{i}.png"}}',
+                    },
+                }
+            ],
+        },
+        {
+            "role": "tool",
+            "tool_call_id": f"call_{i}",
+            "content": [
+                {"type": "text", "text": f"Image attached natively shot {i}"},
+                {
+                    "type": "image_url",
+                    "image_url": {"url": f"data:image/png;base64,{blob}{i}"},
+                },
+            ],
+        },
+    ]
+
+
+def _history_with_screenshots(n: int) -> list[dict]:
+    msgs: list[dict] = [{"role": "user", "content": "look at these"}]
+    for i in range(n):
+        msgs.extend(_image_tool(i))
+    return msgs
+
+
+def _make_assemble_agent() -> types.SimpleNamespace:
+    """Fake agent covering what assemble_api_request touches (caching off)."""
+    return types.SimpleNamespace(
+        prefill_messages=[],
+        tools=[],
+        _use_prompt_caching=False,
+        provider="openrouter",
+        model="test/model",
+        base_url="https://openrouter.ai/api/v1",
+        api_mode="chat_completions",
+        ephemeral_system_prompt="",
+        _usage_anchor=None,
+        context_compressor=types.SimpleNamespace(
+            last_real_prompt_tokens=0,
+            awaiting_real_usage_after_compression=False,
+        ),
+        _sanitize_api_messages=sanitize_api_messages,
+        _drop_thinking_only_and_merge_users=drop_thinking_only_and_merge_users,
+        _copy_reasoning_content_for_api=lambda _src, _dst: None,
+        _should_sanitize_tool_calls=lambda: False,
+        _emit_warning=lambda *a, **k: None,
+    )
+
+
+def _assembled(history: list[dict]) -> list[dict]:
+    """Real request assembly for one API call (history must stay untouched)."""
+    agent = _make_assemble_agent()
+    return assemble_api_request(
+        agent,
+        messages=history,
+        current_turn_user_idx=0,
+        _ext_prefetch_cache="",
+        _plugin_user_context="",
+        moa_config=None,
+        active_system_prompt="SYSTEM",
+        original_user_message="look at these",
+        pending_moa_prepared_request=None,
+        request_logger=logging.getLogger("test"),
+    ).api_messages
+
+
+def _prepared(api_messages: list[dict]):
+    """Real transport hygiene after assembly (never retires images)."""
+    from openai import OpenAI
+
+    client = OpenAI(api_key="sk-test")
+    return prepare_chat_messages(client, {"model": "test/model", "messages": api_messages})["messages"]
+
+
+def _image_bearing_tool_ids(messages: list[dict]) -> list[str]:
+    return [
+        m["tool_call_id"]
+        for m in messages
+        if m.get("role") == "tool" and _tool_content_has_images(m.get("content"))
+    ]
+
+
+def _wire_bytes(messages: list[dict]) -> bytes:
+    return json.dumps(
+        messages, ensure_ascii=False, sort_keys=True, separators=(",", ":"), default=str
+    ).encode("utf-8")
+
+
+class TestKeepToolImagesKnob:
+    def test_default_keeps_newest_window(self, monkeypatch):
+        monkeypatch.delenv("HERMES_KEEP_TOOL_IMAGES", raising=False)
+        assert resolve_outbound_keep_tool_images() == _MAX_KEEP_TOOL_IMAGES
+        outbound = _assembled(_history_with_screenshots(5))
+        assert _image_bearing_tool_ids(outbound) == [
+            f"call_{i}" for i in range(5 - _MAX_KEEP_TOOL_IMAGES, 5)
+        ]
+
+    def test_all_keeps_every_image(self, monkeypatch):
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "all")
+        assert resolve_outbound_keep_tool_images() is None
+        outbound = _assembled(_history_with_screenshots(5))
+        assert _image_bearing_tool_ids(outbound) == [f"call_{i}" for i in range(5)]
+
+    def test_int_and_invalid_values(self, monkeypatch):
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "1")
+        assert resolve_outbound_keep_tool_images() == 1
+        assert _image_bearing_tool_ids(_assembled(_history_with_screenshots(5))) == ["call_4"]
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "0")
+        assert _image_bearing_tool_ids(_assembled(_history_with_screenshots(5))) == []
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "bogus")
+        assert resolve_outbound_keep_tool_images() == _MAX_KEEP_TOOL_IMAGES
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "-2")
+        assert resolve_outbound_keep_tool_images() == _MAX_KEEP_TOOL_IMAGES
+
+
+class TestPrefixStability:
+    def test_all_is_message_prefix_extension_across_six_images(self, monkeypatch):
+        """Request N+1 extends request N: first len(N) rows byte-identical."""
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "all")
+        prior: list[dict] | None = None
+        for n in range(1, 7):
+            history = _history_with_screenshots(n)
+            snapshot = copy.deepcopy(history)
+            outbound = _prepared(_assembled(history))
+            assert history == snapshot
+            assert _image_bearing_tool_ids(outbound) == [f"call_{i}" for i in range(n)]
+            if prior is not None:
+                assert outbound[: len(prior)] == prior
+                assert _wire_bytes(outbound).startswith(_wire_bytes(prior)[:-1])
+            prior = outbound
+
+    def test_default_rewrites_history_on_fourth_image(self, monkeypatch):
+        """Default still retires: the 4th screenshot rewrites an older row."""
+        monkeypatch.delenv("HERMES_KEEP_TOOL_IMAGES", raising=False)
+        before = _assembled(_history_with_screenshots(3))
+        after = _assembled(_history_with_screenshots(4))
+        assert _image_bearing_tool_ids(before) == ["call_0", "call_1", "call_2"]
+        assert _image_bearing_tool_ids(after) == ["call_1", "call_2", "call_3"]
+        assert after[: len(before)] != before
+
+    def test_compression_still_retires_with_all(self, monkeypatch):
+        """Compression is the sanctioned rewrite: fixed window even with all."""
+        from agent.context_compressor import ContextCompressor
+
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "all")
+        c = ContextCompressor.__new__(ContextCompressor)
+        c.quiet_mode = True
+        out, _ = c._prune_old_tool_results(_history_with_screenshots(5), protect_tail_count=20)
+        kept = [
+            m["tool_call_id"]
+            for m in out
+            if m.get("role") == "tool" and _tool_content_has_images(m.get("content"))
+        ]
+        assert kept == [f"call_{i}" for i in range(5 - _MAX_KEEP_TOOL_IMAGES, 5)]
+
+
+def _anthropic_history(n: int) -> list[dict]:
+    """Anthropic-shape rows: user tool_result blocks each carrying one image."""
+    return [
+        {
+            "role": "user",
+            "content": [
+                {
+                    "type": "tool_result",
+                    "tool_use_id": f"t{i}",
+                    "content": [
+                        {"type": "text", "text": f"shot {i}"},
+                        {"type": "image", "source": {"type": "base64", "data": "AAAA"}},
+                    ],
+                }
+            ],
+        }
+        for i in range(n)
+    ]
+
+
+def _remaining_anthropic_images(messages: list[dict]) -> int:
+    return sum(
+        1
+        for m in messages
+        if isinstance(m.get("content"), list)
+        for block in m["content"]
+        if isinstance(block, dict) and block.get("type") == "tool_result"
+        for part in (block.get("content") or [])
+        if isinstance(part, dict) and part.get("type") == "image"
+    )
+
+
+class TestAnthropicScreenshotEviction:
+    def test_default_keeps_newest_three(self, monkeypatch):
+        from agent.anthropic_message_convert import _evict_old_screenshots
+
+        monkeypatch.delenv("HERMES_KEEP_TOOL_IMAGES", raising=False)
+        rows = _anthropic_history(5)
+        _evict_old_screenshots(rows)
+        assert _remaining_anthropic_images(rows) == 3
+
+    def test_all_keeps_every_image(self, monkeypatch):
+        from agent.anthropic_message_convert import _evict_old_screenshots
+
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "all")
+        rows = _anthropic_history(5)
+        _evict_old_screenshots(rows)
+        assert _remaining_anthropic_images(rows) == 5
+
+    def test_explicit_count(self):
+        from agent.anthropic_message_convert import _evict_old_screenshots
+
+        rows = _anthropic_history(5)
+        _evict_old_screenshots(rows, keep_newest=1)
+        assert _remaining_anthropic_images(rows) == 1
+
+
+class TestSendPathHelpers:
+    def test_evict_leaves_history_untouched(self, monkeypatch):
+        from agent.conversation_loop import _clone_message_for_send
+
+        monkeypatch.setenv("HERMES_KEEP_TOOL_IMAGES", "all")
+        history = _history_with_screenshots(5)
+        snapshot = copy.deepcopy(history)
+        outbound = [_clone_message_for_send(m) for m in history]
+        assert evict_stale_outbound_tool_images(outbound) == 0
+        assert history == snapshot
