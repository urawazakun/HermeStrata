 import logging
+import os
 import sqlite3
 import re
 import time
@@ -983,6 +984,40 @@ _PRESSURE_KEEP_RECENT_MESSAGES = 3
 # pass 2, so they ride every later request until anti-thrash disables compression (#92699).
 _MAX_KEEP_TOOL_IMAGES = 3
 
+# Send-path retirement knob: HERMES_KEEP_TOOL_IMAGES=int|all, default 3.
+# "all" keeps every image on the per-call API copy; images are then retired
+# only by compression.
+_KEEP_TOOL_IMAGES_ENV_VAR = "HERMES_KEEP_TOOL_IMAGES"
+
+
+def _parse_keep_tool_images(raw: Any) -> int | None:
+    """Parse the HERMES_KEEP_TOOL_IMAGES value: nonnegative int keeps N, "all" keeps all (None)."""
+    if raw is None:
+        return _MAX_KEEP_TOOL_IMAGES
+    text = str(raw).strip()
+    if not text:
+        return _MAX_KEEP_TOOL_IMAGES
+    if text.lower() == "all":
+        return None
+    try:
+        value = int(text, 10)
+    except (TypeError, ValueError):
+        return _MAX_KEEP_TOOL_IMAGES
+    if value < 0:
+        return _MAX_KEEP_TOOL_IMAGES
+    return value
+
+
+def resolve_outbound_keep_tool_images(raw: Any = None) -> int | None:
+    """Send-path keep window: explicit ``raw`` wins, else HERMES_KEEP_TOOL_IMAGES, else 3.
+
+    Returns None for "keep all" (no send-path retirement). Compression never
+    calls this — it always passes ``_MAX_KEEP_TOOL_IMAGES`` explicitly.
+    """
+    if raw is not None:
+        return _parse_keep_tool_images(raw)
+    return _parse_keep_tool_images(os.getenv(_KEEP_TOOL_IMAGES_ENV_VAR, ""))
+
 # Below this window the threshold is floored (raise-only): at 50% the incompressible
 # floor eats the reclaimed headroom and compaction re-fires every 1-2 turns.
 _SMALL_CTX_WINDOW_LIMIT = 512_000
