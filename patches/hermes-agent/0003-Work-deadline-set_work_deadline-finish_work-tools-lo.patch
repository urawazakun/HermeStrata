+def test_final_before_deadline_injects_exact_rows_and_preserves_prefix():
+    agent = _GateAgent()
+    _set_deadline(agent, goal="harden the sync")
+    messages = [
+        {"role": "user", "content": "work until late", "timestamp": 1.0},
+        {"role": "assistant", "content": "on it", "timestamp": 2.0},
+        {"role": "tool", "tool_call_id": "c1", "content": "ok", "timestamp": 3.0},
+    ]
+    snapshot = copy.deepcopy(messages)
+    expected_nudge = _pinned_nudge(agent)
+
+    verdict, final_msg = _gate_call(agent, messages)
+
+    assert verdict.continue_turn is True
+    assert verdict.final_response is None
+    # Prefix rows byte-identical; exactly two rows appended.
+    assert messages[:len(snapshot)] == snapshot
+    assert len(messages) == len(snapshot) + 2
+    assistant_row, nudge_row = messages[-2], messages[-1]
+    assert assistant_row["role"] == "assistant"
+    assert assistant_row["content"] == "draft done"
+    assert final_msg.get("finish_reason") == "work_deadline_continue"
+    assert nudge_row["role"] == "user"
+    assert nudge_row["content"] == expected_nudge
+    assert nudge_row.get(wd.CONTINUATION_FLAG) is True
+    assert nudge_row.get("display_kind") == "hidden"
+    # Strict alternation holds across the seam.
+    roles = [m["role"] for m in messages]
+    assert roles[-2:] == ["assistant", "user"]
+    assert all(a != b for a, b in zip(roles, roles[1:]))
+    # Interim delivery surfaced the attempted answer; the nudge stays out of it.
+    assert agent.interim and agent.interim[0]["content"] == "draft done"
+    assert agent._work_deadline_idle_continuations == 1
+
