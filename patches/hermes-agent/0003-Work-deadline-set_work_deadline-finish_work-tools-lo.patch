+"""Tests for the self-managed work deadline ("work until 18:00").
+
+Behavior contracts for ``agent/work_deadline.py`` and its turn-loop wiring
+(``agent/turn_stop_gates.py`` text-answer gate, ``agent/work_deadline.py::
+phase_boundary_stop`` tool-loop gate, ``agent/turn_iteration_prep.py::
+begin_iteration`` priorities), exercised with stub agents and a real
+``SessionDB`` — mock model responses only, no network.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import time
+from datetime import datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent import work_deadline as wd
+from agent.turn_final_response import finish_text_response
+from agent.turn_stop_gates import apply_stop_gates
+from agent.work_deadline import phase_boundary_stop
+
+
+# ── stub agents ──────────────────────────────────────────────────────────────
+
+class _GateAgent:
+    """Minimal agent for the text-answer stop gate."""
+
+    def __init__(self):
+        self._delegate_depth = 0
+        self._is_fork_child = False
+        self._persist_disabled = False
+        self._deadline_enabled = True
+        self._deadline_max_idle_continuations = 3
+        self._work_deadline_until = None
+        self._work_deadline_goal = None
+        self._work_deadline_finish_called = False
+        self._work_deadline_finish_reason = None
+        self._work_deadline_idle_continuations = 0
+        self._verification_stop_nudges = 0
+        self._pre_verify_nudges = 0
+        self._kanban_stop_nudges = 0
+        self._turn_file_mutation_paths = set()
+        self._session_db = None
+        self.session_id = "wd-test-session"
+        self._session_messages = []
+        self.run_budget_seconds = None
+        self._run_budget_started_at = None
+        self._run_budget_wrapup_injected = False
+        self.interim = []
+        self.flushed = []
+        self.statuses = []
+
+    def _emit_interim_assistant_message(self, msg):
+        self.interim.append(dict(msg))
+
+    def _flush_messages_to_session_db(self, messages, conversation_history=None):
+        self.flushed.append([dict(m) for m in messages])
+        return True
+
+    def _interim_content_was_streamed(self, content):
+        return False
+
+    def _emit_status(self, msg):
+        self.statuses.append(msg)
+
+
+class _PhaseAgent(_GateAgent):
+    """Stub for the tool-loop phase boundary + begin_iteration."""
+
+    def __init__(self):
+        super().__init__()
+        self._budget_grace_call = False
+        self._interrupt_requested = False
+        self.quiet_mode = True
+        self._api_call_count = 0
+        self.max_iterations = 50
+        self._checkpoint_mgr = SimpleNamespace(new_turn=lambda: None)
+        from agent.iteration_budget import IterationBudget
+        self.iteration_budget = IterationBudget(50)
+        self.prints = []
+
+    def _drain_pending_redirect(self):
+        return None
+
+    def _touch_activity(self, _msg):
+        pass
+
+    def _persist_session(self, _messages, _history):
+        pass
+
+    def _safe_print(self, msg):
+        self.prints.append(msg)
+
+
+def _future_iso(seconds_ahead=7200):
+    return datetime.fromtimestamp(time.time() + seconds_ahead).isoformat(timespec="minutes")
+
+
+def _past_iso(seconds_behind=120):
+    return datetime.fromtimestamp(time.time() - seconds_behind).isoformat(timespec="minutes")
+
+
+def _set_deadline(agent, until=None, goal="ship the feature"):
+    raw = wd.set_work_deadline(agent, {"until": until or _future_iso(), "goal": goal})
+    return json.loads(raw)
+
+
+def _gate_call(agent, messages, text="draft done"):
+    final_msg = {"role": "assistant", "content": text}
+    return apply_stop_gates(
+        agent, final_msg,
+        final_response=text, messages=messages, conversation_history=[],
+        pending_verification_response=None,
+        pending_verification_response_previewed=False,
+    ), final_msg
+
+
+def _stub_conversation_loop(monkeypatch):
+    """Seed ``sys.modules`` so ``begin_iteration``'s lazy ``conversation_loop`` import works.
+
+    The deadline venv lacks ``concurrent_log_handler`` (pulled in by the real
+    ``agent.conversation_loop`` via ``hermes_logging``), so the full loop module
+    cannot import here. The two helpers ``begin_iteration`` needs are unrelated
+    to deadline ordering — the stub gives them their inert values (no redirect,
+    review budget not exhausted) so the real priority logic is exercised.
+    """
+    import sys
+    import types
+    stub = types.ModuleType("agent.conversation_loop")
+    stub._apply_active_turn_redirect = lambda agent, messages, text: None
+    stub._review_input_budget_exhausted = lambda agent: False
+    # Nudge constants lazily imported by agent.context_compressor
+    # (_is_synthetic_compression_user_turn) on the SessionDB write path.
+    # Sentinels match nothing real, so classification of the rows under test
+    # is identical to production; only the missing third-party import
+    # (concurrent_log_handler via hermes_logging) is avoided.
+    for _name in (
+        "_CODEX_ACK_CONTINUATION_NUDGE", "_CODEX_INCOMPLETE_NUDGE",
+        "_DROPPED_TOOLCALL_NUDGE_CONTENT", "_EMPTY_TOOL_RESPONSE_NUDGE",
+        "_LENGTH_CONTINUATION_NETWORK_STUB", "_LENGTH_CONTINUATION_OUTPUT_LIMIT",
+        "_LENGTH_CONTINUATION_DROPPED_TOOLS_PREFIX",
+    ):
+        setattr(stub, _name, f"<stub-{_name}>")
+    # finish_text_response lazily imports the truncation joiner; only the name
+    # must exist (unused on paths without truncated fragments).
+    stub._join_truncated_parts = lambda parts: "".join(
+        p if isinstance(p, str) else "" for p in parts)
+    monkeypatch.setitem(sys.modules, "agent.conversation_loop", stub)
+    return stub
+
+
+# ── time parsing ─────────────────────────────────────────────────────────────
