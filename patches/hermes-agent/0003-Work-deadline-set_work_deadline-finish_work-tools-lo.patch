+def _work_deadline_outcome(agent) -> Optional[tuple]:
+    """Evaluate the self-managed work deadline at a text-only final answer.
+
+    Returns ``(action, text)`` with action one of ``"finished"`` (finish_work was
+    called this turn — footer carrying the reason), ``"budget"`` (run budget elapsed —
+    one-line note, no further request), ``"reached"`` (deadline passed — one-line note,
+    deadline consumed), ``"idle"`` (too many tool-less continuations — one-line note),
+    or ``"continue"`` (user-role nudge); None when no deadline applies or the
+    run-budget wrap-up owns the ending. Never raises: a broken clock must end the
+    turn, not trap it.
+    """
+    try:
+        from agent import work_deadline as _wd
+        if getattr(agent, "_delegate_depth", 0) not in (0, None):
+            return None
+        if not _wd.deadline_enabled(agent):
+            return None
+        if getattr(agent, "_work_deadline_finish_called", False):
+            reason = getattr(agent, "_work_deadline_finish_reason", "") or "done"
+            return ("finished", _wd.finished_early_note(str(reason)))
+        current = _wd.active_deadline(agent)
+        if current is None:
+            return None
+        until, goal = current
+        if _wd.run_budget_expired(agent):
+            return ("budget", _wd.run_budget_exhausted_note())
+        if _wd.is_reached(until):
+            return ("reached", _wd.deadline_reached_note(until))
+        if _wd.wrapup_injected(agent):
+            # The 80% wrap-up notice told the model to produce its final deliverable;
+            # a "keep improving" continuation would contradict it.
+            return None
+        streak = _wd.coerce_count(getattr(agent, "_work_deadline_idle_continuations", 0))
+        limit = _wd.max_idle_continuations(agent)
+        if streak >= limit:
+            return ("idle", _wd.idle_guard_note(limit))
+        return ("continue", _wd.build_continuation_nudge(until, goal))
+    except Exception:
+        logger.debug("work deadline gate check failed", exc_info=True)
+        return None
+
