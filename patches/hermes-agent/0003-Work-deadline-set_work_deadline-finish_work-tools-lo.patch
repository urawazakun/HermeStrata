+@pytest.fixture()
+def loop_factory():
+    """Build a real AIAgent with a mock provider client and deadline tools."""
+    pytest.importorskip("concurrent_log_handler", reason=_LOOP_SKIP_REASON)
+    from unittest.mock import MagicMock
+
+    from run_agent import AIAgent
