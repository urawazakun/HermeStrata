+"""Work-deadline tool schemas (``set_work_deadline`` / ``finish_work``).
+
+Schemas live in the registry under the ``work_deadline`` toolset so discovery,
+toolsets, and session filtering see them; execution is agent-level (live agent
+state + session persistence) via ``agent/inline_tool_executors.py`` and is
+refused here, the same split ``todo_list``/``memory`` use.
+"""
+
+from __future__ import annotations
+
+from agent.work_deadline import FINISH_WORK_NAME, SET_WORK_DEADLINE_NAME, WORK_DEADLINE_TOOLSET
+from utils import is_truthy_value
+
+SET_WORK_DEADLINE_SCHEMA = {
+    "name": SET_WORK_DEADLINE_NAME,
+    "description": (
+        "Set a self-managed work deadline: keep working toward the goal until the given "
+        "local time instead of ending the turn at the first final answer. Call this when "
+        "the user asks you to keep working until a time (e.g. 'work until 18:00'). Calling "
+        "again replaces the deadline; pass until=\"none\" to clear it. "
+        "To stop before the deadline, call finish_work with a reason."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "until": {
+                "type": "string",
+                "description": (
+                    'Local wall-clock "HH:MM" (today, or tomorrow if already past), '
+                    'an ISO datetime, or "none" to clear the deadline.'
+                ),
+            },
+            "goal": {
+                "type": "string",
+                "description": (
+                    "What to keep working toward (required, unless until is \"none\")."
+                ),
+            },
+        },
+        "required": ["until"],
+    },
+}
+
+FINISH_WORK_SCHEMA = {
+    "name": FINISH_WORK_NAME,
+    "description": (
+        "End a work deadline early. The ONLY way to stop before the deadline: call with "
+        "the reason (blocked on a human decision, environment broken, goal fully met with "
+        "nothing sensible left). The reason is logged and shown to the user."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "reason": {
+                "type": "string",
+                "description": "Why the work stops before the deadline.",
+            },
+        },
+        "required": ["reason"],
+    },
+}
+
+
+def check_work_deadline_requirements() -> bool:
+    """Available unless ``agent.deadline_enabled`` is false (config-wide, cache-safe)."""
+    try:
