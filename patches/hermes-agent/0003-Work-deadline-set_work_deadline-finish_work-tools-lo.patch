diff --git a/agent/work_deadline.py b/agent/work_deadline.py
new file mode 100644
index 00000000..a2116900
--- /dev/null
+++ b/agent/work_deadline.py
@@ -0,0 +1,468 @@
+"""Self-managed work deadline ("work until 18:00"): tools, state, and turn-loop wiring.
+
+The model calls ``set_work_deadline`` when the user asks it to keep working until a
+wall-clock time; the turn loop then keeps a text-only final answer from ending the
+turn and re-prompts with a short byte-stable continuation instead. ``finish_work``
+is the only early exit while a deadline is active. The wall-clock run budget stays
+the ceiling; the deadline is a floor.
+
+State: ``agent._work_deadline_until`` (epoch seconds) + ``agent._work_deadline_goal``
+are session-scoped (persisted in the session's ``model_config`` so ``--resume``,
+CLI, and gateway turns all see them); ``_work_deadline_finish_called`` /
+``_work_deadline_finish_reason`` / ``_work_deadline_idle_continuations`` are
+per-turn markers reset at turn start (``agent/turn_context.py``).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import re
+import time
+from datetime import datetime, timedelta
+from typing import Any, Dict, Optional, Tuple
+
+from agent.delegation_context import is_delegated_child_context
+from utils import is_truthy_value
+
+logger = logging.getLogger(__name__)
+
+SET_WORK_DEADLINE_NAME = "set_work_deadline"
+FINISH_WORK_NAME = "finish_work"
+WORK_DEADLINE_TOOLSET = "work_deadline"
+
+# Session model_config key holding {"until": epoch, "goal": str}; absent = no deadline.
+_MODEL_CONFIG_KEY = "work_deadline"
+
+# Marker on deadline continuation rows: display_kind="hidden" keeps them out of
+# rendered user input while persistence stays append-only (durable + replayed).
+CONTINUATION_FLAG = "_work_deadline_synthetic"
+
+_MAX_GOAL_CHARS = 1000
+
+_HHMM_RE = re.compile(r"^\s*(\d{1,2}):(\d{2})\s*$")
+
+_PARSE_HINT = (
+    'Use local wall-clock "HH:MM" (e.g. "18:00"; already past today means tomorrow), '
+    'an ISO datetime (e.g. "2026-09-30T18:00:00"), or "none" to clear.'
+)
+
+
+def is_clear_request(until: Any) -> bool:
+    """True when ``until`` asks to clear the deadline."""
+    return str(until or "").strip().lower() == "none"
+
+
+def parse_work_deadline(until: Any, now: Optional[datetime] = None) -> Optional[Tuple[float, str]]:
+    """Parse ``until`` to ``(epoch_seconds, "HH:MM")``; ``"none"`` returns None (clear).
+
+    "HH:MM" is today, or tomorrow when already past. ISO datetimes are taken as
+    given (even when past — the next final answer then ends the turn with the
+    deadline-reached note). Raises ValueError when unparseable.
+    """
+    text = str(until or "").strip()
+    if text.lower() == "none":
+        return None
+    now_dt = now if isinstance(now, datetime) else datetime.now()
+    match = _HHMM_RE.match(text)
+    if match:
+        hour, minute = int(match.group(1)), int(match.group(2))
+        if not 0 <= hour <= 23 or not 0 <= minute <= 59:
+            raise ValueError(f'invalid time "{text}": hour 0-23, minute 00-59. {_PARSE_HINT}')
+        target = now_dt.replace(hour=hour, minute=minute, second=0, microsecond=0)
+        if target <= now_dt:
+            target += timedelta(days=1)
+        return target.timestamp(), target.strftime("%H:%M")
+    try:
+        parsed = datetime.fromisoformat(text)
+    except (TypeError, ValueError):
+        raise ValueError(f'could not parse "{text}" as a deadline. {_PARSE_HINT}')
+    if parsed.tzinfo is not None:
+        parsed = parsed.astimezone().replace(tzinfo=None)
+    return parsed.timestamp(), parsed.strftime("%H:%M")
+
+
+def minutes_left(until_epoch: float, now: Optional[float] = None) -> int:
+    """Whole minutes until the deadline, floored at 0."""
+    now_t = time.time() if now is None else now
+    return max(0, int((until_epoch - now_t) // 60))
+
+
+def is_reached(until_epoch: float, now: Optional[float] = None) -> bool:
+    """True when the deadline has passed."""
+    now_t = time.time() if now is None else now
+    return now_t >= until_epoch
+
+
+def deadline_hhmm(until_epoch: float) -> str:
+    """Local wall-clock "HH:MM" of the deadline (the only varying text besides minutes)."""
+    return datetime.fromtimestamp(until_epoch).strftime("%H:%M")
+
+
+def build_continuation_nudge(until_epoch: float, goal: str, now: Optional[float] = None) -> str:
+    """User-role continuation: byte-stable apart from the two numbers."""
+    return (
+        f"[deadline {deadline_hhmm(until_epoch)}, {minutes_left(until_epoch, now)} min left] "
+        f'Record progress where your task expects it, then choose the next most valuable '
+        f'improvement toward "{goal}" yourself and continue. Do not ask the user. '
+        f"To stop before the deadline, call finish_work(reason)."
+    )
+
+
+def deadline_reached_note(until_epoch: float) -> str:
+    """One-line note ending a turn whose deadline passed."""
+    return f"Work deadline reached ({deadline_hhmm(until_epoch)}) — ending the turn."
+
+
+def finished_early_note(reason: str) -> str:
+    """One-line footer carrying the finish_work reason into the final output."""
+    return f"[work deadline: finished early — {reason}]"
+
+
+def idle_guard_note(limit: int) -> str:
+    """One-line note ending a turn stuck on tool-less continuations."""
+    return (
+        f"Ending the turn: {limit} consecutive deadline continuations "
+        f"produced no tool calls."
+    )
+
+
+def active_deadline(agent: Any) -> Optional[Tuple[float, str]]:
+    """``(until_epoch, goal)`` when a deadline is set, else None.
+
+    Non-finite epochs (NaN/Inf from a corrupt row) never count as active — they
+    would neither elapse nor sort, spinning the continuation.
+    """
+    until = getattr(agent, "_work_deadline_until", None)
+    goal = getattr(agent, "_work_deadline_goal", None)
+    if not isinstance(until, (int, float)) or isinstance(until, bool):
+        return None
+    if not math.isfinite(float(until)):
+        return None
+    if not isinstance(goal, str) or not goal:
+        return None
+    return float(until), goal
+
+
+def coerce_count(raw: Any) -> int:
+    """Non-negative int for streak counters; garbage maps to 0."""
+    if isinstance(raw, bool):
+        return 0
+    try:
+        return max(0, int(raw))
+    except (TypeError, ValueError):
+        return 0
+
+
+def _is_child_agent(agent: Any) -> Optional[str]:
+    """Refusal reason when ``agent`` is a delegated child, else None.
+
+    Children (including fork children with inherited schemas) must never set,
+    finish, or inherit the parent's deadline. Fork children share the parent's
+    session id with persistence disabled, so they are refused here rather than
+    by schema filtering alone.
+    """
+    if getattr(agent, "_is_fork_child", False) is True:
+        return "not available to a forked child: the parent owns the work deadline"
+    if getattr(agent, "_persist_disabled", False) is True:
+        return "not available to a persistence-isolated agent: the parent owns the work deadline"
+    depth = getattr(agent, "_delegate_depth", 0)
+    if isinstance(depth, int) and not isinstance(depth, bool) and depth > 0:
+        return "not available to a delegated child: the parent owns the work deadline"
+    if is_delegated_child_context():
+        return "not available to a delegated child: the parent owns the work deadline"
+    return None
+
+
+def deadline_enabled(agent: Any) -> bool:
+    """``agent.deadline_enabled`` (default true); falls back to config.yaml."""
+    raw = getattr(agent, "_deadline_enabled", None)
+    if raw is None:
+        try:
+            from hermes_cli.config import load_config_readonly
+            section = load_config_readonly().get("agent") or {}
+            raw = section.get("deadline_enabled", True)
+        except Exception:
+            return True
+    if isinstance(raw, bool):
+        return raw
+    return bool(is_truthy_value(raw, default=True))
+
+
+def max_idle_continuations(agent: Any) -> int:
+    """``agent.deadline_max_idle_continuations`` (default 3), floored at 0."""
+    raw = getattr(agent, "_deadline_max_idle_continuations", 3)
+    if raw is None or isinstance(raw, bool):
+        return 3
+    try:
+        return max(0, int(raw))
+    except (TypeError, ValueError):
+        return 3
+
+
+def _sync_init_config(agent: Any) -> None:
+    """Mirror the in-memory deadline into the session-init model_config dict.
+
+    Rotated compression sessions are published with ``agent._session_init_model_config``
+    as the new row's model_config, and initial row creation reads it too — without
+    this mirror a rotation (or a later first row) would drop the deadline on resume.
+    Derives solely from in-memory state; never writes the DB. Children own fresh
+    dicts (plus only their own ``_delegate_from``), so nothing inherits.
+    """
+    init_config = getattr(agent, "_session_init_model_config", None)
+    if not isinstance(init_config, dict):
+        return
+    current = active_deadline(agent)
+    if current is None:
+        init_config.pop(_MODEL_CONFIG_KEY, None)
+    else:
+        init_config[_MODEL_CONFIG_KEY] = {"until": current[0], "goal": current[1]}
+
+
+def _persist(agent: Any) -> None:
+    """Write the in-memory deadline to the session row (source of truth for resume).
+
+    The session-init mirror is updated only after a successful write — never before
+    a failing one — except when there is no durable row yet, where the mirror is
+    the only carrier for later initial row creation.
+    """
+    db = getattr(agent, "_session_db", None)
+    session_id = getattr(agent, "session_id", None)
+    if db is None or not session_id:
+        _sync_init_config(agent)
+        return
+    current = active_deadline(agent)
+    payload = {"until": current[0], "goal": current[1]} if current else None
+    db.patch_session_model_config(session_id, {_MODEL_CONFIG_KEY: payload})
+    _sync_init_config(agent)
+
+
+def hydrate_work_deadline(agent: Any) -> None:
+    """Restore the session deadline from the session row (CLI resume, gateway turns).
+
+    The DB is authoritative: a stored deadline is adopted, a missing one clears
+    the in-memory state. Never runs for children or persistence-isolated agents
+    (fork children share the parent's session id).
+    """
+    if _is_child_agent(agent) is not None:
+        return
+    db = getattr(agent, "_session_db", None)
+    session_id = getattr(agent, "session_id", None)
+    if db is None or not session_id:
+        return
+    try:
+        stored = db.get_session_model_config_value(session_id, _MODEL_CONFIG_KEY)
+    except Exception as exc:
+        logger.debug("work deadline hydrate skipped (session=%s): %s", session_id, exc)
+        return
+    if not isinstance(stored, dict):
+        if stored is None:
+            agent._work_deadline_until = None
+            agent._work_deadline_goal = None
+            _sync_init_config(agent)
+        return
+    until, goal = stored.get("until"), stored.get("goal")
+    if isinstance(until, (int, float)) and not isinstance(until, bool) and math.isfinite(float(until)) \
+            and isinstance(goal, str) and goal:
+        agent._work_deadline_until = float(until)
+        agent._work_deadline_goal = goal
+    else:
+        agent._work_deadline_until = None
+        agent._work_deadline_goal = None
+    _sync_init_config(agent)
+
+
+def _cap_goal(goal: str) -> str:
+    if len(goal) > _MAX_GOAL_CHARS:
+        return goal[:_MAX_GOAL_CHARS] + "… [truncated]"
+    return goal
+
+
+def set_work_deadline(agent: Any, args: Dict[str, Any]) -> str:
+    """Inline executor for ``set_work_deadline`` (see ``agent/inline_tool_executors.py``)."""
+    args = args if isinstance(args, dict) else {}
+    refusal = _is_child_agent(agent)
+    if refusal is not None:
+        return json.dumps({"success": False, "error": refusal}, ensure_ascii=False)
+    if not deadline_enabled(agent):
+        return json.dumps(
+            {"success": False, "error": "work deadlines are disabled (agent.deadline_enabled=false)"},
+            ensure_ascii=False,
+        )
+    replaced = active_deadline(agent) is not None
+    if is_clear_request(args.get("until", "")):
+        previous = active_deadline(agent)
+        agent._work_deadline_until = None
+        agent._work_deadline_goal = None
+        try:
+            _persist(agent)
+        except Exception as exc:
+            # Clearing failed: the row still holds the deadline and resume would
+            # reactivate it, so restore the snapshot and report failure.
+            if previous is None:
+                agent._work_deadline_until = None
+                agent._work_deadline_goal = None
+            else:
+                agent._work_deadline_until, agent._work_deadline_goal = previous
+            logger.warning("work deadline clear persist failed: %s", exc)
+            return json.dumps(
+                {"success": False, "error": f"deadline could not be cleared (persist failed): {exc}"},
+                ensure_ascii=False,
+            )
+        logger.info("work deadline cleared (session=%s)", getattr(agent, "session_id", None) or "none")
+        agent._work_deadline_finish_called = False
+        agent._work_deadline_finish_reason = None
+        agent._work_deadline_idle_continuations = 0
+        return json.dumps({"success": True, "cleared": True, "replaced": replaced}, ensure_ascii=False)
+    goal = str(args.get("goal") or "").strip()
+    if not goal:
+        return json.dumps({"success": False, "error": "goal is required"}, ensure_ascii=False)
+    try:
+        until_epoch, hhmm = parse_work_deadline(args.get("until", ""))
+    except ValueError as exc:
+        return json.dumps({"success": False, "error": str(exc)}, ensure_ascii=False)
+    previous = active_deadline(agent)
+    agent._work_deadline_until = until_epoch
+    agent._work_deadline_goal = _cap_goal(goal)
+    try:
+        _persist(agent)
+    except Exception as exc:
+        if previous is None:
+            agent._work_deadline_until = None
+            agent._work_deadline_goal = None
+        else:
+            agent._work_deadline_until, agent._work_deadline_goal = previous
+        logger.warning("work deadline persist failed: %s", exc)
+        return json.dumps(
+            {"success": False, "error": f"deadline could not be persisted: {exc}"},
+            ensure_ascii=False,
+        )
+    # A successful (re)placement owns the turn: drop any finish latch and idle streak
+    # so the new deadline actually operates.
+    agent._work_deadline_finish_called = False
+    agent._work_deadline_finish_reason = None
+    agent._work_deadline_idle_continuations = 0
+    left = minutes_left(until_epoch)
+    logger.info(
+        "work deadline set until %s (%d min left), goal=%r (session=%s)",
+        hhmm, left, agent._work_deadline_goal,
+        getattr(agent, "session_id", None) or "none",
+    )
+    return json.dumps({
+        "success": True, "until": datetime.fromtimestamp(until_epoch).isoformat(timespec="minutes"),
+        "hhmm": hhmm, "minutes_left": left, "goal": agent._work_deadline_goal,
+        "replaced": replaced,
+    }, ensure_ascii=False)
+
+
+def finish_work(agent: Any, args: Dict[str, Any]) -> str:
+    """Inline executor for ``finish_work``: the only early exit under a deadline."""
+    args = args if isinstance(args, dict) else {}
+    refusal = _is_child_agent(agent)
+    if refusal is not None:
+        return json.dumps({"success": False, "error": refusal}, ensure_ascii=False)
+    if not deadline_enabled(agent):
+        return json.dumps(
+            {"success": False, "error": "work deadlines are disabled (agent.deadline_enabled=false)"},
+            ensure_ascii=False,
+        )
+    reason = str(args.get("reason") or "").strip()
+    if not reason:
+        return json.dumps({"success": False, "error": "reason is required"}, ensure_ascii=False)
+    current = active_deadline(agent)
+    if current is None:
+        return json.dumps(
+            {"success": False, "error": "no work deadline is active; nothing to finish"},
+            ensure_ascii=False,
+        )
+    left = minutes_left(current[0])
+    previous = current
+    agent._work_deadline_until = None
+    agent._work_deadline_goal = None
+    try:
+        _persist(agent)
+    except Exception as exc:
+        # Clearing failed: the row still holds the deadline and resume would reactivate
+        # it, so neither claim success nor latch the finish.
+        agent._work_deadline_until, agent._work_deadline_goal = previous
+        logger.warning("finish_work persist failed: %s", exc)
+        return json.dumps(
+            {"success": False, "error": f"could not end the deadline (persist failed): {exc}"},
+            ensure_ascii=False,
+        )
+    agent._work_deadline_finish_called = True
+    agent._work_deadline_finish_reason = reason
+    logger.info(
+        "finish_work called with %d min left (session=%s): %s",
+        left, getattr(agent, "session_id", None) or "none", reason,
+    )
+    return json.dumps({
+        "success": True, "finished": True, "reason": reason, "minutes_left": left,
+    }, ensure_ascii=False)
+
+
+def note_tool_activity(agent: Any) -> None:
+    """A tool round ran, so the deadline idle streak restarts."""
+    agent._work_deadline_idle_continuations = 0
+
+
+def run_budget_expired(agent: Any, now: Optional[float] = None) -> bool:
+    """True when a configured wall-clock run budget has fully elapsed."""
+    budget = getattr(agent, "run_budget_seconds", None)
+    started = getattr(agent, "_run_budget_started_at", None)
+    if isinstance(budget, bool) or not isinstance(started, (int, float)) or isinstance(started, bool):
+        return False
+    try:
+        limit = float(budget)
+    except (TypeError, ValueError):
+        return False
+    if not math.isfinite(limit) or limit <= 0:
+        return False
+    now_t = time.time() if now is None else now
+    return (now_t - float(started)) >= limit
+
+
+def run_budget_exhausted_note() -> str:
+    """One-line note ending a deadline turn whose run budget elapsed."""
+    return "Run time budget exhausted — ending the turn."
+
+
+def wrapup_injected(agent: Any) -> bool:
+    """True once the 80% run-budget wrap-up notice fired: it owns the ending."""
+    return getattr(agent, "_run_budget_wrapup_injected", False) is True
+
+
+def phase_boundary_stop(agent: Any) -> Optional[Tuple[str, str]]:
+    """``(exit_reason, note)`` to stop before another model request, else None.
+
+    Covers the tool-loop case the text-answer gate never sees: the in-flight model
+    call already finished and its tool round is recorded, so breaking here keeps
+    every tool-call/result pair complete. Interrupts and iteration ceilings are
+    checked earlier in ``begin_iteration`` and always win; the iteration-budget
+    grace call plays out untouched.
+    """
+    if _is_child_agent(agent) is not None:
+        return None
+    if getattr(agent, "_budget_grace_call", False):
+        return None
+    if not deadline_enabled(agent):
+        return None
+    finish_latched = getattr(agent, "_work_deadline_finish_called", False) is True
+    if active_deadline(agent) is None and not finish_latched:
+        return None
+    if run_budget_expired(agent):
+        return ("run_budget_exhausted", run_budget_exhausted_note())
+    if finish_latched:
+        reason = getattr(agent, "_work_deadline_finish_reason", "") or "done"
+        return ("work_deadline_finished", finished_early_note(str(reason)))
+    current = active_deadline(agent)
+    if current is not None and is_reached(current[0]):
+        agent._work_deadline_until = None
+        agent._work_deadline_goal = None
+        try:
+            _persist(agent)
+        except Exception as exc:
+            logger.warning("work deadline reached-clear persist failed: %s", exc)
+        return ("work_deadline_reached", deadline_reached_note(current[0]))
+    return None
