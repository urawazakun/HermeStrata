+def _run_loop(agent, script):
+    """Run one turn against the scripted mock responses.
+
+    Turn-boundary persistence hooks (``_persist_session``, trajectories,
+    task cleanup) are mocked; the SessionDB message flush stays real, as does
+    all deadline state handling. The only model stand-in is the scripted
+    provider client.
+    """
+    agent.client.chat.completions.create.side_effect = script
+    with (
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        return agent.run_conversation("work until late")
+
+
+def _request_kwargs(agent, index):
+    return agent.client.chat.completions.create.call_args_list[index].kwargs
+
+
+def _assert_complete_pairs(messages):
+    tc_ids = [
+        tc["id"] for m in messages
+        if isinstance(m, dict) and m.get("role") == "assistant" and m.get("tool_calls")
+        for tc in m["tool_calls"]
+    ]
+    res_ids = [
+        m.get("tool_call_id") for m in messages
+        if isinstance(m, dict) and m.get("role") == "tool"
+    ]
+    assert tc_ids, "expected at least one tool_call/result pair"
+    assert sorted(tc_ids) == sorted(res_ids)
+
