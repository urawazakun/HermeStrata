+def test_deadline_survives_compression_child_publish(tmp_path, monkeypatch):
+    """A compression rotation must carry the deadline via the init-config mirror.
+
+    The child row is published with ``agent._session_init_model_config`` as its
+    model_config, so ``hydrate`` on a fresh agent must adopt the same deadline
+    and re-mirror it into the fresh agent's init dict. A successful clear
+    removes the mirror; a failed clear leaves memory, row, and mirror intact.
+
+    The ``conversation_loop`` sys.modules seed covers only nudge constants
+    lazily imported by the message-write path (missing third-party logging dep
+    in this venv); SessionDB publish/hydrate and all deadline code are real.
+    """
+    _stub_conversation_loop(monkeypatch)
+    from hermes_state import SessionDB
+    db = SessionDB(db_path=tmp_path / "compress.db")
+    try:
+        db.ensure_session("sess-rot-parent", source="cli")
+        owner = _db_agent(db, "sess-rot-parent")
+        owner._session_init_model_config = {}
+        assert _set_deadline(owner, goal="survive rotation")["success"] is True
+        assert owner._session_init_model_config["work_deadline"] == {
+            "until": owner._work_deadline_until, "goal": "survive rotation"}
+
+        db.publish_compression_child(
+            parent_session_id="sess-rot-parent", child_session_id="sess-rot-child",
+            source="cli", messages=[{"role": "user", "content": "hi", "timestamp": 1.0}],
+            model_config=owner._session_init_model_config,
+            require_compression_lease=False)
+
+        fresh = _db_agent(db, "sess-rot-child")
+        fresh._session_init_model_config = {}
+        assert wd.active_deadline(fresh) is None
+        wd.hydrate_work_deadline(fresh)
+        assert wd.active_deadline(fresh) == wd.active_deadline(owner)
+        assert fresh._session_init_model_config["work_deadline"] == \
+            owner._session_init_model_config["work_deadline"]
+
+        # Successful clear removes the row key and the mirror.
+        assert json.loads(
+            wd.set_work_deadline(owner, {"until": "none"}))["success"] is True
+        assert "work_deadline" not in owner._session_init_model_config
+        assert db.get_session_model_config_value(
+            "sess-rot-parent", "work_deadline") is None
+
+        # Failed clear restores memory and leaves row and mirror unchanged.
+        assert _set_deadline(owner, goal="second wind")["success"] is True
+        mirrored = dict(owner._session_init_model_config["work_deadline"])
+
+        class _FailingDB:
+            def patch_session_model_config(self, _sid, _patch):
+                raise RuntimeError("disk gone")
+
+        real_db = owner._session_db
+        owner._session_db = _FailingDB()
+        try:
+            payload = json.loads(wd.set_work_deadline(owner, {"until": "none"}))
+        finally:
+            owner._session_db = real_db
+        assert payload["success"] is False
+        assert wd.active_deadline(owner) is not None
+        assert owner._session_init_model_config["work_deadline"] == mirrored
+        assert db.get_session_model_config_value(
+            "sess-rot-parent", "work_deadline") is not None
+    finally:
+        db.close()
