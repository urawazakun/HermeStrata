+def test_loop_set_continue_finish_arc(loop_factory):
+    """Full arc through the real loop: set → continue → finish_work stops the turn.
+
+    The finish_work tool round latches the finish, so the phase boundary ends
+    the turn before any further provider request: exactly 3 calls.
+    """
+    agent = loop_factory()
+    result = _run_loop(agent, [
+        _mock_tool("set_work_deadline",
+                   {"until": _future_iso(7200), "goal": "harden sync"}, "call_1"),
+        _mock_text("progress update"),
+        _mock_tool("finish_work", {"reason": "blocked on human decision"}, "call_2"),
+    ])
+    assert agent.client.chat.completions.create.call_count == 3
+    assert "blocked on human decision" in result["final_response"]
+    assert agent._work_deadline_finish_called is True
+    assert wd.active_deadline(agent) is None
+    _assert_complete_pairs(result["messages"])
+    # Later requests extend earlier ones byte-identically (prompt-cache prefix),
+    # with the same system prompt and tool schemas: request 2 adds the
+    # tool-call/result pair, request 3 adds the assistant answer + user nudge.
+    first, second, third = (_request_kwargs(agent, i) for i in range(3))
+    assert second["messages"][:len(first["messages"])] == first["messages"]
+    assert len(second["messages"]) == len(first["messages"]) + 2
+    assert [m["role"] for m in second["messages"][-2:]] == ["assistant", "tool"]
+    assert third["messages"][:len(second["messages"])] == second["messages"]
+    assert len(third["messages"]) == len(second["messages"]) + 2
+    assert [m["role"] for m in third["messages"][-2:]] == ["assistant", "user"]
+    assert third["messages"][-1]["content"].startswith("[deadline ")
+    assert second["tools"] == first["tools"]
+    assert third["tools"] == first["tools"]
