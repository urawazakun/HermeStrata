+def _wd_tool_defs():
+    return [
+        {
+            "type": "function", "function": {
+                "name": name, "description": f"{name} tool",
+                "parameters": {"type": "object", "properties": {}},
+            },
+        }
+        for name in ("set_work_deadline", "finish_work")
+    ]
