+def _pinned_nudge(agent):
+    """The exact nudge text the gate must inject, pinned per the byte-stability contract."""
+    until, goal = wd.active_deadline(agent)
+    hhmm = wd.deadline_hhmm(until)
+    left = wd.minutes_left(until)
+    return (
+        f"[deadline {hhmm}, {left} min left] "
+        f'Record progress where your task expects it, then choose the next most valuable '
+        f'improvement toward "{goal}" yourself and continue. Do not ask the user. '
+        f"To stop before the deadline, call finish_work(reason)."
+    )
