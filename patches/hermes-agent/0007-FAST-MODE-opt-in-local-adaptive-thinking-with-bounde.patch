+def _merged_wire(kwargs):
+    """Final wire body under SDK merge order: ``extra_body`` wins over top level."""
+    merged = {k: v for k, v in kwargs.items() if k != "extra_body"}
+    merged.update(kwargs.get("extra_body") or {})
+    return merged
