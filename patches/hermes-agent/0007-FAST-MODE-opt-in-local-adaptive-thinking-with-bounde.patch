diff --git a/agent/think_mode.py b/agent/think_mode.py
new file mode 100644
index 0000000..091e73b
--- /dev/null
+++ b/agent/think_mode.py
@@ -0,0 +1,217 @@
+"""Hermes adaptive thinking policy (``HERMES_THINK_MODE=adaptive``).
+
+Fast by default, deliberate on demand — and scoped to exactly one surface:
+the loopback OpenAI-compatible custom/local endpoint (``api_mode ==
+"chat_completions"``, custom-family provider, ``base_url`` hostname
+``localhost`` / ``127.0.0.1`` / ``::1``). Every other provider, api_mode,
+or hostname returns ``None`` from :func:`apply_adaptive_layer` having
+touched nothing: no thinking flag, no output cap, no window consumption.
+
+In scope, every model request goes out with thinking OFF
+(``reasoning_effort: "none"`` + ``extra_body.chat_template_kwargs.
+enable_thinking: false``). The model calls the ``think_harder`` tool when a
+step needs deliberate reasoning; the next ``turns`` model calls go out with
+thinking ON (``reasoning_effort`` from the effective ``reasoning_config``,
+``enable_thinking: true``). A per-call output cap (``HERMES_MAX_OUTPUT_TOKENS``,
+default 16384) bounds a runaway generation.
+
+Unset ``HERMES_THINK_MODE`` (anything but ``"adaptive"``) is a complete
+no-op. All session state rides plain ``agent`` attributes (never the system
+prompt), so the cached prefix stays byte-identical across turns.
+"""
+
+from __future__ import annotations
+
+import copy
+import os
+from typing import Any, Optional
+from urllib.parse import urlparse
+
+from agent.reasoning_effort import OPENAI_COMPAT_WIRE_EFFORTS, clamp_effort
+
+THINK_MODE_ENV = "HERMES_THINK_MODE"
+MAX_OUTPUT_ENV = "HERMES_MAX_OUTPUT_TOKENS"
+ADAPTIVE_MODE = "adaptive"
+DEFAULT_MAX_OUTPUT_TOKENS = 16384
+DEFAULT_THINK_EFFORT = "medium"
+MIN_THINK_TURNS = 1
+MAX_THINK_TURNS = 5
+
+# Exact-match loopback hostnames (urlparse lowercases + strips brackets/ports,
+# so "localhost.evil.com" or "evil-localhost.com" never match).
+_LOOPBACK_HOSTS = frozenset({"localhost", "127.0.0.1", "::1"})
+
+# CustomProfile aliases (plugins/model-providers/custom/__init__.py) plus
+# named "custom:<route>" providers: the local-endpoint family.
+_LOCAL_PROVIDERS = frozenset({"custom", "ollama", "local", "vllm", "llamacpp", "llama.cpp", "llama-cpp"})
+
+
+def is_adaptive_think_mode() -> bool:
+    """True only when ``HERMES_THINK_MODE=adaptive`` (case-insensitive)."""
+    return os.getenv(THINK_MODE_ENV, "").strip().lower() == ADAPTIVE_MODE
+
+
+def get_max_output_cap() -> Optional[int]:
+    """Per-call output cap in adaptive mode, else None (leave requests alone)."""
+    if not is_adaptive_think_mode():
+        return None
+    raw = (os.getenv(MAX_OUTPUT_ENV, "") or "").strip()
+    if not raw:
+        return DEFAULT_MAX_OUTPUT_TOKENS
+    try:
+        value = int(raw)
+    except (TypeError, ValueError):
+        return DEFAULT_MAX_OUTPUT_TOKENS
+    return value if value > 0 else DEFAULT_MAX_OUTPUT_TOKENS
+
+
+def get_think_remaining(agent: Any) -> int:
+    """Outstanding thinking-ON model calls armed by ``think_harder``."""
+    try:
+        return max(0, int(getattr(agent, "_think_remaining", 0) or 0))
+    except (TypeError, ValueError):
+        return 0
+
+
+def arm_thinking(agent: Any, turns: Any) -> int:
+    """Arm the next *turns* model calls with thinking ON (clamped 1..5)."""
+    try:
+        wanted = int(turns)
+    except (TypeError, ValueError):
+        wanted = MIN_THINK_TURNS
+    armed = min(MAX_THINK_TURNS, max(MIN_THINK_TURNS, wanted))
+    agent._think_remaining = armed
+    return armed
+
+
+def _base_url_hostname(base_url: Any) -> Optional[str]:
+    """Lowercased hostname of *base_url*, or None when unparseable."""
+    if not isinstance(base_url, str) or not base_url.strip():
+        return None
+    try:
+        return urlparse(base_url.strip()).hostname
+    except ValueError:
+        return None
+
+
+def is_loopback_local_request(agent: Any) -> bool:
+    """True only for the loopback custom/local chat-completions endpoint."""
+    if (getattr(agent, "api_mode", None) or "chat_completions") != "chat_completions":
+        return False
+    provider = str(getattr(agent, "provider", "") or "").strip().lower()
+    if not (provider in _LOCAL_PROVIDERS or provider.startswith("custom:")):
+        return False
+    return _base_url_hostname(getattr(agent, "base_url", None)) in _LOOPBACK_HOSTS
+
+
+def effective_think_effort(agent: Any) -> str:
+    """Top-level ``reasoning_effort`` for a thinking-ON call.
+
+    The effective ``reasoning_config`` effort, ``"medium"`` when the config
+    carries none, clamped to the OpenAI-compatible wire vocabulary.
+    """
+    cfg = getattr(agent, "reasoning_config", None)
+    effort = cfg.get("effort") if isinstance(cfg, dict) else None
+    effort = str(effort or "").strip().lower() or DEFAULT_THINK_EFFORT
+    if effort == "none":
+        effort = DEFAULT_THINK_EFFORT
+    return clamp_effort(effort, OPENAI_COMPAT_WIRE_EFFORTS)
+
+
+def _merge_thinking_flag(api_kwargs: dict, thinking_on: bool) -> None:
+    """Set ``extra_body.chat_template_kwargs.enable_thinking`` in place.
+
+    Operates on a deep copy of ``extra_body`` so the caller's stored
+    ``request_overrides`` / provider-config dicts (aliased into the built
+    kwargs by the transport's shallow merge) are never mutated; sibling
+    ``chat_template_kwargs`` keys survive, only the ``enable_thinking``
+    leaf is owned here.
+
+    A stored ``extra_body.reasoning_effort`` is dropped from the copy: the
+    OpenAI SDK merges ``extra_body`` over the top-level body on the wire,
+    so a stale shadow would override the controlled top-level value set
+    here.
+    """
+    extra_body = copy.deepcopy(api_kwargs.get("extra_body") or {})
+    if not isinstance(extra_body, dict):
+        extra_body = {}
+    extra_body.pop("reasoning_effort", None)
+    template_kwargs = extra_body.get("chat_template_kwargs")
+    if not isinstance(template_kwargs, dict):
+        template_kwargs = {}
+    template_kwargs["enable_thinking"] = bool(thinking_on)
+    extra_body["chat_template_kwargs"] = template_kwargs
+    api_kwargs["extra_body"] = extra_body
+
+
+def _apply_output_cap(agent: Any, api_kwargs: dict) -> None:
+    """Clamp the outgoing response-token cap to the adaptive ceiling, in place.
+
+    Each already-present cap field (``max_tokens`` / ``max_completion_tokens``
+    / ``max_output_tokens``) is lowered to the ceiling independently, so an
+    explicit lower caller cap is preserved and no stale large field survives
+    next to the new one. Absent entirely, the ceiling is added with the
+    agent's own ``max_tokens`` spelling.
+
+    The copied ``extra_body`` gets the same treatment: the SDK merges it over
+    the top-level body, so a stored ``extra_body.max_tokens`` would otherwise
+    override the capped top-level value on the wire.
+    """
+    cap = get_max_output_cap()
+    if cap is None:
+        return
+    present = False
+    for key in ("max_tokens", "max_completion_tokens", "max_output_tokens"):
+        if key not in api_kwargs:
+            continue
+        present = True
+        try:
+            value = int(api_kwargs[key])
+        except (TypeError, ValueError):
+            value = 0
+        # A negative completion limit wins over a valid max_tokens on Strata.
+        # Clamp nonpositive/invalid competing fields instead of leaving a bypass.
+        if value <= 0 or value > cap:
+            api_kwargs[key] = cap
+    extra_body = api_kwargs.get("extra_body")
+    if isinstance(extra_body, dict):
+        for key in ("max_tokens", "max_completion_tokens", "max_output_tokens"):
+            if key not in extra_body:
+                continue
+            try:
+                value = int(extra_body[key])
+            except (TypeError, ValueError):
+                value = 0
+            # Local servers treat nonpositive limits as context-sized output.
+            # An extra_body shadow must never restore that unbounded default.
+            if value <= 0 or value > cap:
+                extra_body[key] = cap
+    if not present:
+        max_tokens_param = getattr(agent, "_max_tokens_param", None)
+        param = max_tokens_param(cap) if callable(max_tokens_param) else {"max_tokens": cap}
+        if isinstance(param, dict) and param:
+            api_kwargs.update(param)
+
+
+def apply_adaptive_layer(agent: Any, api_kwargs: dict) -> Optional[bool]:
+    """Apply the adaptive policy to one outgoing request, in place.
+
+    Returns whether thinking is ON for this call, or None when out of scope
+    (adaptive off, or any non-loopback-local request): out of scope the
+    kwargs are untouched and no armed window turn is consumed.
+    """
+    if not is_adaptive_think_mode():
+        return None
+    if not is_loopback_local_request(agent):
+        return None
+    window_on = get_think_remaining(agent) > 0
+    if window_on:
+        agent._think_remaining = get_think_remaining(agent) - 1
+    if window_on:
+        api_kwargs["reasoning_effort"] = effective_think_effort(agent)
+        _merge_thinking_flag(api_kwargs, True)
+    else:
+        api_kwargs["reasoning_effort"] = "none"
+        _merge_thinking_flag(api_kwargs, False)
+    _apply_output_cap(agent, api_kwargs)
+    return window_on
