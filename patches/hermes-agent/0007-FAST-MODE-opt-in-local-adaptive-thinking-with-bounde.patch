diff --git a/tests/agent/test_adaptive_think_mode.py b/tests/agent/test_adaptive_think_mode.py
new file mode 100644
index 0000000..520fe31
--- /dev/null
+++ b/tests/agent/test_adaptive_think_mode.py
@@ -0,0 +1,557 @@
+"""Adaptive thinking policy (HERMES_THINK_MODE=adaptive): behaviour contracts.
+
+Scope is exactly the loopback OpenAI-compatible custom/local endpoint;
+every other provider, api_mode, or hostname is untouched. Default (env
+unset) is byte-identical to today.
+"""
+
+import copy
+import json
+import sys
+import types
+from types import SimpleNamespace
+
+import pytest
+
+from agent import think_mode
+from agent.think_mode import (
+    apply_adaptive_layer,
+    arm_thinking,
+    effective_think_effort,
+    get_max_output_cap,
+    get_think_remaining,
+    is_adaptive_think_mode,
+    is_loopback_local_request,
+)
+
+sys.modules.setdefault("fire", types.SimpleNamespace(Fire=lambda *a, **k: None))
+
+LOCAL_BASE = "http://127.0.0.1:8080/v1"
+
+
+def _clear_env(monkeypatch):
+    monkeypatch.delenv("HERMES_THINK_MODE", raising=False)
+    monkeypatch.delenv("HERMES_MAX_OUTPUT_TOKENS", raising=False)
+
+
+def _refresh_tool_visibility():
+    from tools.registry import invalidate_check_fn_cache
+
+    import model_tools
+
+    invalidate_check_fn_cache()
+    model_tools._clear_tool_defs_cache()
+
+
+def _stub_agent(**overrides):
+    base = dict(api_mode="chat_completions", provider="custom", base_url=LOCAL_BASE, model="m")
+    base.update(overrides)
+    agent = SimpleNamespace(**base)
+
+    def _max_tokens_param(value):
+        return {"max_tokens": value}
+
+    agent._max_tokens_param = _max_tokens_param
+    return agent
+
+
+# ── mode gate ─────────────────────────────────────────────────────────────
+
+def test_default_mode_is_not_adaptive(monkeypatch):
+    _clear_env(monkeypatch)
+    assert is_adaptive_think_mode() is False
+    assert get_max_output_cap() is None
+
+
+def test_adaptive_mode_gate_case_insensitive(monkeypatch):
+    monkeypatch.setenv("HERMES_THINK_MODE", "Adaptive")
+    assert is_adaptive_think_mode() is True
+
+
+def test_other_values_are_not_adaptive(monkeypatch):
+    monkeypatch.setenv("HERMES_THINK_MODE", "fast")
+    assert is_adaptive_think_mode() is False
+
+
+# ── scope: only loopback custom/local chat_completions ────────────────────
+
+_LOOPBACK_BASES = [
+    "http://localhost:8080/v1",
+    "http://LOCALHOST:8080/v1",
+    "http://127.0.0.1:8080/v1",
+    "http://127.0.0.1/v1",
+    "http://[::1]:8080/v1",
+    "http://[::1]/v1",
+]
+
+
+@pytest.mark.parametrize("base_url", _LOOPBACK_BASES)
+@pytest.mark.parametrize("provider", ["custom", "custom:flashnext", "ollama", "local"])
+def test_loopback_local_providers_are_in_scope(base_url, provider):
+    assert is_loopback_local_request(_stub_agent(provider=provider, base_url=base_url)) is True
+
+
+@pytest.mark.parametrize(
+    "provider,base_url,api_mode",
+    [
+        # Other providers, even on loopback.
+        ("openai", "http://127.0.0.1:8080/v1", "chat_completions"),
+        ("openrouter", "http://localhost:8080/v1", "chat_completions"),
+        ("anthropic", "http://127.0.0.1:8080/v1", "chat_completions"),
+        # Custom on a remote host.
+        ("custom", "https://example.test/v1", "chat_completions"),
+        ("custom:flashnext", "https://example.test/v1", "chat_completions"),
+        # Deceptive hostnames that merely contain a loopback token.
+        ("custom", "http://localhost.evil.com/v1", "chat_completions"),
+        ("custom", "http://evil-localhost.com/v1", "chat_completions"),
+        ("custom", "http://127.0.0.1.evil.com/v1", "chat_completions"),
+        ("custom", "http://localhost./v1", "chat_completions"),
+        # Non-chat api_modes, even loopback-local.
+        ("custom", "http://127.0.0.1:8080/v1", "anthropic_messages"),
+        ("custom", "http://127.0.0.1:8080/v1", "codex_responses"),
+        ("custom", "http://127.0.0.1:8080/v1", "bedrock_converse"),
+        # Unparseable / missing endpoints fail closed.
+        ("custom", "http://[::1/v1", "chat_completions"),
+        ("custom", "", "chat_completions"),
+        ("custom", None, "chat_completions"),
+    ],
+)
+def test_out_of_scope_requests(provider, base_url, api_mode):
+    assert (
+        is_loopback_local_request(_stub_agent(provider=provider, base_url=base_url, api_mode=api_mode))
+        is False
+    )
+
+
+def test_out_of_scope_leaves_kwargs_and_window_untouched(monkeypatch):
+    monkeypatch.setenv("HERMES_THINK_MODE", "adaptive")
+    agent = _stub_agent(provider="openai", base_url="https://api.openai.com/v1")
+    arm_thinking(agent, 2)
+    api_kwargs = {"model": "m", "messages": []}
+    before = copy.deepcopy(api_kwargs)
+    assert apply_adaptive_layer(agent, api_kwargs) is None
+    assert api_kwargs == before
+    assert get_think_remaining(agent) == 2
+
+
+def test_default_mode_leaves_request_bytes_untouched(monkeypatch):
+    _clear_env(monkeypatch)
+    agent = _stub_agent()
+    arm_thinking(agent, 2)
+    api_kwargs = {"model": "m", "messages": []}
+    before = copy.deepcopy(api_kwargs)
+    assert apply_adaptive_layer(agent, api_kwargs) is None
+    assert api_kwargs == before
+
+
+# ── thinking OFF by default, ON for exactly N calls ───────────────────────
+
+def test_adaptive_thinking_off_by_default(monkeypatch):
+    monkeypatch.setenv("HERMES_THINK_MODE", "adaptive")
+    agent = _stub_agent(reasoning_config={"enabled": True, "effort": "medium"})
+    api_kwargs = {"model": "m", "messages": []}
+    assert apply_adaptive_layer(agent, api_kwargs) is False
+    assert api_kwargs["reasoning_effort"] == "none"
+    assert api_kwargs["extra_body"]["chat_template_kwargs"]["enable_thinking"] is False
+
+
+def test_think_window_covers_exactly_n_calls(monkeypatch):
+    monkeypatch.setenv("HERMES_THINK_MODE", "adaptive")
+    agent = _stub_agent(reasoning_config={"enabled": True, "effort": "medium"})
+    arm_thinking(agent, 2)
+    flags = []
+    for _ in range(4):
+        kwargs = {"model": "m", "messages": []}
+        flags.append(apply_adaptive_layer(agent, kwargs))
+        assert kwargs["extra_body"]["chat_template_kwargs"]["enable_thinking"] is (len(flags) <= 2)
+    assert flags == [True, True, False, False]
+    assert get_think_remaining(agent) == 0
+
+
