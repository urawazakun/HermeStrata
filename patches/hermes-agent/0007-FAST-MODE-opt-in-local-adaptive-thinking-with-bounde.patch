+"""think_harder tool: model-triggered escalation for adaptive thinking.
+
+In ``HERMES_THINK_MODE=adaptive`` every loopback-local request goes out with
+thinking OFF; the model calls this tool when a step needs deliberate
+reasoning and the next ``turns`` (1..5) model calls go out with thinking ON.
+Outside adaptive mode the tool is never offered (check_fn), so default
+sessions are byte-identical to today.
+
+Agent-state mutation runs through the inline executor
+(``agent/inline_tool_executors.py``), mirroring ``todo_list``/``memory``:
+the registry handler below is the schema/dispatch fallback for non-loop
+callers.
+"""
+
+import json
+from typing import Any
+
+from agent.think_mode import (
+    MAX_THINK_TURNS,
+    MIN_THINK_TURNS,
+    arm_thinking,
+    is_adaptive_think_mode,
+)
+
+THINK_HARDER_SCHEMA = {
+    "name": "think_harder",
+    "description": (
+        "Enable deeper thinking for the next few model calls (adaptive fast mode only). "
+        "Call first with a one-line reason when a step genuinely needs deliberate reasoning; "
+        "otherwise answer directly without calling it."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "reason": {
+                "type": "string",
+                "description": "One-line reason this step needs deliberate reasoning.",
+            },
+            "turns": {
+                "type": "integer",
+                "description": "How many of the next model calls think harder (1-5).",
+                "minimum": 1,
+                "maximum": 5,
+                "default": 1,
+            },
+        },
+        "required": ["reason"],
+    },
+}
+
+
+def think_harder(reason: Any = "", turns: Any = 1, agent: Any = None) -> str:
+    """Arm thinking for the next *turns* model calls; returns a JSON string."""
+    text = reason if isinstance(reason, str) else str(reason or "")
+    if not text.strip():
+        return json.dumps({"success": False, "error": "reason is required"}, ensure_ascii=False)
+    if not is_adaptive_think_mode():
+        return json.dumps(
+            {"success": False, "error": "think_harder is only available in adaptive think mode"},
+            ensure_ascii=False,
+        )
+    try:
+        wanted = int(turns)
+    except (TypeError, ValueError):
+        wanted = MIN_THINK_TURNS
+    armed = min(MAX_THINK_TURNS, max(MIN_THINK_TURNS, wanted))
+    if agent is not None:
+        arm_thinking(agent, armed)
+    return json.dumps(
+        {"success": True, "thinking": "on", "turns": armed, "reason": text.strip()},
+        ensure_ascii=False,
+    )
+
+
+def check_think_requirements() -> bool:
+    """Only offered in adaptive think mode (process env, like other opt-ins)."""
+    return bool(is_adaptive_think_mode())
+
+
+from tools.registry import registry
+
+registry.register(
+    name="think_harder",
+    toolset="thinking",
+    schema=THINK_HARDER_SCHEMA,
+    handler=lambda args, **kw: think_harder(
+        reason=args.get("reason", ""), turns=args.get("turns", 1), agent=kw.get("agent")
+    ),
+    check_fn=check_think_requirements,
+    emoji="🧠",
+)
