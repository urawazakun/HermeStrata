diff --git a/tools/delegate_tool_fork.py b/tools/delegate_tool_fork.py
new file mode 100644
index 00000000..075dc8c8
--- /dev/null
+++ b/tools/delegate_tool_fork.py
@@ -0,0 +1,315 @@
+"""``delegate_task`` fork mode: cheap subagents via prompt-cache prefix parity.
+
+The backend is ONE local engine slot that reuses the KV of the longest
+previously-seen token prefix. A forked child is cheap only if its first request
+is the parent's last request extended at the END — any byte change earlier
+(system prompt, tools[], message order) costs a full re-read of 12K-100K
+tokens.
+
+A fork task (``tasks[]`` item ``"fork": true``, default from
+``delegation.fork_default``) therefore inherits, verbatim:
+
+- the parent's cached system prompt (no re-render, no child additions) plus the
+  parent's ``ephemeral_system_prompt`` (appended at API time, never cached);
+- the parent's ``tools[]`` list, same order — child-blocked tools stay
+  advertised and are refused at CALL time instead (see
+  :func:`fork_child_block_message`);
+- the parent's transcript prefix: the parent's messages exactly as staged for
+  the most recent API request (``agent._fork_prefix_snapshot``, stashed by the
+  tool round after the assistant tool-call message is appended), plus that
+  assistant message verbatim, plus one tool-result message per tool_call id —
+  the spawning call's result carries the fork instruction, every other call
+  gets ``"(running in the parent)"``.
+
+This module is stdlib-only so ``agent/tool_executor.py`` can call the
+call-time guard without an import cycle.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import logging
+from typing import Any, Dict, List, Optional, Tuple
+
+logger = logging.getLogger("tools.delegate_tool")  # log-record parity with the origin module
+
+# Stashed by the tool round (agent/turn_tool_round.py) right after the assistant
+# tool-call message is appended: prefix + assistant message, pre-tool-results.
+_FORK_PREFIX_ATTR = "_fork_prefix_snapshot"
+
+# Placeholder content for tool calls that are still running in the parent when
+# the fork child is built. Keeps every tool_call id paired with exactly one
+# result so the orphan sweep never fires on the child's first request.
+_FORK_SIBLING_PLACEHOLDER = "(running in the parent)"
+
+# Synthesized assistant tool-call id for direct callers (no staged snapshot):
+# identical for every child of one call so siblings share one prefix.
+_FORK_SYNTH_CALL_ID = "fork-delegate-call"
+
+# Tools that stay ADVERTISED on a fork child (tools[] parity) but refuse at
+# call time. ``delegate_task`` is not listed: it stays callable and is gated by
+# the normal depth budget instead (depth == max refuses inside delegate_task).
+_FORK_BLOCKED_TOOL_REASONS = {
+    "clarify": "no user interaction from a forked child",
+    "memory": "no writes to shared MEMORY.md from a forked child",
+    "send_message": "no cross-platform side effects from a forked child",
+    "cronjob_manage": "no scheduling more work in the parent's name from a forked child",
+}
+
+_SCHEMA_JSON_CAP = 4000
+
+
+def resolve_task_fork(task: Any, default: bool = False) -> bool:
+    """Per-task fork flag: explicit ``task["fork"]`` wins, else ``default``.
+    ``None``/missing means "no opinion" and falls back to the default."""
+    if not isinstance(task, dict) or task.get("fork") is None:
+        return bool(default)
+    try:
+        from utils import is_truthy_value
+        return bool(is_truthy_value(task.get("fork"), default=default))
+    except Exception:
+        return bool(default)
+
+
+def tasks_request_fork(tasks: Any, goal: Any, cfg: Optional[Dict[str, Any]]) -> bool:
+    """Lightweight peek used by the depth-limit gate: True when this call would
+    spawn at least one fork child. Handles the JSON-string ``tasks`` shape the
+    same way ``_normalize_task_list`` does."""
+    default = False
+    try:
+        from utils import is_truthy_value
+        default = bool(is_truthy_value((cfg or {}).get("fork_default", False), default=False))
+    except Exception:
+        pass
+    effective = tasks
+    if isinstance(tasks, str):
+        try:
+            from tools.delegate_tool_tasks import _recover_tasks_from_json_string
+            recovered, _ = _recover_tasks_from_json_string(tasks)
+            if recovered is not None:
+                effective = recovered
+        except Exception:
+            pass
+    if isinstance(effective, list) and effective:
+        return any(resolve_task_fork(t, default) for t in effective)
+    if isinstance(goal, str) and goal.strip():
+        return default
+    return False
+
+
+def fork_depth_error(depth: int, max_spawn: int) -> str:
+    """Tool error for a fork spawn refused by the depth budget."""
+    return json.dumps(
+        {"error": f"delegation depth limit reached ({depth}/{max_spawn}): do this work yourself"},
+        ensure_ascii=False,
+    )
+
+
+def build_fork_instruction(
+    *, goal: str, context: Optional[str], child_depth: int, max_spawn_depth: int,
+    output_schema: Optional[Dict[str, Any]] = None,
+) -> str:
+    """The fork instruction: this task's tool-result content in the child's
+    inherited prefix. Ends the prefix; the child extends it with its own turns."""
+    text = (
+        f"[forked child, depth {child_depth}/{max_spawn_depth}] "
+        f"You are a copy of the agent above, now working ONLY on this task: {goal}"
+    )
+    if context and str(context).strip():
+        text += f"\n{context}"
+    text += " Do it yourself; delegate only clearly separable sub-work."
+    tail = " Your final message is your report to the parent"
+    if isinstance(output_schema, dict):
+        try:
+            schema_json = json.dumps(output_schema, ensure_ascii=False)
+        except (TypeError, ValueError):
+            schema_json = str(output_schema)
+        if len(schema_json) > _SCHEMA_JSON_CAP:
+            schema_json = schema_json[:_SCHEMA_JSON_CAP] + " ...[truncated]"
+        tail += f", matching this JSON schema: {schema_json}"
+    return text + tail + "."
+
+
+def _snapshot_prefix(parent_agent: Any) -> List[Dict[str, Any]]:
+    """Deep copy of the parent's staged prefix (prefix + assistant tool-call
+    message), or of ``_session_messages`` when no snapshot was stashed (direct
+    callers, tests). Never a live reference: the child loop mutates history."""
+    snap = getattr(parent_agent, _FORK_PREFIX_ATTR, None)
+    if isinstance(snap, list) and snap and all(isinstance(m, dict) for m in snap):
+        return copy.deepcopy(snap)
+    hist = getattr(parent_agent, "_session_messages", None)
+    if isinstance(hist, list) and hist and all(isinstance(m, dict) for m in hist):
+        return copy.deepcopy(hist)
+    return []
+
+
+def _assistant_tool_calls(prefix: List[Dict[str, Any]]) -> Tuple[Optional[Dict[str, Any]], List[Dict[str, Any]]]:
+    """``(assistant_msg, tool_calls)`` from the prefix tail, or ``(None, [])``
+    when the prefix does not end on an assistant tool-call message."""
+    if not prefix:
+        return None, []
+    assistant_msg = prefix[-1]
+    if not isinstance(assistant_msg, dict) or assistant_msg.get("role") != "assistant":
+        return None, []
+    tool_calls = assistant_msg.get("tool_calls") or []
+    if not isinstance(tool_calls, list) or not tool_calls:
+        return None, []
+    return assistant_msg, [tc for tc in tool_calls if isinstance(tc, dict)]
+
+
+def _synthesized_assistant(goal: str) -> Dict[str, Any]:
+    """Minimal assistant tool-call message for direct callers without a staged
+    snapshot: one ``delegate_task`` call carrying this task's goal."""
+    try:
+        args = json.dumps({"tasks": [{"goal": goal}]}, ensure_ascii=False)
+    except (TypeError, ValueError):
+        args = "{}"
+    return {
+        "role": "assistant",
+        "content": "",
+        "tool_calls": [{
+            "id": _FORK_SYNTH_CALL_ID, "type": "function",
+            "function": {"name": "delegate_task", "arguments": args},
+        }],
+    }
+
+
+def _tool_call_id(tc: Dict[str, Any]) -> Optional[str]:
+    for key in ("id", "call_id", "tool_call_id"):
+        value = tc.get(key)
+        if isinstance(value, str) and value.strip():
+            return value.strip()
+    return None
+
+
+def _tool_call_name(tc: Dict[str, Any]) -> str:
+    fn = tc.get("function")
+    if isinstance(fn, dict) and isinstance(fn.get("name"), str):
+        return fn["name"]
+    name = tc.get("name")
+    return name if isinstance(name, str) else ""
+
+
+def _spawning_call_id(
+    tool_calls: List[Dict[str, Any]], task_goal: str, explicit_id: Optional[str] = None,
+) -> Optional[str]:
+    """Which tool_call id spawned this fork child. An explicit id (wired
+    through when available) wins; otherwise the ``delegate_task`` call whose
+    arguments carry this task's goal; else the single ``delegate_task`` call;
+    else the first tool call. ``None`` only when ``tool_calls`` is empty."""
+    if explicit_id is not None:
+        return explicit_id
+    ids = [(_tool_call_id(tc), _tool_call_name(tc), tc) for tc in tool_calls]
+    delegate_ids = [cid for cid, name, _ in ids if cid and name == "delegate_task"]
+    if len(delegate_ids) == 1:
+        return delegate_ids[0]
+    for cid, name, tc in ids:
+        if not cid or name != "delegate_task":
+            continue
+        try:
+            args = (tc.get("function") or {}).get("arguments")
+            parsed = json.loads(args) if isinstance(args, str) else args
+        except (TypeError, ValueError):
+            continue
+        if not isinstance(parsed, dict):
+            continue
+        goals = [t.get("goal") for t in parsed.get("tasks", []) if isinstance(t, dict)]
+        if task_goal in goals or parsed.get("goal") == task_goal:
+            return cid
+    if delegate_ids:
+        return delegate_ids[0]
+    return ids[0][0] if ids else None
+
+
+def build_fork_conversation_history(
+    parent_agent: Any, *, task_goal: str, instruction: str,
+    spawn_tool_call_id: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Full initial history for one fork child: parent prefix + verbatim
+    assistant tool-call message + one tool result per tool_call id (this
+    task's result carries ``instruction``)."""
+    prefix = _snapshot_prefix(parent_agent)
+    assistant_msg, tool_calls = _assistant_tool_calls(prefix)
+    if assistant_msg is None:
+        assistant_msg = _synthesized_assistant(task_goal)
+        prefix = prefix + [assistant_msg]
+        tool_calls = assistant_msg["tool_calls"]
+    spawn_id = _spawning_call_id(tool_calls, task_goal, spawn_tool_call_id)
+    history = list(prefix)
+    for tc in tool_calls:
+        cid = _tool_call_id(tc)
+        if not cid:
+            continue
+        content = instruction if cid == spawn_id else _FORK_SIBLING_PLACEHOLDER
+        history.append({
+            "role": "tool", "name": _tool_call_name(tc) or "delegate_task",
+            "tool_name": _tool_call_name(tc) or "delegate_task",
+            "content": content, "tool_call_id": cid,
+        })
+    return history
+
+
+def fork_parent_toolsets(parent_agent: Any) -> Tuple[Any, Any]:
+    """``(enabled_toolsets, disabled_toolsets)`` for a fork child: the parent's
+    own pair, verbatim — restriction moves to call time so ``tools[]`` stays
+    byte-identical."""
+    return getattr(parent_agent, "enabled_toolsets", None), getattr(parent_agent, "disabled_toolsets", None)
+
+
+def apply_fork_parity(child: Any, parent_agent: Any) -> None:
+    """Post-construction parity for a fork child (mirrors
+    ``agent.background_review.build_cache_parity_fork``): inherit the parent's
+    cached system prompt verbatim (no re-render), pin ``session_start`` so any
+    re-render stays byte-identical, advertise the parent's exact ``tools[]``
+    (frozen snapshot generation so refreshes cannot rebuild it), skip the
+    between-turns MCP refresh for the same reason, and defer preflight
+    compaction until after the first provider response so request #1 is a warm
+    cache read. Marks the child ``_is_fork_child`` for the call-time guard."""
+    from agent.background_review import _inherit_parent_tool_surface
+
+    system = getattr(parent_agent, "_cached_system_prompt", None)
+    if isinstance(system, str) and system:
+        child._cached_system_prompt = system
+    else:
+        logger.warning(
+            "fork child: parent has no cached system prompt; the child prompt "
+            "was built fresh and the first request will miss the prefix cache",
+        )
+    try:
+        import datetime as _dt
+        parent_start = getattr(parent_agent, "session_start", None)
+        if isinstance(parent_start, _dt.datetime):
+            child.session_start = parent_start
+    except Exception:
+        pass
+    parent_tools = getattr(parent_agent, "tools", None)
+    if (isinstance(parent_tools, list) and parent_tools
+            and all(isinstance(t, dict) for t in parent_tools)):
+        _inherit_parent_tool_surface(child, parent_agent)
+    else:
+        logger.warning(
+            "fork child: parent tools[] is not a concrete list; keeping the "
+            "constructed toolsets and the first request may miss the cache",
+        )
+    child._skip_mcp_refresh = True
+    # Same deferral the background-review fork uses: preflight compaction must
+    # not rewrite the inherited prefix before the first response (spec §6).
+    # Consumed generically by agent/turn_context._review_fork_first_request_pending.
+    child._review_defer_compaction_before_first_response = True
+    child._is_fork_child = True
+
+
+def fork_child_block_message(agent: Any, tool_name: str) -> Optional[str]:
+    """Call-time restriction for fork children: ``None`` to proceed, else the
+    tool-error text. ``delegate_task`` always passes through here — its own
+    depth budget decides (depth == max refuses inside ``delegate_task``)."""
+    if not getattr(agent, "_is_fork_child", False):
+        return None
+    reason = _FORK_BLOCKED_TOOL_REASONS.get(tool_name)
+    if reason is None:
+        return None
+    return json.dumps(
+        {"error": f"not available to a forked child: {reason} ({tool_name})"},
+        ensure_ascii=False,
+    )
