+#!/usr/bin/env python3
+"""Tests for delegate_task fork mode (prompt-cache prefix parity).
+
+A fork task (``tasks[]`` item ``"fork": true``, default from
+``delegation.fork_default``) inherits the parent's system prompt, ``tools[]``
+and transcript prefix verbatim so its first request extends the parent's last
+request at the END. Blocked tools stay advertised and refuse at CALL time.
+
+Uses stub agents + a FakeAgent class (no network, no real model calls).
+
+Run with:  venv\\Scripts\\python.exe -m pytest tests/tools/test_delegate_fork.py -v
+"""
+
+import copy
+import datetime as _dt
+import json
+import time
+import unittest
+from unittest.mock import patch
+
+from tools.delegate_tool import DELEGATE_TASK_SCHEMA, delegate_task
+
+FORK_GOAL = "Summarize the quarterly report figures"
+FORK_CONTEXT = "The report lives at /tmp/q3.txt; keep the summary under 200 words."
+PARENT_SYSTEM = "PARENT-SYSTEM-PROMPT-BYTES::v1"
+PARENT_EPHEMERAL = "PARENT-EPHEMERAL-BYTES::v1"
+
+
+def _tool_def(name):
+    return {
+        "type": "function",
+        "function": {"name": name, "description": f"{name} tool", "parameters": {"type": "object"}},
+    }
+
+
+PARENT_TOOLS = [_tool_def(n) for n in ("terminal", "read_file", "delegate_task", "memory", "clarify")]
+
+
+def _delegate_call_msg(call_id="call-1", tasks=None):
+    if tasks is None:
+        tasks = [{"goal": FORK_GOAL, "context": FORK_CONTEXT, "fork": True}]
+    return {
+        "id": call_id, "type": "function",
+        "function": {"name": "delegate_task", "arguments": json.dumps({"tasks": tasks})},
+    }
+
+
+def _parent_prefix(extra_calls=True):
+    """Parent transcript as staged for the most recent API request, plus the
+    assistant tool-call message (what turn_tool_round stashes)."""
+    tool_calls = [_delegate_call_msg()]
+    if extra_calls:
+        tool_calls.append({
+            "id": "call-2", "type": "function",
+            "function": {"name": "read_file", "arguments": json.dumps({"path": "/tmp/q3.txt"})},
+        })
+    return [
+        {"role": "user", "content": "Please summarize the quarterly report"},
+        {"role": "assistant", "content": "", "tool_calls": tool_calls},
+    ]
+
+
+class _StubParent:
+    """Minimal parent with REAL values (no MagicMock attribute fog)."""
+
+    def __init__(self, depth=0):
+        self.base_url = "https://openrouter.ai/api/v1"
+        self.api_key = "test-key"
+        self.provider = "openrouter"
+        self.api_mode = "chat_completions"
+        self.model = "anthropic/claude-sonnet-4"
+        self.platform = "cli"
+        self.session_id = "parent-sess-1"
+        self._session_db = None
+        self._delegate_depth = depth
+        self._active_children = []
+        self._print_fn = None
+        self.tool_progress_callback = None
+        self._cached_system_prompt = PARENT_SYSTEM
+        self.ephemeral_system_prompt = PARENT_EPHEMERAL
+        self.session_start = _dt.datetime(2026, 1, 1, 12, 0, 0)
+        self.tools = copy.deepcopy(PARENT_TOOLS)
+        self.enabled_toolsets = ["terminal", "file", "web", "delegation", "memory", "clarify"]
+        self.disabled_toolsets = []
+        self.prefill_messages = [{"role": "system", "content": "PREFILL-BYTES"}]
+        self.reasoning_config = None
+        self.request_overrides = {}
+        self._credential_pool = None
+        self._fallback_chain = None
+        self._client_kwargs = {}
+        self.client = None
+        self.capabilities = None
+        self.acp_command = None
+        self.acp_args = []
+        self._memory_manager = None
+        self._fork_prefix_snapshot = _parent_prefix()
+        self._session_messages = copy.deepcopy(self._fork_prefix_snapshot)
+
+
+class FakeAgent:
+    """Stand-in for run_agent.AIAgent: captures construction + first turn."""
+
+    instances = []
+    final_response_text = "fork report: done"
+
+    def __init__(self, **kwargs):
+        self.kwargs = dict(kwargs)
+        for key, value in kwargs.items():
+            setattr(self, key, value)
+        self.run_conversation_calls = []
+        FakeAgent.instances.append(self)
+
+    def run_conversation(self, user_message=None, conversation_history=None,
+                         task_id=None, stream_callback=None, **kw):
+        self.run_conversation_calls.append({
+            "user_message": user_message,
+            "conversation_history": copy.deepcopy(conversation_history),
+            "task_id": task_id,
+        })
+        return {
+            "final_response": type(self).final_response_text,
+            "completed": True,
+            "api_calls": 1,
+            "messages": [
+                {"role": "user", "content": user_message},
+                {"role": "assistant", "content": type(self).final_response_text},
+            ],
+        }
+
+    def get_activity_summary(self):
+        return {
+            "api_call_count": 1, "current_tool": None,
+            "last_activity_ts": time.time(), "max_iterations": 250,
+            "last_activity_desc": "",
+        }
+
+    def close(self):
+        pass
+
+
+def _run_fork(parent, tasks, **kw):
+    """Run delegate_task with AIAgent patched; return (payload, children)."""
+    FakeAgent.instances = []
+    kw.setdefault("background", False)
+    with patch("run_agent.AIAgent", FakeAgent):
+        raw = delegate_task(tasks=tasks, parent_agent=parent, **kw)
+    return json.loads(raw), list(FakeAgent.instances)
+
+
+class TestForkFirstRequestParity(unittest.TestCase):
+    def test_system_tools_and_prefix_parity(self):
+        """Fork child's first request: system identical, tools identical
+        (json dumps equal), messages[:k] equal to the parent's last request
+        messages, followed by the assistant tool-call message + results."""
+        parent = _StubParent()
+        payload, children = _run_fork(parent, [{"goal": FORK_GOAL, "context": FORK_CONTEXT, "fork": True}])
+        self.assertEqual(len(children), 1)
+        child = children[0]
+
+        # System prompt: byte-identical, no re-render, no additions.
+        self.assertEqual(child._cached_system_prompt, PARENT_SYSTEM)
+        self.assertIs(child._cached_system_prompt, parent._cached_system_prompt)
+        self.assertEqual(child.kwargs.get("ephemeral_system_prompt"), PARENT_EPHEMERAL)
+        wire_parent = (PARENT_SYSTEM + "\n\n" + PARENT_EPHEMERAL).strip()
+        wire_child = (child._cached_system_prompt + "\n\n" + child.ephemeral_system_prompt).strip()
+        self.assertEqual(wire_child, wire_parent)
+
+        # tools[]: byte-identical, same order — blocked tools NOT removed.
+        self.assertEqual(json.dumps(child.tools), json.dumps(parent.tools))
+        child_names = [t["function"]["name"] for t in child.tools]
+        for blocked in ("delegate_task", "memory", "clarify"):
+            self.assertIn(blocked, child_names)
+
+        # First turn: prefix + verbatim assistant + per-call tool results.
+        self.assertEqual(len(child.run_conversation_calls), 1)
+        call = child.run_conversation_calls[0]
+        history = call["conversation_history"]
+        prefix = parent._fork_prefix_snapshot
+        self.assertEqual(history[: len(prefix)], prefix)
+        assistant = history[len(prefix) - 1]
+        self.assertEqual(assistant["role"], "assistant")
+        self.assertEqual(assistant, prefix[-1])  # verbatim, incl. all tool_calls
+        call_ids = [tc.get("id") for tc in assistant["tool_calls"]]
+        self.assertEqual(call_ids, ["call-1", "call-2"])
+        results = history[len(prefix):]
+        self.assertEqual(len(results), 2)
+        by_id = {m["tool_call_id"]: m for m in results}
+        self.assertEqual(set(by_id), {"call-1", "call-2"})
+        self.assertTrue(all(m["role"] == "tool" for m in results))
+        instruction = by_id["call-1"]["content"]
+        self.assertIn("[forked child, depth 1/1]", instruction)
+        self.assertIn(FORK_GOAL, instruction)
+        self.assertIn(FORK_CONTEXT, instruction)
+        self.assertIn("Your final message is your report to the parent", instruction)
+        self.assertEqual(by_id["call-2"]["content"], "(running in the parent)")
+
+        # Simulated wire messages: parent prefix, then assistant + results,
+        # then the goal turn extending at the END.
+        first_request = history + [{"role": "user", "content": call["user_message"]}]
+        self.assertEqual(first_request[: len(prefix)], prefix)
+        self.assertEqual(call["user_message"], FORK_GOAL)
+
+        # Fork bookkeeping.
+        self.assertTrue(child._is_fork_child)
+        self.assertEqual(child._fork_conversation_history, history)
+        self.assertTrue(child._review_defer_compaction_before_first_response)
+        self.assertTrue(child._skip_mcp_refresh)
+        self.assertEqual(child._delegate_depth, 1)
+
+        # Prefill deep-copied (send-time sanitizers must not rewrite parent's).
+        self.assertEqual(child.kwargs.get("prefill_messages"), parent.prefill_messages)
+        self.assertIsNot(child.kwargs.get("prefill_messages"), parent.prefill_messages)
+
+        # Parent received the normal result entry (transcript NOT merged).
+        self.assertIn("results", payload)
+        self.assertEqual(payload["results"][0]["status"], "completed")
+        self.assertIn("fork report", payload["results"][0]["summary"])
+
+    def test_output_schema_rides_the_instruction(self):
+        parent = _StubParent()
+        schema = {"type": "object", "properties": {"total": {"type": "number"}}, "required": ["total"]}
+        FakeAgent.final_response_text = '{"total": 42}'
+        try:
+            payload, children = _run_fork(
+                parent, [{"goal": FORK_GOAL, "fork": True, "output_schema": schema}])
+        finally:
+            FakeAgent.final_response_text = "fork report: done"
+        history = children[0].run_conversation_calls[0]["conversation_history"]
+        by_id = {m["tool_call_id"]: m for m in history if m.get("role") == "tool"}
+        instruction = by_id["call-1"]["content"]
+        self.assertIn("matching this JSON schema", instruction)
+        self.assertIn('"total"', instruction)
+        self.assertEqual(payload["results"][0].get("schema_valid"), True)
+
+    def test_several_fork_tasks_share_prefix_with_own_instruction(self):
+        """One assistant message launching several fork tasks: each child gets
+        the same prefix and its own instruction."""
+        parent = _StubParent()
+        tasks = [
+            {"goal": "First parallel analysis tropic", "fork": True},
+            {"goal": "Second parallel analysis tropic", "fork": True},
+        ]
+        parent._fork_prefix_snapshot = [
+            {"role": "user", "content": "fan out please"},
+            {"role": "assistant", "content": "", "tool_calls": [_delegate_call_msg("call-9", tasks=tasks)]},
+        ]
+        payload, children = _run_fork(parent, tasks)
+        self.assertEqual(len(children), 2)
+        histories = [c.run_conversation_calls[0]["conversation_history"] for c in children]
+        self.assertEqual(histories[0][:2], histories[1][:2])
+        first_instructions = [h[2]["content"] for h in histories]
+        self.assertIn("First parallel analysis tropic", first_instructions[0])
+        self.assertIn("Second parallel analysis tropic", first_instructions[1])
+        self.assertNotIn("Second parallel analysis tropic", first_instructions[0])
+        self.assertNotIn("First parallel analysis tropic", first_instructions[1])
+
+    def test_fork_default_config(self):
+        """delegation.fork_default: true makes flag-less tasks fork."""
+        parent = _StubParent()
+        with patch("tools.delegate_tool._load_config",
+                   return_value={"fork_default": True, "max_iterations": 250}):
+            payload, children = _run_fork(parent, [{"goal": "Unflagged but defaulted task here"}])
+        self.assertEqual(len(children), 1)
+        self.assertTrue(children[0]._is_fork_child)
+
+    def test_explicit_fork_false_opts_out(self):
+        parent = _StubParent()
+        with patch("tools.delegate_tool._load_config",
+                   return_value={"fork_default": True, "max_iterations": 250}):
+            payload, children = _run_fork(
+                parent, [{"goal": "Explicitly isolated task here", "fork": False}])
+        self.assertEqual(len(children), 1)
+        self.assertFalse(getattr(children[0], "_is_fork_child", False))
+
+    def test_schema_advertises_fork(self):
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        self.assertIn("fork", props)
+        self.assertEqual(props["fork"]["type"], "boolean")
+
+
+class TestForkCallTimeRestrictions(unittest.TestCase):
+    def _fork_child(self):
+        child = FakeAgent(model="m")
+        child._is_fork_child = True
+        return child
+
+    def test_blocked_tools_refuse_at_call_time(self):
+        from tools.delegate_tool_fork import fork_child_block_message
+
+        child = self._fork_child()
+        for tool in ("clarify", "memory", "send_message", "cronjob_manage"):
+            raw = fork_child_block_message(child, tool)
+            self.assertIsNotNone(raw, tool)
+            parsed = json.loads(raw)
+            self.assertIn("not available to a forked child", parsed["error"])
+        # Allowed tools pass through (None), including delegate_task itself:
+        # its own depth budget decides.
+        for tool in ("terminal", "read_file", "delegate_task", "execute_code"):
+            self.assertIsNone(fork_child_block_message(child, tool))
+
+    def test_non_fork_children_unaffected(self):
+        from tools.delegate_tool_fork import fork_child_block_message
+
+        plain = FakeAgent(model="m")
+        self.assertIsNone(fork_child_block_message(plain, "memory"))
+        self.assertIsNone(fork_child_block_message(object(), "memory"))
+
+    def test_executor_pre_tool_block_enforces_fork_guard(self):
+        """The agent-loop dispatch chokepoint refuses blocked fork tools."""
+        from agent.tool_executor import _ToolCallRef, _pre_tool_block
+
+        child = self._fork_child()
+        message, _ = _pre_tool_block(child, _ToolCallRef("memory", {}, "t", "c", []))
+        self.assertIsNotNone(message)
+        self.assertIn("not available to a forked child", json.loads(message)["error"])
+        message, _ = _pre_tool_block(child, _ToolCallRef("terminal", {}, "t", "c", []))
+        self.assertIsNone(message)
+
+    def test_executor_guard_failure_is_fail_closed_for_fork_child(self):
+        """A broken restriction helper must refuse, not silently enable blocked tools."""
+        from agent.tool_executor import _ToolCallRef, _pre_tool_block
+
+        child = self._fork_child()
+        with patch("tools.delegate_tool_fork.fork_child_block_message", side_effect=RuntimeError("boom")):
+            message, _ = _pre_tool_block(child, _ToolCallRef("memory", {}, "t", "c", []))
+        self.assertIsNotNone(message)
+        self.assertIn("restriction enforcement failed", json.loads(message)["error"].lower())
+
+    def test_depth_limit_refusal_for_fork(self):
+        parent = _StubParent(depth=1)  # default max_spawn_depth == 1
+        parent._is_fork_child = True
+        with patch("run_agent.AIAgent", FakeAgent):
+            raw = delegate_task(
+                tasks=[{"goal": FORK_GOAL, "fork": True}],
+                parent_agent=parent, background=False,
+            )
+        parsed = json.loads(raw)
+        self.assertIn("error", parsed)
+        self.assertIn("delegation depth limit reached (1/1)", parsed["error"])
+        self.assertIn("do this work yourself", parsed["error"])
+
+    def test_depth_limit_unchanged_for_non_fork(self):
+        parent = _StubParent(depth=2)
+        with patch("tools.delegate_tool._get_max_spawn_depth", return_value=2):
+            with patch("run_agent.AIAgent", FakeAgent):
+                raw = delegate_task(goal="test", parent_agent=parent)
+        parsed = json.loads(raw)
+        self.assertIn("error", parsed)
+        self.assertIn("depth limit", parsed["error"].lower())
+        self.assertNotIn("do this work yourself", parsed["error"])
+
+
+class TestNonForkPathUnchanged(unittest.TestCase):
+    def test_normal_child_has_no_fork_state(self):
+        parent = _StubParent()
+        payload, children = _run_fork(parent, [{"goal": "A normal isolated task here"}])
+        child = children[0]
+        self.assertFalse(getattr(child, "_is_fork_child", False))
+        self.assertFalse(hasattr(child, "_fork_conversation_history"))
+        # Focused task prompt, not the parent's cached system prompt.
+        ephemeral = child.kwargs.get("ephemeral_system_prompt") or ""
+        self.assertIn("YOUR TASK", ephemeral)
+        self.assertNotEqual(
+            getattr(child, "_cached_system_prompt", None), parent._cached_system_prompt)
+        # Normal path starts a fresh conversation (no inherited history).
+        call = child.run_conversation_calls[0]
+        self.assertIsNone(call["conversation_history"])
+        self.assertEqual(payload["results"][0]["status"], "completed")
+
+
+if __name__ == "__main__":
+    unittest.main()
