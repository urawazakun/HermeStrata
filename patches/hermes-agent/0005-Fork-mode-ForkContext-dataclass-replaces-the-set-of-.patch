+@dataclass(frozen=True)
+class ForkContext:
+    """Everything a ``delegate_task`` fork child inherits from its parent.
+
+    "What a fork is" as a type instead of N private attributes read off the
+    parent at scattered call sites: the parent's cached system prompt text,
+    its exact ``tools[]`` snapshot, its last-request transcript prefix, the
+    toolset pair, depth / max depth, the blocked-tool policy, the per-task
+    fork instruction, and the flags the child needs (skip MCP refresh, defer
+    review compaction). ``from_parent`` is the ONE place that reads the
+    parent's internals; ``_build_child_agent`` builds exactly one of these
+    per fork and passes it into child construction, where agent-owned
+    initialization installs the cached prompt / tool surface from it.
+    ``child._is_fork_child`` (a read-only property on ``AIAgent``) is simply
+    ``child.fork_context is not None``.
+
+    Frozen prevents rebinding, not deep immutability: ``from_parent``
+    deep-copies every captured structure (prefix, tools, toolsets, prefill)
+    so the snapshot is detached from the parent, and ``build_history``
+    deep-copies on the way out so sibling children never share message
+    dicts.
+    """
+
+    system_prompt: Optional[str] = None
+    ephemeral_system_prompt: Optional[str] = None
+    tools: List[Dict[str, Any]] = field(default_factory=list)
+    prefix: List[Dict[str, Any]] = field(default_factory=list)
