     # agent/turn_context.py without touching the session deadline.
@@ -2142,6 +2147,39 @@ def _snapshot_primary_runtime(agent):
         })
 
 
+def _install_fork_context_surface(agent, fork_ctx) -> None:
+    """Agent-owned fork parity (mirrors ``agent.background_review``
+    ``build_cache_parity_fork``): attach the delegate-fork snapshot and
+    install the cached prompt / tool surface from it, so the child's first
+    request is byte-identical to the parent's last. Runs at the END of
+    construction (after context-engine tools land) so the inherited surface
+    wins. Refresh/deferral flags are NOT copied — the turn loop reads them
+    off ``fork_context`` live, and the per-task history is rebuilt from the
+    context at run time."""
+    agent.fork_context = fork_ctx
+    if fork_ctx is None:
+        return
+    from agent.background_review import _inherit_parent_tool_surface
+
+    if isinstance(fork_ctx.system_prompt, str) and fork_ctx.system_prompt:
+        agent._cached_system_prompt = fork_ctx.system_prompt
+    else:
+        logger.warning(
+            "fork child: parent has no cached system prompt; the child prompt "
+            "was built fresh and the first request will miss the prefix cache",
+        )
+    if isinstance(fork_ctx.session_start, datetime):
+        agent.session_start = fork_ctx.session_start
+    if (isinstance(fork_ctx.tools, list) and fork_ctx.tools
+            and all(isinstance(t, dict) for t in fork_ctx.tools)):
+        _inherit_parent_tool_surface(agent, SimpleNamespace(tools=fork_ctx.tools))
+    else:
+        logger.warning(
+            "fork child: parent tools[] is not a concrete list; keeping the "
+            "constructed toolsets and the first request may miss the cache",
+        )
+
+
 def _init_usage_state(agent):
