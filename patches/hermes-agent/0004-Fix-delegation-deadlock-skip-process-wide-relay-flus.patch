index 00000000..d6eb23cb
--- /dev/null
+++ b/tools/ask_document_tool.py
@@ -0,0 +1,369 @@
+"""Ask-document tool (cache-augmented generation over a local file or directory).
+
+``ask_document(path, question, max_tokens=800)`` reads a UTF-8 text file — or a
+directory, concatenated in global sorted order of relative paths with
+``### <relpath>`` headers, skipping binaries — and sends ONE plain chat
+completion (no tools, no response_format) on the calling agent's own chat
+client, then returns the answer text.
+
+Client reuse (no edits to the agent runtime): inside an agent turn,
+``agent.subagent_lifecycle.get_active_subagent_parent()`` is the live ``AIAgent``
+(bound by ``agent/turn_facade.py`` for every turn), so the tool calls
+``agent.client.chat.completions.create`` directly — the same client, model,
+endpoint and headers as the turn loop, and never the auxiliary route
+(``agent/auxiliary_client.call_llm`` is deliberately NOT used, so the call is
+not classified as an aux request and carries no auxiliary task config). There
+is intentionally NO fallback client: outside a bound ``chat_completions`` turn
+the tool refuses with a clear error rather than silently changing
+endpoint/profile/model.
+
+Cache behavior is by construction: the system message is a FIXED reader
+instruction plus the document bytes, byte-identical for the same file content,
+so the serving engine can pin the system prefix as a cache root and a second
+question on the same document may resume from the cached prefix.
+
+Not offered to delegated children: ``model_tools._select_tool_names``
+discards ``ask_document`` in a delegated-child context (the session-toolset
+filter — a ``check_fn`` gate would be wrong here: check_fn verdicts are
+TTL-cached process-wide in ``tools/registry.py`` and must never answer
+per-session surface), and the handler itself refuses in that context so
+explicit or forked calls fail closed too.
+"""
+
+from __future__ import annotations
+
+import codecs
+import json
+import logging
+import os
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+ASK_DOCUMENT_TOOLSET = "ask_document"
+
+# Fixed reader instruction (English, constant): identical bytes for identical
+# documents, so the engine can pin the system prefix as a cache root.
+READER_SYSTEM_PREFIX = (
+    "You are a precise document reader. Answer the user's question using ONLY "
+    "the document below. Quote briefly when helpful. If the answer is not in "
+    "the document, say so plainly."
+)
+
+DEFAULT_MAX_CHARS = 800_000
+DEFAULT_MAX_TOKENS = 800
+_MAX_TOKENS_HARD_CAP = 16_000
+# Byte reads are bounded by remaining char budget * worst-case UTF-8 expansion.
+_UTF8_MAX_BYTES_PER_CHAR = 4
+
+
+def _ask_document_section() -> Dict[str, Any]:
+    """``ask_document`` config section ({} when absent/unreadable); never raises."""
+    try:
+        from hermes_cli.config import load_config_readonly
+        section = load_config_readonly().get("ask_document")
+    except Exception:
+        return {}
+    return section if isinstance(section, dict) else {}
+
+
+def _ask_document_enabled() -> bool:
+    """Config ``ask_document.enabled`` (default True); never raises."""
+    try:
+        from utils import is_truthy_value
+        return bool(is_truthy_value(_ask_document_section().get("enabled", True), default=True))
+    except Exception:
+        return True
+
+
+def _ask_document_max_chars() -> int:
+    """Config ``ask_document.max_chars`` (default 800000); never raises."""
+    try:
+        value = int(_ask_document_section().get("max_chars", DEFAULT_MAX_CHARS))
+    except Exception:
+        return DEFAULT_MAX_CHARS
+    return value if value > 0 else DEFAULT_MAX_CHARS
+
+
+def _is_child_context() -> bool:
+    """True while running for a delegate_task child."""
+    from agent.delegation_context import is_delegated_child_context
+    return bool(is_delegated_child_context())
+
+
+def check_ask_document_requirements() -> bool:
+    """Available unless ``ask_document.enabled`` is false (config-wide, cache-safe).
+
+    Child exclusion is NOT handled here: check_fn verdicts are TTL-cached
+    process-wide, so per-session surface goes through
+    ``model_tools._select_tool_names`` plus the handler's own refusal.
+    """
+    return _ask_document_enabled()
+
+
+def _ok(**payload: Any) -> str:
+    return json.dumps({"success": True, **payload}, ensure_ascii=False)
+
+
+def _fail(message: str) -> str:
+    from tools.registry import tool_error
+    return tool_error(message)
+
+
+def _resolve_doc_path(path: str, task_id: str = "default") -> Path:
+    """Task-aware absolute path (same anchor as read_file)."""
+    from tools.file_tools_paths import _resolve_path_for_task
+    return Path(str(_resolve_path_for_task(path, task_id)))
+
+
+def _has_binary_suffix(path: Path) -> bool:
+    from tools.binary_extensions import has_binary_extension
+    return bool(has_binary_extension(str(path)))
+
+
+def _read_text_file(path: Path, max_bytes: Optional[int] = None) -> Tuple[Optional[str], bool]:
+    """(text, limit_hit); None when binary, non-UTF-8, or unreadable.
+
+    A null byte anywhere in the examined bytes means binary and is rejected
+    before any decoding. Capped reads decode the prefix with an incremental
+    strict UTF-8 decoder, which drops a trailing incomplete sequence of any
+    length; invalid bytes always reject the file.
+    """
+    try:
+        with open(path, "rb") as f:
+            raw = f.read() if max_bytes is None else f.read(max_bytes + 1)
+    except (OSError, ValueError):
+        return None, False
+    is_eof = max_bytes is None or len(raw) <= max_bytes
+    if not is_eof:
+        raw = raw[:max_bytes]
+    if b"\x00" in raw:
+        return None, False
+    try:
+        decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
+        return decoder.decode(raw, final=is_eof), not is_eof
+    except UnicodeDecodeError:
+        return None, False
+
+
+def _byte_budget(remaining_chars: int) -> int:
+    return max(64, remaining_chars * _UTF8_MAX_BYTES_PER_CHAR + _UTF8_MAX_BYTES_PER_CHAR)
+
+
+def _load_document_text(resolved: Path, max_chars: int) -> Tuple[Optional[str], Dict[str, Any]]:
+    """(text, meta) for a file or directory; (None, meta with error) on failure.
+
+    The char cap covers the concatenated document INCLUDING ``###`` headers.
+    """
+    if not resolved.exists():
+        return None, {"error": f"ask_document: path does not exist: {resolved}"}
+    if resolved.is_file():
+        if _has_binary_suffix(resolved):
+            return None, {"error": f"ask_document: refusing binary file: {resolved}"}
+        text, _ = _read_text_file(resolved, _byte_budget(max_chars))
+        if text is None:
+            return None, {"error": f"ask_document: cannot read as text (binary or unreadable): {resolved}"}
+        truncated = len(text) > max_chars
+        if truncated:
+            text = text[:max_chars]
+        return text, {"label": str(resolved), "truncated": truncated}
+    if resolved.is_dir():
+        entries: List[Tuple[str, Path]] = []
+        for root, dirs, files in os.walk(resolved, followlinks=False):
+            for name in files:
+                full = Path(root) / name
+                entries.append((full.relative_to(resolved).as_posix(), full))
+        entries.sort(key=lambda item: item[0])
+        parts: List[str] = []
+        truncated = False
+        budget = max_chars
+        for rel, full in entries:
+            if budget <= 0:
+                truncated = True
+                break
+            if _has_binary_suffix(full):
+                continue
+            text, _ = _read_text_file(full, _byte_budget(budget))
+            if text is None:
+                continue
+            chunk = f"### {rel}\n{text}\n"
+            if len(chunk) > budget:
+                chunk = chunk[:budget]
+                truncated = True
+            parts.append(chunk)
+            budget -= len(chunk)
+            if truncated:
+                break
+        if not parts:
+            return None, {"error": f"ask_document: no readable text files under: {resolved}"}
+        return "".join(parts), {"label": str(resolved), "truncated": truncated}
+    return None, {"error": f"ask_document: not a file or directory: {resolved}"}
+
+
+def build_reader_system(document_label: str, document_text: str) -> str:
+    """Byte-identical system message for identical (label, text)."""
+    return f"{READER_SYSTEM_PREFIX}\n\n<document path={document_label}>\n{document_text}\n</document>"
+
+
+def _resolve_chat_client() -> Optional[Tuple[Any, str]]:
+    """(client, model) from the live turn-bound agent, else None (no fallback).
+
+    Only for ``chat_completions`` agents whose client exposes the OpenAI
+    ``chat.completions.create`` shape; every other mode (or no bound turn)
+    resolves to None and the handler refuses rather than silently switching
+    endpoint/profile/model.
+    """
+    from agent.subagent_lifecycle import get_active_subagent_parent
+    agent = get_active_subagent_parent()
+    if agent is None:
+        return None
+    if str(getattr(agent, "api_mode", "chat_completions") or "chat_completions") != "chat_completions":
+        return None
+    client = getattr(agent, "client", None)
+    create = getattr(getattr(getattr(client, "chat", None), "completions", None), "create", None)
+    if not callable(create):
+        return None
+    model = str(getattr(agent, "model", "") or "").strip()
+    if not model:
+        return None
+    return client, model
+
+
+def _content_to_text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for part in content:
+            if isinstance(part, str):
+                parts.append(part)
+            elif isinstance(part, dict) and isinstance(part.get("text"), str):
+                parts.append(part["text"])
+            else:
+                text = getattr(part, "text", None)
+                if isinstance(text, str):
+                    parts.append(text)
+        return "".join(parts)
+    return str(content) if content is not None else ""
+
+
+def _extract_cached_tokens(response: Any) -> Optional[int]:
+    try:
+        usage = getattr(response, "usage", None)
+        if usage is None:
+            return None
+        details = usage.get("prompt_tokens_details") if isinstance(usage, dict) else getattr(usage, "prompt_tokens_details", None)
+        if details is None:
+            return None
+        value = details.get("cached_tokens") if isinstance(details, dict) else getattr(details, "cached_tokens", None)
+        return int(value) if isinstance(value, (int, float)) and value is not None else None
+    except Exception:
+        return None
+
+
+def ask_document(path: str, question: str, max_tokens: int = DEFAULT_MAX_TOKENS,
+                 task_id: str = "default") -> str:
+    """Ask *question* about the file or directory at *path*; JSON string result."""
+    if _is_child_context():
+        return _fail("ask_document: not available to delegated children (use read_file)")
+    if not _ask_document_enabled():
+        return _fail("ask_document: disabled by configuration (ask_document.enabled=false)")
+    question = str(question or "").strip()
+    if not question:
+        return _fail("ask_document: 'question' is required")
+    if not str(path or "").strip():
+        return _fail("ask_document: 'path' is required")
+    try:
+        tokens = int(max_tokens)
+    except Exception:
+        tokens = DEFAULT_MAX_TOKENS
+    tokens = max(1, min(tokens, _MAX_TOKENS_HARD_CAP))
+
+    max_chars = _ask_document_max_chars()
+    try:
+        resolved = _resolve_doc_path(str(path).strip(), task_id)
+    except Exception as exc:
+        return _fail(f"ask_document: cannot resolve path: {exc}")
+    document_text, meta = _load_document_text(resolved, max_chars)
+    if document_text is None:
+        return _fail(str(meta.get("error") or "ask_document: cannot load document"))
+
+    resolved_client = _resolve_chat_client()
+    if resolved_client is None:
+        return _fail("ask_document: requires a chat_completions agent turn (no bound agent chat client)")
+    client, model = resolved_client
+    system = build_reader_system(str(meta["label"]), document_text)
+    try:
+        response = client.chat.completions.create(
+            model=model,
+            messages=[
+                {"role": "system", "content": system},
+                {"role": "user", "content": question},
+            ],
+            max_tokens=tokens,
+        )
+    except Exception as exc:
+        logger.warning("ask_document chat completion failed: %s", exc)
+        return _fail(f"ask_document: completion failed: {exc}")
+
+    try:
+        answer = _content_to_text(response.choices[0].message.content).strip()
+    except Exception:
+        return _fail("ask_document: malformed completion response")
+    if not answer:
+        return _fail("ask_document: empty answer from model")
+    payload: Dict[str, Any] = {"answer": answer, "model": model, "truncated": bool(meta.get("truncated", False))}
+    cached = _extract_cached_tokens(response)
+    if cached is not None:
+        payload["cached_tokens"] = cached
+    return _ok(**payload)
+
+
+ASK_DOCUMENT_SCHEMA = {
+    "name": "ask_document",
+    "description": (
+        "Ask a question about a local text file (or a directory of text files). "
+        "Reads the file as UTF-8 — a directory is concatenated in sorted order "
+        "with '### <relpath>' headers, binaries skipped, capped at the "
+        "ask_document.max_chars config — and answers from that content only via "
+        "a single same-model completion. The document prefix may stay cached "
+        "server-side, so follow-up questions on the same path can be cheap. "
+        "Use when a file is too large for the context or you need one focused "
+        "answer instead of the full text. Directory reads never include binary "
+        "files. Parent turn only: unavailable to delegated children."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "path": {
+                "type": "string",
+                "description": "File or directory to ask about (absolute, or relative to the session cwd).",
+            },
+            "question": {
+                "type": "string",
+                "description": "The question to answer from the document content.",
+            },
+            "max_tokens": {
+                "type": "integer",
+                "description": "Max answer tokens (default 800).",
+                "default": DEFAULT_MAX_TOKENS,
+            },
+        },
+        "required": ["path", "question"],
+    },
+}
+
+
+from tools.registry import registry  # noqa: E402  (registration at import time)
+
+registry.register(
+    name="ask_document",
+    toolset=ASK_DOCUMENT_TOOLSET,
+    schema=ASK_DOCUMENT_SCHEMA,
+    handler=lambda args, **kw: ask_document(
+        path=args.get("path", ""), question=args.get("question", ""),
+        max_tokens=args.get("max_tokens", DEFAULT_MAX_TOKENS),
+        task_id=kw.get("task_id") or "default"),
+    check_fn=check_ask_document_requirements,
+    emoji="📄")
