+def _defer_flush() -> bool:
+    """True while a process-wide subscriber flush could deadlock.
+
+    Two cases, same wait cycle: (a) a delegate_task child worker whose parent
+    waits in ``await_child``; (b) ANY thread inside a managed Relay callback
+    (``agent.relay_runtime.in_managed_callback``) — the native pipeline binds
+    its Futures to the outer call's loop, blocked inside the synchronous
+    callback, so a flush waiting on queued callbacks waits on the callback
+    itself. Case (b) covers the parent thread while ``await_child`` or the
+    parent-thread ``subagent_stop`` child-session close is still on the stack.
+    Lazy imports: this module is reached from lifecycle-hook paths where eager
+    agent imports would be a needless cycle risk. Fail-closed (no deferral) so
+    a broken probe can never silently stop metrics.
+    """
+    try:
+        from agent.delegation_context import is_delegated_child_context
+        if is_delegated_child_context():
+            return True
+    except Exception:
+        pass
+    try:
+        from agent.relay_runtime import in_managed_callback
+        return bool(in_managed_callback())
+    except Exception:
+        return False
+
+
