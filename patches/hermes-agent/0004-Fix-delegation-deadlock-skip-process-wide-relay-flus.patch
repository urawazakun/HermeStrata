index a204ec5b..fe6ef8b3 100644
--- a/agent/relay_runtime.py
+++ b/agent/relay_runtime.py
@@ -847,6 +847,23 @@ def managed_callback_guard():
         _MANAGED_CALLBACK_DEPTH.reset(token)
 
 
+def in_managed_callback() -> bool:
+    """True while the current context runs inside a managed Relay callback.
+
+    Telemetry uses this to avoid process-wide ``subscribers.flush()`` there: the
+    native pipeline binds its Futures to the outer call's loop, which is blocked
+    inside the synchronous callback, so a flush that waits on queued callbacks
+    can deadlock (delegation: the parent waits in ``await_child`` while the
+    callback is still on the stack, and the child already skipped its flush).
+    Queued events are drained by the parent task finish / teardown after the
+    callback returns instead.
+    """
+    try:
+        return _MANAGED_CALLBACK_DEPTH.get() > 0
+    except Exception:
+        return False
+
+
