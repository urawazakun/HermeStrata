diff --git a/tests/hermes_cli/test_relay_shared_metrics_delegate_deadlock.py b/tests/hermes_cli/test_relay_shared_metrics_delegate_deadlock.py
new file mode 100644
index 00000000..fb16c3b8
--- /dev/null
+++ b/tests/hermes_cli/test_relay_shared_metrics_delegate_deadlock.py
@@ -0,0 +1,78 @@
+"""Delegation-deadlock guard: no process-wide subscriber flush while a managed
+Relay callback is on the stack or on a delegated child worker.
+
+``subscribers.flush()`` waits on ALL queued callbacks process-wide, which can
+need the loop blocked inside the current synchronous callback: the child
+worker (parent waits in ``await_child``) and the parent thread itself (still
+inside the tool callback in ``await_child`` / the ``subagent_stop`` close).
+Skipped flushes lose nothing: events stay queued and drain at the parent task
+finish / teardown after the callback returns.
+"""
+
+from __future__ import annotations
+
+import threading
+from types import SimpleNamespace
+
+from agent.delegation_context import delegated_child_context
+from agent.relay_runtime import in_managed_callback, managed_callback_guard
+from hermes_cli.observability.relay_shared_metrics import _Runtime, _defer_flush
+
+
+def _bare_runtime(monkeypatch, flush, on_export):
+    """A _Runtime without __init__ (no disk, no atexit, no real Relay)."""
+    runtime = object.__new__(_Runtime)
+    runtime.relay = SimpleNamespace(subscribers=SimpleNamespace(flush=flush))
+    monkeypatch.setattr(runtime, "_export", on_export)
+    return runtime
+
+
+def test_no_deferral_on_healthy_path():
+    assert in_managed_callback() is False
+    assert _defer_flush() is False
+
+
+def test_child_worker_defers_flush(monkeypatch):
+    calls: list[str] = []
+    runtime = _bare_runtime(
+        monkeypatch, lambda: calls.append("flush"), lambda: calls.append("export")
+    )
+    with delegated_child_context("child-sess"):
+        assert _defer_flush() is True
+        runtime._flush_and_export("task flush failed")
+    assert calls == []
+
+
+def test_in_callback_defers_flush_and_close_still_forgets(monkeypatch):
+    from hermes_cli.observability.relay_shared_metrics import _MetricsSession
+
+    calls: list[str] = []
+    runtime = _bare_runtime(
+        monkeypatch, lambda: calls.append("flush"), lambda: calls.append("export")
+    )
+    runtime._sessions_lock = threading.RLock()
+    session = _MetricsSession(
+        session_id="child-sess",
+        relay_session=SimpleNamespace(handle=None, context=None),
+    )
+    runtime._sessions = {"child-sess": session}
+
+    with managed_callback_guard():
+        assert _defer_flush() is True
+        runtime._flush_and_export("task flush failed")
+        # Parent-thread ``subagent_stop`` close of the child session: abort +
+        # forget now, drain later.
+        runtime.close_session({"session_id": "child-sess"})
+
+    assert calls == []
+    assert runtime._sessions == {}
+    assert session.closing is True
+
+
+def test_outside_callback_flush_and_export_proceed(monkeypatch):
+    calls: list[str] = []
+    runtime = _bare_runtime(
+        monkeypatch, lambda: calls.append("flush"), lambda: calls.append("export")
+    )
+    runtime._flush_and_export("task flush failed")
+    assert calls == ["flush", "export"]
