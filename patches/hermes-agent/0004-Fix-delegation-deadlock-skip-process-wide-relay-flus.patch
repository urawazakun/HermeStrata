@@ -0,0 +1,317 @@
+"""Tests for the ask_document tool (Goal 2, CELL-A).
+
+All LLM traffic uses a fake OpenAI-shaped client on a turn-bound agent double
+(``bind_subagent_parent``) — no network, no credentials, no fallback client.
+File loading, registration, config gating and child exclusion are exercised
+through the real registry/toolset code paths.
+"""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+import tools.ask_document_tool as ad
+from tools.registry import registry
+
+
+class _FakeCompletions:
+    def __init__(self, owner):
+        self._owner = owner
+
+    def create(self, **kwargs):
+        self._owner.calls.append(kwargs)
+        return self._owner.response
+
+
+class _FakeChat:
+    def __init__(self, owner):
+        self.completions = _FakeCompletions(owner)
+
+
+class FakeClient:
+    """OpenAI-shaped fake: records create() kwargs, returns a canned response."""
+
+    def __init__(self, answer="the answer", cached_tokens=None):
+        self.calls = []
+        self.chat = _FakeChat(self)
+        message = SimpleNamespace(content=answer)
+        usage = None
+        if cached_tokens is not None:
+            usage = SimpleNamespace(
+                prompt_tokens=100, completion_tokens=10, total_tokens=110,
+                prompt_tokens_details=SimpleNamespace(cached_tokens=cached_tokens))
+        self.response = SimpleNamespace(choices=[SimpleNamespace(message=message)], usage=usage)
+
+
+@pytest.fixture
+def bound_client():
+    """Fake client on a bound chat_completions agent (the production path)."""
+    from agent.subagent_lifecycle import bind_subagent_parent
+    client = FakeClient()
+    agent = SimpleNamespace(api_mode="chat_completions", model="test-model", client=client)
+    with bind_subagent_parent(agent):
+        yield client
+
+
+@pytest.fixture
+def doc_file(tmp_path):
+    target = tmp_path / "notes.md"
+    target.write_text("# Notes\n\nThe sky cipher is BLUE.\n", encoding="utf-8")
+    return target
+
+
+def _payload(raw):
+    data = json.loads(raw)
+    assert isinstance(data, dict)
+    return data
+
+
+def _system_of(client):
+    assert len(client.calls) == 1
+    return client.calls[0]["messages"][0]["content"]
+
+
+class TestReaderCall:
+    def test_answer_returned(self, bound_client, doc_file):
+        data = _payload(ad.ask_document(str(doc_file), "What is the cipher?"))
+        assert data["success"] is True
+        assert data["answer"] == "the answer"
+        assert data["model"] == "test-model"
+        assert data["truncated"] is False
+        assert "cached_tokens" not in data
+
+    def test_cached_tokens_surfaced(self, bound_client, tmp_path):
+        bound_client.response = FakeClient(cached_tokens=1234).response
+        target = tmp_path / "d.md"
+        target.write_text("content here", encoding="utf-8")
+        data = _payload(ad.ask_document(str(target), "q?"))
+        assert data["cached_tokens"] == 1234
+
+    def test_plain_completion_shape(self, bound_client, doc_file):
+        ad.ask_document(str(doc_file), "Q?")
+        assert len(bound_client.calls) == 1
+        kwargs = bound_client.calls[0]
+        assert kwargs["model"] == "test-model"
+        assert set(kwargs) == {"model", "messages", "max_tokens"}
+        messages = kwargs["messages"]
+        assert [m["role"] for m in messages] == ["system", "user"]
+        assert messages[1]["content"] == "Q?"
+        assert "<document path=" in messages[0]["content"]
+        assert "The sky cipher is BLUE." in messages[0]["content"]
+        assert "</document>" in messages[0]["content"]
+
+    def test_system_bytes_identical_across_questions(self, bound_client, doc_file):
+        ad.ask_document(str(doc_file), "First question?")
+        ad.ask_document(str(doc_file), "Second question?")
+        first, second = bound_client.calls
+        assert first["messages"][0]["content"] == second["messages"][0]["content"]
+        assert isinstance(first["messages"][0]["content"], str)
+        assert first["messages"][1]["content"] != second["messages"][1]["content"]
+
+    def test_resolve_uses_bound_client_and_model(self, bound_client):
+        resolved = ad._resolve_chat_client()
+        assert resolved is not None
+        assert resolved[0] is bound_client
+        assert resolved[1] == "test-model"
+
+    def test_empty_question_is_error(self, bound_client, doc_file):
+        data = _payload(ad.ask_document(str(doc_file), "   "))
+        assert "error" in data
+        assert bound_client.calls == []
+
+    def test_missing_path_is_error(self, bound_client, tmp_path):
+        data = _payload(ad.ask_document(str(tmp_path / "nope.md"), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+
+class TestClientRequirement:
+    def test_unbound_context_refused_without_network(self, doc_file):
+        assert ad._resolve_chat_client() is None
+        data = _payload(ad.ask_document(str(doc_file), "Q?"))
+        assert "error" in data
+        assert "no bound agent chat client" in data["error"]
+
+    def test_non_chat_mode_refused_no_fallback(self, doc_file):
+        from agent.subagent_lifecycle import bind_subagent_parent
+        decoy = FakeClient()
+        agent = SimpleNamespace(api_mode="codex_responses", model="codex-model", client=decoy)
+        with bind_subagent_parent(agent):
+            assert ad._resolve_chat_client() is None
+            data = _payload(ad.ask_document(str(doc_file), "Q?"))
+        assert "error" in data
+        assert decoy.calls == []
+
+    def test_registry_dispatch_uses_bound_client(self, doc_file):
+        from agent.subagent_lifecycle import bind_subagent_parent
+        client = FakeClient()
+        agent = SimpleNamespace(api_mode="chat_completions", model="bound-model", client=client)
+        with bind_subagent_parent(agent):
+            data = _payload(registry.dispatch(
+                "ask_document", {"path": str(doc_file), "question": "Q?"},
+                task_id="default"))
+        assert data["success"] is True
+        assert data["model"] == "bound-model"
+        assert len(client.calls) == 1
+
+
+class TestDocumentLoading:
+    def test_directory_global_sorted_order(self, bound_client, tmp_path):
+        root = tmp_path / "docs"
+        (root / "sub").mkdir(parents=True)
+        (root / "b.txt").write_text("B-body", encoding="utf-8")
+        (root / "sub" / "c.txt").write_text("C-body", encoding="utf-8")
+        (root / "a" / "z.txt").parent.mkdir(parents=True)
+        (root / "a" / "z.txt").write_text("Z-body", encoding="utf-8")
+        data = _payload(ad.ask_document(str(root), "Q?"))
+        assert data["success"] is True
+        system = _system_of(bound_client)
+        ia, ib, ic = (system.index("### a/z.txt"), system.index("### b.txt"),
+                      system.index("### sub/c.txt"))
+        assert ia < ib < ic
+
+    def test_binary_files_skipped(self, bound_client, tmp_path):
+        root = tmp_path / "docs"
+        root.mkdir()
+        (root / "good.txt").write_text("good-body", encoding="utf-8")
+        (root / "evil.txt").write_bytes(b"abc\x00def")
+        (root / "img.png").write_bytes(b"\x89PNG\r\n\x1a\n" + b"\x00" * 64)
+        data = _payload(ad.ask_document(str(root), "Q?"))
+        assert data["success"] is True
+        system = _system_of(bound_client)
+        assert "good-body" in system
+        assert "img.png" not in system
+        assert "evil.txt" not in system
+
+    def test_non_utf8_bytes_are_binary(self, bound_client, tmp_path):
+        target = tmp_path / "random.bin.txt"
+        target.write_bytes(bytes(range(128, 256)) * 4)
+        data = _payload(ad.ask_document(str(target), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+    def test_single_binary_refused(self, bound_client, tmp_path):
+        target = tmp_path / "img.png"
+        target.write_bytes(b"\x89PNG\r\n\x1a\n" + b"\x00" * 64)
+        data = _payload(ad.ask_document(str(target), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+    def test_size_cap_covers_headers(self, bound_client, tmp_path, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_max_chars", lambda: 60)
+        root = tmp_path / "docs"
+        root.mkdir()
+        (root / "a.txt").write_text("A" * 50, encoding="utf-8")
+        (root / "b.txt").write_text("B" * 50, encoding="utf-8")
+        data = _payload(ad.ask_document(str(root), "Q?"))
+        assert data["success"] is True
+        assert data["truncated"] is True
+        system = _system_of(bound_client)
+        doc = system.split("<document path=", 1)[1].split(">\n", 1)[1].rsplit("\n</document>", 1)[0]
+        assert len(doc) == 60
+        assert "truncated to max_chars" not in system
+
+    def test_large_file_bounded_and_truncated(self, bound_client, tmp_path, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_max_chars", lambda: 100)
+        target = tmp_path / "big.txt"
+        target.write_text("x" * 5000, encoding="utf-8")
+        data = _payload(ad.ask_document(str(target), "Q?"))
+        assert data["success"] is True
+        assert data["truncated"] is True
+        system = _system_of(bound_client)
+        doc = system.split("<document path=", 1)[1].split(">\n", 1)[1].rsplit("\n</document>", 1)[0]
+        assert doc == "x" * 100
+
+    def test_capped_nul_rejected(self, bound_client, tmp_path, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_max_chars", lambda: 100)
+        target = tmp_path / "bin.txt"
+        target.write_bytes(b"A" * 50 + b"\x00" + b"B" * 5000)
+        data = _payload(ad.ask_document(str(target), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+    def test_partial_4byte_boundary_dropped(self, tmp_path):
+        target = tmp_path / "emoji.txt"
+        target.write_bytes(b"B" * 401 + "😀".encode("utf-8") + b"D" * 100)
+        text, limit_hit = ad._read_text_file(target, 404)
+        assert limit_hit is True
+        assert text == "B" * 401
+
+    def test_invalid_bytes_near_boundary_rejected(self, bound_client, tmp_path):
+        target = tmp_path / "bad.txt"
+        target.write_bytes(b"B" * 400 + b"\xff" + b"D" * 100)
+        assert ad._read_text_file(target, 404)[0] is None
+        data = _payload(ad.ask_document(str(target), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+    def test_empty_directory_is_error(self, bound_client, tmp_path):
+        root = tmp_path / "empty"
+        root.mkdir()
+        data = _payload(ad.ask_document(str(root), "Q?"))
+        assert "error" in data
+        assert bound_client.calls == []
+
+
+class TestRegistrationAndGating:
+    def test_registered_in_own_toolset(self):
+        assert registry.get_toolset_for_tool("ask_document") == "ask_document"
+
+    def test_exposed_in_core_bundle(self):
+        from toolsets import _HERMES_CORE_TOOLS, resolve_toolset
+        assert "ask_document" in _HERMES_CORE_TOOLS
+        assert "ask_document" in resolve_toolset("hermes-cli")
+
+    def test_schema_excluded_for_delegated_child(self):
+        from agent.delegation_context import delegated_child_context
+        from model_tools import get_tool_definitions
+
+        def names():
+            return [t["function"]["name"] for t in get_tool_definitions(
+                enabled_toolsets=["ask_document"], quiet_mode=True)]
+
+        assert "ask_document" in names()
+        with delegated_child_context("child-session"):
+            assert "ask_document" not in names()
+        assert "ask_document" in names()
+
+    def test_child_dispatch_refused(self, tmp_path):
+        from agent.delegation_context import delegated_child_context
+        from agent.subagent_lifecycle import bind_subagent_parent
+        target = tmp_path / "d.md"
+        target.write_text("content here", encoding="utf-8")
+        client = FakeClient()
+        agent = SimpleNamespace(api_mode="chat_completions", model="m", client=client)
+        with bind_subagent_parent(agent), delegated_child_context("child-session"):
+            data = _payload(registry.dispatch(
+                "ask_document", {"path": str(target), "question": "Q?"},
+                task_id="default"))
+        assert "error" in data
+        assert "delegated children" in data["error"]
+        assert client.calls == []
+
+    def test_check_fn_defaults_enabled(self, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_section", lambda: {})
+        assert ad.check_ask_document_requirements() is True
+
+    def test_check_fn_respects_disabled(self, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_section", lambda: {"enabled": False})
+        assert ad.check_ask_document_requirements() is False
+
+    def test_handler_enforces_disabled(self, tmp_path, monkeypatch):
+        from agent.subagent_lifecycle import bind_subagent_parent
+        monkeypatch.setattr(ad, "_ask_document_section", lambda: {"enabled": False})
+        target = tmp_path / "d.md"
+        target.write_text("content here", encoding="utf-8")
+        client = FakeClient()
+        agent = SimpleNamespace(api_mode="chat_completions", model="m", client=client)
+        with bind_subagent_parent(agent):
+            data = _payload(ad.ask_document(str(target), "Q?"))
+        assert "error" in data
+        assert "disabled" in data["error"]
+        assert client.calls == []
+
+    def test_max_chars_config_respected(self, monkeypatch):
+        monkeypatch.setattr(ad, "_ask_document_section", lambda: {"max_chars": 123})
+        assert ad._ask_document_max_chars() == 123
