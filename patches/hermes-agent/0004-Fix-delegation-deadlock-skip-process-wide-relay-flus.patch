@@ -0,0 +1,197 @@
+"""Delegation deadlock end-to-end: real ``_ChildRun.await_child`` driven inside a
+blocked asyncio callback, with a fake subscriber queue that needs the callback
+to return.
+
+The loop thread runs the tool callback synchronously (as the native Relay
+pipeline does in ``relay_tools.invoke``); the child worker emits its task
+finish there. ``flush()`` schedules a no-op on the loop and waits for it, so
+any synchronous flush before the callback returns wedges: on regression the
+fake raises instead of hanging the suite. After the callback returns, the
+parent task finish drains the queued events.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextvars
+import threading
+import time
+from types import SimpleNamespace
+
+from agent.relay_runtime import managed_callback_guard
+from hermes_cli.observability.relay_shared_metrics import (
+    _MetricsSession,
+    _Runtime,
+    _TaskRun,
+)
+from tools import delegate_tool, delegate_tool_child_run
+
+
+def _fake_relay(order: list[str], loop: asyncio.AbstractEventLoop):
+    relay = SimpleNamespace()
+
+    def needs_loop_flush() -> None:
+        # Models _native_flush waiting on a callback bound to the loop that is
+        # blocked inside the synchronous tool callback: it cannot proceed
+        # until the callback returns.
+        order.append("flush_entered")
+        done = threading.Event()
+        loop.call_soon_threadsafe(done.set)
+        assert done.wait(timeout=10), (
+            "subscriber flush waited on the loop blocked in the tool callback: deadlock"
+        )
+        order.append("flushed")
+
+    relay.subscribers = SimpleNamespace(flush=needs_loop_flush)
+    relay.get_scope_stack = lambda: order.append("scope_sync")
+    relay.scope = SimpleNamespace(
+        push=lambda *a, **k: order.append("scope_push"),
+        pop=lambda handle, **kwargs: order.append("scope_pop"),
+    )
+    return relay
+
+
+def _bare_runtime(relay, on_export) -> _Runtime:
+    runtime = object.__new__(_Runtime)
+    runtime.relay = relay
+    runtime.host = SimpleNamespace(runtime_id="deadlock-test")
+    runtime._export = on_export
+    runtime._sessions_lock = threading.RLock()
+    runtime._task_sessions_lock = threading.RLock()
+    runtime._sessions = {}
+    runtime._task_sessions = {}
+    runtime._turn_sessions = {}
+    return runtime
+
+
+def _register_task(runtime: _Runtime, session_id: str, task_id: str) -> None:
+    relay_session = SimpleNamespace(handle=(session_id, "scope"), context=contextvars.copy_context())
+    session = _MetricsSession(session_id=session_id, relay_session=relay_session)
+    session.tasks[task_id] = _TaskRun(
+        task_id=task_id,
+        handle=(session_id, task_id),
+        context=contextvars.copy_context(),
+        started_ns=time.monotonic_ns(),
+        start_fields={},
+    )
+    runtime._sessions[session_id] = session
+    runtime._task_sessions[(session_id, task_id)] = session
+
+
+class _DelegatingChild:
+    """Child whose turn finish emits the real metrics task hook on the worker."""
+
+    def __init__(self, runtime: _Runtime) -> None:
+        self._runtime = runtime
+        self.session_id = "child-sess"
+        self._fork_conversation_history = None
+
+    def run_conversation(self, **_kwargs):
+        self._runtime.finish_task(
+            {
+                "session_id": "child-sess",
+                "task_id": "child-task",
+                "platform": "cli",
+                "completed": True,
+            }
+        )
+        return {"final_response": "done", "completed": True, "api_calls": 1, "messages": []}
+
+
+def test_await_child_inside_blocked_callback_defers_flush(monkeypatch):
+    order: list[str] = []
+    loop = asyncio.new_event_loop()
+    relay = _fake_relay(order, loop)
+    runtime = _bare_runtime(relay, lambda: order.append("exported"))
+    _register_task(runtime, "child-sess", "child-task")
+    _register_task(runtime, "parent-sess", "parent-task")
+
+    monkeypatch.setattr(delegate_tool, "_get_child_timeout", lambda: None)
+    monkeypatch.setattr(delegate_tool, "_get_subagent_approval_callback", lambda: None)
+    monkeypatch.setattr(delegate_tool, "_set_subagent_approval_cb", lambda _cb: None)
+    run = delegate_tool_child_run._ChildRun(
+        child=_DelegatingChild(runtime),
+        parent_agent=SimpleNamespace(session_id="parent-sess", _current_task_id=None),
+        task_index=0,
+        goal="return quickly",
+        subagent_id=None,
+        child_progress_cb=None,
+    )
+    run.child_task_id = "child-task"
+
+    async def tool_callback():
+        # Synchronous tool execution on the loop thread, as relay_tools.invoke
+        # dispatches it: the loop cannot run anything else until this returns.
+        with managed_callback_guard():
+            result = run.await_child()
+            order.append("await_returned")
+            # Parent-thread ``subagent_stop`` close of the child session, still
+            # inside the callback: must abort + forget without flushing.
+            runtime.close_session({"session_id": "child-sess"})
+            order.append("stop_close_done")
+            return result
+
+    try:
+        result, error_entry, close_deferred = loop.run_until_complete(tool_callback())
+    finally:
+        loop.close()
+    order.append("callback_exited")
+
+    assert error_entry is None and close_deferred is False
+    assert result is not None and result["final_response"] == "done"
+    assert "flush_entered" not in order, (
+        "no synchronous flush may run before the tool callback returns"
+    )
+    assert runtime._sessions.get("child-sess") is None, "child session must be forgotten"
+    assert order.index("await_returned") < order.index("callback_exited")
+
+    # After the callback returns the loop is free: the parent task finish
+    # drains everything the child left queued.
+    relay.subscribers.flush = lambda: order.append("flushed")
+    runtime.finish_task(
+        {
+            "session_id": "parent-sess",
+            "task_id": "parent-task",
+            "platform": "cli",
+            "completed": True,
+        }
+    )
+    assert order.index("callback_exited") < order.index("flushed")
+    assert order.index("flushed") < order.index("exported")
+
+
+def test_await_child_survives_metrics_hook_failure(monkeypatch):
+    monkeypatch.setattr(delegate_tool, "_get_child_timeout", lambda: None)
+    monkeypatch.setattr(delegate_tool, "_get_subagent_approval_callback", lambda: None)
+    monkeypatch.setattr(delegate_tool, "_set_subagent_approval_cb", lambda _cb: None)
+
+    class _QuickChild:
+        session_id = "child-flush-test"
+        _fork_conversation_history = None
+
+        def run_conversation(self, **_kwargs):
+            raise RuntimeError("metrics hook exploded")
+
+    run = delegate_tool_child_run._ChildRun(
+        child=_QuickChild(),
+        parent_agent=SimpleNamespace(session_id="parent-sess", _current_task_id=None),
+        task_index=0,
+        goal="return quickly",
+        subagent_id=None,
+        child_progress_cb=None,
+    )
+    run.child_task_id = "child-task"
+
+    loop = asyncio.new_event_loop()
+    try:
+        _result, error_entry, _ = loop.run_until_complete(
+            _await_in_callback(run),
+        )
+    finally:
+        loop.close()
+    assert error_entry is not None and error_entry["status"] == "error"
+
+
+async def _await_in_callback(run) -> tuple:
+    with managed_callback_guard():
+        return run.await_child()
