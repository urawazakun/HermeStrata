+    def test_concurrent_repairs_stay_bounded_and_parseable(self):
+        svc, log = self.bare(capacity=8)
+        svc.keeper_remember([{"role": "system", "content": self.system()},
+                             {"role": "user", "content": "seed"}], None, {})
+        errors = []
+
+        def repair_work(n):
+            try:
+                for i in range(5):
+                    svc.keeper_repair(
+                        [{"role": "system",
+                          "content": self.system(volatile=f"77 untracked t{n}")},
+                         {"role": "user", "content": "seed"},
+                         {"role": "user", "content": f"t{n}-{i}"}], None, {})
+            except Exception as e:  # noqa: BLE001 - thread failures are collected and raised on the main thread
+                errors.append(e)
+
+        def run_all(work):
+            threads = [threading.Thread(target=work, args=(n,)) for n in range(4)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join(30)
+
+        _, err = self.capture(lambda: run_all(repair_work))
+        self.assertEqual(errors, [])
+        rows = self.jsonl(log)
+        self.assertEqual(len([r for r in rows if r["kind"] == "system-delta"]), 20)  # every repair logged ...
+        for row in rows:                                                              # ... as a parseable row
+            self.assertEqual(set(row), {"req", "kind", "index", "before_bytes", "after_bytes", "diff"})
+        self.assertNotIn("keeper error", err)
+
+        def remember_work(n):
+            try:
+                for i in range(5):
+                    svc.keeper_remember([{"role": "user", "content": f"w{n}-{i}"}], None, {})
+            except Exception as e:  # noqa: BLE001 - as above
+                errors.append(e)
+
+        self.capture(lambda: run_all(remember_work))
+        self.assertEqual(errors, [])
+        self.assertLessEqual(len(svc.keeper.entries), 8)      # distinct remembers stay bounded
+        for row in self.jsonl(log):
+            self.assertEqual(set(row), {"req", "kind", "index", "before_bytes", "after_bytes", "diff"})
