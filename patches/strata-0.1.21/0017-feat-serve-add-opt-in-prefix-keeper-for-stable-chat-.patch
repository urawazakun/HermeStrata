+
+    @staticmethod
+    def _build(e: dict, plan: dict, messages: list) -> tuple:
+        """Assemble the forwarded list: stored bytes verbatim for match/shorten/restore (exactly what the engine
+        cached, earlier injected blocks included - never reworded or dropped), the request's own messages for
+        appends. A fresh delta block goes ONLY on an actually appended last message (copied first, so the
+        requester's objects are never altered), with `_keeper_injected` provenance recording its raw+suffix; the
+        caller keeps repairs without an appended message out of here. -> (repaired, first restored index or -1).
+        Non-ok verdicts only ever append (never resurrect)."""
+        S = e["messages"]
+        off = 1 if plan["sys"] else 0
+        hist = S[off:]
+        out = []
+        if plan["sys"]:
+            out.append(copy.deepcopy(S[0]))
+        first = -1
+        for op in plan["ops"]:
+            kind = op[0]
+            if kind == "append":
+                msg = messages[off + op[1]]
+                out.append(msg if plan["verdict"] == "ok" else copy.deepcopy(msg))
+            elif plan["verdict"] == "ok":
+                if kind != "match" and first < 0:
+                    first = len(out)
+                elif kind == "match" and first < 0 and hist[op[1]] != messages[off + op[2]]:
+                    first = len(out)      # provenance-alias substitution restores injected text: a repair
+                out.append(copy.deepcopy(hist[op[1]]))
+            # else: an unrelated verdict never resurrects stored messages
+        if plan["deltas"] and out and plan["ops"] and plan["ops"][-1][0] == "append":
+            # A fresh delta block goes ONLY on an actually appended last message. An exact repeat (stored
+            # bytes already carry the identical delta) forwards unchanged - never a stacked second block.
+            last = copy.deepcopy(out[-1])
+            raw = last.get("content") if isinstance(last.get("content"), str) else ""
+            suffix = KEEPER_TAG + "\n".join(plan["deltas"])
+            last["content"] = raw + suffix
+            last["_keeper_injected"] = {"raw": raw, "suffix": suffix}
+            out[-1] = last
+        return out, first
+
+    def _budget_ok(self, svc, repaired: list, tools, kw: dict, req_id: str, before: int, after: int) -> bool:
+        """Budget gate for a repair, estimated with the server's own template+tokenizer (never vision: multimodal
+        never reaches here). True proceeds; False already logged (skip-budget when over, mutation-unrepaired
+        when estimation itself fails) and the caller forwards the original unchanged - never fail-open."""
+        try:
+            n = len(svc.tok.encode(svc.template.render(repaired, tools=tools, **kw), parse_special=True))
+        except Exception as e:
+            self._log(svc, "mutation-unrepaired", req_id, 0, before, after,
+                      f"budget estimate failed ({str(e)[:120]})")
+            return False
+        if n > svc.engine.max_context - KEEPER_RESERVE:
+            self._log(svc, "skip-budget", req_id, 0, before, after,
+                      f"prompt exceeds max_context-{KEEPER_RESERVE}")
+            return False
+        return True
+
+    def remember(self, messages: list, tools, kw: dict) -> None:
+        """Cache a successfully prepared/forwarded request (deep copy; failed validation never reaches here).
+        Multimodal requests are never cached."""
+        if any(isinstance(m.get("content"), list) for m in messages):
+            return
+        try:
+            entry = {"messages": copy.deepcopy(messages), "tools": copy.deepcopy(tools),
+                     "kw": copy.deepcopy(kw)}
+        except Exception:
+            return
+        with self.lock:
+            self.entries[uuid.uuid4().hex] = entry
+            while len(self.entries) > self.capacity:
+                self.entries.popitem(last=False)
+
+    def _log_file(self, svc):
+        """prefix-keeper.jsonl next to the engine log, or the explicit override, or None (e.g. the mock engine
+        has no log file: stderr only, by design)."""
+        if self.log_path:
+            return self.log_path
+        lp = getattr(getattr(svc, "engine", None), "log_path", None)
+        if not lp:
+            return None
+        try:
+            return str(Path(lp).parent / "prefix-keeper.jsonl")
+        except Exception:
+            return None
+
+    def _log(self, svc, kind: str, req_id: str, index: int, before: int, after: int, diff: str) -> None:
+        """One stderr line plus one JSONL row per event (index: system-delta 0, history-restore first restored
+        forwarded index, mutation-unrepaired divergence index in the received request, skip-budget 0). The diff
+        is bounded; CR/LF are escaped so one event is always one stderr line."""
+        diff = (diff or "")[:KEEPER_DIFF_CHARS]
+        line = (f"strata serve: keeper {kind} msg={index} req={req_id} bytes={before}->{after} {diff}"
+                .replace("\r", "\\r").replace("\n", "\\n"))
+        with self.log_lock:
+            print(line, file=sys.stderr, flush=True)
+            path = self._log_file(svc)
+            if path is None:
+                return
+            try:
+                with open(path, "a", encoding="utf-8") as f:
+                    f.write(json.dumps({"req": req_id, "kind": kind, "index": index, "before_bytes": before,
+                                        "after_bytes": after, "diff": diff}, ensure_ascii=False) + "\n")
+            except OSError as e:
+                print(f"strata serve: keeper log unavailable ({e})", file=sys.stderr, flush=True)
