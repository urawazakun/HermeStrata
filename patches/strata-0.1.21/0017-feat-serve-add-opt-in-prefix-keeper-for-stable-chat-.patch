+def _keeper_openai_request(req: dict) -> tuple:
+    """openai_to_messages + id annotation (server-only; the template ignores the extra keys). Assistant tool
+    calls keep their `id`, tool messages keep `tool_call_id`. Mapping is 1:1 with the raw messages."""
+    messages, tools, kw = openai_to_messages(req)
+    try:
+        for norm, raw in zip(messages, req.get("messages", [])):
+            if not isinstance(raw, dict):
+                continue
+            tcs, rtcs = norm.get("tool_calls"), raw.get("tool_calls")
+            if tcs and isinstance(rtcs, list):
+                for tc, rtc in zip(tcs, rtcs):
+                    if isinstance(rtc, dict) and rtc.get("id") is not None:
+                        tc["id"] = rtc["id"]
+            if norm.get("role") == "tool" and raw.get("tool_call_id") is not None:
+                norm["tool_call_id"] = raw["tool_call_id"]
+    except Exception:
+        pass
+    for m in messages:
+        if isinstance(m, dict):
+            m.pop("_keeper_injected", None)   # clients can never mint keeper provenance
+    return messages, tools, kw
+
+
+def _keeper_anthropic_request(req: dict) -> tuple:
+    """anthropic_to_messages + id annotation (server-only). tool_use blocks keep `id` on their call, tool_result
+    blocks keep `tool_use_id` on their message. The cursor mirrors anthropic_to_messages' block splitting."""
+    messages, tools, kw = anthropic_to_messages(req)
+    try:
+        cur = 1 if req.get("system") else 0
+        for raw in req.get("messages", []):
+            content = raw.get("content") if isinstance(raw, dict) else None
+            if isinstance(content, str) or (raw.get("role") == "user" and _has_image(content) and not any(
+                    isinstance(b, dict) and b.get("type") == "tool_result" for b in content)):
+                cur += 1
+                continue
+            blocks = content if isinstance(content, list) else []
+            for b in blocks:
+                if isinstance(b, dict) and b.get("type") == "tool_result" and cur < len(messages):
+                    tid = b.get("tool_use_id") or b.get("id")
+                    if tid:
+                        messages[cur]["tool_call_id"] = tid
+                    cur += 1
+            uses = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_use"]
+            text = "".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
+            think = "".join(b.get("thinking", "") for b in blocks
+                            if isinstance(b, dict) and b.get("type") == "thinking")
+            if (text or uses or think) and cur < len(messages):
+                for tc, u in zip(messages[cur].get("tool_calls") or [], uses):
+                    if u.get("id"):
+                        tc["id"] = u["id"]
+                cur += 1
+    except Exception:
+        pass
+    for m in messages:
+        if isinstance(m, dict):
+            m.pop("_keeper_injected", None)   # clients can never mint keeper provenance
+    return messages, tools, kw
+
+
+# ------------------------------------------------------------------------------------------------ prefix keeper
+# `--prefix-keeper` (also STRATA_PREFIX_KEEPER=1), default OFF: keep every forwarded chat request append-only so
+# the engine's conversation cache keeps resuming its tip instead of restarting cold (`resume from none`).
+# Motivated by Hermes' volatile system tail (workspace git snapshot, breaks the root every session) and history
+# pruning (a forked child's return once shortened its parent 19521 -> 17603 tokens). The keeper stores the last
+# N forwarded requests (messages + tools + template kwargs, deep-copied, bounded LRU) and repairs each new
+# non-aux request on either endpoint, streaming or not, before `prepare` (aux bypasses entirely; repair runs
+# after the MCP merge against the actually forwarded tools):
+#   system: a stored system message under the same tools[], differing only in volatile lines (<= 8 changed
+#     lines AND <= 5% of its stored lines), is sent unchanged, with `- old` / `+ new` pairs appended to the END
+#     of the last message as `\n\n[context update]\n...` (full lines; also across sessions, prior conversation
+#     untouched). Bigger rewrites with related history are logged mutations, never silent.
+#   history: removed/shortened earlier messages (truncations, same-identity summaries) are re-inserted so the
+#     request is exactly stored + appended - but only when the repaired prompt, rendered with the server's own
+#     template and tokenizer, still fits max_context - 8192 tokens, else Hermes' version goes unchanged.
+# Anything else (reordered/changed messages or calls, changed tools) forwards unchanged and atomic (then even
+# the system is left alone), with a mutation logged. Every repair and detected non-append mutation logs one
+# stderr line (`strata serve: keeper <kind> msg=<i> ...`, CR/LF escaped) plus one JSON row in
+# `prefix-keeper.jsonl` next to the engine log (request id, kind, index, UTF-8 bytes before/after, bounded short
+# diff - never full prompts); both sinks serialize on one lock, and engines without a log file (mock) log to
+# stderr only. Repairs reuse stored-message bytes verbatim and never mutate the requester's objects, so the
+# forwarded prefix is exactly what the engine cached - including stale `[context update]` blocks mid-history,
+# which is what lets the NEXT turn align (Hermes never sees our blocks; each injected block carries
+# `_keeper_injected` provenance with its raw text, matched explicitly - client text resembling the tag is never
+# stripped, on either side). Multimodal (list-content) requests bypass the keeper entirely, so estimating a
+# repair never touches the vision encoder or GPU.
+KEEPER_CAPACITY = 32            # last forwarded requests kept (STRATA_PREFIX_KEEPER_CAPACITY / --prefix-keeper-capacity)
+KEEPER_RESERVE = 8192           # a repaired prompt must fit max_context - this many tokens
+KEEPER_MAX_SYS_LINES = 8        # a system message may differ by this many changed lines at most
+KEEPER_MAX_SYS_FRAC = 0.05      # ... and by this fraction of its stored lines at most
+KEEPER_TAG = "\n\n[context update]\n"
+KEEPER_DIFF_CHARS = 600         # bound on the diff text in both log sinks
+
+
+def _keeper_nometa(m: dict) -> dict:
+    """A message's non-content fields for comparison, excluding the keeper's private provenance field (client
+    metadata - role, reasoning, call structures and ids - must all match; the provenance field never does)."""
+    return {k: v for k, v in m.items() if k not in ("content", "_keeper_injected")}
+
+
+def _keeper_same_base(a: dict, b: dict) -> bool:
+    """Same message modulo keeper-injected continuity: `a` is the stored forwarded message, `b` the new one.
+    Exact content matches, or `a` carries `_keeper_injected` provenance (raw+suffix recorded when the keeper
+    appended the block) and `b` equals that raw text - Hermes never saw the block, so its echo lacks it. Client
+    text resembling the tag is compared literally and never stripped, on either side."""
+    if _keeper_nometa(a) != _keeper_nometa(b):
+        return False
+    ca, cb = a.get("content"), b.get("content")
+    if ca == cb:
+        return True
+    if not (isinstance(ca, str) and isinstance(cb, str)):
+        return False
+    f = a.get("_keeper_injected")
+    return isinstance(f, dict) and f.get("raw") == cb and ca == cb + (f.get("suffix") or "")
+
+
+def _keeper_bytes(messages: list) -> int:
+    """Approximate request size: UTF-8 bytes of text contents plus rendered tool calls."""
+    n = 0
+    for m in messages:
+        c = m.get("content")
+        if isinstance(c, str):
+            n += len(c.encode("utf-8"))
+        for tc in m.get("tool_calls") or []:
+            n += len(json.dumps(tc, ensure_ascii=False).encode("utf-8"))
+    return n
+
+
+def _keeper_system_delta(old: str, new: str) -> tuple:
+    """Volatile-line deltas as `- old` / `+ new` pairs, one pair per changed line (insertions/deletions unpaired),
+    with FULL lines for the model - only the logs are bounded. -> (deltas or None when too big, changed count).
+    Changed lines per hunk count as max(old lines, new lines); an empty stored system never fuzzy-matches."""
+    a, b = old.splitlines(), new.splitlines()
+    if a == b:
+        return [], 0
+    if not a:
+        return None, len(b)
+    changed, diff = 0, []
+    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(a=a, b=b, autojunk=False).get_opcodes():
+        if tag == "equal":
+            continue
+        changed += max(i2 - i1, j2 - j1)
+        old_lines, new_lines = a[i1:i2], b[j1:j2]
+        for k in range(max(len(old_lines), len(new_lines))):
+            if k < len(old_lines):
+                diff.append("- " + old_lines[k])
+            if k < len(new_lines):
+                diff.append("+ " + new_lines[k])
+    if changed > KEEPER_MAX_SYS_LINES or changed > KEEPER_MAX_SYS_FRAC * len(a):
+        return None, changed
+    return diff, changed
+
+
+def _keeper_same(a: dict, b: dict) -> bool:
+    """Byte-identical normalized messages (roles, contents, assistant call structures)."""
+    return a == b
+
+
+def _keeper_identity(m: dict):
+    """A message's nonempty tool identity, or None: assistant call ids, or a tool message's tool_call_id."""
+    tcs = m.get("tool_calls") or []
+    if tcs:
+        ids = tuple(c.get("id") for c in tcs if isinstance(c, dict))
+        if len(ids) == len(tcs) and all(isinstance(x, str) and x for x in ids):
+            return ("calls", ids)
+        return None
+    tid = m.get("tool_call_id")
+    return ("tool", tid) if isinstance(tid, str) and tid else None
+
+
+def _keeper_shortened(s: dict, n: dict) -> bool:
+    """`n` is a shortened form of stored `s`: every non-content field (role, reasoning, call structures AND ids,
+    provenance excluded) must match exactly; then, against the stored text - the provenance raw when the keeper
+    injected a block, else the literal content - a strict non-empty truncation for anchored plain text, or any
+    shorter text only with the same nonempty tool identity (same-identity summary)."""
+    if _keeper_nometa(s) != _keeper_nometa(n):
+        return False
+    cs, cn = s.get("content"), n.get("content")
+    if not isinstance(cs, str) or not isinstance(cn, str) or not cn:
+        return False
+    f = s.get("_keeper_injected")
+    base = f.get("raw") if isinstance(f, dict) and isinstance(f.get("raw"), str) else cs
+    if cn == base or len(cn) >= len(base):
+        return False
+    sid, nid = _keeper_identity(s), _keeper_identity(n)
+    if sid is not None and sid == nid:
+        return True
+    return base.startswith(cn)
+
+
+def _keeper_describe(s: dict, n: dict) -> str:
+    """Short reason a message pair is a change, not a removal/shortening (bounded by the caller)."""
+    if s.get("role") != n.get("role"):
+        return f"role {s.get('role')!r}!={n.get('role')!r}"
+    if s.get("tool_call_id") != n.get("tool_call_id"):
+        return f"tool_call_id changed {s.get('tool_call_id')!r}!={n.get('tool_call_id')!r}"
+    if (s.get("tool_calls") or []) != (n.get("tool_calls") or []):
+        def sig(c):
+            fn = (c.get("function") or {}) if isinstance(c, dict) else {}
+            return (c.get("id") if isinstance(c, dict) else None, fn.get("name"),
+                    json.dumps(fn.get("arguments"), ensure_ascii=False, sort_keys=True)[:80])
+        sn = [sig(c) for c in (s.get("tool_calls") or [])]
+        nn = [sig(c) for c in (n.get("tool_calls") or [])]
+        if [x[1] for x in sn] != [x[1] for x in nn]:
+            return f"tool_calls changed {[x[1] for x in sn]!r}!={[x[1] for x in nn]!r}"
+        return f"tool_call ids/args changed {sn!r}!={nn!r}"
+    if s.get("reasoning_content") != n.get("reasoning_content"):
+        return "reasoning changed"
+    return "content changed"
+
+
+def _keeper_related(S: list, N: list) -> bool:
+    """Identity evidence linking new history to stored history: a shared nonempty tool identity (call ids or a
+    tool_call_id). Plain-text coincidence alone is not relation."""
+    ids = set()
+    for s in S:
+        sid = _keeper_identity(s)
+        if sid is not None:
+            ids.add(sid)
+    return any(_keeper_identity(m) in ids and _keeper_identity(m) is not None for m in N)
+
+
+def _keeper_align(S: list, N: list) -> tuple:
+    """Align stored history S with new history N (system already handled). -> (status, ops, j, note, at) where
+    ops is match/shorten/restore/append with stored/new indices, j the consumed new count, `at` the N index to
+    log. "ok" means N is stored minus removals/shortenings plus appends; "mutation" means a change, reorder
+    (including a stored message re-sent in the appended tail), ambiguity or identity-linked divergence after j
+    aligned pairs; "unrelated" means zero alignment and zero identity evidence (a fresh conversation)."""
+    ops, i, j = [], 0, 0
+    while i < len(S) and j < len(N):
+        s, n = S[i], N[j]
+        if _keeper_same(s, n) or _keeper_same_base(s, n):
+            ops.append(("match", i, j))
+            i, j = i + 1, j + 1
+            continue
+        if _keeper_shortened(s, n):
+            ops.append(("shorten", i, j))
+            i, j = i + 1, j + 1
+            continue
+        ks = [k for k in range(i + 1, len(S)) if _keeper_same(S[k], n) or _keeper_same_base(S[k], n)]
+        if len(ks) == 1:                        # earlier stored messages removed: re-insert them
+            for r in range(i, ks[0]):
+                ops.append(("restore", r))
+            i = ks[0]
+            continue
+        tail = [("append", a) for a in range(j, len(N))]   # divergence keeps the new tail (never dropped)
+        if len(ks) > 1:
+            # the same stored content twice: an ambiguous move, never a removal
+            return ("mutation", ops + tail, j, "ambiguous alignment", j)
+        if any(_keeper_same(S[i], m) or _keeper_same_base(S[i], m) for m in N[j + 1:]):
+            return ("mutation", ops + tail, j, "insertion/reorder", j)
+        if j or _keeper_related(S, N):          # first-divergence with identity evidence is a change, not fresh
+            return ("mutation", ops + tail, j, _keeper_describe(s, n), j)
+        return ("unrelated", ops + tail, j, "", j)
+    for r in range(i, len(S)):
+        ops.append(("restore", r))              # a truncated tail is restored too
+    for a in range(j, len(N)):
+        ops.append(("append", a))
+    if not sum(1 for o in ops if o[0] in ("match", "shorten")):
+        return ("mutation" if _keeper_related(S, N) else "unrelated", ops, j, "", j)
+    used = {o[1] for o in ops if o[0] in ("match", "shorten", "restore")}
+    for o in ops:
+        if o[0] == "append" and any(_keeper_same_base(S[k], N[o[1]]) for k in used):
+            return ("mutation", ops, j, "moved/reordered message", o[1])   # a stored message re-sent later
+    return ("ok", ops, j, "", j)
+
+
+def _keeper_exact_repeat(e: dict, plan: dict, messages: list) -> bool:
+    """A repeated logical request: no appends, and the stored last message's injected suffix is exactly the
+    current delta block over the incoming last message's raw text. Forwarding the stored bytes then repeats the
+    identical logical request instead of stacking another block; a genuinely new delta still fails safe."""
+    if not plan["deltas"] or any(o[0] == "append" for o in plan["ops"]):
+        return False
+    S, N = e["messages"], messages
+    if not S or not N:
+        return False
+    f = S[-1].get("_keeper_injected")
+    raw = N[-1].get("content")
+    return isinstance(f, dict) and isinstance(raw, str) and \
+        f.get("suffix") == KEEPER_TAG + "\n".join(plan["deltas"]) and f.get("raw") == raw and \
+        S[-1].get("content") == raw + f.get("suffix")
+
+
+def _keeper_plan(S: list, N: list) -> dict:
+    """Full repair plan for stored S vs new N: system deltas plus history alignment. "nomatch" = different world
+    (system appeared/vanished/rewritten, multimodal); history never resurrects on "unrelated"."""
+    s_sys = S[0] if S and S[0].get("role") == "system" else None
+    n_sys = N[0] if N and N[0].get("role") == "system" else None
+    if (s_sys is None) != (n_sys is None):
+        return {"verdict": "nomatch"}
+    deltas, sys_rewrite = [], None
+    if s_sys is not None:
+        if not _keeper_same(s_sys, n_sys):
+            cs, cn = s_sys.get("content"), n_sys.get("content")
+            if not isinstance(cs, str) or not isinstance(cn, str):
+                return {"verdict": "nomatch"}
+            deltas, changed = _keeper_system_delta(cs, cn)
+            if deltas is None:
+                sys_rewrite = changed     # decided below: mutation when the history is related, else silent
+    off = 1 if s_sys is not None else 0
+    S_hist, N_hist = S[off:], N[off:]
+    status, ops, j, note, at = _keeper_align(S_hist, N_hist)
+    if sys_rewrite is not None:           # a big system rewrite is a non-append mutation, not a new world...
+        if status in ("ok", "mutation"):  # ...when the same history relates; unrelated sessions stay silent
+            return {"verdict": "mutation", "deltas": [], "ops": ops, "j": j,
+                    "note": f"system rewritten ({sys_rewrite} changed lines)", "at": 0, "sys": True}
+        return {"verdict": "nomatch"}
+    if status == "ok":                    # a plain first-message shortening alone proves nothing: it needs an
+        for o in ops:                     # unchanged anchor elsewhere or a shared tool id, else it may be fresh
+            if o[0] == "shorten" and _keeper_identity(S_hist[o[1]]) is None and \
+                    not any(p[0] == "match" for p in ops) and not _keeper_related(S_hist, N_hist):
+                return {"verdict": "mutation", "deltas": [], "ops": ops, "j": j,
+                        "note": "unanchored shortened message", "at": off + o[2], "sys": s_sys is not None}
+    return {"verdict": status, "deltas": deltas, "ops": ops, "j": j, "note": note, "at": off + at,
+            "sys": s_sys is not None}
+
+class PrefixKeeper:
+    """Bounded in-memory LRU of forwarded chat requests with append-only repair (see the section comment). All
+    methods are fail-safe: any internal error forwards Hermes' version unchanged. Thread-safe via one lock with
+    short critical sections (rendering and logging happen outside it)."""
+
+    def __init__(self, capacity: int = KEEPER_CAPACITY, enabled: bool = True, log_path=None):
+        self.capacity = max(1, int(capacity or KEEPER_CAPACITY))
+        self.enabled = bool(enabled)
+        self.log_path = log_path                # explicit prefix-keeper.jsonl path (tests); else engine log sibling
+        self.lock = threading.Lock()
+        self.log_lock = threading.Lock()      # stderr + jsonl appends serialize here (one event, one line each)
+        self.entries: collections.OrderedDict = collections.OrderedDict()   # req id -> stored request
+
+    def repair(self, svc, messages: list, tools, kw: dict) -> tuple:
+        """-> (forward messages, forward tools): the repaired request, or the original objects untouched."""
+        if any(isinstance(m.get("content"), list) for m in messages):
+            return messages, tools               # multimodal: passthrough, never estimate (no vision/GPU touch)
+        req_id = uuid.uuid4().hex[:12]
+        before = _keeper_bytes(messages)
+        with self.lock:
+            cands = list(self.entries.items())[::-1]    # most recent first
+        best = None                 # strongest related candidate: (prefix, identity, rank, key, entry, plan)
+        sys_only = None             # most recent same-config system-only repair candidate
+        rank = -1
+        for key, e in cands:        # most recent first; rank 0 wins ties after identity evidence
+            rank += 1
+            if any(isinstance(m.get("content"), list) for m in e["messages"]):
+                continue
+            plan = _keeper_plan(e["messages"], messages)
+            if plan["verdict"] == "nomatch":
+                continue
+            if plan["verdict"] == "unrelated":
+                if plan["deltas"] and sys_only is None and e["tools"] == tools and e["kw"] == kw:
+                    sys_only = (key, e, plan)
+                continue
+            off = 1 if plan["sys"] else 0   # longest CONSECUTIVE common prefix, not subsequence count
+            prefix = 0
+            for o in plan["ops"]:
+                if o[0] not in ("match", "shorten"):
+                    break
+                prefix += 1
+            s_ids = {_keeper_identity(m) for m in e["messages"]}   # shared ids anywhere in BOTH histories:
+            s_ids.discard(None)                                    # a mutation stops before C, so aligned ops
+            n_ids = {_keeper_identity(m) for m in messages}        # alone would hide the relation; the full
+            n_ids.discard(None)                                    # intersection does not (roles/types in identity)
+            ident = len(s_ids & n_ids)
+            if best is None or (prefix, ident, -rank) > (best[0], best[1], -best[2]):
+                best = (prefix, ident, rank, key, e, plan)
+        try:
+            if best is not None:
+                # the related candidate first, then its verdict decides: a cfg mismatch or mutation in the
+                # strongest candidate is never overruled by an older repair
+                _, _, _, key, e, plan = best
+                off = 1 if plan["sys"] else 0
+                if e["tools"] != tools or e["kw"] != kw:
+                    what = "/".join(x for x, same in (("tools", e["tools"] == tools),
+                                                      ("options", e["kw"] == kw)) if not same)
+                    self._log(svc, "mutation-unrepaired", req_id, plan["at"],
+                              before, before, f"{what} changed")
+                    return messages, tools
+                if plan["verdict"] == "mutation":
+                    self._log(svc, "mutation-unrepaired", req_id, plan["at"],
+                              before, before, plan["note"])
+                    return messages, tools
+                hist = e["messages"][off:]
+                if not plan["deltas"] and all(o[0] in ("match", "append") for o in plan["ops"]) and \
+                        all(hist[o[1]] == messages[off + o[2]] for o in plan["ops"] if o[0] == "match"):
+                    with self.lock:              # already stored + appended, byte-identical: silent, no render
+                        if key in self.entries:
+                            self.entries.move_to_end(key)
+                    return messages, tools
+                if plan["deltas"] and not any(o[0] == "append" for o in plan["ops"]) and \
+                        not _keeper_exact_repeat(e, plan, messages):
+                    self._log(svc, "mutation-unrepaired", req_id, 0, before, before,
+                              "system delta unrepairable without touching the stored prefix")
+                    return messages, tools
+                repaired, first = self._build(e, plan, messages)
+                if not repaired:
+                    return messages, tools
+                after = _keeper_bytes(repaired)
+                if not self._budget_ok(svc, repaired, tools, kw, req_id, before, after):
+                    return messages, tools
+                with self.lock:
+                    if key in self.entries:
+                        self.entries.move_to_end(key)
+                if plan["deltas"]:
+                    self._log(svc, "system-delta", req_id, 0, before, after, "; ".join(plan["deltas"]))
+                if first >= 0:
+                    n_r = sum(1 for o in plan["ops"] if o[0] == "restore")
+                    n_s = sum(1 for o in plan["ops"] if o[0] == "shorten")
+                    n_a = sum(1 for o in plan["ops"] if o[0] == "append")
+                    self._log(svc, "history-restore", req_id, first, before, after,
+                              f"restored={n_r} shortened={n_s} appended={n_a}")
+                return repaired, tools
+            if sys_only is not None:
+                _, e, plan = sys_only
+                if plan["deltas"] and not any(o[0] == "append" for o in plan["ops"]) and \
+                        not _keeper_exact_repeat(e, plan, messages):
+                    self._log(svc, "mutation-unrepaired", req_id, 0, before, before,
+                              "system delta unrepairable without touching the stored prefix")
+                    return messages, tools
+                repaired, _ = self._build(e, plan, messages)
+                if not repaired:
+                    return messages, tools
+                after = _keeper_bytes(repaired)
+                if not self._budget_ok(svc, repaired, tools, kw, req_id, before, after):
