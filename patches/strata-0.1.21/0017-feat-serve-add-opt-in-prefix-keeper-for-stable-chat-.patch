+    # -- keeper mechanics: capacity, input safety, log shape, concurrency ----------------------
+    def test_capacity_lru_bounded(self):
+        svc, _ = self.bare(capacity=2)
+        e1, e2, e3 = [{"role": "user", "content": "E1-x"}], [{"role": "user", "content": "E2-y"}], \
+            [{"role": "user", "content": "E3-z"}]
+        svc.keeper_remember(e1, None, {})
+        svc.keeper_remember(e2, None, {})
+        svc.keeper_remember(e3, None, {})
+        blob = json.dumps([e["messages"] for e in svc.keeper.entries.values()])
+        self.assertEqual(len(svc.keeper.entries), 2)
+        self.assertNotIn("E1-x", blob)
+        self.assertIn("E2-y", blob)
+        fwd, _ = svc.keeper_repair(e2 + [{"role": "user", "content": "probe"}], None, {})  # touches E2
+        self.assertIn("probe", json.dumps(fwd))
+        svc.keeper_remember([{"role": "user", "content": "E4-w"}], None, {})
+        blob = json.dumps([e["messages"] for e in svc.keeper.entries.values()])
+        self.assertIn("E2-y", blob)                        # recently repaired E2 survives ...
+        self.assertNotIn("E3-z", blob)                     # ... while the untouched E3 drops out
