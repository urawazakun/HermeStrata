+    def test_lru_touch_does_not_hide_related_mutation(self):
+        svc, eng, log, base = self.fresh()
+        s, b = self.chat(base, "openai", None, [{"role": "user", "content": "U1-m2"}], self.OAI_TOOLS)
+        self.assertEqual(s, 200, b)                            # e1
+        e2 = [{"role": "user", "content": "U1-m2"}, self.oai_call(args={"q": "W1-marker"}, cid="call_D"),
+              self.oai_result("T-ok", cid="call_D")]
+        s, b = self.chat(base, "openai", None, e2, self.OAI_TOOLS)
+        self.assertEqual(s, 200, b)                            # e2 extends e1
+        # A pure-append repair of e1 would see e2's stronger mutation and never touch e1 (Sol), so the
+        # LRU order is arranged explicitly: e1 most recent, e2 older.
+        e1_key = next(k for k, e in svc.keeper.entries.items() if len(e["messages"]) == 1)
+        with svc.keeper.lock:
+            svc.keeper.entries.move_to_end(e1_key)
+            self.assertEqual(list(svc.keeper.entries)[-1], e1_key)
+        new = [{"role": "user", "content": "U1-m2"}, self.oai_call(args={"q": "W2-marker"}, cid="call_D"),
+               self.oai_result("T-ok", cid="call_D"), {"role": "user", "content": "Ufresh-m2"}]
+        (s, b), err = self.capture(lambda: self.chat(base, "openai", None, new, self.OAI_TOOLS))
+        self.assertEqual(s, 200, b)
+        text = self.prompt(eng)
+        self.assertIn("W2-marker", text)       # the changed call goes out as sent ...
+        self.assertNotIn("W1-marker", text)    # ... with nothing resurrected ...
+        self.assertIn("keeper mutation-unrepaired", err)       # ... and the related mutation is logged
+        self.assertTrue([r for r in self.jsonl(log) if r["kind"] == "mutation-unrepaired"])
