+
+// ---- E5 fixtures -----------------------------------------------------------
+//
+// Two small geometries with hand-derived byte sizes (literals, worked out by hand from the layout
+// contract in saved_state.hpp - not via kv_pool_bytes - so a wrong formula fails the test):
+//
+//   gA fp16: 1 layer, 1 KV head, head_dim 8, page 4. One code row = 8 dim * 2 B = 16 B; one page
+//     holds 1 head * 4 cells * 16 B = 64 B. C cells -> ceil(C/4) pages -> ceil(C/4)*64 B per k/v,
+//     no scales. Indexer (block 4, idx_dim 4): rows = L/4+1, pooled = rows*16 B, dead_key 16 B.
+//   gB int8/q4: 1 layer, 2 KV heads, head_dim 64, page 8. int8 code row = 64 B, scale row =
+//     (64/64 group)*2 B = 2 B; one page = 2 heads * 8 cells * row -> 1024 B code, 32 B scales.
+//     q4: one head = (64/32 blocks)*18 B = 36 B; one page = 2*8*36 = 576 B, no scales.
+// Boundary row everywhere: hc=2, n_embd=4 -> 8 floats.
+
+saved::SnapshotGeom geom_a() {
+    saved::SnapshotGeom g;
+    g.n_qsa_layers = 1;
+    g.n_head_kv = 1;
+    g.head_dim = 8;
+    g.idx_dim = 4;
+    g.idx_block = 4;
+    g.page_size = 4;
+    return g;
+}
+
+saved::SnapshotGeom geom_b() {
+    saved::SnapshotGeom g;
+    g.n_qsa_layers = 1;
+    g.n_head_kv = 2;
+    g.head_dim = 64;
+    g.idx_dim = 4;
+    g.idx_block = 4;
+    g.page_size = 8;
+    return g;
+}
+
+void fill_indexer(saved::StagePayload& sp, int L, const saved::SnapshotGeom& g) {
+    saved::IndexerPayload ix;
+    ix.pooled_rows = L / (int) g.idx_block + 1;
+    ix.pooled.assign((size_t) (ix.pooled_rows * g.idx_dim * 4), 0x11);
+    ix.block_pos = {3};
+    ix.dead_key.assign((size_t) (g.idx_dim * 4), 0x22);
+    sp.idx.push_back(std::move(ix));
+}
+
+void fill_boundary(saved::SavedItem& it) {
+    it.boundary.hc = 2;
+    it.boundary.n_embd = 4;
+    it.boundary.row.assign(8, 0.5f);
+}
+
+// Complete fp16 gA item, ids = base..base+L-1 (two different bases = two unrelated lines).
+saved::SavedItem make_line(int L, int base) {
+    saved::SavedItem it;
+    it.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) it.ids[(size_t) i] = (int32_t) (base + i);
+    it.cvec = true;
+    it.n_stages = 1;
+    it.geom = geom_a();
+    saved::StagePayload sp;
+    sp.rec.gdn = {7, 9};
+    sp.rec.tails = {8};
+    sp.rec.ple_prev[0] = L >= 2 ? L - 2 : -1;
+    sp.rec.ple_prev[1] = L - 1;
+    const size_t code = (size_t) ((L + 3) / 4) * 64;   // ceil(L/4) pages * 64 B
+    saved::KvLayerPayload kv;
+    kv.fmt = saved::kKvF16;
+    kv.cells = L;
+    kv.k.assign(code, 0x31);
+    kv.v.assign(code, 0x32);
+    sp.kv.push_back(std::move(kv));
+    fill_indexer(sp, L, it.geom);
+    it.stages.push_back(std::move(sp));
+    fill_boundary(it);
+    if (L > 1) {
+        const size_t mcode = (size_t) ((L - 1 + 3) / 4) * 64;   // MTP rows are exactly [0, L-1)
+        saved::KvLayerPayload m;
+        m.fmt = saved::kKvF16;
+        m.cells = L - 1;
+        m.k.assign(mcode, 0x41);
+        m.v.assign(mcode, 0x42);
+        it.mtp.kv.push_back(std::move(m));
+        it.mtp.cells = L - 1;
+        it.mtp.valid_from = 0;
+    }
+    return it;
+}
+
+// Complete int8 gB item (codes + scales, same fmt on MTP).
+saved::SavedItem make_int8_line(int L, int base) {
+    saved::SavedItem it;
+    it.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) it.ids[(size_t) i] = (int32_t) (base + i);
+    it.cvec = false;
+    it.n_stages = 1;
+    it.geom = geom_b();
+    saved::StagePayload sp;
+    sp.rec.gdn = {7};
+    sp.rec.ple = {1, 2, 3};
+    sp.rec.tails = {8};
+    const size_t pages = (size_t) ((L + 7) / 8);
+    saved::KvLayerPayload kv;
+    kv.fmt = saved::kKvInt8;
+    kv.cells = L;
+    kv.k.assign(pages * 1024, 0x51);
+    kv.v.assign(pages * 1024, 0x52);
+    kv.ks.assign(pages * 32, 0x53);
+    kv.vs.assign(pages * 32, 0x54);
+    sp.kv.push_back(std::move(kv));
+    fill_indexer(sp, L, it.geom);
+    it.stages.push_back(std::move(sp));
+    fill_boundary(it);
+    if (L > 1) {
+        const size_t mp = (size_t) ((L - 1 + 7) / 8);
+        saved::KvLayerPayload m;
+        m.fmt = saved::kKvInt8;
+        m.cells = L - 1;
+        m.k.assign(mp * 1024, 0x61);
+        m.v.assign(mp * 1024, 0x62);
+        m.ks.assign(mp * 32, 0x63);
+        m.vs.assign(mp * 32, 0x64);
+        it.mtp.kv.push_back(std::move(m));
+        it.mtp.cells = L - 1;
+        it.mtp.valid_from = 0;
+    }
+    return it;
+}
+
+// Complete q4 gB item (no scales anywhere).
+saved::SavedItem make_q4_line(int L, int base) {
+    saved::SavedItem it;
+    it.ids.resize((size_t) L);
+    for (int i = 0; i < L; ++i) it.ids[(size_t) i] = (int32_t) (base + i);
+    it.cvec = true;
+    it.n_stages = 1;
+    it.geom = geom_b();
+    saved::StagePayload sp;
+    sp.rec.gdn = {7};
+    sp.rec.tails = {8};
+    const size_t pages = (size_t) ((L + 7) / 8);
+    saved::KvLayerPayload kv;
+    kv.fmt = saved::kKvQ4;
+    kv.cells = L;
+    kv.k.assign(pages * 576, 0x71);
+    kv.v.assign(pages * 576, 0x72);
+    sp.kv.push_back(std::move(kv));
+    fill_indexer(sp, L, it.geom);
+    it.stages.push_back(std::move(sp));
+    fill_boundary(it);
+    if (L > 1) {
+        const size_t mp = (size_t) ((L - 1 + 7) / 8);
+        saved::KvLayerPayload m;
+        m.fmt = saved::kKvQ4;
+        m.cells = L - 1;
+        m.k.assign(mp * 576, 0x81);
+        m.v.assign(mp * 576, 0x82);
+        it.mtp.kv.push_back(std::move(m));
+        it.mtp.cells = L - 1;
+        it.mtp.valid_from = 0;
+    }
+    return it;
+}
+
+std::vector<int32_t> req_at(int base, int n) {
+    std::vector<int32_t> v((size_t) n);
+    for (int i = 0; i < n; ++i) v[(size_t) i] = (int32_t) (base + i);
+    return v;
+}
+
+// A mutated copy must fail complete() AND be refused by insert_tip (the store's structural gate).
+void rejects(saved::SavedItem good, const std::function<void(saved::SavedItem&)>& mut, const char* what,
+             const char* what_ins) {
+    mut(good);
+    check(!good.complete(), what);
+    saved::SavedStateStore st;
+    check(!st.insert_tip(good, false) && st.tips() == 0, what_ins);
+}
 }  // namespace
 
