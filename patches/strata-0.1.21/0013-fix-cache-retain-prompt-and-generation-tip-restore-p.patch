+// backing (immutable during decode); only cells/valid_from metadata is the prompt's own.
+saved::SavedItem make_shared_prompt_item(int n, int base) {
+    saved::SavedItem it = make_prompt_item(n, base);
+    it.mtp.kv.clear();
+    it.mtp.cells = n - 1;
+    it.mtp.valid_from = 0;
+    return it;
+}
