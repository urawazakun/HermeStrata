+// ---- F2 fixtures -----------------------------------------------------------
+//
+// A prompt-end point for the first n ids of a gen line (same base, so it is a strict prefix of the gen ids):
+// own recurrent/indexer/boundary/MTP payloads (prompt-only, marker-filled to prove no aliasing with the
+// generation state), EMPTY main KV (it shares the generation storage - no duplicate copy).
+saved::SavedItem make_prompt_item(int n, int base) {
+    saved::SavedItem it = make_line(n, base);
+    for (saved::StagePayload& s : it.stages) s.kv.clear();   // shared: the prompt stores no KV copy
+    for (saved::StagePayload& s : it.stages) {
+        if (!s.rec.gdn.empty()) s.rec.gdn[0] = 0xA1;
+        if (!s.rec.tails.empty()) s.rec.tails[0] = 0xA2;
+        for (saved::IndexerPayload& x : s.idx) {
+            if (!x.pooled.empty()) x.pooled[0] = 0xA3;
+            if (!x.dead_key.empty()) x.dead_key[0] = 0xA4;
+        }
+    }
+    if (!it.boundary.row.empty()) it.boundary.row[0] = 1.5f;   // R_(n-1), not the generation row
+    if (!it.mtp.kv.empty()) {
+        if (!it.mtp.kv[0].k.empty()) it.mtp.kv[0].k[0] = 0xA5;   // own exact [0, n-1) pairs
+        if (!it.mtp.kv[0].v.empty()) it.mtp.kv[0].v[0] = 0xA6;
+    }
+    return it;
+}
