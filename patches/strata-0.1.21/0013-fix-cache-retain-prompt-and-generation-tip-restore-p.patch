 // Section 7 (forked children): a tip covers prompt + GENERATED assistant tokens at exactly the DONE boundary,
 // so a forked child (parent prompt + parent's generated tool-call + a short tool result) resumes with a tiny
 // suffix. Tips are snapshotted after DONE is sent/flushed, never blocking the reply.
+//
+// F2 (BRIEF-CACHE-FIX-1): the tip's generation-end ids are prompt + generated ids (reasoning/<think> included)
+// but the next turn re-renders the assistant WITHOUT the reasoning, so the generation point is never a prefix
+// of the next prompt. One tip therefore retains TWO coherent restorable points of its line:
+//   (a) the prompt end (state + logical KV [0, n)) - always a prefix of the next turn of the same line and of
+//       a forked child's prompt (parent prompt + re-rendered assistant + tool result);
+//   (b) the generation end (previous behaviour) - used when the client echoes the generated ids verbatim.
+// Resume picks the longest valid point across both. The prompt point lives in the store (tips_), so it survives
+// an unrelated (child) request independently of the chain, which the chain does not. Roots stay single-point
+// (E3 persists roots only; paired tips are RAM-only).
 #pragma once
 
 #include "strata/kernels/kv_q4.hpp"   // authoritative q4 row formula (CPU-clean: <cstdint> + qsa.hpp only)
@@ -250,6 +260,21 @@ inline bool kv_blob_ok(const KvLayerPayload& k, int64_t cells, const SnapshotGeo
     return (uint64_t)k.ks.size() == sc && (uint64_t)k.vs.size() == sc;
 }
 
+/// F2: prefix coverage - `src` holds at least the [0, cells) page range. Pages are written in order, so the
+/// range is a byte-prefix of the stored vectors. Lets a prompt point validate against (and E2 restore from)
+/// its generation owner's KV without any copy.
+inline bool kv_prefix_ok(const KvLayerPayload& src, int64_t cells, const SnapshotGeom& gm) {
+    if (cells < 1 || src.cells < cells) return false;
+    if (src.fmt != kKvF16 && src.fmt != kKvInt8 && src.fmt != kKvQ4) return false;
+    const uint64_t code = kv_pool_bytes(src.fmt, cells, gm.n_head_kv, gm.head_dim, gm.page_size, false);
+    if ((uint64_t)src.k.size() < code || (uint64_t)src.v.size() < code) return false;
+    if (src.fmt == kKvInt8) {
+        const uint64_t sc = kv_pool_bytes(src.fmt, cells, gm.n_head_kv, gm.head_dim, gm.page_size, true);
+        return (uint64_t)src.ks.size() >= sc && (uint64_t)src.vs.size() >= sc;
+    }
+    return src.ks.empty() && src.vs.empty();
+}
